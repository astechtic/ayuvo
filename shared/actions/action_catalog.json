{
  "format": "ayuvo-actions-catalog",
  "version": 1,
  "enums": {
    "aggregation": ["latest", "sum", "average", "min", "max", "count"],
    "body_site": ["neck", "waist", "hips", "chest", "upper_arm", "thigh", "calf", "wrist"],
    "date_range": ["today", "yesterday", "this_week", "last_week", "last_7_days", "last_30_days", "this_month", "last_month"],
    "dose_action": ["taken", "skipped", "snoozed"],
    "goal_kind": ["calories", "protein", "carbs", "fat", "water", "steps"],
    "length_unit": ["cm", "in"],
    "mass_unit": ["kg", "lb"],
    "meal_type": ["breakfast", "lunch", "dinner", "snack", "other"],
    "nutrient": ["calories", "protein", "carbs", "fat", "fiber"],
    "search_domain": ["all", "food", "exercises", "metrics", "records", "medications"],
    "section": ["summary", "browse", "health", "nutrition", "water", "fasting", "body", "activity", "workouts", "records", "medications", "coach", "settings"],
    "volume_unit": ["ml", "l", "floz", "cup"]
  },
  "units": {
    "length": {"canonical": "cm", "enum": "length_unit", "factors": {"cm": 1, "in": 2.54}},
    "mass": {"canonical": "kg", "enum": "mass_unit", "factors": {"kg": 1, "lb": 0.45359237}},
    "volume": {"canonical": "ml", "enum": "volume_unit", "factors": {"cup": 240, "floz": 29.5735295625, "l": 1000, "ml": 1}}
  },
  "entities": {
    "dose": "A scheduled medication dose for today. Shows the medication name and time only, never the strength or amount.",
    "exercise": "An exercise from the Ayuvo exercise library or your own exercises.",
    "fasting_session": "A completed or active fast.",
    "food": "A saved, favourite or recent food that can be logged again.",
    "food_entry": "A food you logged.",
    "health_record": "A document in Health Records (lab report, prescription, note).",
    "lab_value": "A lab test (analyte) found in your Health Records, e.g. HbA1c.",
    "medication": "A medication in your list.",
    "metric": "Any metric Ayuvo can chart: app metrics (app:water) or Health data types (steps).",
    "search_result": "A result from universal search.",
    "workout": "A completed workout session."
  },
  "actions": [
    {
      "id": "health.metric.get",
      "kind": "get",
      "domain": "health",
      "title": "Get Health Data",
      "summary": "A single value for any metric over a date range: total steps this week, average heart rate, latest weight.",
      "params": [
        {"name": "metric", "type": "metric", "required": true, "summary": "Metric key, e.g. steps, heart_rate, app:water."},
        {"name": "range", "type": "enum", "enum": "date_range", "default": "today", "summary": "Date range."},
        {"name": "aggregation", "type": "enum", "enum": "aggregation", "summary": "How to combine samples. Defaults to the metric's natural aggregation."}
      ],
      "output": {"kind": "scalar", "fields": ["value", "unit", "aggregation", "sample_count", "from_ms", "to_ms"]},
      "permissions": ["health_read"],
      "confirmation": "never",
      "requires_unlock": true,
      "surfaces": ["siri", "shortcuts", "android", "deeplink"],
      "coach_mode": "none",
      "screen": "metric:{metric}",
      "examples": {
        "siri": ["What was my average heart rate this week in Ayuvo?", "How many steps today in Ayuvo?"],
        "shortcuts": ["Get Health Data (Heart Rate, This Week, Average) → If < 60 → Show Notification"],
        "android": ["ayuvo://action/health.metric.get?metric=steps&range=today"]
      }
    },
    {
