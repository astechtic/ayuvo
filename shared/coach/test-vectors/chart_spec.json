      },
      "input": {
        "raw": "{'type':'bar','series':[{'points':[['a',1]]}]}"
      },
      "name": "single quotes are rejected",
      "notes": "Guessing where a quoted string starts could change a value, so a spec written with single quotes is refused rather than repaired."
    },
    {
      "expected": {
        "ok": false,
        "reason": "invalid_json"
      },
      "input": {
        "raw": "{type:\"bar\",\"series\":[{\"points\":[[\"a\",1]]}]}"
      },
