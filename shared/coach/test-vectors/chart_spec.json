      "notes": "Repairs never guess at structure."
    },
    {
      "expected": {
        "ok": false,
        "reason": "no_points"
      },
      "input": {
        "raw": "{\"type\":\"bar\",\"series\":[{\"points\":[[\"a\",01]]}]}"
      },
      "name": "a leading zero is not a readable number",
      "notes": "01 could mean 1 or the string \"01\". It is read as no reading at all, so the point is left out rather than guessed at."
    },
