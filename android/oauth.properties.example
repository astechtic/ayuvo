# Copy to android/oauth.properties (gitignored) after creating OAuth clients
# in Google Cloud Console. Enable the Drive API. Use drive.appdata only.
#
# Android OAuth clients:
#   release  package com.ayuvo.health + Play App signing SHA-1
#   debug    package com.ayuvo.health.debug + debug keystore SHA-1
#
# Web client ID is used by AuthorizationClient.requestOfflineAccess.
cloud.backup.web.client.id=

# Google Health API (docs/google-health.md §2). Enable the Google Health API in the same
# Cloud project, add the googlehealth.* read scopes plus openid/email to the consent screen,
# and register the Android clients above for package + SHA-1. The web client id is optional;
# when set it is passed to AuthorizationClient.requestOfflineAccess.
google.health.web.client.id=
