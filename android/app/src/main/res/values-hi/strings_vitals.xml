    <string name="camvitals_calibration_spo2_footer">SpO₂ के लिए इस फ़ोन मॉडल पर उंगली स्कैन के साथ जोड़ी गई कम से कम %1$d पल्स ऑक्सीमीटर रीडिंग ज़रूरी हैं (%2$s, अब तक %3$d)। स्वस्थ रीडिंग 95 और 99 %% के बीच रहती हैं, इसलिए कैलिब्रेशन कम मानों को शायद ही कवर करता है; इसके बाहर के मान अनुपलब्ध रहते हैं।</string>
    <string name="camvitals_calibration_spo2_off">प्रायोगिक अनुमान सेटिंग्स में बंद हैं।</string>
    <string name="camvitals_calibration_spo2_row">SpO₂ %1$s %%</string>
    <string name="camvitals_calibration_bp_header">ब्लड प्रेशर (शोध)</string>
    <string name="camvitals_calibration_bp_footer">कम से कम %1$d कफ़ रीडिंग ज़रूरी हैं, हर एक किसी उंगली स्कैन के %2$d मिनट के भीतर ली गई हो। कैलिब्रेशन %3$d दिनों के बाद समाप्त हो जाते हैं (अभी %4$d उपयोग योग्य)। शोध अनुमान, ब्लड प्रेशर माप नहीं।</string>
    <string name="camvitals_calibration_bp_off">शोध अनुमान सेटिंग्स में बंद हैं।</string>
    <string name="camvitals_calibration_bp_row">%1$s mmHg</string>
    <string name="camvitals_calibration_gap">स्कैन से %1$s मिनट</string>
