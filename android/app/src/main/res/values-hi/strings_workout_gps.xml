    <string name="workout_gps_cooper">Cooper 12-मिनट टेस्ट</string>
    <string name="workout_gps_cooper_detail">12 मिनट में जितनी हो सके उतनी दूरी तय करें। वर्कआउट अपने आप समाप्त हो जाता है।</string>
