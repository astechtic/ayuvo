    <string name="c_derived_metrics_lowest_night_hr_about">昨晚睡眠期间的单次最低心率读数。</string>
    <string name="c_derived_metrics_night_hr_dip_about" formatted="false">你睡眠时的心率比清醒时低多少。下降 10% 或以上是常见的健康模式。</string>
    <string name="c_derived_metrics_sedentary_hr_about">你白天 (09:00-21:00) 静坐时的心率，即至少 10 分钟没有走动时。</string>
    <string name="c_derived_metrics_daytime_hr_about">今天清醒时的平均、最低和最高心率。</string>
    <string name="c_derived_metrics_observed_max_hr_about">今天持续至少 2 分钟的最高心率。</string>
    <string name="c_derived_metrics_hr_max_estimate_about">你的估算最大心率，用于设定心率区间。</string>
    <string name="c_derived_metrics_hr_reserve_about">你的最大心率与静息心率之差。储备越大通常意味着体能越好。</string>
    <string name="c_derived_metrics_cardio_minutes_about">你的心率处于中等或高强度范围的分钟数，高强度分钟按两倍计算。WHO 建议每周 150-300 分钟。</string>
    <string name="c_derived_metrics_training_impulse_about">按心脏用力程度对时间加权的负荷分数。强度越高的分钟，计分呈指数级增加。</string>
    <string name="c_derived_metrics_vo2max_estimate_about">根据你的最大心率和静息心率估算的 VO₂max。这只是粗略参考；户外 GPS 训练可提供更准确的估算。</string>
    <string name="c_derived_metrics_rhr_deviation_about">今天的静息心率与你 30 天平均值的差距。连续两天比平时高 5 bpm 或以上，可能意味着身体负荷过大、睡眠不佳或即将生病。</string>
    <string name="c_derived_metrics_wear_minutes_about">今天你的可穿戴设备记录心率的分钟数。达到 10 小时或以上的一天计为有效天。</string>
    <string name="c_derived_metrics_walking_hr_about">你步行时的平均心率。通常随着体能提升而下降。</string>
    <string name="c_derived_metrics_sleep_efficiency_about" formatted="false">卧床时间中处于睡眠的比例。85% 或以上被认为是良好。</string>
    <string name="c_derived_metrics_sleep_onset_latency_about">上床后多久入睡。30 分钟以内属于常见情况。</string>
    <string name="c_derived_metrics_deep_sleep_pct_about" formatted="false">深睡占睡眠的比例。成年人通常约为 13-23%。</string>
    <string name="c_derived_metrics_rem_sleep_pct_about" formatted="false">REM 占睡眠的比例。成年人通常约为 20-25%。</string>
    <string name="c_derived_metrics_sleep_wakeups_about">首次入睡后清醒 5 分钟或以上的次数。</string>
    <string name="c_derived_metrics_bedtime_about">你的夜间睡眠开始的时间。</string>
    <string name="c_derived_metrics_wake_time_about">你最终醒来的时间。</string>
    <string name="c_derived_metrics_sleep_midpoint_about">入睡与醒来之间的中点。反映你的生物钟时间。</string>
    <string name="c_derived_metrics_deep_latency_about">从入睡到首次进入深睡的分钟数。</string>
    <string name="c_derived_metrics_rem_latency_about">从入睡到首次进入 REM 睡眠的分钟数。通常为 70-120 分钟。</string>
    <string name="c_derived_metrics_sleep_timing_variability_about">你过去 14 晚就寝时间的波动程度。低于 30-60 分钟即为规律。</string>
    <string name="c_derived_metrics_sleep_regularity_index_about">你在连续两天同一时间处于相同状态（睡着或清醒）的概率，换算为 100 分制。越高越规律。</string>
    <string name="c_derived_metrics_social_jetlag_about">你周末比工作日晚睡多少。低于 1 小时为佳。</string>
    <string name="c_derived_metrics_chronotype_about">你天然的生物钟时间：休息日的睡眠中点，并已校正补觉的影响。</string>
    <string name="c_derived_metrics_sleep_debt_about">过去 14 晚你相对每晚所需睡眠而缺少的睡眠。成年人至少需要 7 小时。</string>
    <string name="c_derived_metrics_brisk_minutes_about">你以每分钟 100 步或更快速度步行的分钟数，计为中等强度活动。</string>
    <string name="c_derived_metrics_peak_30_cadence_about">你今天步频最快的 30 分钟的平均值。</string>
    <string name="c_derived_metrics_active_hours_about">07:00 至 22:00 之间步数至少 250 步的小时数。建议每小时起身打断久坐。</string>
    <string name="c_derived_metrics_longest_sedentary_about">07:00 至 22:00 之间佩戴设备时，你连续没有走动的最长分钟数。</string>
    <string name="c_derived_metrics_step_band_about">你的每日步数按 Tudor-Locke 分级：久坐 &lt;5,000，低度活跃 5,000-7,499，较为活跃 7,500-9,999，活跃 10,000-12,499，高度活跃 ≥12,500。</string>
    <string name="c_derived_metrics_phone_left_behind_about">你的可穿戴设备计了步数而手机几乎没有计步的步数，例如手机留在家中时。</string>
    <string name="c_derived_metrics_step_streak_about">你连续达成步数目标的天数。</string>
    <string name="c_derived_metrics_stride_length_about">根据手机记录的距离和步数计算的平均步长，并与你身高对应的典型步长比较。</string>
    <string name="c_derived_metrics_tdee_about">你的身体今天消耗的全部能量：静息、活动和消化食物。</string>
    <string name="c_derived_metrics_measured_bmr_about">你的设备记录的每日静息能量消耗，并与 Mifflin-St Jeor 公式预测值并列显示。</string>
    <string name="c_derived_metrics_physical_activity_level_about">总能量消耗 ÷ 静息能量。1.40-1.69 为久坐至轻度活跃，1.70-1.99 为活跃，2.00-2.40 为高度活跃。</string>
    <string name="c_derived_metrics_walking_speed_weekly_about">你过去 7 天的典型步行速度。在老年人中，低于 0.8 m/s 与较高的健康风险相关。</string>
    <string name="c_derived_metrics_double_support_weekly_about" formatted="false">每一步中双脚同时着地的时间占比。典型值为 20-40%；较高可能意味着平衡能力较弱。</string>
    <string name="c_derived_metrics_asymmetry_flags_about" formatted="false">过去 7 天中，一侧步伐与另一侧相差超过 10% 的步行读数。</string>
    <string name="c_derived_metrics_sound_dose_about" formatted="false">你使用了每周安全聆听限额的多少，每周 100% 相当于 80 dB 持续 40 小时。</string>
    <string name="c_derived_metrics_weight_trend_about">平滑掉每日水分波动后的体重。</string>
    <string name="c_derived_metrics_weight_rate_about">你的平滑体重每周变化的速度。</string>
    <string name="c_derived_metrics_bmi_derived_about">根据你的平滑体重和身高计算的身体质量指数 (BMI)。</string>
    <string name="c_derived_metrics_healthy_weight_range_about">按你的身高，BMI 处于健康范围时对应的体重范围。</string>
    <string name="c_derived_metrics_goal_eta_about">按当前速度，还需要多少周达到目标体重。</string>
    <string name="c_derived_metrics_protein_per_kg_about">你记录的每公斤体重蛋白质摄入量。每天 1.4-2.0 g/kg 有助于力量训练。</string>
    <string name="c_derived_metrics_macro_split_about">根据你记录的克数，你的能量中来自蛋白质、碳水化合物和脂肪的比例。</string>
    <string name="c_derived_metrics_saturated_fat_share_about" formatted="false">你的能量中来自饱和脂肪的比例。WHO 建议低于 10%。</string>
    <string name="c_derived_metrics_fiber_density_about">你每摄入 1,000 kcal 所含的纤维。建议每 1,000 kcal 约 14 g。</string>
    <string name="c_derived_metrics_sodium_potassium_ratio_about">钠与钾的摩尔比。WHO 建议保持在 1 以下。烹饪时添加的盐通常不包含在食物估算中。</string>
    <string name="c_derived_metrics_eating_window_about">从你记录的第一份到最后一份食物的时间，以进食时间为准。</string>
    <string name="c_derived_metrics_last_meal_to_bed_about">从你最后一次进食到上床睡觉的时间。</string>
    <string name="c_derived_metrics_iron_absorption_risk_about">你在食用富铁食物前后一小时内喝茶或咖啡的次数，这可能会减少铁的吸收。</string>
    <string name="c_derived_metrics_energy_balance_about">你今天记录的卡路里减去消耗的能量。</string>
    <string name="c_derived_metrics_adaptive_tdee_about">根据你 4 周内的饮食和体重趋势变化，推算你身体每天可能消耗的能量。</string>
    <string name="c_derived_metrics_resting_hr_derived_method" formatted="false">昨晚主要睡眠期间连续 5 分钟的最低平均值。需要至少 3 小时睡眠，且其中至少 70% 的分钟有心率数据。</string>
    <string name="c_derived_metrics_sleeping_hr_method">主要睡眠时段内每分钟心率的平均值。</string>
    <string name="c_derived_metrics_lowest_night_hr_method">主要睡眠时段内的每分钟心率最低值。</string>
    <string name="c_derived_metrics_night_hr_dip_method">1 −（睡眠平均值 ÷ 醒来后 14 小时内的清醒平均值）× 100。需要至少 4 小时的清醒心率数据。</string>
    <string name="c_derived_metrics_sedentary_hr_method">白天当前及之前 10 分钟均无步数的每分钟心率平均值。需要 30 个这样的分钟。</string>
    <string name="c_derived_metrics_daytime_hr_method">主要睡眠时段以外每分钟心率的平均值、最小值和最大值。需要 60 分钟。</string>
    <string name="c_derived_metrics_observed_max_hr_method">2 分钟滚动平均值的最大值，忽略单次读数的尖峰。</string>
    <string name="c_derived_metrics_hr_max_estimate_method">Tanaka 公式 208 − 0.7 × 年龄；若过去 180 天内出现的最高 2 分钟心率更高，则采用该值。</string>
    <string name="c_derived_metrics_hr_reserve_method">最大心率 − 静息心率 (Karvonen)。</string>
    <string name="c_derived_metrics_cardio_minutes_method" formatted="false">每分钟心率按心率储备百分比分类（中等 40-59%，高强度 60-89%，接近最大 ≥90%）。没有静息心率时，改用最大心率百分比（中等 64-76%，高强度 77-95%，接近最大 ≥96%）。中等 + 2 ×（高强度 + 接近最大）。</string>
    <string name="c_derived_metrics_training_impulse_method" formatted="false">Banister TRIMP，统计心率储备 ≥30% 的分钟：Σ 分钟 × HRr × 0.64 × e^(k × HRr)，男性 k = 1.92，女性 k = 1.67。</string>
    <string name="c_derived_metrics_vo2max_estimate_method">Uth-Sørensen：15.3 × 最大心率 ÷ 静息心率。当最大心率来自年龄公式时，置信度较低。</string>
    <string name="c_derived_metrics_rhr_deviation_method">今天 − 前 30 天的平均值（需要 14 天数据）。当今天和昨天都至少高出 5 bpm 时进行标记。</string>
    <string name="c_derived_metrics_wear_minutes_method">当地日期内有心率读数的分钟数。</string>
    <string name="c_derived_metrics_walking_hr_method">每分钟 60-130 步、且连续 3 分钟或以上的分钟内的平均心率（更快的分钟计为跑步）。需要 10 分钟。</string>
    <string name="c_derived_metrics_sleep_efficiency_method">睡眠时间 ÷ 卧床时间 × 100。</string>
    <string name="c_derived_metrics_sleep_onset_latency_method">第一个睡眠阶段 − 卧床开始时间。需要有“卧床”记录。</string>
    <string name="c_derived_metrics_deep_sleep_pct_method">深睡分钟数 ÷ 睡眠时间 × 100。仅限有睡眠阶段数据的夜晚。</string>
    <string name="c_derived_metrics_rem_sleep_pct_method">REM 分钟数 ÷ 睡眠时间 × 100。仅限有睡眠阶段数据的夜晚。</string>
    <string name="c_derived_metrics_sleep_wakeups_method">从首次入睡到最终醒来之间，睡眠阶段间 ≥5 分钟的间隔。清醒分钟数显示为入睡后清醒时间。</string>
    <string name="c_derived_metrics_bedtime_method">第一条睡眠记录的开始时间（钟点时间）。</string>
    <string name="c_derived_metrics_wake_time_method">最后一个睡眠阶段的结束时间（钟点时间）。</string>
    <string name="c_derived_metrics_sleep_midpoint_method">入睡时间 + 至最终醒来时间的一半。</string>
    <string name="c_derived_metrics_deep_latency_method">第一个深睡阶段 − 入睡时间。</string>
    <string name="c_derived_metrics_rem_latency_method">第一个 REM 阶段 − 入睡时间。</string>
    <string name="c_derived_metrics_sleep_timing_variability_method">过去 14 晚就寝时间（及起床时间）的样本标准差。需要 5 晚数据。</string>
    <string name="c_derived_metrics_sleep_regularity_index_method">在过去 14 天中，将每个中午到中午的一天与下一天逐分钟比较：200 × 一致率 − 100。需要 5 组相邻天数据。</string>
    <string name="c_derived_metrics_social_jetlag_method">|休息日夜晚（周六或周日醒来）的平均睡眠中点 − 工作日夜晚的平均睡眠中点|。14 天内需要 2 个休息日夜晚和 3 个工作日夜晚。</string>
    <string name="c_derived_metrics_chronotype_method">当休息日睡眠长于工作日睡眠时，MSFsc = MSF − (SDf − SDweek) ÷ 2，其中 SDweek = (5 × SDw + 2 × SDf) ÷ 7。</string>
    <string name="c_derived_metrics_sleep_debt_method">过去 14 天有记录的夜晚中 Σ max(0, 所需睡眠 − 睡眠时间)。所需睡眠默认为 8 小时。</string>
    <string name="c_derived_metrics_brisk_minutes_method">根据可穿戴设备的每分钟数据，步数 ≥100 的分钟数。</string>
    <string name="c_derived_metrics_peak_30_cadence_method">当天步数最高的 30 个分钟的平均值。</string>
    <string name="c_derived_metrics_active_hours_method">07:00-21:59 之间去重后步数 ≥250 的小时数。</string>
    <string name="c_derived_metrics_longest_sedentary_method">07:00-21:59 之间，佩戴设备（有心率数据）且无步数的最长连续分钟数。</string>
    <string name="c_derived_metrics_step_band_method">当天去重后总步数所属的分级。</string>
    <string name="c_derived_metrics_phone_left_behind_method" formatted="false">当可穿戴设备计步 ≥1,000 步而手机计步不到其 10% 时进行标记。</string>
    <string name="c_derived_metrics_step_streak_method">连续达成目标的天数，今天达成后也计入。</string>
    <string name="c_derived_metrics_stride_length_method">同一来源的距离 ÷ 步数（需要 1,000 步）。典型值：男性 = 0.415 × 身高，女性 = 0.413 × 身高。</string>
    <string name="c_derived_metrics_tdee_method" formatted="false">（静息能量 + 活动能量）÷ 0.9，约增加 10% 用于消化。需要一整天的静息能量数据（至少为预测 BMR 的 70%）。</string>
    <string name="c_derived_metrics_measured_bmr_method">每日静息能量；预测值 = 10 × kg + 6.25 × cm − 5 × 年龄 + 5（男性）或 − 161（女性）。</string>
    <string name="c_derived_metrics_physical_activity_level_method">TDEE ÷ 静息能量。</string>
    <string name="c_derived_metrics_walking_speed_weekly_method">过去 7 天步行速度读数的中位数。</string>
    <string name="c_derived_metrics_double_support_weekly_method">过去 7 天双脚支撑读数的中位数。</string>
    <string name="c_derived_metrics_asymmetry_flags_method" formatted="false">不对称读数 &gt;10% 的次数（100% 的读数视为传感器错误）。达到 3 次或以上时进行标记。</string>
    <string name="c_derived_metrics_sound_dose_method">Σ 小时 × 2^((dB − 80) ÷ 3) ÷ 40 × 100（3 dB 交换率）。</string>
    <string name="c_derived_metrics_weight_trend_method">指数平滑平均值：每个有称重记录的日子，趋势 += 0.1 ×（称重值 − 趋势）。</string>
    <string name="c_derived_metrics_weight_rate_method">（今天的趋势 − 14 天前的趋势）÷ 2。14 天内需要 4 次称重。</string>
    <string name="c_derived_metrics_bmi_derived_method">趋势体重 ÷ 身高²。采用 WHO 分类，或在设置中选择的亚洲标准（超重 ≥23，肥胖 ≥27.5）。</string>
    <string name="c_derived_metrics_healthy_weight_range_method">18.5 × 身高² 至 24.9 × 身高²（亚洲标准为 22.9）。</string>
    <string name="c_derived_metrics_goal_eta_method">（目标 − 趋势）÷ 每周变化速度，适用于以每周 ≥0.05 kg 的速度向目标靠近时。</string>
    <string name="c_derived_metrics_protein_per_kg_method">记录的蛋白质 ÷ 最新体重。</string>
    <string name="c_derived_metrics_macro_split_method">蛋白质和碳水化合物按 4 kcal/g，脂肪按 9 kcal/g；分别计算各自在总量中的占比。</string>
    <string name="c_derived_metrics_saturated_fat_share_method">9 × 饱和脂肪克数 ÷ 宏量营养素能量 × 100。</string>
    <string name="c_derived_metrics_fiber_density_method">纤维克数 × 1,000 ÷ 记录的 kcal。</string>
    <string name="c_derived_metrics_sodium_potassium_ratio_method">（钠 mg ÷ 22.99）÷（钾 mg ÷ 39.10）。</string>
    <string name="c_derived_metrics_eating_window_method">最后进食时间 − 首次进食时间。</string>
    <string name="c_derived_metrics_last_meal_to_bed_method">就寝时间 − 最后进食时间。</string>
    <string name="c_derived_metrics_iron_absorption_risk_method">在含铁 ≥3 mg 的食物前后 60 分钟内饮用茶/咖啡的次数。</string>
    <string name="c_derived_metrics_energy_balance_method">记录的 kcal − 总能量消耗。</string>
    <string name="c_derived_metrics_adaptive_tdee_method">平均记录 kcal −（趋势变化 × 7,700 kcal/kg）÷ 28 天。需要 14 天的饮食记录和 6 次称重。</string>
