    <string name="partner_export_header">파일로 보내기</string>
    <string name="partner_export_footer">이 파트너 전용으로 서명된 .ayuvo.zip을 만들어 아무 앱으로나 보낼 수 있습니다. 암호화되지 않습니다.</string>
