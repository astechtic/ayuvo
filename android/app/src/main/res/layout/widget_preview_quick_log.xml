<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (android:previewLayout); mirrors the Glance layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" tools:ignore="UseAppTint" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_preview_bg" android:orientation="horizontal" android:padding="6dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/widget_preview_tile" android:orientation="vertical" android:gravity="center" android:padding="6dp">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/widget_preview_bubble_eat">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_widget_camera" android:tint="#FF34C759" android:contentDescription="@null"/>
        </FrameLayout>
        <FrameLayout android:layout_width="1dp" android:layout_height="4dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/wp_camera" android:textSize="12sp" android:textColor="@color/widget_preview_primary" android:maxLines="1" android:includeFontPadding="false" android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_preview_tile" android:orientation="vertical" android:gravity="center" android:padding="6dp">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/widget_preview_bubble_drink">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_widget_water" android:tint="#FF007AFF" android:contentDescription="@null"/>
        </FrameLayout>
        <FrameLayout android:layout_width="1dp" android:layout_height="4dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/wp_water" android:textSize="12sp" android:textColor="@color/widget_preview_primary" android:maxLines="1" android:includeFontPadding="false" android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_preview_tile" android:orientation="vertical" android:gravity="center" android:padding="6dp">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/widget_preview_bubble_body">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_widget_scale" android:tint="#FFAF52DE" android:contentDescription="@null"/>
        </FrameLayout>
        <FrameLayout android:layout_width="1dp" android:layout_height="4dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/wp_weight" android:textSize="12sp" android:textColor="@color/widget_preview_primary" android:maxLines="1" android:includeFontPadding="false" android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="3dp" android:background="@drawable/widget_preview_tile" android:orientation="vertical" android:gravity="center" android:padding="6dp">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/widget_preview_bubble_move">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_widget_fitness" android:tint="#FFFF9500" android:contentDescription="@null"/>
        </FrameLayout>
        <FrameLayout android:layout_width="1dp" android:layout_height="4dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/wp_workout" android:textSize="12sp" android:textColor="@color/widget_preview_primary" android:maxLines="1" android:includeFontPadding="false" android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</LinearLayout>
