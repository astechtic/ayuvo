<?xml version="1.0" encoding="utf-8"?>
<!-- Workout widget chronometer, embedded in Glance through AndroidRemoteViews (Glance has no chronometer). -->
<Chronometer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_workout_chronometer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="sans-serif-medium"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:textColor="@color/widget_workout_primary"
    android:textSize="26sp"
    android:textStyle="bold" />
