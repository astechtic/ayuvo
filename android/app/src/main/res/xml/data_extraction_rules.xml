<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules (API 31+). The Health Data mirror (ayuvo_health.db and its
   journal files) is excluded from both cloud backup and device-to-device transfer:
   it holds heart rate, sleep, blood pressure and other platform health records
   that must stay on this device. Health Records (ayuvo_records.db and the ayuvo-records/
   files root) are excluded the same way, as are Medications and Coach conversations
   (ayuvo_coach.db and ayuvo-coach/), which quote health values. Everything else keeps
   the default behaviour.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="ayuvo_health.db" />
        <exclude domain="database" path="ayuvo_health.db-wal" />
        <exclude domain="database" path="ayuvo_health.db-shm" />
        <exclude domain="database" path="ayuvo_health.db-journal" />
        <exclude domain="database" path="ayuvo_records.db" />
        <exclude domain="database" path="ayuvo_records.db-wal" />
        <exclude domain="database" path="ayuvo_records.db-shm" />
        <exclude domain="database" path="ayuvo_records.db-journal" />
        <exclude domain="file" path="ayuvo-records/" />
        <exclude domain="database" path="ayuvo_medications.db" />
        <exclude domain="database" path="ayuvo_medications.db-wal" />
        <exclude domain="database" path="ayuvo_medications.db-shm" />
        <exclude domain="database" path="ayuvo_medications.db-journal" />
        <exclude domain="file" path="ayuvo-medications/" />
        <exclude domain="database" path="ayuvo_coach.db" />
        <exclude domain="database" path="ayuvo_coach.db-wal" />
        <exclude domain="database" path="ayuvo_coach.db-shm" />
        <exclude domain="database" path="ayuvo_coach.db-journal" />
        <exclude domain="file" path="ayuvo-coach/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="ayuvo_health.db" />
        <exclude domain="database" path="ayuvo_health.db-wal" />
        <exclude domain="database" path="ayuvo_health.db-shm" />
        <exclude domain="database" path="ayuvo_health.db-journal" />
        <exclude domain="database" path="ayuvo_records.db" />
        <exclude domain="database" path="ayuvo_records.db-wal" />
        <exclude domain="database" path="ayuvo_records.db-shm" />
        <exclude domain="database" path="ayuvo_records.db-journal" />
        <exclude domain="file" path="ayuvo-records/" />
        <exclude domain="database" path="ayuvo_medications.db" />
        <exclude domain="database" path="ayuvo_medications.db-wal" />
        <exclude domain="database" path="ayuvo_medications.db-shm" />
        <exclude domain="database" path="ayuvo_medications.db-journal" />
        <exclude domain="file" path="ayuvo-medications/" />
        <exclude domain="database" path="ayuvo_coach.db" />
        <exclude domain="database" path="ayuvo_coach.db-wal" />
        <exclude domain="database" path="ayuvo_coach.db-shm" />
        <exclude domain="database" path="ayuvo_coach.db-journal" />
        <exclude domain="file" path="ayuvo-coach/" />
    </device-transfer>
</data-extraction-rules>
