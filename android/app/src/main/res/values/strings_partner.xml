    <string name="partner_what_i_share_footer">%1$s sees only what is switched on. Switching a category off stops new updates; what they already received stays on their phone.</string>
    <string name="partner_export_header">Send as a file</string>
    <string name="partner_export_footer">Makes a signed .ayuvo.zip for this partner only, to send through any app. It is not encrypted.</string>
    <string name="partner_export_all">Export everything I share</string>
    <string name="partner_export_changes">Export changes since last sync</string>
    <string name="partner_export_failed">Could not make the file. Check that you share at least one category.</string>
    <string name="partner_remove_footer">Unpair keeps the data you received. Delete partner data removes it. Remove partner does both.</string>
    <string name="partner_unpair">Unpair</string>
