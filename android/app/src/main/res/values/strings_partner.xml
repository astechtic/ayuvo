    <!-- Settings page. -->
    <string name="partner_intro_title">Share health with someone you trust</string>
    <string name="partner_intro_body">Pair two phones to see each other\'s health summaries. You choose exactly what each partner can see, and what they share with you stays separate from your own data.</string>
    <string name="partner_partners_header">Partners</string>
    <string name="partner_partners_empty">No partners yet. Add one below while you are together.</string>
    <string name="partner_add_header">Add partner</string>
    <string name="partner_add_footer">Both phones must be on the same Wi-Fi or one phone\'s hotspot. One phone shows a code, the other scans it.</string>
    <string name="partner_show_code">Show my code</string>
    <string name="partner_show_code_sub">Your partner scans it with their phone</string>
    <string name="partner_scan_code">Scan partner\'s code</string>
    <string name="partner_scan_code_sub">Scan the code on your partner\'s phone</string>
    <string name="partner_import">Import package</string>
    <string name="partner_import_footer">If your phones cannot reach each other, your partner can send a .ayuvo.zip file through any app. Import works only from a paired partner.</string>
    <string name="partner_this_device">This device</string>
    <string name="partner_this_device_footer">Your partner sees this fingerprint for you. It changes if Ayuvo is reinstalled or the phone is replaced, and you would need to pair again.</string>
    <string name="partner_fingerprint">Fingerprint</string>
    <string name="partner_fingerprint_hint">Matches the fingerprint shown under This device on your partner\'s phone.</string>
    <string name="partner_how_title">How sync works</string>
    <string name="partner_how_lan">Data moves directly between the two phones on the same Wi-Fi or hotspot.</string>
    <string name="partner_how_awake">Both phones need to be awake at the same time. Opening Ayuvo starts a sync; in the background it happens only when Android allows.</string>
    <string name="partner_how_no_cloud">There is no Ayuvo server, account or cloud copy. Partner data is stored on this device and is not included in backups.</string>
    <string name="partner_how_signed">Files sent as packages are signed, not encrypted: anyone who gets the file can read it. Send it only to your partner.</string>
    <string name="partner_how_read_only">What a partner shares is read-only here and never mixes with your own health data.</string>

