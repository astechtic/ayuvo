    <string name="partner_status_long_syncing">Syncing with your partner now.</string>
    <string name="partner_status_long_up_to_date">Up to date. The last sync finished without problems.</string>
    <string name="partner_status_long_offline">Your partner\'s phone was not found on this network during the last sync. You are seeing the data from the last successful sync.</string>
    <string name="partner_status_long_no_network">This phone was not on Wi-Fi or a hotspot. Sync runs again when it is.</string>
    <string name="partner_status_long_lan_denied">This phone could not use the local network. Check that Wi-Fi is on and not a guest or isolated network.</string>
    <string name="partner_status_long_not_trusted">Your partner\'s phone no longer recognises this phone. They may have unpaired or reinstalled Ayuvo. Pair again to keep syncing.</string>
