    <string name="partner_status_long_pairing_required">Not synced yet. Open Ayuvo on both phones on the same Wi-Fi to sync.</string>
    <string name="partner_status_long_unpaired">You unpaired from this partner. Nothing new will arrive; the data already here is kept until you delete it.</string>
    <string name="partner_limits">Sync works only on the same Wi-Fi or hotspot, while both phones are awake. Opening Ayuvo on either phone helps. There is no cloud and no internet fallback.</string>
