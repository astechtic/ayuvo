    <string name="camvitals_finger_step_3">Rest your hand and stay still for about a minute.</string>
    <string name="camvitals_face_step_1">Sit still and face the camera.</string>
    <string name="camvitals_face_step_2">Use even lighting, without strong light from behind you.</string>
