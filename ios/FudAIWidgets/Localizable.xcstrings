    "Eat, Move and Drink rings, plus fasting, your next dose, weight and today's workout." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "حلقات الأكل والحركة والشرب، مع الصيام وجرعتك التالية والوزن وتمرين اليوم."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yemək, Hərəkət və İçmək halqaları, üstəlik oruc, növbəti doza, çəki və bugünkü məşq."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kruhy Jídlo, Pohyb a Pití, k tomu půst, další dávka, hmotnost a dnešní trénink."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ringe für Essen, Bewegung und Trinken, dazu Fasten, nächste Dosis, Gewicht und heutiges Training."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anillos de Comer, Moverse y Beber, más ayuno, tu próxima dosis, peso y el entrenamiento de hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anneaux Manger, Bouger et Boire, plus jeûne, prochaine dose, poids et entraînement du jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "खाना, गतिविधि और पानी रिंग, साथ में उपवास, अगली खुराक, वज़न और आज का वर्कआउट।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anelli Mangia, Muoviti e Bevi, più digiuno, prossima dose, peso e allenamento di oggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "食事・運動・水分のリング、断食、次の服用、体重、今日のワークアウト。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "먹기, 움직이기, 마시기 링과 단식, 다음 복용, 체중, 오늘의 운동."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eten-, Bewegen- en Drinken-ringen, plus vasten, je volgende dosis, gewicht en de training van vandaag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pierścienie Jedz, Ruszaj się i Pij oraz post, następna dawka, waga i dzisiejszy trening."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anéis Comer, Mover e Beber, mais jejum, próxima dose, peso e treino de hoje."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inelele Mănâncă, Mișcă-te și Bea, plus postul, doza următoare, greutatea și antrenamentul de azi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Кольца «Еда», «Движение» и «Питьё», голодание, следующая доза, вес и тренировка дня."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Кільця Їжа, Рух і Вода, а також голодування, наступна доза, вага й сьогоднішнє тренування."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "饮食、活动和饮水圆环，以及禁食、下次剂量、体重和今日训练。"
          }
        }
      }
    },
