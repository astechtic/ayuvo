    "Four shortcuts that open Ayuvo straight to logging food, water, weight, workouts and more." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أربعة اختصارات تفتح Ayuvo مباشرةً لتسجيل الطعام والماء والوزن والتمارين والمزيد."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo-nu birbaşa qida, su, çəki, məşq və s. qeydinə açan dörd qısayol."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Čtyři zkratky, které otevřou Ayuvo rovnou na zápis jídla, vody, hmotnosti, tréninků a dalšího."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vier Kurzbefehle, die Ayuvo direkt zum Erfassen von Essen, Wasser, Gewicht, Training und mehr öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuatro accesos directos que abren Ayuvo para registrar comida, agua, peso, entrenamientos y más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quatre raccourcis qui ouvrent Ayuvo pour enregistrer repas, eau, poids, entraînements et plus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "चार शॉर्टकट जो Ayuvo को सीधे भोजन, पानी, वज़न, वर्कआउट आदि लॉग करने पर खोलते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quattro scorciatoie per aprire Ayuvo e registrare subito alimenti, acqua, peso, allenamenti e altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "食事・水分・体重・ワークアウトなどの記録画面をすぐに開く4つのショートカット。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "음식, 물, 체중, 운동 등 기록 화면으로 Ayuvo를 바로 여는 바로가기 4개."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vier snelkoppelingen die Ayuvo direct openen om voeding, water, gewicht, trainingen en meer te loggen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cztery skróty otwierające Ayuvo od razu na dodawaniu jedzenia, wody, wagi, treningów i nie tylko."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quatro atalhos que abrem o Ayuvo direto no registro de alimentos, água, peso, treinos e mais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Patru scurtături care deschid Ayuvo direct la înregistrarea alimentelor, apei, greutății, antrenamentelor și altele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Четыре ярлыка для быстрой записи еды, воды, веса, тренировок и не только."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Чотири ярлики, що відкривають Ayuvo одразу для запису їжі, води, ваги, тренувань тощо."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "四个快捷方式，直接打开 Ayuvo 记录饮食、饮水、体重、锻炼等。"
          }
        }
      }
    },
