    "Start a walk, run, ride, hike or strength session, then pause, mark laps and finish from your Home Screen." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ابدأ مشيًا أو جريًا أو ركوب دراجة أو مشيًا لمسافات طويلة أو جلسة قوة، ثم أوقف مؤقتًا وسجّل اللفات وأنهِ من الشاشة الرئيسية."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gəzinti, qaçış, velosiped, yürüş və ya güc məşqinə başlayın, sonra ana ekrandan fasilə verin, dövrə qeyd edin və tamamlayın."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zahaj chůzi, běh, jízdu na kole, túru nebo silový trénink a pak ho z plochy pozastav, označ kola a dokonči."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Starte Gehen, Laufen, Radfahren, Wandern oder Krafttraining – pausiere, markiere Runden und beende vom Home-Bildschirm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inicia una caminata, carrera, salida en bici, ruta o sesión de fuerza; pausa, marca vueltas y finaliza desde tu pantalla de inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lancez une marche, course, sortie vélo, randonnée ou séance de musculation, puis mettez en pause, marquez des tours et terminez depuis l'écran d'accueil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "वॉक, रन, राइड, हाइक या स्ट्रेंथ सेशन शुरू करें, फिर होम स्क्रीन से रोकें, लैप मार्क करें और पूरा करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Avvia camminata, corsa, giro in bici, escursione o forza, poi metti in pausa, segna i giri e completa dalla schermata Home."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ウォーキング、ランニング、サイクリング、ハイキング、筋トレを開始し、ホーム画面から一時停止・ラップ・終了を操作。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "걷기, 달리기, 라이딩, 하이킹 또는 근력 운동을 시작하고 홈 화면에서 일시정지, 랩 기록, 완료까지 할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Start een wandeling, hardloop-, fiets-, hike- of krachttraining en pauzeer, markeer rondes en voltooi vanaf je beginscherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rozpocznij spacer, bieg, jazdę, wędrówkę lub trening siłowy, a potem wstrzymuj, oznaczaj okrążenia i kończ z ekranu początkowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inicie caminhada, corrida, pedalada, trilha ou força; pause, marque voltas e finalize na Tela de Início."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Începe o sesiune de mers, alergare, ciclism, drumeție sau forță, apoi pune pe pauză, marchează ture și termină din ecranul principal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Начните ходьбу, бег, велозаезд, поход или силовую, затем ставьте на паузу, отмечайте круги и завершайте с экрана «Домой»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Починайте ходьбу, біг, велопоїздку, похід чи силове тренування, а потім ставте на паузу, позначайте кола й завершуйте з екрана «Додому»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在主屏幕上开始步行、跑步、骑行、徒步或力量训练，并可暂停、计圈和完成。"
          }
        }
      }
    },
