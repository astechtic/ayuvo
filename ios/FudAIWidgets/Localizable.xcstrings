    "Pick any four metrics: nutrition, water, body, fasting, activity, sleep or your next dose." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اختر أي أربعة مقاييس: التغذية أو الماء أو الجسم أو الصيام أو النشاط أو النوم أو جرعتك التالية."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "İstənilən dörd göstərici seçin: qidalanma, su, bədən, oruc, aktivlik, yuxu və ya növbəti doza."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vyber libovolné čtyři metriky: výživa, voda, tělo, půst, aktivita, spánek nebo další dávka."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wähle vier Werte: Ernährung, Wasser, Körper, Fasten, Aktivität, Schlaf oder nächste Dosis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elige cuatro métricas: nutrición, agua, cuerpo, ayuno, actividad, sueño o tu próxima dosis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Choisissez quatre métriques : nutrition, eau, corps, jeûne, activité, sommeil ou prochaine dose."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कोई भी चार मेट्रिक्स चुनें: पोषण, पानी, शरीर, उपवास, गतिविधि, नींद या अगली खुराक।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scegli quattro metriche: nutrizione, acqua, corpo, digiuno, attività, sonno o prossima dose."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "栄養、水分、体、断食、アクティビティ、睡眠、次の服用から好きな指標を4つ選択。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "영양, 물, 신체, 단식, 활동, 수면, 다음 복용 중 원하는 지표 4개를 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kies vier waarden: voeding, water, lichaam, vasten, activiteit, slaap of je volgende dosis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wybierz dowolne cztery metryki: odżywianie, woda, ciało, post, aktywność, sen lub następna dawka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Escolha quatro métricas: nutrição, água, corpo, jejum, atividade, sono ou próxima dose."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alege oricare patru valori: nutriție, apă, corp, post, activitate, somn sau doza următoare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Любые четыре показателя: питание, вода, тело, голодание, активность, сон или следующая доза."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Виберіть будь-які чотири показники: харчування, вода, тіло, голодування, активність, сон або наступна доза."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "任选四项指标：营养、饮水、身体、禁食、活动、睡眠或下次剂量。"
          }
        }
      }
    },
