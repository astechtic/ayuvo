    "ai.error.rate_limit" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تم بلوغ حد المعدل لمفتاح API. انتظر دقيقة، أو غيّر المزوّد في الإعدادات ← مزوّد الذكاء الاصطناعي. إذا كنت تستخدم خطة مجانية، فتحقّق مما إذا كانت حصتها اليومية قد استُنفدت."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "API açarınız sorğu limitinə çatıb. Bir dəqiqə gözləyin və ya Parametrlər → Sİ provayderi bölməsində provayderi dəyişin. Pulsuz plandan istifadə edirsinizsə, gündəlik limitin bitib-bitmədiyini yoxlayın."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Byl dosažen limit požadavků pro tvůj API klíč. Počkej minutu, nebo změň poskytovatele v Nastavení → Poskytovatel AI. Pokud používáš bezplatný tarif, zkontroluj, zda není vyčerpaná jeho denní kvóta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anfragelimit für deinen API-Schlüssel erreicht. Warte eine Minute oder wechsle den Anbieter unter Einstellungen → KI-Anbieter. Wenn du einen kostenlosen Tarif nutzt, prüfe, ob das Tageskontingent aufgebraucht ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rate limit hit on your API key. Wait a minute, or switch provider in Settings → AI Provider. If you use a free tier, check whether its daily quota is used up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se alcanzó el límite de solicitudes de tu clave de API. Espera un minuto o cambia de proveedor en Ajustes → Proveedor de IA. Si usas un plan gratuito, comprueba si se ha agotado su cuota diaria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Limite de requêtes atteinte pour votre clé API. Patientez une minute, ou changez de fournisseur dans Réglages → Fournisseur d'IA. Si vous utilisez une offre gratuite, vérifiez si son quota quotidien est épuisé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपकी API कुंजी की रेट लिमिट पूरी हो गई। एक मिनट रुकें, या सेटिंग्स → AI प्रदाता में प्रदाता बदलें। अगर आप फ़्री टियर इस्तेमाल करते हैं, तो जाँचें कि उसका दैनिक कोटा खत्म तो नहीं हुआ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Limite di richieste raggiunto per la tua chiave API. Attendi un minuto oppure cambia provider in Impostazioni → Provider IA. Se usi un piano gratuito, controlla se la quota giornaliera è esaurita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "APIキーのレート制限に達しました。1分ほど待つか、設定 → AIプロバイダでプロバイダを切り替えてください。無料プランを利用している場合は、1日の上限に達していないか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "API 키의 요청 한도에 도달했어요. 1분 정도 기다리거나 설정 → AI 제공업체에서 제공업체를 변경하세요. 무료 요금제를 사용 중이라면 일일 할당량을 모두 사용했는지 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Snelheidslimiet bereikt voor je API-sleutel. Wacht een minuut of kies een andere provider in Instellingen → AI-provider. Gebruik je een gratis abonnement, controleer dan of het dagquotum op is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przekroczono limit zapytań dla Twojego klucza API. Odczekaj minutę lub zmień dostawcę w Ustawienia → Dostawca AI. Jeśli korzystasz z darmowego planu, sprawdź, czy nie wykorzystano dziennego limitu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Limite de requisições atingido na sua chave de API. Aguarde um minuto ou troque de provedor em Ajustes → Provedor de IA. Se você usa um plano gratuito, verifique se a cota diária acabou."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cheia ta API a atins limita de cereri. Așteaptă un minut sau schimbă furnizorul în Setări → Furnizor AI. Dacă folosești un plan gratuit, verifică dacă i s-a epuizat cota zilnică."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Превышен лимит запросов для вашего API-ключа. Подождите минуту или смените провайдера в разделе «Настройки → Провайдер ИИ». Если вы используете бесплатный тариф, проверьте, не исчерпана ли его дневная квота."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Досягнуто ліміт запитів для вашого ключа API. Зачекайте хвилину або змініть провайдера в Налаштування → Провайдер ШІ. Якщо ви використовуєте безкоштовний тариф, перевірте, чи не вичерпано щоденну квоту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你的 API 密钥已达到速率限制。请稍等一分钟，或在“设置 → AI 提供商”中切换提供商。如果你使用的是免费套餐，请检查其每日配额是否已用完。"
