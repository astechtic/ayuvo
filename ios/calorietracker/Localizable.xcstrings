    "Insights use Apple Health. Turn on Health Sync to see Recovery, Health Age and Patterns." : {
      "comment" : "A description of the health data that is used by the Insights feature.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تستخدم الرؤى Apple Health. شغّل مزامنة الصحة لعرض التعافي والعمر الصحي والأنماط."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Təhlillər Apple Health-dən istifadə edir. Bərpa, Sağlamlıq yaşı və Qanunauyğunluqları görmək üçün Sağlamlıq sinxronunu yandırın."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Postřehy využívají Apple Health. Zapni Synchronizaci zdraví, abys viděl(a) Regeneraci, Zdravotní věk a Vzorce."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Insights nutzen Apple Health. Aktiviere den Gesundheits-Sync, um Erholung, Gesundheitsalter und Muster zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Análisis usa Apple Health. Activa la sincronización con Salud para ver Recuperación, Edad de salud y Patrones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Analyses utilise Apple Health. Activez la synchronisation santé pour voir Récupération, Âge santé et Tendances."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इनसाइट्स Apple Health का उपयोग करते हैं। रिकवरी, हेल्थ एज और पैटर्न देखने के लिए हेल्थ सिंक चालू करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Approfondimenti usa Apple Health. Attiva la sincronizzazione salute per vedere Recupero, Età della salute e Schemi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
