    "Ingredient changes update the meal's calorie and macro totals automatically." : {
      "comment" : "A footer for the ingredients section of a meal.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تؤدي تغييرات المكوّنات إلى تحديث إجمالي السعرات الحرارية والمغذيات الكبرى للوجبة تلقائيًا."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "İnqrediyent dəyişiklikləri yeməyin kalori və makro cəmlərini avtomatik yeniləyir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Změny ingrediencí automaticky aktualizují celkové kalorie a makroživiny jídla."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Änderungen an Zutaten aktualisieren die Kalorien- und Makrosummen der Mahlzeit automatisch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los cambios en los ingredientes actualizan automáticamente las calorías y los macros de la comida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les modifications des ingrédients mettent automatiquement à jour les totaux de calories et de macros du repas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सामग्री बदलने पर भोजन की कुल कैलोरी और मैक्रो अपने-आप अपडेट हो जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le modifiche agli ingredienti aggiornano automaticamente le calorie e i macronutrienti totali del pasto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "材料を変更すると、食事のカロリーと主要栄養素の合計が自動的に更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "재료를 변경하면 식사의 칼로리와 다량 영양소 합계가 자동으로 업데이트돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wijzigingen in ingrediënten werken de totalen aan calorieën en macro's van de maaltijd automatisch bij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zmiany składników automatycznie aktualizują sumę kalorii i makroskładników posiłku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alterações nos ingredientes atualizam automaticamente os totais de calorias e macros da refeição."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Modificările ingredientelor actualizează automat totalul de calorii și macronutrienți al mesei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "При изменении ингредиентов калории и макронутриенты блюда пересчитываются автоматически."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Зміни інгредієнтів автоматично оновлюють калорії та макроси страви."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "修改配料会自动更新这餐的卡路里和宏量营养素总量。"
          }
        }
      }
