    "Apple Health asks which types Ayuvo may write." : {
      "comment" : "Google Health setup write-back toggle subtitle"
    },
    "Apple Health data is kept on this device and shared with your AI provider only through Coach." : {
      "comment" : "Footer text in the Browse tab.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُحفظ بيانات Apple Health على هذا الجهاز ولا تُشارك مع مزوّد الذكاء الاصطناعي إلا عبر المدرب."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apple Health məlumatları bu cihazda saxlanılır və Sİ provayderinizlə yalnız Məşqçi vasitəsilə paylaşılır."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Data z Apple Health zůstávají v tomto zařízení a s tvým poskytovatelem AI se sdílejí pouze prostřednictvím Kouče."
          }
        },
        "de" : {
          "stringUnit" : {
