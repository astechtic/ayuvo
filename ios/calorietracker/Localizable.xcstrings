    "Uploads your diary, workouts, fasting, photos, and settings to your iCloud. API keys stay on the phone." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يرفع يومياتك وتمارينك وصيامك وصورك وإعداداتك إلى iCloud الخاص بك. تبقى مفاتيح API على الهاتف."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gündəliyinizi, məşqlərinizi, orucu, fotoları və parametrləri iCloud-a yükləyir. API açarları telefonda qalır."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
