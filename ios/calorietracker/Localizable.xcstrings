          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आप आमतौर पर इसे रिमाइंडर के बाद लेते हैं। इसे खिसकाने से केवल आगे के रिमाइंडर बदलते हैं।"
