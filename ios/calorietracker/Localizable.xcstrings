    "Train the whole body each workout with broad coverage." : {
      "comment" : "A description of the full-body workout preference.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "درّب الجسم كله في كل تمرين بتغطية واسعة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hər məşqdə geniş əhatə ilə bütün bədəni işlədin."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Při každém tréninku procvič celé tělo se širokým záběrem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trainiere bei jedem Training den ganzen Körper mit breiter Abdeckung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entrena todo el cuerpo en cada sesión con una cobertura amplia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Travaillez tout le corps à chaque séance, avec une couverture large."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हर वर्कआउट में पूरे शरीर को व्यापक रूप से ट्रेन करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Allena tutto il corpo in ogni allenamento con una copertura ampia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "毎回のワークアウトで全身を幅広く鍛えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "매 운동마다 전신을 고르게 훈련해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Train bij elke training het hele lichaam, breed gedekt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trenuj całe ciało na każdym treningu, obejmując szeroki zakres."
