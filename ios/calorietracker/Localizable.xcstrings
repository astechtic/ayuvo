          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fügt neue Medikamente, Einnahmepläne und Dosen hinzu und behält jeweils die neuere Kopie. Es wird nichts gelöscht."
          }
        },
        "es" : {
