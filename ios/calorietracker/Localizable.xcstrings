          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voegt nieuwe medicijnen, schema's en doses toe en houdt van elk de nieuwste versie. Er wordt niets verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dodaje nowe leki, harmonogramy i dawki oraz zachowuje nowszą kopię każdego z nich. Nic nie jest usuwane."
