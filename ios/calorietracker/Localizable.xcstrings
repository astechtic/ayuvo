    "On supported iPhones, Apple Intelligence also handles typed and voice meals without a key." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "على أجهزة iPhone المدعومة، تتعامل Apple Intelligence أيضًا مع الوجبات المكتوبة والصوتية دون مفتاح."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dəstəklənən iPhone-larda Apple Intelligence yazılmış və səsli yeməkləri də açarsız emal edir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Na podporovaných iPhonech zpracuje Apple Intelligence napsaná i hlasová jídla i bez klíče."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Auf unterstützten iPhones verarbeitet Apple Intelligence auch eingetippte und gesprochene Mahlzeiten ohne Schlüssel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On supported iPhones, Apple Intelligence also handles typed and voice meals without a key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En los iPhone compatibles, Apple Intelligence también procesa las comidas escritas y por voz sin clave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sur les iPhone compatibles, Apple Intelligence traite aussi les repas saisis ou dictés sans clé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "समर्थित iPhone पर, Apple Intelligence बिना कुंजी के टाइप किए और आवाज़ वाले भोजन भी संभालता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sugli iPhone supportati, Apple Intelligence gestisce anche i pasti scritti e dettati a voce senza chiave."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "対応するiPhoneでは、入力や音声による食事の記録もApple Intelligenceがキーなしで処理します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "지원되는 iPhone에서는 Apple Intelligence가 키 없이도 입력하거나 말한 식사를 처리해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Op ondersteunde iPhones verwerkt Apple Intelligence ook getypte en ingesproken maaltijden zonder sleutel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Na obsługiwanych iPhone’ach Apple Intelligence obsługuje też posiłki wpisane i podyktowane bez klucza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Em iPhones compatíveis, o Apple Intelligence também processa refeições digitadas e por voz sem chave."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pe iPhone-urile compatibile, Apple Intelligence procesează și mesele scrise sau dictate fără cheie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "На поддерживаемых iPhone Apple Intelligence также обрабатывает приёмы пищи, введённые текстом или голосом, без ключа."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "На підтримуваних iPhone Apple Intelligence також обробляє введені текстом і голосом страви без ключа."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
