    "Focus each day around one major muscle or body region." : {
      "comment" : "A description of the Bro Split workout preference.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ركّز كل يوم على عضلة رئيسية واحدة أو منطقة واحدة من الجسم."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hər günü bir əsas əzələ qrupu və ya bədən nahiyəsi üzərində cəmləyin."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Každý den se zaměř na jednu hlavní svalovou skupinu nebo část těla."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Konzentriere dich jeden Tag auf eine große Muskelgruppe oder Körperregion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dedica cada día a un grupo muscular o zona del cuerpo principal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Consacrez chaque journée à un grand groupe musculaire ou à une région du corps."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हर दिन एक मुख्य मांसपेशी या शरीर के हिस्से पर ध्यान दें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dedica ogni giorno a un gruppo muscolare o a una zona del corpo principale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "1日ごとに1つの主要な筋肉または部位に集中します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "하루에 하나의 주요 근육이나 신체 부위에 집중해요."
          }
        },
