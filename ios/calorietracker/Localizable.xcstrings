          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uprav čas začátku nebo konce, aby se půsty nepřekrývaly."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe Start- oder Endzeit an, damit sich Fastenzeiten nicht überschneiden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta la hora de inicio o fin para que las sesiones de ayuno no se superpongan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifie l’heure de début ou de fin afin que les sessions de jeûne ne se chevauchent pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शुरू या समाप्ति का समय बदलें ताकि उपवास सत्र ओवरलैप न हों।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifica l’ora di inizio o fine in modo che le sessioni di digiuno non si sovrappongano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "断食セッションが重複しないよう、開始時刻または終了時刻を調整してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단식 세션이 겹치지 않도록 시작 또는 종료 시간을 조정하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de begin- of eindtijd aan zodat vastensessies niet overlappen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmień czas rozpoczęcia lub zakończenia, aby sesje postu się nie nakładały."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste o horário de início ou fim para que as sessões de jejum não se sobreponham."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustează ora de început sau de sfârșit pentru ca sesiunile de post să nu se suprapună."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
