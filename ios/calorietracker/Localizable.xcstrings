    "Last night's sleep hasn't synced yet, so there's no Recovery score." : {
      "comment" : "Text for the Recovery score when the last night's sleep hasn't synced yet.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لم تتم مزامنة نوم الليلة الماضية بعد، لذا لا توجد درجة تعافٍ."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Keçən gecənin yuxusu hələ sinxronlaşmayıb, buna görə Bərpa balı yoxdur."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spánek z minulé noci se ještě nesynchronizoval, proto není k dispozici skóre Regenerace."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Schlaf der letzten Nacht wurde noch nicht synchronisiert, daher gibt es keinen Erholungswert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El sueño de anoche aún no se ha sincronizado, así que no hay puntuación de Recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le sommeil de la nuit dernière n'est pas encore synchronisé, il n'y a donc pas de score de récupération."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "पिछली रात की नींद अभी सिंक नहीं हुई है, इसलिए कोई रिकवरी स्कोर नहीं है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il sonno della notte scorsa non è ancora stato sincronizzato, quindi non c'è un punteggio di Recupero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "昨夜の睡眠がまだ同期されていないため、リカバリースコアはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "지난밤 수면이 아직 동기화되지 않아 회복 점수가 없어요."
          }
        },
