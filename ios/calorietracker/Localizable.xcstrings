    "Stop and save an exercise timer, or enter reps for a strength exercise on %@, before calculating workout calories." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أوقف مؤقت تمرين واحفظه، أو أدخل التكرارات لتمرين قوة في %@، قبل حساب سعرات التمرين."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Məşq kalorilərini hesablamazdan əvvəl %@ tarixində hərəkət taymerini dayandırıb saxlayın və ya güc hərəkəti üçün təkrarları daxil edin."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Před výpočtem kalorií z tréninku zastav a ulož časovač cviku, nebo zadej opakování u silového cviku dne %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stoppe und speichere einen Übungstimer oder gib Wdh. für eine Kraftübung am %@ ein, bevor du die Trainingskalorien berechnest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Detén y guarda un temporizador de ejercicio, o introduce las reps de un ejercicio de fuerza el %@, antes de calcular las calorías del entrenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arrêtez et enregistrez un minuteur d'exercice, ou saisissez les répétitions d'un exercice de musculation le %@, avant de calculer les calories de l'entraînement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "वर्कआउट कैलोरी की गणना करने से पहले, %@ पर किसी एक्सरसाइज़ टाइमर को रोककर सहेजें, या किसी स्ट्रेंथ एक्सरसाइज़ के रेप्स दर्ज करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ferma e salva il timer di un esercizio, oppure inserisci le ripetizioni di un esercizio di forza il %@, prima di calcolare le calorie dell'allenamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ワークアウトのカロリーを計算する前に、種目のタイマーを停止して保存するか、%@の筋トレ種目のレップ数を入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "운동 칼로리를 계산하기 전에 %@에 운동 타이머를 중지하고 저장하거나 근력 운동의 반복 횟수를 입력하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stop en bewaar een oefeningstimer, of voer herhalingen in voor een krachtoefening op %@, voordat je de calorieën van de training berekent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zatrzymaj i zapisz licznik ćwiczenia lub wpisz powtórzenia ćwiczenia siłowego %@, zanim obliczysz kalorie treningu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pare e salve um timer de exercício ou insira repetições para um exercício de força em %@ antes de calcular as calorias do treino."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oprește și salvează un cronometru de exercițiu sau introdu repetările pentru un exercițiu de forță pe %@ înainte de a calcula caloriile antrenamentului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Прежде чем рассчитывать калории тренировки, остановите и сохраните таймер упражнения или введите повторения для силового упражнения за %@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Перш ніж розраховувати калорії тренування, зупиніть і збережіть таймер вправи або введіть повтори для силової вправи на %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在计算训练卡路里之前，请先停止并保存一个动作计时器，或为 %@ 的某个力量动作输入次数。"
          }
        }
      }
    },
