    "Meals, workouts, sleep, heart, fasting and water —\nprivate, on your device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الوجبات والتمارين والنوم والقلب والصيام والماء —\nبخصوصية، على جهازك."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yeməklər, məşqlər, yuxu, ürək, oruc və su —\nməxfi, cihazınızda."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jídla, tréninky, spánek, srdce, půst a voda —\nsoukromě ve tvém zařízení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mahlzeiten, Trainings, Schlaf, Herz, Fasten und Wasser –\nprivat auf deinem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Comidas, entrenamientos, sueño, corazón, ayuno y agua,\nde forma privada en tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Repas, entraînements, sommeil, cœur, jeûne et eau —\nen toute confidentialité, sur votre appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "भोजन, वर्कआउट, नींद, हृदय, उपवास और पानी —\nनिजी, आपके डिवाइस पर।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pasti, allenamenti, sonno, cuore, digiuno e acqua:\nprivati, sul tuo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "食事、ワークアウト、睡眠、心臓、断食、水分 —\nプライベートに、あなたのデバイス上で。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "식사, 운동, 수면, 심장, 단식 및 물 —\n기기에서 비공개로."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Maaltijden, trainingen, slaap, hart, vasten en water —\nprivé, op je apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Posiłki, treningi, sen, serce, post i woda —\nprywatnie, na Twoim urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Refeições, treinos, sono, coração, jejum e água —\nprivado, no seu dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mese, antrenamente, somn, inimă, post și apă —\nprivat, pe dispozitivul tău."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Питание, тренировки, сон, сердце, голодание и вода —\nконфиденциально, на вашем устройстве."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Їжа, тренування, сон, серце, голодування та вода —\nприватно, на вашому пристрої."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "餐食、训练、睡眠、心脏、禁食和饮水——\n私密地保存在你的设备上。"
          }
        }
      }
    },
