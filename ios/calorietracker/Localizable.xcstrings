        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fereastra acestei doze a trecut. Ayuvo nu marchează niciodată singur o doză ca luată; dacă nu știi sigur ce să faci, întreabă medicul sau farmacistul."
          }
