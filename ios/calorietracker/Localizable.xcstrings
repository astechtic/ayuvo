    "Runs text extraction and detail finding again on every record. Details you confirmed or edited are kept." : {
      "comment" : "A description of the \"Reprocess all\" action.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يعيد استخراج النص والبحث عن التفاصيل في كل سجل. يُحتفظ بالتفاصيل التي أكدتها أو عدّلتها."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hər qeyddə mətnin çıxarılmasını və təfərrüatların tapılmasını yenidən icra edir. Təsdiqlədiyiniz və ya redaktə etdiyiniz təfərrüatlar saxlanılır."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Znovu spustí extrakci textu a hledání podrobností u každého záznamu. Podrobnosti, které jsi potvrdil(a) nebo upravil(a), zůstanou zachovány."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Führt Textextraktion und Detailsuche für jeden Eintrag erneut aus. Details, die du bestätigt oder bearbeitet hast, bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vuelve a extraer el texto y a buscar detalles en todos los registros. Los detalles que confirmaste o editaste se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Relance l'extraction du texte et la recherche des détails sur chaque dossier. Les détails que vous avez confirmés ou modifiés sont conservés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हर रिकॉर्ड पर टेक्स्ट निकालना और विवरण खोजना फिर से चलाता है। आपके द्वारा पुष्टि या संपादित किए गए विवरण रखे जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esegue di nuovo l'estrazione del testo e la ricerca dei dettagli su ogni documento. I dettagli che hai confermato o modificato vengono mantenuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "すべての記録でテキスト抽出と詳細の検出をやり直します。確認または編集した詳細は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "모든 기록에서 텍스트 추출과 세부 정보 찾기를 다시 실행해요. 확인하거나 편집한 세부 정보는 유지돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voert tekstextractie en het zoeken naar details opnieuw uit op elk document. Details die je hebt bevestigd of gewijzigd, blijven behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ponownie wyodrębnia tekst i wyszukuje szczegóły w każdym dokumencie. Szczegóły potwierdzone lub edytowane przez Ciebie zostaną zachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Executa novamente a extração de texto e a busca de detalhes em todos os registros. Os detalhes que você confirmou ou editou são mantidos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rulează din nou extragerea textului și căutarea detaliilor pentru fiecare înregistrare. Detaliile pe care le-ai confirmat sau editat sunt păstrate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Заново извлекает текст и ищет сведения в каждой записи. Подтверждённые или изменённые вами сведения сохраняются."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Повторно виконує видобування тексту й пошук даних для кожного запису. Дані, які ви підтвердили або відредагували, зберігаються."
          }
        },
        "zh-Hans" : {
