    "Deleting a record removes it and its file permanently. Delete All Data removes every record." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يؤدي حذف سجل إلى إزالته هو وملفه نهائيًا. يزيل «حذف كل البيانات» كل السجلات."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Qeydi silmək onu və faylını həmişəlik silir. Bütün məlumatları sil bütün qeydləri silir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Smazání záznamu ho trvale odstraní i s jeho souborem. Smazat všechna data odstraní všechny záznamy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beim Löschen eines Befunds werden er und seine Datei dauerhaft entfernt. „Alle Daten löschen“ entfernt alle Befunde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eliminar un registro lo borra de forma permanente junto con su archivo. Eliminar todos los datos borra todos los registros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Supprimer un dossier le retire définitivement, ainsi que son fichier. Supprimer toutes les données retire tous les dossiers."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "किसी रिकॉर्ड को हटाने से वह और उसकी फ़ाइल हमेशा के लिए हट जाती है। \"सारा डेटा हटाएं\" हर रिकॉर्ड हटा देता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eliminare un documento lo rimuove definitivamente insieme al suo file. Elimina tutti i dati rimuove tutti i documenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "記録を削除すると、その記録とファイルは完全に削除されます。「すべてのデータを削除」はすべての記録を削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "기록을 삭제하면 기록과 파일이 영구적으로 제거돼요. 모든 데이터 삭제는 모든 기록을 제거해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Als je een document verwijdert, worden het en het bijbehorende bestand definitief verwijderd. Verwijder alle gegevens wist alle documenten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usunięcie rekordu trwale usuwa go razem z plikiem. Usuń wszystkie dane usuwa wszystkie rekordy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apagar um registro o remove permanentemente, junto com o arquivo. Apagar todos os dados remove todos os registros."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ștergerea unei înregistrări o elimină definitiv, împreună cu fișierul ei. Șterge toate datele elimină toate înregistrările."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Удаление записи безвозвратно удаляет её и её файл. «Удалить все данные» удаляет все записи."
          }
        },
        "uk" : {
