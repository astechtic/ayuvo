        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Mahlzeit wird damit nicht erfasst. Es zeigt, wie heute aussehen würde, wenn du %@ erfasst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esto no registra la comida. Muestra cómo sería tu día si registraras %@."
