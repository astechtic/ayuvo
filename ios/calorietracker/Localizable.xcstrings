    "Fasting for %@. %@ to your %@ goal." : {
      "comment" : "The text of the dialog shown when the user is fasting. The first argument is the duration of the current fasting session. The second argument is the remaining time on the fasting session.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "صيام منذ %1$@. متبقٍ %2$@ على هدفك البالغ %3$@."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oruc müddəti: %1$@. %3$@ hədəfinizə %2$@ qalıb."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Postíš se %1$@. Do cíle %3$@ zbývá %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du fastest seit %1$@. Noch %2$@ bis zu deinem Ziel von %3$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fasting for %1$@. %2$@ to your %3$@ goal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Llevas %1$@ de ayuno. Faltan %2$@ para tu objetivo de %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jeûne depuis %1$@. %2$@ avant votre objectif de %3$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ से उपवास। आपके %3$@ लक्ष्य तक %2$@ बाकी।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Digiuno da %1$@. Mancano %2$@ al tuo obiettivo di %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "断食中：%1$@。%3$@の目標まであと%2$@です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@째 단식 중이에요. %3$@ 목표까지 %2$@ 남았어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aan het vasten sinds %1$@. Nog %2$@ tot je doel van %3$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Post trwa %1$@. Do celu %3$@ brakuje %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Em jejum há %1$@. Faltam %2$@ para sua meta de %3$@."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Post de %1$@. Mai ai %2$@ până la obiectivul de %3$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Голодание длится %1$@. До цели %3$@ осталось %2$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Голодування триває %1$@. До мети %3$@ залишилося %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "已禁食 %1$@。距离 %3$@ 目标还有 %2$@。"
          }
        }
      }
    },
    "Fasting for %@. You've reached your goal." : {
      "comment" : "The text that appears in the dialog box when the user is fasting. The first argument is the duration of the current fasting session. The second argument is the duration of the user's fasting goal.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
