    "Coach exceeded the tool-call round limit. Try rephrasing your question." : {
      "comment" : "Coach error: too many tool calls in one reply",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تجاوز المدرب حد جولات استدعاء الأدوات. جرّب إعادة صياغة سؤالك."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Məşqçi alət çağırışı dövrlərinin limitini aşdı. Sualınızı başqa cür ifadə edin."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kouč překročil limit kol volání nástrojů. Zkus otázku přeformulovat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coach hat das Limit für Tool-Aufrufe überschritten. Formuliere deine Frage anders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coach superó el límite de rondas de llamadas a herramientas. Prueba a reformular tu pregunta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le Coach a dépassé la limite d'appels d'outils. Essayez de reformuler votre question."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कोच ने टूल-कॉल राउंड की सीमा पार कर दी। अपना सवाल दूसरे शब्दों में पूछकर देखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il Coach ha superato il limite di chiamate agli strumenti. Prova a riformulare la domanda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "コーチがツール呼び出し回数の上限を超えました。質問を言い換えてお試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "코치가 도구 호출 횟수 한도를 초과했어요. 질문을 바꿔서 다시 해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coach heeft de limiet voor toolaanroepen overschreden. Probeer je vraag anders te formuleren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trener przekroczył limit rund wywołań narzędzi. Spróbuj inaczej sformułować pytanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Coach excedeu o limite de rodadas de chamadas de ferramentas. Tente reformular sua pergunta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Antrenorul a depășit limita de runde de apeluri de instrumente. Încearcă să reformulezi întrebarea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Тренер превысил лимит вызовов инструментов. Попробуйте переформулировать вопрос."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Тренер перевищив ліміт раундів викликів інструментів. Спробуйте переформулювати запитання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "教练超出了工具调用轮次上限。请尝试换个方式提问。"
          }
        }
      }
    },
    "Coach never tells you to start, stop or change a medicine." : {
      "comment" : "A description of the benefits of using Coach.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا يطلب منك المدرب أبدًا بدء دواء أو إيقافه أو تغييره."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Məşqçi heç vaxt sizə dərmana başlamağı, dayandırmağı və ya dəyişməyi demir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kouč ti nikdy neřekne, abys začal(a) užívat, přestal(a) užívat nebo změnil(a) lék."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coach fordert dich nie auf, ein Medikament zu beginnen, abzusetzen oder zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coach nunca te dice que empieces, dejes o cambies un medicamento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le Coach ne vous dit jamais de commencer, d'arrêter ou de modifier un médicament."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कोच आपको कभी कोई दवा शुरू करने, बंद करने या बदलने के लिए नहीं कहता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il Coach non ti dice mai di iniziare, interrompere o modificare un farmaco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "コーチが薬の開始、中止、変更を指示することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "코치는 약을 시작하거나 중단하거나 변경하라고 절대 말하지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coach zegt nooit dat je met een medicijn moet beginnen, stoppen of het moet wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trener nigdy nie każe Ci rozpocząć, przerwać ani zmienić leku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Coach nunca diz para você começar, parar ou alterar um medicamento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Antrenorul nu îți spune niciodată să începi, să oprești sau să schimbi un medicament."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Тренер никогда не советует начать, прекратить или изменить приём лекарства."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Тренер ніколи не радить почати, припинити чи змінити прийом ліків."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "教练绝不会让你开始、停止或更改任何药物。"
          }
        }
      }
    },
    "Coach reads the records on this device; nothing is sent online." : {
      "localizations" : {
        "ar" : {
