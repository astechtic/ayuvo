    "Regular gym, cardio, climbing, cycling, or sport 3–5 days/week.\nApprox. step guide: 7,500–9,999 steps/day." : {
      "comment" : "Display text looked up at runtime (LocalizedDisplayText).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "نادي رياضي أو كارديو أو تسلق أو دراجات أو رياضة 3–5 أيام/أسبوع.\nدليل تقريبي: 7,500–9,999 خطوة/يوم."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Həftədə 3–5 gün müntəzəm zal, kardio, dırmanma, velosiped və ya idman.\nTəxmini göstərici: gündə 7 500–9 999 addım."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pravidelně posilovna, kardio, lezení, kolo nebo sport 3–5 dní v týdnu.\nOrientačně: 7 500–9 999 kroků denně."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Regelmäßig Fitnessstudio, Cardio, Klettern, Radfahren oder Sport an 3–5 Tagen/Woche.\nRichtwert: 7.500–9.999 Schritte/Tag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gimnasio, cardio, escalada, ciclismo o deporte regular 3–5 días/semana.\nGuía aproximada: 7500–9999 pasos/día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Salle, cardio, escalade, vélo ou sport régulier 3 à 5 jours/semaine.\nRepère approximatif : 7 500–9 999 pas/jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सप्ताह में 3–5 दिन नियमित जिम, कार्डियो, चढ़ाई, साइकिलिंग या खेल।\nअनुमानित मार्गदर्शक: प्रतिदिन 7,500–9,999 कदम।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Palestra, cardio, arrampicata, ciclismo o sport regolare 3–5 giorni/settimana.\nIndicazione approssimativa: 7.500–9.999 passi/giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "週3〜5日はジム、有酸素運動、クライミング、サイクリング、スポーツなどを定期的に行う。\n目安：1日7,500〜9,999歩。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "주 3–5일 정기적으로 헬스, 유산소, 클라이밍, 사이클 또는 스포츠를 함.\n대략적인 기준: 하루 7,500–9,999보."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Regelmatig sportschool, cardio, klimmen, fietsen of sport 3–5 dagen per week.\nRichtlijn: 7.500–9.999 stappen/dag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regularna siłownia, cardio, wspinaczka, rower lub sport 3–5 dni w tygodniu.\nOrientacyjnie: 7 500–9 999 kroków dziennie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Academia, cardio, escalada, ciclismo ou esporte regular 3–5 dias/semana.\nReferência aproximada: 7.500–9.999 passos/dia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sală, cardio, escaladă, ciclism sau sport regulat 3–5 zile/săptămână.\nReper aproximativ: 7.500–9.999 de pași/zi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Регулярный зал, кардио, скалолазание, велосипед или спорт 3–5 дней в неделю.\nПримерный ориентир: 7 500–9 999 шагов в день."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Регулярні тренування в залі, кардіо, скелелазіння, велоспорт або інші заняття спортом 3–5 днів на тиждень.\nОрієнтир: 7 500–9 999 кроків на день."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每周 3–5 天规律进行健身、有氧、攀岩、骑行或运动。\n大致参考：每天 7,500–9,999 步。"
          }
        }
      }
    },
    "Reinstalled or switched phones? Your food log, weight, and body fat now restore automatically from Apple Health." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعدت التثبيت أو غيّرت هاتفك؟ يُستعاد الآن سجل طعامك ووزنك ودهون جسمك تلقائيًا من Apple Health."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yenidən quraşdırmısınız və ya telefonu dəyişmisiniz? Yemək jurnalınız, çəkiniz və bədən yağınız indi Apple Health-dən avtomatik bərpa olunur."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přeinstalace nebo nový telefon? Deník jídel, váha i tělesný tuk se teď automaticky obnoví z Apple Health."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neu installiert oder neues iPhone? Ernährungstagebuch, Gewicht und Körperfett werden jetzt automatisch aus Apple Health wiederhergestellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Reinstalaste o cambiaste de teléfono? Tu registro de comidas, peso y grasa corporal ahora se restauran automáticamente desde Apple Health."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réinstallation ou nouveau téléphone ? Ton journal alimentaire, ton poids et ta masse grasse se restaurent désormais automatiquement depuis Apple Health."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोबारा इंस्टॉल किया या फ़ोन बदला? आपका फ़ूड लॉग, वज़न और बॉडी फ़ैट अब Apple Health से अपने आप बहाल हो जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai reinstallato o cambiato telefono? Diario alimentare, peso e grasso corporeo ora si ripristinano automaticamente da Apple Health."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再インストールや機種変更をしても、食事記録・体重・体脂肪がApple Healthから自動的に復元されるようになりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재설치했거나 휴대폰을 바꿨나요? 이제 음식 기록, 체중, 체지방이 Apple Health에서 자동으로 복원됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opnieuw geïnstalleerd of een nieuwe telefoon? Je voedingslogboek, gewicht en vetpercentage worden nu automatisch hersteld uit Apple Health."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponowna instalacja lub nowy telefon? Dziennik posiłków, waga i tkanka tłuszczowa są teraz automatycznie przywracane z Apple Health."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reinstalou ou trocou de celular? Seu diário alimentar, peso e gordura corporal agora são restaurados automaticamente do Apple Health."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ai reinstalat sau ai schimbat telefonul? Jurnalul alimentar, greutatea și grăsimea corporală se restaurează acum automat din Apple Health."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переустановили приложение или сменили телефон? Дневник питания, вес и процент жира теперь автоматически восстанавливаются из Apple Health."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Перевстановили застосунок або змінили телефон? Ваш щоденник харчування, вага й відсоток жиру тепер автоматично відновлюються з Apple Health."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新安装或更换手机后，你的饮食记录、体重和体脂现在会从 Apple Health 自动恢复。"
          }
        }
      }
    },
