        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Désactivez pour une valeur qui ne doit pas être comparée aux autres, comme un test répété ou une méthode différente."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ऐसे मान के लिए बंद करें जिसकी दूसरों से तुलना नहीं होनी चाहिए, जैसे दोबारा किया गया टेस्ट या कोई अलग तरीका।"
