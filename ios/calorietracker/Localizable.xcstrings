    "If I could only change one habit this month, what does my data say it should be?" : {
      "comment" : "Prompt text for a card that asks the user to choose one habit to change in the coming month.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لو كان بإمكاني تغيير عادة واحدة فقط هذا الشهر، فماذا تقول بياناتي إنها يجب أن تكون؟"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bu ay yalnız bir vərdişi dəyişə bilsəydim, məlumatlarıma görə hansı olmalıdır?"
