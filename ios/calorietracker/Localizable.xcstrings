    "Uses saved exercise duration and intensity, or strength sets, repetitions and load, with current body weight" : {
      "comment" : "A hint for the calculate button on the workout log.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يستخدم مدة التمرين وشدته المحفوظتين، أو مجموعات القوة والتكرارات والحمل، مع وزن الجسم الحالي"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yadda saxlanmış hərəkət müddəti və intensivliyindən və ya güc dəstləri, təkrarlar və yükdən, cari bədən çəkisi ilə birlikdə istifadə edir"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Použije uloženou dobu trvání a intenzitu cviku, nebo série, opakování a zátěž u silového tréninku, spolu s aktuální tělesnou hmotností"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verwendet gespeicherte Übungsdauer und Intensität oder Kraftsätze, Wiederholungen und Last, mit dem aktuellen Körpergewicht"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usa la duración e intensidad guardadas del ejercicio, o las series, repeticiones y carga de fuerza, junto con tu peso corporal actual"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilise la durée et l'intensité enregistrées de l'exercice, ou les séries, répétitions et charges de musculation, avec votre poids actuel"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सहेजी गई एक्सरसाइज़ की अवधि और तीव्रता, या स्ट्रेंथ सेट, रेप्स और वज़न का, मौजूदा शरीर के वज़न के साथ उपयोग करता है"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usa la durata e l'intensità dell'esercizio salvate, oppure serie, ripetizioni e carico di forza, con il peso corporeo attuale"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "保存された運動時間と強度、または筋トレのセット、レップ、重量と、現在の体重を使用します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "저장된 운동 시간과 강도 또는 근력 세트, 반복 횟수, 중량을 현재 체중과 함께 사용해요"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gebruikt de bewaarde duur en intensiteit van de oefening, of krachtsets, herhalingen en gewicht, met je huidige lichaamsgewicht"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Używa zapisanego czasu trwania i intensywności ćwiczenia albo serii, powtórzeń i obciążenia w ćwiczeniach siłowych, wraz z aktualną masą ciała"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usa a duração e a intensidade salvas do exercício, ou séries, repetições e carga de força, com o peso corporal atual"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folosește durata și intensitatea salvate ale exercițiului sau seriile, repetările și greutatea de forță, împreună cu greutatea corporală actuală"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Использует сохранённые длительность и интенсивность упражнения или силовые подходы, повторения и нагрузку с учётом текущего веса тела"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Використовує збережені тривалість та інтенсивність вправи або силові підходи, повтори й навантаження разом із поточною вагою тіла"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "使用已保存的运动时长和强度，或力量训练的组数、次数和负重，并结合当前体重"
          }
        }
      }
    },
