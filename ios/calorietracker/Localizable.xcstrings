          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cheia ta API a atins limita de cereri. Așteaptă un minut sau schimbă furnizorul în Setări → Furnizor AI."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
