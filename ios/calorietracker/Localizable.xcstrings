    "Delete All Data removes food logs, weight, workouts, health records, medications, the Apple Health mirror and your profile from this iPhone." : {
      "comment" : "A description of the action of deleting all data.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يزيل «حذف كل البيانات» سجلات الطعام والوزن والتمارين والسجلات الصحية والأدوية ونسخة Apple Health وملفك الشخصي من هذا الـ iPhone."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bütün məlumatları sil qida qeydlərini, çəkini, məşqləri, sağlamlıq qeydlərini, dərmanları, Apple Health surətini və profilinizi bu iPhone-dan silir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Smazat všechna data odstraní z tohoto iPhonu záznamy jídla, hmotnost, tréninky, zdravotní záznamy, léky, zrcadlo Apple Health a tvůj profil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Alle Daten löschen“ entfernt Essenseinträge, Gewicht, Trainings, Gesundheitsbefunde, Medikamente, die Apple Health-Spiegelung und dein Profil von diesem iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eliminar todos los datos borra de este iPhone los registros de comida, el peso, los entrenamientos, los registros de salud, los medicamentos, la copia de Apple Health y tu perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Supprimer toutes les données retire de cet iPhone les journaux alimentaires, le poids, les entraînements, les dossiers de santé, les médicaments, la copie Apple Health et votre profil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\"सारा डेटा हटाएं\" इस iPhone से भोजन लॉग, वज़न, वर्कआउट, हेल्थ रिकॉर्ड, दवाइयाँ, Apple Health मिरर और आपकी प्रोफ़ाइल हटा देता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elimina tutti i dati rimuove da questo iPhone registri alimentari, peso, allenamenti, documenti sanitari, farmaci, la copia di Apple Health e il tuo profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「すべてのデータを削除」を実行すると、食事の記録、体重、ワークアウト、医療記録、服薬、Apple Healthのミラー、プロフィールがこのiPhoneから削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "모든 데이터 삭제는 이 iPhone에서 음식 기록, 체중, 운동, 건강 기록, 약, Apple Health 미러 및 프로필을 제거해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verwijder alle gegevens wist voedingslogs, gewicht, trainingen, gezondheidsdossiers, medicatie, de kopie van Apple Health en je profiel van deze iPhone."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usuń wszystkie dane usuwa z tego iPhone'a wpisy jedzenia, wagę, treningi, dokumentację zdrowotną, leki, kopię danych Apple Health i Twój profil."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apagar todos os dados remove registros de alimentação, peso, treinos, registros de saúde, medicamentos, a cópia espelhada do Apple Health e seu perfil deste iPhone."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Șterge toate datele elimină de pe acest iPhone jurnalele alimentare, greutatea, antrenamentele, dosarele medicale, medicamentele, copia Apple Health și profilul tău."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«Удалить все данные» удаляет с этого iPhone записи о еде, вес, тренировки, медкарту, лекарства, копию данных Apple Health и ваш профиль."
