          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "인사이트는 Apple Health를 사용해요. 회복, 건강 나이 및 패턴을 보려면 건강 동기화를 켜세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
