    "Adjust the start or end time so fasting sessions do not overlap." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدّل وقت البدء أو الانتهاء حتى لا تتداخل جلسات الصيام."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
