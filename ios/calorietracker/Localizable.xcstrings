    "This will permanently delete all your data including food logs, weight entries, and profile. This action cannot be undone." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى حذف جميع بياناتك بشكل دائم، بما في ذلك سجلات الطعام وإدخالات الوزن والملف الشخصي. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, yemək qeydləri, çəki qeydləri və profil daxil olmaqla bütün məlumatlarınızı həmişəlik siləcək. Bu əməliyyat geri qaytarıla bilməz."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trvale smaže všechna tvoje data včetně deníku jídel, záznamů váhy a profilu. Tuto akci nejde vrátit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle deine Daten dauerhaft gelöscht, einschließlich Ernährungstagebuch, Gewichtseinträge und Profil. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will permanently delete all your data including food logs, weight entries, and profile. This action cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará permanentemente todos tus datos, incluidos diarios de comidas, registros de peso y perfil. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprimera définitivement toutes vos données, y compris les journaux alimentaires, les entrées de poids et le profil. Cette action est irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह आपके सभी डेटा को स्थायी रूप से हटा देगा, जिसमें भोजन लॉग, वजन प्रविष्टियाँ और प्रोफ़ाइल शामिल हैं। यह क्रिया पूर्ववत नहीं की जा सकती।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa operazione eliminerà definitivamente tutti i tuoi dati, inclusi diario alimentare, voci di peso e profilo. Non è possibile annullarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより、食事ログ、体重記録、プロフィールを含むすべてのデータが完全に削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 작업은 음식 기록, 체중 기록, 프로필을 포함한 모든 데이터를 영구적으로 삭제합니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee worden al je gegevens permanent verwijderd, waaronder voedingsdagboeken, gewichtsinvoer en profiel. Deze actie kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To trwale usunie wszystkie Twoje dane, w tym dzienniki jedzenia, wpisy wagi i profil. Tej czynności nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso apagará permanentemente todos os seus dados, incluindo diário alimentar, registros de peso e perfil. Esta ação não pode ser desfeita."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest lucru va șterge definitiv toate datele tale, inclusiv jurnalele alimentare, intrările de greutate și profilul. Această acțiune nu poate fi anulată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это навсегда удалит все ваши данные, включая дневник питания, записи веса и профиль. Это действие нельзя отменить."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Усі ваші дані, зокрема записи їжі, записи ваги та профіль, буде видалено назавжди. Цю дію не можна скасувати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作将永久删除你的所有数据，包括饮食记录、体重记录和个人资料。此操作无法撤销。"
          }
        }
      }
    },
    "This will permanently delete all your data including food logs, weight entries, workout history, health records, medications, and profile. This action cannot be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "سيؤدي هذا إلى حذف جميع بياناتك نهائيًا، بما في ذلك سجلات الطعام وإدخالات الوزن وسجل التمارين والسجلات الصحية والأدوية والملف الشخصي. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bu, qida qeydləri, çəki qeydləri, məşq tarixçəsi, sağlamlıq qeydləri, dərmanlar və profil daxil olmaqla bütün məlumatlarınızı həmişəlik siləcək. Bu əməliyyatı geri qaytarmaq mümkün deyil."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tímto trvale smažeš všechna svá data včetně záznamů jídla, záznamů hmotnosti, historie tréninků, zdravotních záznamů, léků a profilu. Tuto akci nelze vrátit zpět."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dadurch werden alle deine Daten dauerhaft gelöscht, einschließlich Essenseinträgen, Gewichtseinträgen, Trainingsverlauf, Gesundheitsbefunden, Medikamenten und Profil. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se eliminarán de forma permanente todos tus datos, incluidos los registros de comida, las entradas de peso, el historial de entrenamientos, los registros de salud, los medicamentos y el perfil. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toutes vos données seront définitivement supprimées, y compris le journal alimentaire, les pesées, l'historique des entraînements, les dossiers de santé, les médicaments et le profil. Cette action est irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इससे आपका सारा डेटा हमेशा के लिए हट जाएगा, जिसमें भोजन लॉग, वज़न एंट्री, वर्कआउट इतिहास, स्वास्थ्य रिकॉर्ड, दवाइयाँ और प्रोफ़ाइल शामिल हैं। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tutti i tuoi dati verranno eliminati definitivamente, inclusi registri alimentari, pesate, cronologia degli allenamenti, documenti sanitari, farmaci e profilo. L'operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "食事記録、体重の記録、ワークアウト履歴、医療記録、服薬、プロフィールを含むすべてのデータが完全に削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "음식 기록, 체중 기록, 운동 이력, 건강 기록, 약, 프로필을 포함한 모든 데이터가 영구적으로 삭제돼요. 이 작업은 되돌릴 수 없어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hiermee worden al je gegevens definitief verwijderd, inclusief voedingslogs, gewichtsmetingen, trainingsgeschiedenis, gezondheidsdossiers, medicatie en profiel. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spowoduje to trwałe usunięcie wszystkich Twoich danych, w tym wpisów jedzenia, wagi, historii treningów, dokumentacji zdrowotnej, leków i profilu. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Isto vai apagar permanentemente todos os seus dados, incluindo registros de alimentação, registros de peso, histórico de treinos, registros de saúde, medicamentos e perfil. Esta ação não pode ser desfeita."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toate datele tale vor fi șterse definitiv, inclusiv jurnalele de alimente, greutățile înregistrate, istoricul antrenamentelor, dosarele medicale, medicamentele și profilul. Acțiunea nu poate fi anulată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Все ваши данные будут удалены безвозвратно, включая дневник питания, записи веса, историю тренировок, медкарту, лекарства и профиль. Это действие нельзя отменить."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Це назавжди видалить усі ваші дані, зокрема журнали їжі, записи ваги, історію тренувань, медичні записи, ліки та профіль. Цю дію не можна скасувати."
