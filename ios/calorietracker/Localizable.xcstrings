          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajoute les nouveaux médicaments, horaires et doses, et conserve la version la plus récente de chacun. Rien n'est supprimé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "नई दवाइयाँ, शेड्यूल और खुराकें जोड़ता है और हर एक की नई कॉपी रखता है। कुछ भी हटाया नहीं जाता।"
          }
