    "Hard training 6–7 days/week, endurance training, or demanding physical work.\nApprox. step guide: 12,500–14,999 steps/day." : {
      "comment" : "Display text looked up at runtime (LocalizedDisplayText).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تدريب شاق 6–7 أيام/أسبوع، أو تدريب تحمل، أو عمل بدني مجهد.\nدليل تقريبي: 12,500–14,999 خطوة/يوم."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Həftədə 6–7 gün ağır məşq, dözümlülük məşqi və ya tələbkar fiziki iş.\nTəxmini göstərici: gündə 12 500–14 999 addım."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tvrdý trénink 6–7 dní v týdnu, vytrvalostní příprava nebo fyzicky náročná práce.\nOrientačně: 12 500–14 999 kroků denně."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hartes Training an 6–7 Tagen/Woche, Ausdauertraining oder körperlich anspruchsvolle Arbeit.\nRichtwert: 12.500–14.999 Schritte/Tag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entrenamiento duro 6–7 días/semana, resistencia o trabajo físico exigente.\nGuía aproximada: 12 500–14 999 pasos/día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entraînement intense 6 à 7 jours/semaine, endurance ou travail physique exigeant.\nRepère approximatif : 12 500–14 999 pas/jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सप्ताह में 6–7 दिन कठिन या सहनशक्ति प्रशिक्षण, या मेहनत वाला शारीरिक काम।\nअनुमानित मार्गदर्शक: प्रतिदिन 12,500–14,999 कदम।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Allenamento duro 6–7 giorni/settimana, resistenza o lavoro fisico impegnativo.\nIndicazione approssimativa: 12.500–14.999 passi/giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "週6〜7日のハードまたは持久系トレーニング、あるいは負荷の高い肉体労働。\n目安：1日12,500〜14,999歩。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "주 6–7일 고강도 또는 지구력 훈련, 혹은 힘든 육체 노동.\n대략적인 기준: 하루 12,500–14,999보."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zware training 6–7 dagen per week, duurtraining of veeleisend lichamelijk werk.\nRichtlijn: 12.500–14.999 stappen/dag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciężki trening 6–7 dni w tygodniu, trening wytrzymałościowy lub wymagająca praca fizyczna.\nOrientacyjnie: 12 500–14 999 kroków dziennie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Treino pesado 6–7 dias/semana, resistência ou trabalho físico exigente.\nReferência aproximada: 12.500–14.999 passos/dia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Antrenament intens 6–7 zile/săptămână, rezistență sau muncă fizică solicitantă.\nReper aproximativ: 12.500–14.999 de pași/zi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Тяжёлые тренировки 6–7 дней в неделю, тренировки на выносливость или тяжёлая физическая работа.\nПримерный ориентир: 12 500–14 999 шагов в день."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Інтенсивні тренування 6–7 днів на тиждень, тренування на витривалість або важка фізична робота.\nОрієнтир: 12 500–14 999 кроків на день."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每周 6–7 天高强度或耐力训练，或从事高强度体力工作。\n大致参考：每天 12,500–14,999 步。"
          }
        }
      }
    },
