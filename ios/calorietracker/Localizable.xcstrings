    "Link follow-ups, prescriptions and earlier reports to keep an episode together." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اربط المتابعات والوصفات الطبية والتقارير السابقة للإبقاء على الحالة المرضية معًا."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bir epizodu bir yerdə saxlamaq üçün təkrar müayinələri, reseptləri və əvvəlki hesabatları əlaqələndirin."
          }
        },
        "cs" : {
          "stringUnit" : {
