    "Asian cut-offs (overweight from 23, obese from 27.5) follow the WHO expert consultation for Asian populations." : {
      "comment" : "The text for the footer of the BMI Categories section in the Derived Metrics settings.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الحدود الفاصلة الآسيوية (زيادة الوزن من 23، والسمنة من 27.5) تتبع مشاورة خبراء منظمة الصحة العالمية للسكان الآسيويين."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Asiya hədləri (artıq çəki 23-dən, piylənmə 27,5-dən) ÜST-ün Asiya əhalisi üçün ekspert məsləhətinə əsaslanır."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Asijské hraniční hodnoty (nadváha od 23, obezita od 27,5) vycházejí z expertní konzultace WHO pro asijskou populaci."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Asiatische Grenzwerte (Übergewicht ab 23, Adipositas ab 27,5) folgen der WHO-Expertenkonsultation für asiatische Bevölkerungsgruppen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
