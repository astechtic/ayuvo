        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La temperatura segue l'unità di lunghezza (metrico → °C, imperiale → °F). I valori vengono salvati in °C."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "温度は長さの単位に従います（メートル法 → °C、ヤード・ポンド法 → °F）。値は°Cで保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "온도는 길이 단위를 따라요 (미터법 → °C, 야드파운드법 → °F). 값은 °C로 저장돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
