    "Remove %@ from your sensitivities?" : {
      "comment" : "A confirmation prompt asking the user to confirm the deletion of a specific allergen from their list of allergies.",
      "isCommentAutoGenerated" : true
    },
    "Remove %@'s entry of %@ kcal? This also deletes the matching sample from Apple Health. The dated workout plan stays in your diary." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد إزالة إدخال %2$@ kcal بتاريخ %1$@؟ سيؤدي ذلك أيضًا إلى حذف العينة المطابقة من Apple Health. ستبقى خطة التمرين المؤرخة في يومياتك."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tarixli %2$@ kcal qeydini silmək istəyirsiniz? Bu, Apple Health-dəki uyğun nümunəni də siləcək. Tarixli məşq planı gündəliyinizdə qalacaq."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Eintrag vom %1$@ mit %2$@ kcal entfernen? Dadurch wird auch das zugehörige Sample aus Apple Health gelöscht. Der datierte Trainingsplan bleibt in deinem Tagebuch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove %1$@'s entry of %2$@ kcal? This also deletes the matching sample from Apple Health. The dated workout plan stays in your diary."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Eliminar el registro del %1$@ de %2$@ kcal? Esto también elimina la muestra correspondiente de Apple Health. El plan de entrenamiento con fecha permanece en tu diario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer l’entrée du %1$@ de %2$@ kcal ? Cela supprime également l’échantillon correspondant d’Apple Health. Le programme d’entraînement daté reste dans votre journal."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ की %2$@ kcal वाली प्रविष्टि हटाएँ? इससे Apple Health का संबंधित नमूना भी हट जाएगा। तारीख वाला वर्कआउट प्लान आपकी डायरी में बना रहेगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovere la voce del %1$@ da %2$@ kcal? Verrà eliminato anche il campione corrispondente da Apple Health. Il piano di allenamento datato resterà nel diario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@の%2$@ kcalの記録を削除しますか？Apple Healthの該当サンプルも削除されます。日付付きのワークアウトプランは日記に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@의 %2$@ kcal 기록을 삭제할까요? Apple Health의 해당 샘플도 삭제됩니다. 날짜가 지정된 운동 계획은 일기에 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De registratie van %1$@ met %2$@ kcal verwijderen? Hiermee wordt ook de bijbehorende meting uit Apple Health verwijderd. Het gedateerde trainingsplan blijft in je dagboek staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunąć wpis z %1$@ o wartości %2$@ kcal? Spowoduje to również usunięcie pasującej próbki z Apple Health. Plan treningu z tą datą pozostanie w dzienniku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover o registro de %1$@ com %2$@ kcal? Isso também exclui a amostra correspondente do Apple Health. O plano de treino com data permanece no seu diário."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimini înregistrarea din %1$@ de %2$@ kcal? Aceasta șterge și eșantionul corespunzător din Apple Health. Planul de antrenament datat rămâne în jurnal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить запись от %1$@ на %2$@ ккал? Также будет удалена соответствующая запись из Apple Health. План тренировки с этой датой останется в дневнике."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видалити запись от %1$@ на %2$@ ккал? Также будет удалена соответствующая запись из Apple Health. План тренировки с етой датой останется в дневнике."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要删除 %1$@ 的 %2$@ kcal 记录吗？这也会删除 Apple Health 中对应的样本。带日期的锻炼计划仍会保留在日记中。"
          }
        }
      }
    },
