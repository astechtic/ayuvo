          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toca una página para empezar allí un registro nuevo, o toca la primera página de un registro para unirlo con el anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touchez une page pour y commencer un nouveau dossier, ou touchez la première page d'un dossier pour le joindre au précédent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "वहाँ नया रिकॉर्ड शुरू करने के लिए किसी पेज पर टैप करें, या किसी रिकॉर्ड के पहले पेज पर टैप करके उसे पिछले रिकॉर्ड से जोड़ें।"
