    "Mix compound strength days with accessory hypertrophy work." : {
      "comment" : "A description of a workout split that includes both compound strength and hypertrophy exercises.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "امزج أيام القوة بالتمارين المركّبة مع تمارين تضخيم مساعدة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mürəkkəb güc günlərini köməkçi hipertrofiya işi ilə birləşdirin."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kombinuj dny složeného silového tréninku s doplňkovou prací na hypertrofii."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kombiniere Krafttage mit Grundübungen und ergänzendem Hypertrophietraining."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Combina días de fuerza con ejercicios compuestos y trabajo accesorio de hipertrofia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alternez des journées de force sur des mouvements polyarticulaires avec un travail d'hypertrophie complémentaire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कंपाउंड स्ट्रेंथ वाले दिनों को सहायक हाइपरट्रॉफी वर्क के साथ मिलाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alterna giorni di forza con esercizi multiarticolari a lavoro complementare per l'ipertrofia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "コンパウンド種目中心の筋力の日と、補助的な筋肥大トレーニングを組み合わせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
