    "Includes supplement doses you marked as taken. Tap a nutrient for its chart." : {
      "comment" : "A description of the nutrition details section.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يشمل جرعات المكمّلات التي حدّدتها كمتناولة. اضغط على عنصر غذائي لعرض مخططه."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Qəbul edilmiş kimi işarələdiyiniz əlavə dozalarını əhatə edir. Qrafiki üçün qida maddəsinə toxunun."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zahrnuje dávky doplňků stravy, které jsi označil(a) jako užité. Klepnutím na živinu zobrazíš její graf."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Enthält Dosen von Nahrungsergänzungsmitteln, die du als eingenommen markiert hast. Tippe auf einen Nährstoff, um sein Diagramm zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Incluye las dosis de suplementos que marcaste como tomadas. Toca un nutriente para ver su gráfico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inclut les doses de compléments que vous avez marquées comme prises. Touchez un nutriment pour voir son graphique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इसमें वे सप्लीमेंट खुराकें शामिल हैं जिन्हें आपने ली गई के रूप में चिह्नित किया है। किसी पोषक तत्व का चार्ट देखने के लिए उस पर टैप करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Include le dosi di integratori che hai segnato come assunte. Tocca un nutriente per vederne il grafico."
