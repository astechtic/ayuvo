    "Tap a page to start a new record there, or tap the first page of a record to join it with the one before." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اضغط على صفحة لبدء سجل جديد عندها، أو اضغط على الصفحة الأولى من سجل لضمّه إلى السجل الذي قبله."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Orada yeni qeyd başlatmaq üçün səhifəyə toxunun və ya qeydi əvvəlki ilə birləşdirmək üçün onun ilk səhifəsinə toxunun."
