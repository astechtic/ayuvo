    "Default formula for resting metabolism. Used when body fat is unavailable." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المعادلة الافتراضية للأيض أثناء الراحة. تُستخدم عندما لا تتوفر نسبة دهون الجسم."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstirahət metabolizmi üçün standart düstur. Bədən yağı məlumatı olmadıqda istifadə olunur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardformel für den Ruheumsatz. Wird verwendet, wenn kein Körperfettwert verfügbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fórmula predeterminada para el metabolismo en reposo. Se usa cuando la grasa corporal no está disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formule par défaut du métabolisme au repos. Utilisée lorsque le pourcentage de masse grasse n’est pas disponible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आराम के समय चयापचय की डिफ़ॉल्ट गणना। इसका उपयोग तब होता है जब शरीर की वसा उपलब्ध न हो।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formula predefinita per il metabolismo a riposo. Viene usata quando il grasso corporeo non è disponibile."
