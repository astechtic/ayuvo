    "Reference amounts describe intakes for healthy adults. They are not personal medical advice." : {
      "comment" : "A description of the reference amounts.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تصف الكميات المرجعية المدخول للبالغين الأصحاء. وهي ليست نصيحة طبية شخصية."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "İstinad miqdarları sağlam yetkinlər üçün qəbulu təsvir edir. Onlar fərdi tibbi məsləhət deyil."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Referenční hodnoty popisují příjem pro zdravé dospělé. Nejde o osobní lékařskou radu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Referenzmengen beschreiben die Aufnahme für gesunde Erwachsene. Sie sind keine persönliche medizinische Beratung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las cantidades de referencia describen ingestas para adultos sanos. No son consejo médico personal."
