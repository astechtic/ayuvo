    "Any role using it will need a model chosen again. The provider's API key is kept." : {
      "comment" : "The text in the confirmation dialog for deleting a model.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "سيتعين اختيار نموذج من جديد لأي دور يستخدمه. يتم الاحتفاظ بمفتاح API الخاص بالمزوّد."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ondan istifadə edən hər rol üçün modeli yenidən seçmək lazım olacaq. Provayderin API açarı saxlanılır."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "U každé role, která ho používá, bude potřeba znovu vybrat model. API klíč poskytovatele zůstane zachován."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jede Rolle, die es verwendet, benötigt erneut ein ausgewähltes Modell. Der API-Schlüssel des Anbieters bleibt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cualquier función que lo use necesitará que vuelvas a elegir un modelo. Se conserva la clave de API del proveedor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tout rôle qui l'utilise devra se voir attribuer un nouveau modèle. La clé API du fournisseur est conservée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इसका उपयोग करने वाली हर भूमिका के लिए फिर से मॉडल चुनना होगा। प्रदाता की API कुंजी रखी जाती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Per ogni ruolo che lo usa dovrà essere scelto di nuovo un modello. La chiave API del provider viene mantenuta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このモデルを使用している役割では、モデルを再度選択する必要があります。プロバイダのAPIキーは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 모델을 사용하는 역할에서는 모델을 다시 선택해야 해요. 제공업체의 API 키는 유지돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elke rol die het gebruikt, moet opnieuw een model kiezen. De API-sleutel van de provider blijft bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Każda rola, która go używa, będzie wymagać ponownego wyboru modelu. Klucz API dostawcy zostaje zachowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Qualquer função que o use precisará escolher um modelo novamente. A chave de API do provedor é mantida."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Orice rol care îl folosește va avea nevoie din nou de un model ales. Cheia API a furnizorului se păstrează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Для всех ролей, использующих её, нужно будет снова выбрать модель. API-ключ провайдера сохранится."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Для кожної ролі, що її використовує, потрібно буде знову вибрати модель. Ключ API провайдера збережеться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
