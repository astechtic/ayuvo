            "state" : "needs_review",
            "value" : "Tvůj průměrný příjem živiny %1$@ je %2$lld %% referenční hodnoty a žádný z tvých doplňků stravy ji neobsahuje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
