    "Only workout burns calculated in Ayuvo are shown. Workouts without a burn estimate are not included." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم عرض حرق السعرات الذي حسبه Ayuvo فقط. لا تُدرج التمارين التي لا يتوفر لها تقدير للحرق."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnız Ayuvo-da hesablanmış məşq sərfiyyatları göstərilir. Sərfiyyat təxmini olmayan məşqlər daxil edilmir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird nur der in Ayuvo berechnete Trainingsverbrauch angezeigt. Trainings ohne Verbrauchsschätzung werden nicht berücksichtigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only workout burns calculated in Ayuvo are shown. Workouts without a burn estimate are not included."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se muestran las calorías de entrenamiento calculadas en Ayuvo. No se incluyen los entrenamientos sin una estimación de gasto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules les dépenses d’entraînement calculées dans Ayuvo sont affichées. Les entraînements sans estimation ne sont pas inclus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल Ayuvo में गणना की गई वर्कआउट कैलोरी दिखाई जाती हैं। जिन वर्कआउट के लिए बर्न का अनुमान नहीं है, वे शामिल नहीं होते।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene mostrato solo il consumo degli allenamenti calcolato in Ayuvo. Gli allenamenti senza una stima non sono inclusi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvoで計算されたワークアウトの消費量のみ表示されます。消費量の推定がないワークアウトは含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo에서 계산한 운동 소모량만 표시됩니다. 소모량 추정치가 없는 운동은 포함되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen het trainingsverbruik dat in Ayuvo is berekend, wordt getoond. Trainingen zonder schatting worden niet meegenomen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetlane jest tylko spalanie treningowe obliczone w Ayuvo. Treningi bez oszacowanego spalania nie są uwzględniane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas o gasto dos treinos calculado no Ayuvo é exibido. Treinos sem estimativa de gasto não são incluídos."
          }
        },
        "ro" : {
          "stringUnit" : {
