    "Keep steps, heart, sleep, workouts and body\nmeasurements in sync — kept on this device." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "حافظ على مزامنة الخطوات والقلب والنوم والتمارين وقياسات\nالجسم — محفوظة على هذا الجهاز."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Addımları, ürəyi, yuxunu, məşqləri və bədən\nölçülərini sinxron saxlayın — bu cihazda saxlanılır."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Synchronizuj kroky, srdce, spánek, tréninky a tělesné\nmíry — uloženo v tomto zařízení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halte Schritte, Herz, Schlaf, Trainings und Körper-\nmaße synchron – gespeichert auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep steps, heart, sleep, workouts and body\nmeasurements in sync — kept on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantén sincronizados tus pasos, corazón, sueño, entrenamientos y\nmedidas corporales, guardados en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Synchronisez pas, cœur, sommeil, entraînements et\nmensurations — conservés sur cet appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कदम, हृदय, नींद, वर्कआउट और शरीर के\nमाप सिंक में रखें — इसी डिवाइस पर सुरक्षित।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantieni sincronizzati passi, cuore, sonno, allenamenti e misure\ncorporee, conservati su questo dispositivo."
          }
        },
        "ja" : {
