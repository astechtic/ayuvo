    "Pair chest/back, shoulders/arms, legs, and core days." : {
      "comment" : "A description of the Arnold workout split.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اجمع أيام الصدر/الظهر، والأكتاف/الذراعين، والأرجل، والجذع."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Döş/kürək, çiyin/qol, ayaq və kor günlərini cütləşdirin."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Střídej dny hrudník/záda, ramena/paže, nohy a střed těla."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kombiniere Tage für Brust/Rücken, Schultern/Arme, Beine und Core."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Combina días de pecho/espalda, hombros/brazos, piernas y core."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Associez des journées pectoraux/dos, épaules/bras, jambes et gainage."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "छाती/पीठ, कंधे/बाँहें, पैर और कोर के दिन जोड़ी में रखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abbina giorni per petto/schiena, spalle/braccia, gambe e core."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "胸・背中、肩・腕、脚、体幹の日を組み合わせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "가슴/등, 어깨/팔, 하체, 코어로 날을 묶어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Combineer dagen voor borst/rug, schouders/armen, benen en core."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Łącz w pary dni klatka/plecy, barki/ramiona, nogi i core."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Combine dias de peito/costas, ombros/braços, pernas e core."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Combină zile de piept/spate, umeri/brațe, picioare și abdomen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Дни грудь/спина, плечи/руки, ноги и кор."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Поєднуйте дні груди/спина, плечі/руки, ноги та корпус."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "分为胸/背、肩/手臂、腿部和核心训练日。"
          }
        }
      }
    },
    "Pair opposing muscle groups for balanced sessions." : {
      "comment" : "A description of the `antagonistSplit` workout preference.",
