    "Off until you turn it on. Uses the iCloud account on this iPhone. API keys stay on the device." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "متوقف حتى تشغّله. يستخدم حساب iCloud على هذا الـ iPhone. تبقى مفاتيح API على الجهاز."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Siz yandırana qədər sönülüdür. Bu iPhone-dakı iCloud hesabından istifadə edir. API açarları cihazda qalır."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vypnuto, dokud to nezapneš. Používá účet iCloud na tomto iPhonu. API klíče zůstávají v zařízení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aus, bis du es aktivierst. Verwendet den iCloud-Account auf diesem iPhone. API-Schlüssel bleiben auf dem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desactivado hasta que lo actives. Usa la cuenta de iCloud de este iPhone. Las claves de API se quedan en el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Désactivé jusqu'à ce que vous l'activiez. Utilise le compte iCloud de cet iPhone. Les clés API restent sur l'appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "जब तक आप इसे चालू न करें, बंद रहता है। इस iPhone के iCloud खाते का उपयोग करता है। API कुंजियाँ डिवाइस पर ही रहती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Disattivato finché non lo attivi. Usa l'account iCloud di questo iPhone. Le chiavi API restano sul dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "オンにするまでオフです。このiPhoneのiCloudアカウントを使用します。APIキーはデバイスに保存されたままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "직접 켤 때까지 꺼져 있어요. 이 iPhone의 iCloud 계정을 사용해요. API 키는 기기에 남아 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uit tot je het aanzet. Gebruikt het iCloud-account op deze iPhone. API-sleutels blijven op het apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wyłączone, dopóki tego nie włączysz. Używa konta iCloud na tym iPhonie. Klucze API pozostają na urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desativado até você ativar. Usa a conta do iCloud deste iPhone. As chaves de API ficam no dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dezactivat până îl activezi. Folosește contul iCloud de pe acest iPhone. Cheile API rămân pe dispozitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Выключено, пока вы не включите. Используется аккаунт iCloud на этом iPhone. API-ключи остаются на устройстве."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимкнено, доки ви не увімкнете. Використовує обліковий запис iCloud на цьому iPhone. Ключі API залишаються на пристрої."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在你开启前保持关闭。使用这台 iPhone 上的 iCloud 账户。API 密钥保留在设备上。"
          }
        }
      }
    },
    "Off: Ayuvo does not calculate this metric and its estimates are deleted. Values from Apple Health still show." : {
      "comment" : "A description of why a derived metric is disabled.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
