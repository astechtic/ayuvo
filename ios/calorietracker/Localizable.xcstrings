    "You usually take it later than the reminder. Moving it changes future reminders only." : {
      "comment" : "A description of the effect of moving the reminder time.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "عادةً ما تتناوله بعد موعد التذكير. نقله يغيّر التذكيرات المستقبلية فقط."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Adətən onu xatırlatmadan gec qəbul edirsiniz. Vaxtı dəyişmək yalnız gələcək xatırlatmalara təsir edir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Obvykle ho užíváš později než v čas připomínky. Posunutí změní jen budoucí připomínky."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du nimmst es meist später als zur Erinnerungszeit ein. Eine Verschiebung ändert nur zukünftige Erinnerungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sueles tomarlo más tarde que el recordatorio. Moverlo solo cambia los recordatorios futuros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
