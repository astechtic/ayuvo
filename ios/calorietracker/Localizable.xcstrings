        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Non sei a digiuno in questo momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "現在、断食中ではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
