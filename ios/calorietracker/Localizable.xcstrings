    "Explain my latest blood report: what stands out, what is normal, and what should I ask my doctor?" : {
      "comment" : "Prompt text for the \"explain_latest_report\" prompt.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اشرح أحدث تقرير دم لي: ما الذي يلفت الانتباه، وما الطبيعي، وماذا يجب أن أسأل طبيبي؟"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Son qan analizimi izah et: nə diqqət çəkir, nə normaldır və həkimimdən nə soruşmalıyam?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vysvětli moji poslední zprávu z krevního rozboru: co vybočuje, co je v normě a na co se mám zeptat lékaře?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erkläre meinen neuesten Blutbefund: Was fällt auf, was ist normal und was sollte ich meine Ärztin oder meinen Arzt fragen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
