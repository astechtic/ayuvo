        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le repas n'est pas enregistré. Voici à quoi ressemblerait votre journée si vous enregistriez %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इससे भोजन लॉग नहीं होता। यह दिखाता है कि अगर आप %@ लॉग करें तो आज कैसा दिखेगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo non registra il pasto. Mostra come sarebbe la giornata di oggi se registrassi %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
