    "Water Tracking also shows the Drink ring on Summary. Change the water unit in Units." : {
      "comment" : "A footer for the water tracking section of the settings.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يعرض تتبّع الماء أيضًا حلقة الشرب في الملخص. غيّر وحدة الماء من «الوحدات»."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Su izləməsi Xülasədə İç halqasını da göstərir. Su vahidini Vahidlər bölməsində dəyişin."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sledování vody také zobrazuje v Přehledu kruh Pití. Jednotku vody změníš v části Jednotky."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mit der Wasser-Erfassung wird auch der Trink-Ring in der Übersicht angezeigt. Die Wassereinheit änderst du unter „Einheiten“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El seguimiento del agua también muestra el anillo Beber en Resumen. Cambia la unidad de agua en Unidades."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le suivi de l'eau affiche aussi l'anneau Boire dans Résumé. Modifiez l'unité d'eau dans Unités."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "पानी ट्रैकिंग सारांश में ड्रिंक रिंग भी दिखाती है। पानी की इकाई इकाइयाँ में बदलें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il monitoraggio dell'acqua mostra anche l'anello Bevande in Riepilogo. Cambia l'unità dell'acqua in Unità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
