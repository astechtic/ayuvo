    "Home redesign: speedometer calorie gauge, vertical macro bars, four nutrient cards, and a floating add button." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصميم جديد للرئيسية: عدّاد سرعة للسعرات، وأشرطة ماكرو عمودية، وأربع بطاقات مغذّيات، وزر إضافة عائم."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yenilənmiş Ana səhifə: spidometr kalori göstəricisi, şaquli makro zolaqları, dörd qida kartı və üzən əlavə düyməsi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nový design Domů: tachometrový ukazatel kalorií, svislé sloupce maker, čtyři karty živin a plovoucí tlačítko přidání."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home-Redesign: Tacho-Kalorienanzeige, vertikale Makro-Balken, vier Nährstoffkarten und ein schwebender Hinzufügen-Button."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rediseño de Inicio: velocímetro de calorías, barras verticales de macros, cuatro tarjetas de nutrientes y un botón flotante para añadir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refonte de l'accueil : compteur de calories façon tachymètre, barres de macros verticales, quatre cartes de nutriments et un bouton d'ajout flottant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नया होम: स्पीडोमीटर कैलोरी गेज, खड़ी मैक्रो बार, चार पोषक कार्ड और फ़्लोटिंग जोड़ें बटन।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuova Home: tachimetro delle calorie, barre verticali dei macro, quattro schede nutrienti e un pulsante di aggiunta flottante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホームを刷新：スピードメーター型カロリーゲージ、縦型マクロバー、4枚の栄養素カード、フローティング追加ボタン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈 화면 개편: 속도계형 칼로리 게이지, 세로 매크로 바, 영양소 카드 4개, 플로팅 추가 버튼."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home vernieuwd: snelheidsmeter voor calorieën, verticale macrobalken, vier voedingskaarten en een zwevende toevoegknop."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowy ekran główny: prędkościomierz kalorii, pionowe paski makro, cztery karty składników i pływający przycisk dodawania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nova tela inicial: velocímetro de calorias, barras verticais de macros, quatro cartões de nutrientes e um botão flutuante de adicionar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ecran principal reproiectat: vitezometru pentru calorii, bare verticale de macronutrienți, patru carduri de nutrienți și un buton plutitor de adăugare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новый главный экран: спидометр калорий, вертикальные полосы макросов, четыре карточки нутриентов и плавающая кнопка добавления."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Редизайн головної сторінки: шкала калорій у вигляді спідометра, вертикальні індикатори макросів, чотири картки нутрієнтів і плаваюча кнопка додавання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主页焕新：仪表盘式卡路里表、竖向宏量条、四张营养卡片和悬浮添加按钮。"
          }
        }
      }
    },
