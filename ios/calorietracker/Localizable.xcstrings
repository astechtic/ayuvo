    "Ayuvo estimates this from your Apple Health data once enough readings are available." : {
      "comment" : "Description of the empty state when the user has not logged enough data to estimate a derived metric.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يقدّر Ayuvo هذا من بيانات Apple Health بمجرد توفر قراءات كافية."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kifayət qədər ölçmə olduqda Ayuvo bunu Apple Health məlumatlarınızdan təxmin edir."
          }
        },
        "cs" : {
          "stringUnit" : {
