        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nie udało się dokończyć na podstawie Twoich odpowiedzi. Dodaj brakujące szczegóły do opisu (np. serie i powtórzenia) lub zacznij od nowa."
