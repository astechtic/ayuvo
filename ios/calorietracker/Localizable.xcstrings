    "Calculated on this iPhone from your Apple Health data. Apple Health's own value is shown instead whenever it has one." : {
      "comment" : "A description of the values shown in the \"Estimated by Ayuvo\" section of the Browse",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يُحسب على هذا الـ iPhone من بيانات Apple Health. تُعرض قيمة Apple Health نفسها بدلًا من ذلك متى توفرت."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apple Health məlumatlarınızdan bu iPhone-da hesablanıb. Apple Health-in öz dəyəri olduqda, əvəzində o göstərilir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vypočteno na tomto iPhonu z tvých dat v Apple Health. Pokud má Apple Health vlastní hodnotu, zobrazí se místo toho ta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Auf diesem iPhone aus deinen Apple Health-Daten berechnet. Sobald Apple Health einen eigenen Wert hat, wird stattdessen dieser angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Calculado en este iPhone a partir de tus datos de Apple Health. Si Apple Health tiene su propio valor, se muestra ese."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Calculé sur cet iPhone à partir de vos données Apple Health. La valeur propre d'Apple Health est affichée à la place chaque fois qu'elle existe."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपके Apple Health डेटा से इस iPhone पर गणना की गई। जब भी Apple Health में अपना मान हो, तो उसकी जगह वही दिखाया जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Calcolato su questo iPhone dai tuoi dati di Apple Health. Quando Apple Health ha un proprio valore, viene mostrato quello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
