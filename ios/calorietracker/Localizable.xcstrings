    "Add a note to refine this entry — e.g. “large bowl, extra olive oil” — then tap Reprocess." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أضف ملاحظة لتحسين هذا الإدخال — مثل «وعاء كبير، زيت زيتون إضافي» — ثم اضغط «إعادة المعالجة»."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bu qeydi dəqiqləşdirmək üçün qeyd əlavə edin — məs. “böyük kasa, əlavə zeytun yağı” — sonra Yenidən emal et düyməsinə toxunun."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Přidej poznámku pro upřesnění záznamu — např. „velká miska, olivový olej navíc“ — a klepni na Znovu zpracovat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Füge eine Notiz hinzu, um diesen Eintrag zu präzisieren – z. B. „große Schüssel, extra Olivenöl“ – und tippe dann auf „Neu verarbeiten“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Añade una nota para afinar esta entrada (p. ej., “bol grande, aceite de oliva extra”) y toca Reprocesar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajoutez une note pour affiner cette entrée — par ex. « grand bol, huile d'olive en plus » — puis touchez Retraiter."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इस प्रविष्टि को बेहतर बनाने के लिए नोट जोड़ें — जैसे “बड़ा कटोरा, अतिरिक्त ऑलिव ऑयल” — फिर \"फिर से प्रोसेस करें\" पर टैप करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aggiungi una nota per perfezionare questa voce, ad es. “ciotola grande, olio d'oliva in più”, poi tocca Rielabora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "メモを追加してこの記録を調整し（例：「大盛り、オリーブオイル多め」）、「再処理」をタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 항목을 보완할 메모를 추가한 다음(예: “큰 그릇, 올리브유 추가”) 재처리를 탭하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voeg een notitie toe om deze invoer te verfijnen — bijv. “grote kom, extra olijfolie” — en tik dan op Opnieuw verwerken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dodaj notatkę, aby doprecyzować ten wpis — np. „duża miska, dodatkowa oliwa” — a potem stuknij Przetwórz ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Adicione uma nota para refinar este registro — por exemplo, “tigela grande, azeite extra” — e toque em Reprocessar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Adaugă o notă pentru a rafina această înregistrare — de ex. „castron mare, ulei de măsline în plus” — apoi atinge Reprocesează."
          }
        },
        "ru" : {
