        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "いつもリマインダーより遅く服用しています。時刻を変更しても、今後のリマインダーにのみ反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "보통 알림보다 늦게 복용하고 있어요. 시간을 옮기면 앞으로의 알림만 변경돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je neemt het meestal later in dan de herinnering. Verplaatsen wijzigt alleen toekomstige herinneringen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zwykle przyjmujesz go później niż przypomnienie. Przesunięcie zmieni tylko przyszłe przypomnienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Você costuma tomá-lo mais tarde que o lembrete. Mudar o horário altera apenas os lembretes futuros."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De obicei îl iei mai târziu decât mementoul. Mutarea lui schimbă doar mementourile viitoare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Обычно вы принимаете его позже напоминания. Перенос изменит только будущие напоминания."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Зазвичай ви приймаєте пізніше за нагадування. Перенесення змінить лише майбутні нагадування."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你通常比提醒时间晚服用。调整时间只会更改之后的提醒。"
          }
        }
      }
    },
