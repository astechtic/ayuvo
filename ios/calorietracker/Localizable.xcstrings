    "Pre-filled from the prescription; check every field before saving." : {
      "comment" : "A footer that appears below the instructions section of a medication form.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مُعبّأ مسبقًا من الوصفة الطبية؛ تحقّق من كل حقل قبل الحفظ."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reseptdən əvvəlcədən dolduruldu; saxlamazdan əvvəl hər sahəni yoxlayın."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Předvyplněno z receptu; před uložením zkontroluj každé pole."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aus dem Rezept vorausgefüllt; prüfe vor dem Speichern jedes Feld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rellenado a partir de la receta; revisa todos los campos antes de guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prérempli à partir de l'ordonnance ; vérifiez chaque champ avant d'enregistrer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "प्रिस्क्रिप्शन से पहले से भरा गया; सहेजने से पहले हर फ़ील्ड जाँचें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Precompilato dalla prescrizione; controlla ogni campo prima di salvare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "処方箋から自動入力されています。保存する前にすべての項目を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "처방전에서 미리 채웠어요. 저장하기 전에 모든 항목을 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vooraf ingevuld vanuit het recept; controleer elk veld voordat je bewaart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wstępnie wypełnione na podstawie recepty; sprawdź każde pole przed zapisaniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Preenchido a partir da receita médica; verifique todos os campos antes de salvar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Precompletat din rețetă; verifică fiecare câmp înainte de a salva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Заполнено по рецепту; проверьте каждое поле перед сохранением."
          }
        },
        "uk" : {
          "stringUnit" : {
