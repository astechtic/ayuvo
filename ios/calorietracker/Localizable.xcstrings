    "Height and weight units can now be set independently." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن الآن ضبط وحدتي الطول والوزن بشكل مستقل."
