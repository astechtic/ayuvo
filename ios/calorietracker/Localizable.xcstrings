    "Training most days, or a job with substantial standing, movement, or lifting.\nApprox. step guide: 10,000–12,499 steps/day." : {
      "comment" : "Display text looked up at runtime (LocalizedDisplayText).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تدريب معظم الأيام، أو عمل يتطلب الكثير من الوقوف والحركة أو الرفع.\nدليل تقريبي: 10,000–12,499 خطوة/يوم."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Əksər günlər məşq və ya çox ayaqüstə qalma, hərəkət və qaldırma tələb edən iş.\nTəxmini göstərici: gündə 10 000–12 499 addım."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trénink většinu dní, nebo práce s hodně stání, pohybu či zvedání.\nOrientačně: 10 000–12 499 kroků denně."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Training an den meisten Tagen oder ein Beruf mit viel Stehen, Bewegung oder Heben.\nRichtwert: 10.000–12.499 Schritte/Tag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entrenamiento la mayoría de los días, o trabajo con bastante tiempo de pie, movimiento o carga.\nGuía aproximada: 10 000–12 499 pasos/día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entraînement presque tous les jours, ou métier avec beaucoup de station debout, mouvement ou port de charges.\nRepère approximatif : 10 000–12 499 pas/jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अधिकतर दिनों में प्रशिक्षण, या ऐसा काम जिसमें काफी खड़ा रहना, चलना या उठाना हो।\nअनुमानित मार्गदर्शक: प्रतिदिन 10,000–12,499 कदम।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Allenamento quasi tutti i giorni, o lavoro con molto tempo in piedi, movimento o sollevamento.\nIndicazione approssimativa: 10.000–12.499 passi/giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ほぼ毎日トレーニングする、または立つ・動く・持ち上げることが多い仕事。\n目安：1日10,000〜12,499歩。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "대부분의 날에 훈련하거나 서기, 이동, 들기가 많은 직업.\n대략적인 기준: 하루 10,000–12,499보."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Training op de meeste dagen, of werk met veel staan, bewegen of tillen.\nRichtlijn: 10.000–12.499 stappen/dag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trening przez większość dni lub praca z częstym staniem, ruchem albo dźwiganiem.\nOrientacyjnie: 10 000–12 499 kroków dziennie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Treino na maioria dos dias, ou trabalho com bastante tempo em pé, movimento ou levantamento.\nReferência aproximada: 10.000–12.499 passos/dia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Antrenament în majoritatea zilelor, sau serviciu cu mult stat în picioare, mișcare ori ridicare.\nReper aproximativ: 10.000–12.499 de pași/zi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Тренировки почти каждый день или работа с частым стоянием, движением либо подъёмом тяжестей.\nПримерный ориентир: 10 000–12 499 шагов в день."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Тренування більшість днів або робота з тривалим стоянням, рухом чи фізичною працею.\nОрієнтир: 10 000–12 499 кроків на день."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "大多数天训练，或工作中需要大量站立、走动或搬抬。\n大致参考：每天 10,000–12,499 步。"
          }
        }
      }
