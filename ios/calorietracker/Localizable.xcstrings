          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La recuperación estará lista cuando el sueño de anoche se sincronice desde Apple Health."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
