    "Online AI uses %@. Page text is sent only when details are missing; images only for pages without text." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يستخدم الذكاء الاصطناعي عبر الإنترنت %@. يُرسَل نص الصفحة فقط عند نقص التفاصيل؛ والصور فقط للصفحات التي لا تحتوي على نص."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Onlayn Sİ %@ istifadə edir. Səhifə mətni yalnız təfərrüatlar çatışmadıqda göndərilir; şəkillər isə yalnız mətni olmayan səhifələr üçün."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Online AI používá %@. Text stránky se odesílá jen tehdy, když chybí podrobnosti; obrázky jen u stránek bez textu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Online-KI nutzt %@. Seitentext wird nur gesendet, wenn Details fehlen; Bilder nur für Seiten ohne Text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La IA en línea usa %@. El texto de las páginas solo se envía cuando faltan detalles; las imágenes, solo en páginas sin texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'IA en ligne utilise %@. Le texte des pages n'est envoyé que lorsque des détails manquent ; les images uniquement pour les pages sans texte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ऑनलाइन AI %@ का उपयोग करता है। पेज का टेक्स्ट केवल तब भेजा जाता है जब विवरण न मिलें; इमेज केवल बिना टेक्स्ट वाले पेजों के लिए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'IA online usa %@. Il testo della pagina viene inviato solo se mancano dettagli; le immagini solo per le pagine senza testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "オンラインAIは%@を使用します。ページのテキストは詳細が不足している場合にのみ送信され、画像はテキストのないページの場合にのみ送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "온라인 AI는 %@을(를) 사용해요. 페이지 텍스트는 세부 정보가 누락된 경우에만 전송되고, 이미지는 텍스트가 없는 페이지만 전송돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Online AI gebruikt %@. Paginatekst wordt alleen verstuurd als er details ontbreken; afbeeldingen alleen voor pagina's zonder tekst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "AI online korzysta z %@. Tekst strony jest wysyłany tylko wtedy, gdy brakuje szczegółów; obrazy tylko dla stron bez tekstu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A IA online usa %@. O texto da página só é enviado quando faltam detalhes; imagens, só para páginas sem texto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "AI online folosește %@. Textul paginilor se trimite doar când lipsesc detalii; imaginile doar pentru paginile fără text."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Онлайн-ИИ использует %@. Текст страницы отправляется только при нехватке сведений; изображения — только для страниц без текста."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Онлайн-ШІ використовує %@. Текст сторінки надсилається, лише коли бракує даних; зображення — лише для сторінок без тексту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在线 AI 使用 %@。仅在缺少详情时发送页面文字；仅对没有文字的页面发送图片。"
          }
        }
      }
    },
    "Only as-needed medicines can be logged this way." : {
