    "Data appears here after your iPhone or watch writes it to Apple Health and Ayuvo is allowed to read it (Health › Sharing › Apps › Ayuvo)." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تظهر البيانات هنا بعد أن يكتبها الـ iPhone أو الساعة في Apple Health ويُسمح لـ Ayuvo بقراءتها (الصحة › المشاركة › التطبيقات › Ayuvo)."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iPhone və ya saatınız məlumatları Apple Health-ə yazdıqdan və Ayuvo-ya onları oxumağa icazə verildikdən sonra (Sağlamlıq › Paylaşma › Tətbiqlər › Ayuvo) məlumatlar burada görünür."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Data se tu objeví, jakmile je tvůj iPhone nebo hodinky zapíšou do Apple Health a Ayuvo bude mít povoleno je číst (Zdraví › Sdílení › Aplikace › Ayuvo)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Daten erscheinen hier, nachdem dein iPhone oder deine Watch sie in Apple Health geschrieben hat und Ayuvo sie lesen darf (Health › Teilen › Apps › Ayuvo)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data appears here after your iPhone or watch writes it to Apple Health and Ayuvo is allowed to read it (Health › Sharing › Apps › Ayuvo)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los datos aparecen aquí cuando tu iPhone o reloj los escribe en Apple Health y Ayuvo tiene permiso para leerlos (Salud › Compartir › Apps › Ayuvo)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les données apparaissent ici après que votre iPhone ou votre montre les a écrites dans Apple Health et qu'Ayuvo est autorisé à les lire (Santé › Partage › Apps › Ayuvo)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "डेटा यहाँ तब दिखता है जब आपका iPhone या वॉच उसे Apple Health में लिखता है और Ayuvo को उसे पढ़ने की अनुमति होती है (Health › शेयरिंग › ऐप्स › Ayuvo)।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I dati compaiono qui dopo che il tuo iPhone o orologio li scrive in Apple Health e Ayuvo è autorizzato a leggerli (Salute › Condivisione › App › Ayuvo)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iPhoneまたはウォッチがApple Healthにデータを書き込み、Ayuvoに読み取りが許可されると（ヘルスケア › 共有 › App › Ayuvo）、ここにデータが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iPhone이나 워치가 Apple Health에 데이터를 기록하고 Ayuvo에 읽기 권한이 있으면(건강 › 공유 › 앱 › Ayuvo) 여기에 데이터가 표시돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gegevens verschijnen hier nadat je iPhone of horloge ze naar Apple Health heeft geschreven en Ayuvo ze mag lezen (Gezondheid › Deel › Apps › Ayuvo)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dane pojawią się tutaj, gdy iPhone lub zegarek zapisze je w Apple Health, a Ayuvo będzie mieć pozwolenie na ich odczyt (Zdrowie › Udostępnianie › Aplikacje › Ayuvo)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os dados aparecem aqui depois que seu iPhone ou relógio os grava no Apple Health e o Ayuvo tem permissão para lê-los (Saúde › Compartilhamento › Apps › Ayuvo)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Datele apar aici după ce iPhone-ul sau ceasul le scrie în Apple Health și Ayuvo are permisiunea să le citească (Sănătate › Partajare › Aplicații › Ayuvo)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Данные появятся здесь, после того как iPhone или часы запишут их в Apple Health и Ayuvo получит разрешение на чтение («Здоровье › Доступ › Приложения › Ayuvo»)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Дані з'являться тут після того, як ваш iPhone або годинник запише їх в Apple Health, а Ayuvo отримає дозвіл їх читати («Здоров'я» › Доступ › Програми › Ayuvo)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "当你的 iPhone 或手表将数据写入 Apple Health，并且 Ayuvo 获准读取后（健康 › 共享 › App › Ayuvo），数据将显示在这里。"
          }
        }
      }
    },
