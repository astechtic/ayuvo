    "Recovery is ready once last night's sleep has synced from Apple Health." : {
      "comment" : "Text displayed in a view when the recovery status is \"no_sleep\".",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
