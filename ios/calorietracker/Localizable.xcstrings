    "Temperature follows the length unit (metric → °C, imperial → °F). Values are stored in °C." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تتبع درجة الحرارة وحدة الطول (متري ← °C، إمبراطوري ← °F). تُخزَّن القيم بـ °C."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Temperatur uzunluq vahidinə uyğundur (metrik → °C, imperial → °F). Dəyərlər °C ilə saxlanılır."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Teplota se řídí jednotkou délky (metrické → °C, imperiální → °F). Hodnoty se ukládají v °C."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Temperatur folgt der Längeneinheit (metrisch → °C, imperial → °F). Werte werden in °C gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
