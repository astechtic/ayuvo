        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kan het niet afronden op basis van je antwoorden. Voeg het ontbrekende detail toe aan je beschrijving (bijvoorbeeld sets en herhalingen) of begin opnieuw."
