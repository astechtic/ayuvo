    "Both records stay saved. Only the link is removed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يبقى كلا السجلين محفوظين. تتم إزالة الربط فقط."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hər iki qeyd saxlanılır. Yalnız əlaqə silinir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oba záznamy zůstanou uložené. Odstraní se pouze propojení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beide Befunde bleiben gespeichert. Nur die Verknüpfung wird entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ambos registros se conservan. Solo se quita el vínculo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les deux dossiers restent enregistrés. Seul le lien est supprimé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "दोनों रिकॉर्ड सहेजे रहेंगे। केवल लिंक हटाया जाएगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entrambi i documenti restano salvati. Viene rimosso solo il collegamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "両方の記録は保存されたままです。リンクのみが解除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "두 기록 모두 저장된 상태로 유지돼요. 연결만 제거돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beide documenten blijven bewaard. Alleen de koppeling wordt verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oba rekordy pozostają zapisane. Usuwane jest tylko powiązanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os dois registros continuam salvos. Apenas o vínculo é removido."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ambele înregistrări rămân salvate. Se elimină doar legătura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Обе записи останутся сохранёнными. Удаляется только связь."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Обидва записи залишаться збереженими. Видаляється лише зв'язок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "两条档案都会保留，只会移除关联。"
          }
        }
      }
