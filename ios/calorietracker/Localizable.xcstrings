      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechna čtyři připomenutí jsou chytrá — ve dnech, kdy už máš zapsáno, se neozvou. Tělesný tuk je ve výchozím stavu vypnutý, protože ho většina lidí neměří denně."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti e quattro i promemoria sono intelligenti: non si attivano nei giorni in cui hai già registrato i dati. Quello per il grasso corporeo è disattivato di default poiché la maggior parte degli utenti non lo misura ogni giorno."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie cztery przypomnienia są inteligentne — nie uruchamiają się w dniach, w których masz już wpis. Domyślnie tkanka tłuszczowa jest wyłączona, bo większość użytkowników nie mierzy jej codziennie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все четыре напоминания умные — они не срабатывают в дни, когда вы уже внесли данные. Напоминание о жире отключено по умолчанию, так как большинство пользователей не измеряет его каждый день."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все четире напоминания умние — они не срабативают в дни, когда ви уже внесли данние. Напоминание о жире отключено по умолчанию, так как большинство пользователей не измеряет его каждий день."
          }
        }
      }
    },
