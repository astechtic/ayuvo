        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "लिफ़्टिंग के लिए सबसे अच्छा: आपके पास कितने रेप्स बाकी थे, उसके आधार पर प्रयास को रेट करें।"
