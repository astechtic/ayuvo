          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "पिछली रात की नींद Apple Health से सिंक होते ही रिकवरी तैयार हो जाती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
