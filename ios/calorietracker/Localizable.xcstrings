    "Your average %@ intake is %lld%% of the reference, and none of your supplements contain it." : {
      "comment" : "\"Your average iron intake is 12% of the reference.\"",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "متوسط مدخولك من %1$@ هو %2$lld%% من القيمة المرجعية، ولا يحتوي أي من مكمّلاتك عليه."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Orta %1$@ qəbulunuz istinad dəyərinin %2$lld%%-ni təşkil edir və əlavələrinizin heç birində bu yoxdur."
