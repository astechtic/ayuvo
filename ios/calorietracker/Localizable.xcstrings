        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इस iPhone की सेटिंग्स, प्रोफ़ाइल, भोजन डायरी, पानी, वज़न, वर्कआउट, उपवास और भोजन की फ़ोटो को फ़ाइल में मौजूद डेटा से बदल देता है।"
