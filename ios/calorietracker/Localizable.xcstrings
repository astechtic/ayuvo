        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "식사가 기록되지는 않아요. %@을(를) 기록했을 때 오늘이 어떻게 보일지 보여줘요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hiermee wordt de maaltijd niet gelogd. Je ziet hoe vandaag eruit zou zien als je %@ logt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
