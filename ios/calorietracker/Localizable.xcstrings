    "Times your workout so calories and heart rate use its real start and end" : {
      "comment" : "A hint for the user that times are automatically set for the workout.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يوقّت تمرينك لكي تستخدم السعرات الحرارية ومعدل ضربات القلب وقت بدايته ونهايته الفعليين"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kalori və ürək döyüntüsünün real başlanğıc və bitiş vaxtından istifadə etməsi üçün məşqinizin vaxtını ölçür"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Změří čas tréninku, aby kalorie a tepová frekvence vycházely z jeho skutečného začátku a konce"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Misst die Zeit deines Trainings, damit Kalorien und Herzfrequenz den echten Start und das echte Ende nutzen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cronometra tu entrenamiento para que las calorías y la frecuencia cardíaca usen su inicio y fin reales"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chronomètre votre entraînement pour que les calories et la fréquence cardiaque utilisent ses heures réelles de début et de fin"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपके वर्कआउट का समय मापता है ताकि कैलोरी और हृदय गति उसकी असली शुरुआत और अंत का उपयोग करें"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cronometra l'allenamento così calorie e frequenza cardiaca usano l'inizio e la fine reali"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ワークアウトの時間を計測し、カロリーと心拍数に実際の開始・終了時刻を使います"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "칼로리와 심박수가 실제 시작 및 종료 시각을 사용하도록 운동 시간을 기록해요"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Registreert de tijden van je training zodat calorieën en hartslag de echte start en het echte einde gebruiken"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mierzy czas treningu, aby kalorie i tętno uwzględniały jego rzeczywisty początek i koniec"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cronometra seu treino para que as calorias e a frequência cardíaca usem o início e o fim reais"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
