        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kdybych mohl(a) tento měsíc změnit jen jeden zvyk, který by to podle mých dat měl být?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wenn ich diesen Monat nur eine Gewohnheit ändern könnte, welche sollte es laut meinen Daten sein?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si solo pudiera cambiar un hábito este mes, ¿cuál debería ser según mis datos?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si je ne pouvais changer qu'une seule habitude ce mois-ci, laquelle mes données recommandent-elles ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अगर मैं इस महीने सिर्फ़ एक आदत बदल सकूँ, तो मेरा डेटा कहता है कि वह कौन-सी होनी चाहिए?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se potessi cambiare una sola abitudine questo mese, quale dovrebbe essere secondo i miei dati?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "今月ひとつだけ習慣を変えるとしたら、データからはどれを変えるべきだと言えますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이번 달에 습관 하나만 바꿀 수 있다면, 내 데이터로 보면 어떤 습관이어야 할까?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Als ik deze maand maar één gewoonte kon veranderen, welke zou dat volgens mijn gegevens moeten zijn?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jeśli w tym miesiącu mogę zmienić tylko jeden nawyk, który to powinien być według moich danych?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se eu pudesse mudar apenas um hábito este mês, qual deveria ser, segundo meus dados?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dacă aș putea schimba un singur obicei luna aceasta, care ar trebui să fie, conform datelor mele?"
