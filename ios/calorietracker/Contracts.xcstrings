        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "शरीर के वज़न के प्रति किलोग्राम आपके द्वारा लॉग किया गया प्रोटीन। प्रतिदिन 1.4-2.0 g/kg स्ट्रेंथ ट्रेनिंग में मदद करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Proteine registrate per chilogrammo di peso corporeo. 1,4-2,0 g/kg al giorno supportano l'allenamento di forza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "体重1キログラムあたりの記録したタンパク質です。1日1.4〜2.0 g/kgが筋トレをサポートします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "체중 1킬로그램당 기록한 단백질이에요. 하루 1.4-2.0 g/kg은 근력 운동에 도움이 돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eiwit dat je hebt gelogd per kilogram lichaamsgewicht. 1,4-2,0 g/kg per dag ondersteunt krachttraining."
