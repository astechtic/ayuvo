          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "최근 14일 중 기록된 밤에 대한 Σ max(0, 필요량 − 수면 시간). 필요량 기본값은 8시간이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Σ max(0, behoefte − slaaptijd) over geregistreerde nachten in de laatste 14 dagen. Behoefte is standaard 8 uur."
          }
        },
        "pl" : {
