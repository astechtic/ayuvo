    "derived.metrics.phone_left_behind.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الخطوات التي احتسبها جهازك القابل للارتداء بينما لم يحتسب هاتفك أي خطوات تقريبًا، مثلًا عندما بقي الهاتف في المنزل."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Telefonunuz demək olar ki, heç nə saymadığı halda taxılan cihazınızın saydığı addımlar, məsələn, telefon evdə qaldıqda."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kroky, které napočítalo tvé nositelné zařízení, zatímco telefon nenapočítal téměř žádné, například když telefon zůstal doma."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Schritte, die dein Wearable gezählt hat, während dein Handy fast keine gezählt hat, zum Beispiel wenn das Handy zu Hause geblieben ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steps your wearable counted while your phone counted almost none, for example when the phone stayed at home."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pasos que contó tu wearable mientras tu teléfono no contó casi ninguno, por ejemplo cuando el teléfono se quedó en casa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pas comptés par votre appareil connecté alors que votre téléphone n'en a compté presque aucun, par exemple quand le téléphone est resté à la maison."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "वे कदम जो आपके वियरेबल ने गिने जबकि आपके फ़ोन ने लगभग कोई नहीं गिने, उदाहरण के लिए जब फ़ोन घर पर रह गया।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Passi contati dal tuo dispositivo indossabile mentre il telefono non ne contava quasi nessuno, ad esempio quando il telefono è rimasto a casa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "スマホがほとんど歩数を数えていない間にウェアラブルが数えた歩数です。たとえばスマホを家に置いていた場合などです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "휴대폰이 거의 걸음을 세지 않은 동안 웨어러블이 센 걸음 수예요. 예를 들어 휴대폰을 집에 두고 나간 경우예요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stappen die je wearable telde terwijl je telefoon er bijna geen telde, bijvoorbeeld als je telefoon thuis lag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kroki policzone przez urządzenie noszone, gdy telefon nie policzył prawie żadnych, np. gdy telefon został w domu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Passos que seu wearable contou enquanto o celular não contou quase nenhum, por exemplo, quando o celular ficou em casa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pași numărați de dispozitivul purtabil în timp ce telefonul nu a numărat aproape niciunul, de exemplu când telefonul a rămas acasă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Шаги, которые насчитало носимое устройство, когда телефон почти ничего не насчитал, например если телефон оставался дома."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Кроки, які порахував ваш носимий пристрій, коли телефон не порахував майже жодного, наприклад якщо телефон залишився вдома."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你的可穿戴设备计了步数而手机几乎没有计步的步数，例如手机留在家中时。"
          }
        }
      }
    },
