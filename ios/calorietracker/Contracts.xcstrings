        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu frecuencia cardíaca mientras estás quieto sentado durante el día (09:00-21:00), cuando no has dado ningún paso durante al menos 10 minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Votre fréquence cardiaque lorsque vous êtes immobile pendant la journée (09:00-21:00), sans avoir fait de pas pendant au moins 10 minutes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "दिन में (09:00-21:00) स्थिर बैठे रहने पर आपकी हृदय गति, जब आपने कम से कम 10 मिनट तक कोई कदम नहीं चला।"
