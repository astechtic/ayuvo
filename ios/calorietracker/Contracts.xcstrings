    "derived.metrics.resting_hr_derived.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أدنى معدل ثابت لضربات قلبك أثناء النوم، مُقدَّر من معدل ضربات القلب دقيقة بدقيقة عندما لا يوفّر جهازك معدل ضربات القلب أثناء الراحة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cihazınız istirahət ürək döyüntüsünü təqdim etmədikdə, dəqiqəbədəqiqə ürək döyüntüsündən təxmin edilən, yuxuda ən aşağı sabit ürək döyüntünüz."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tvá nejnižší ustálená tepová frekvence ve spánku, odhadnutá z tepové frekvence minutu po minutě, když tvé zařízení klidovou tepovou frekvenci neposkytuje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deine niedrigste stabile Herzfrequenz im Schlaf, geschätzt aus der minütlichen Herzfrequenz, wenn dein Gerät keine Ruheherzfrequenz liefert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your lowest steady heart rate while asleep, estimated from minute-by-minute heart rate when your device does not provide a resting heart rate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu frecuencia cardíaca estable más baja mientras duermes, estimada a partir de la frecuencia cardíaca minuto a minuto cuando tu dispositivo no proporciona una frecuencia cardíaca en reposo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Votre fréquence cardiaque stable la plus basse pendant le sommeil, estimée à partir de la fréquence cardiaque minute par minute lorsque votre appareil ne fournit pas de fréquence cardiaque au repos."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "नींद के दौरान आपकी सबसे कम स्थिर हृदय गति, जिसका अनुमान मिनट-दर-मिनट हृदय गति से तब लगाया जाता है जब आपका डिवाइस विश्राम हृदय गति नहीं देता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La tua frequenza cardiaca stabile più bassa durante il sonno, stimata dalla frequenza cardiaca minuto per minuto quando il tuo dispositivo non fornisce una frequenza cardiaca a riposo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "デバイスが安静時心拍数を提供しない場合に、1分ごとの心拍数から推定した、睡眠中の安定した最低心拍数です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "기기가 안정 시 심박수를 제공하지 않을 때 분 단위 심박수로 추정한, 수면 중 가장 낮고 안정적인 심박수예요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je laagste stabiele hartslag tijdens je slaap, geschat uit je hartslag per minuut als je apparaat geen hartslag in rust geeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Twoje najniższe stabilne tętno podczas snu, oszacowane z tętna minuta po minucie, gdy Twoje urządzenie nie podaje tętna spoczynkowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sua frequência cardíaca estável mais baixa durante o sono, estimada a partir da frequência cardíaca minuto a minuto quando seu dispositivo não fornece a frequência cardíaca em repouso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
