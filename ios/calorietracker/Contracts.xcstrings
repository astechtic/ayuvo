    "derived.metrics.deep_sleep_pct.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "نسبة النوم التي قضيتها في النوم العميق. يقضي البالغون عادةً نحو 13-23%."
          }
        },
        "az" : {
          "stringUnit" : {
