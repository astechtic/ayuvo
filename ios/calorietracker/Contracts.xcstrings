        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anteil des Schlafs im Tiefschlaf. Erwachsene verbringen meist etwa 13–23 % darin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share of sleep spent in deep sleep. Adults usually spend about 13-23%."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Proporción del sueño en fase de sueño profundo. Los adultos suelen pasar alrededor de un 13-23 %."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Part du sommeil passée en sommeil profond. Les adultes y passent généralement environ 13-23 %."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "नींद का वह हिस्सा जो गहरी नींद में बीता। वयस्क आमतौर पर लगभग 13-23% बिताते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Percentuale del sonno trascorsa in sonno profondo. Gli adulti di solito ne trascorrono circa il 13-23%."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "睡眠のうち深い睡眠の割合です。成人では通常約13〜23%です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "전체 수면 중 깊은 수면의 비율이에요. 성인은 보통 약 13-23%예요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deel van je slaap in diepe slaap. Volwassenen zitten meestal rond 13-23%."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odsetek snu przypadający na sen głęboki. Dorośli zwykle mają go ok. 13-23%."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Parcela do sono passada em sono profundo. Adultos costumam passar cerca de 13-23%."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Proporția din somn petrecută în somn profund. Adulții petrec de obicei circa 13-23%."
          }
        },
        "ru" : {
          "stringUnit" : {
