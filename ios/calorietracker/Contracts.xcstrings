    "insights.methodology.health_age.sections.1.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VO₂max بنسبة 25%، ومعدل ضربات القلب أثناء الراحة 15%، وتقلب معدل ضربات القلب 15%، والخطوات اليومية 15%، والنوم 15%، وانتظام التمارين 10%، وتكوين الجسم 5%. يستخدم كل مؤشر متوسطك خلال آخر 90 يومًا."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VO2 max 25%, istirahət ürək döyüntüsü 15%, ürək döyüntüsü dəyişkənliyi 15%, gündəlik addımlar 15%, yuxu 15%, məşq ardıcıllığı 10% və bədən tərkibi 5%. Hər göstərici son 90 gündəki ortalamanızdan istifadə edir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VO2 max 25 %, klidová tepová frekvence 15 %, variabilita srdeční frekvence 15 %, denní kroky 15 %, spánek 15 %, pravidelnost tréninků 10 % a složení těla 5 %. Každý ukazatel používá tvůj průměr za posledních 90 dní."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VO₂max 25 %, Ruheherzfrequenz 15 %, Herzfrequenzvariabilität 15 %, tägliche Schritte 15 %, Schlaf 15 %, Trainingsregelmäßigkeit 10 % und Körperzusammensetzung 5 %. Jeder Marker nutzt deinen Durchschnitt der letzten 90 Tage."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO2 max 25%, resting heart rate 15%, heart rate variability 15%, daily steps 15%, sleep 15%, workout consistency 10% and body composition 5%. Each marker uses your average over the last 90 days."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VO₂max 25 %, frecuencia cardíaca en reposo 15 %, variabilidad de la frecuencia cardíaca 15 %, pasos diarios 15 %, sueño 15 %, constancia en los entrenamientos 10 % y composición corporal 5 %. Cada marcador usa tu promedio de los últimos 90 días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VO2 max 25 %, fréquence cardiaque au repos 15 %, variabilité de la fréquence cardiaque 15 %, pas quotidiens 15 %, sommeil 15 %, régularité des entraînements 10 % et composition corporelle 5 %. Chaque marqueur utilise votre moyenne des 90 derniers jours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VO2 max 25%, विश्राम हृदय गति 15%, हृदय गति परिवर्तनशीलता 15%, दैनिक कदम 15%, नींद 15%, वर्कआउट नियमितता 10% और शरीर की संरचना 5%। हर मार्कर पिछले 90 दिनों के आपके औसत का उपयोग करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VO₂max 25%, frequenza cardiaca a riposo 15%, variabilità della frequenza cardiaca 15%, passi giornalieri 15%, sonno 15%, costanza negli allenamenti 10% e composizione corporea 5%. Ogni indicatore usa la tua media degli ultimi 90 giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VO2 max 25%、安静時心拍数15%、心拍変動15%、1日の歩数15%、睡眠15%、ワークアウトの継続性10%、体組成5%。各指標には過去90日間の平均を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VO₂max 25%, 안정 시 심박수 15%, 심박 변이도 15%, 일일 걸음 수 15%, 수면 15%, 운동 꾸준함 10%, 체성분 5%. 각 지표는 최근 90일 평균을 사용해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VO2 max 25%, hartslag in rust 15%, hartslagvariabiliteit 15%, dagelijkse stappen 15%, slaap 15%, trainingsregelmaat 10% en lichaamssamenstelling 5%. Elke marker gebruikt je gemiddelde over de laatste 90 dagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VO₂max 25%, tętno spoczynkowe 15%, zmienność rytmu serca 15%, dzienne kroki 15%, sen 15%, regularność treningów 10% i skład ciała 5%. Każdy wskaźnik wykorzystuje Twoją średnią z ostatnich 90 dni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VO₂max 25%, frequência cardíaca em repouso 15%, variabilidade da frequência cardíaca 15%, passos diários 15%, sono 15%, regularidade dos treinos 10% e composição corporal 5%. Cada marcador usa sua média dos últimos 90 dias."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VO₂max 25%, puls în repaus 15%, variabilitatea ritmului cardiac 15%, pași zilnici 15%, somn 15%, constanța antrenamentelor 10% și compoziție corporală 5%. Fiecare marker folosește media ta din ultimele 90 de zile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VO₂max 25%, пульс в покое 15%, вариабельность пульса 15%, шаги за день 15%, сон 15%, регулярность тренировок 10% и состав тела 5%. Для каждого маркера используется ваше среднее за последние 90 дней."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VO₂max 25%, пульс у спокої 15%, варіабельність серцевого ритму 15%, щоденні кроки 15%, сон 15%, регулярність тренувань 10% і склад тіла 5%. Кожен маркер використовує ваше середнє за останні 90 днів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
