    "derived.metrics.social_jetlag.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مقدار تأخّر نومك في عطلات نهاية الأسبوع مقارنةً بأيام الأسبوع. الأفضل أقل من ساعة واحدة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Həftəsonları iş günlərinə nisbətən nə qədər gec yatdığınız. 1 saatdan az olması ən yaxşısıdır."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O kolik později spíš o víkendech než ve všední dny. Nejlepší je méně než 1 hodina."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wie viel später du am Wochenende schläfst als an Wochentagen. Unter 1 Stunde ist am besten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How much later you sleep on weekends than on weekdays. Under 1 hour is best."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuánto más tarde duermes los fines de semana que entre semana. Menos de 1 hora es lo ideal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De combien vous dormez plus tard le week-end qu'en semaine. Moins d'une heure est idéal."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सप्ताह के दिनों की तुलना में सप्ताहांत पर आप कितनी देर से सोते हैं। 1 घंटे से कम सबसे अच्छा है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quanto più tardi dormi nel fine settimana rispetto ai giorni feriali. Meno di 1 ora è l'ideale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "平日と比べて週末にどれだけ遅く寝ているかを示します。1時間未満が理想です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "주말에 평일보다 얼마나 늦게 자는지 보여줘요. 1시간 미만이 가장 좋아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hoeveel later je in het weekend slaapt dan op doordeweekse dagen. Minder dan 1 uur is het best."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O ile później śpisz w weekendy niż w dni robocze. Najlepiej poniżej 1 godziny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quanto mais tarde você dorme nos fins de semana do que nos dias úteis. Menos de 1 hora é o ideal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cu cât mai târziu dormi în weekend față de zilele lucrătoare. Sub 1 oră este cel mai bine."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Насколько позже вы спите в выходные, чем в будни. Лучше всего — менее 1 часа."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Наскільки пізніше ви спите у вихідні, ніж у будні. Найкраще — менше ніж 1 година."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你周末比工作日晚睡多少。低于 1 小时为佳。"
          }
        }
      }
    },
    "derived.metrics.social_jetlag.method" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "|متوسط منتصف النوم في ليالي العطلة (الاستيقاظ يوم السبت أو الأحد) − في ليالي العمل|. يتطلب ليلتي عطلة و3 ليالي عمل خلال 14 يومًا."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "|Sərbəst gecələrdə (şənbə və ya bazar oyanışı) yuxunun orta nöqtəsinin ortalaması − iş gecələrində|. 14 gündə 2 sərbəst və 3 iş gecəsi tələb olunur."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "|Průměrný střed spánku ve volných nocích (probuzení v sobotu nebo neděli) − v pracovních nocích|. Vyžaduje 2 volné a 3 pracovní noci za 14 dní."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "|Mittlerer Schlafmittelpunkt in freien Nächten (Aufwachen am Samstag oder Sonntag) − in Arbeitsnächten|. Erfordert 2 freie und 3 Arbeitsnächte in 14 Tagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "|Mean sleep midpoint on free nights (waking Saturday or Sunday) − on work nights|. Needs 2 free and 3 work nights in 14 days."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "|Punto medio del sueño medio en noches libres (despertando sábado o domingo) − en noches laborables|. Requiere 2 noches libres y 3 laborables en 14 días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "|Milieu du sommeil moyen les nuits libres (réveil le samedi ou le dimanche) − les nuits de travail|. Nécessite 2 nuits libres et 3 nuits de travail sur 14 jours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "|छुट्टी वाली रातों (शनिवार या रविवार को जागना) में नींद का औसत मध्य बिंदु − काम वाली रातों में|। 14 दिनों में 2 छुट्टी वाली और 3 काम वाली रातें चाहिए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "|Punto medio del sonno medio nelle notti libere (risveglio di sabato o domenica) − nelle notti lavorative|. Richiede 2 notti libere e 3 lavorative in 14 giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "|休日の夜（土曜または日曜に起床）の睡眠の中間時刻の平均 − 勤務日の夜の平均|。14日間に休日の夜2回と勤務日の夜3回が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "|자유로운 밤(토요일 또는 일요일 기상)의 평균 수면 중간점 − 근무일 밤의 평균 수면 중간점|. 14일 중 자유로운 밤 2일과 근무일 밤 3일이 필요해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "|Gemiddeld slaapmiddelpunt op vrije nachten (wakker worden op zaterdag of zondag) − op werknachten|. Vereist 2 vrije en 3 werknachten in 14 dagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "|Średni środek snu w wolne noce (pobudka w sobotę lub niedzielę) − w noce robocze|. Wymaga 2 wolnych i 3 roboczych nocy w ciągu 14 dni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "|Ponto médio do sono nas noites livres (acordando no sábado ou domingo) − nas noites de trabalho|. Requer 2 noites livres e 3 de trabalho em 14 dias."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "|Mijlocul mediu al somnului în nopțile libere (trezire sâmbăta sau duminica) − în nopțile de lucru|. Necesită 2 nopți libere și 3 nopți de lucru în 14 zile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "|Средняя середина сна в свободные ночи (с пробуждением в субботу или воскресенье) − в рабочие ночи|. Нужно 2 свободные и 3 рабочие ночи за 14 дней."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "|Середня середина сну у вільні ночі (пробудження в суботу чи неділю) − у робочі ночі|. Потрібно 2 вільні й 3 робочі ночі за 14 днів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "|休息日夜晚（周六或周日醒来）的平均睡眠中点 − 工作日夜晚的平均睡眠中点|。14 天内需要 2 个休息日夜晚和 3 个工作日夜晚。"
          }
        }
      }
    },
