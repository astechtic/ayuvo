    "insights.methodology.daily_review.sections.2.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "التغذية: السعرات ضمن 10% من هدفك، والبروتين عند 90% أو أكثر من هدفك، والألياف عند هدفك، والكربوهيدرات والدهون ضمن 20% من الهدف. الترطيب والخطوات: التقدم نحو أهدافك. التدريب: تمرين، أو يوم راحة بعد يوم شاق. النوم: الليلة الماضية مقارنةً بـ 7 ساعات. التعافي: نتيجة هذا الصباح."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Qidalanma: kalorilər hədəfinizin 10%⁠-i daxilində, protein hədəfinizin 90%⁠-i və ya daha çox, lif hədəfinizdə, karbohidrat və yağ hədəfin 20%⁠-i daxilində. Hidratasiya və addımlar: hədəflərinizə doğru irəliləyiş. Məşq: məşq və ya ağır gündən sonra istirahət günü. Yuxu: keçən gecə 7 saatla müqayisədə. Bərpa: bu səhərki göstərici."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Výživa: kalorie do 10 % od tvého cíle, bílkoviny na 90 % cíle nebo víc, vláknina na cíli a sacharidy i tuky do 20 % od cíle. Hydratace a kroky: pokrok k tvým cílům. Trénink: trénink, nebo den odpočinku po náročném dni. Spánek: minulá noc v porovnání se 7 hodinami. Regenerace: dnešní ranní skóre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ernährung: Kalorien innerhalb von 10 % deines Ziels, Protein bei 90 % oder mehr deines Ziels, Ballaststoffe beim Ziel sowie Kohlenhydrate und Fett innerhalb von 20 % des Ziels. Flüssigkeit und Schritte: Fortschritt zu deinen Zielen. Training: ein Training oder ein Ruhetag nach einem harten Tag. Schlaf: letzte Nacht im Vergleich zu 7 Stunden. Erholung: der Wert von heute Morgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutrition: calories within 10% of your target, protein at 90% or more of your target, fiber at your goal and carbs and fat within 20% of target. Hydration and steps: progress toward your goals. Training: a workout, or a rest day after a hard day. Sleep: last night compared with 7 hours. Recovery: this morning's score."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nutrición: calorías dentro del 10 % de tu objetivo, proteína al 90 % o más de tu objetivo, fibra en tu objetivo y carbohidratos y grasas dentro del 20 % del objetivo. Hidratación y pasos: progreso hacia tus objetivos. Entrenamiento: un entrenamiento, o un día de descanso tras un día intenso. Sueño: la noche anterior comparada con 7 horas. Recuperación: la puntuación de esta mañana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nutrition : calories à 10 % près de votre objectif, protéines à 90 % ou plus de votre objectif, fibres à votre objectif et glucides et lipides à 20 % près de l'objectif. Hydratation et pas : progression vers vos objectifs. Entraînement : une séance, ou un jour de repos après une journée intense. Sommeil : la nuit dernière comparée à 7 heures. Récupération : le score de ce matin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "पोषण: कैलोरी आपके लक्ष्य के 10% के भीतर, प्रोटीन आपके लक्ष्य का 90% या अधिक, फ़ाइबर आपके लक्ष्य पर और कार्ब्स व फैट लक्ष्य के 20% के भीतर। हाइड्रेशन और कदम: आपके लक्ष्यों की ओर प्रगति। ट्रेनिंग: एक वर्कआउट, या कठिन दिन के बाद आराम का दिन। नींद: पिछली रात की तुलना 7 घंटे से। रिकवरी: आज सुबह का स्कोर।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nutrizione: calorie entro il 10% dell'obiettivo, proteine al 90% o più dell'obiettivo, fibre all'obiettivo e carboidrati e grassi entro il 20% dell'obiettivo. Idratazione e passi: progressi verso i tuoi obiettivi. Allenamento: un allenamento, oppure un giorno di riposo dopo una giornata intensa. Sonno: la notte scorsa rispetto a 7 ore. Recupero: il punteggio di stamattina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "栄養：カロリーが目標の10%以内、タンパク質が目標の90%以上、食物繊維が目標どおり、炭水化物と脂質が目標の20%以内。水分補給と歩数：目標に対する進捗。トレーニング：ワークアウト、またはハードな日の翌日の休養日。睡眠：昨夜の睡眠を7時間と比較。リカバリー：今朝のスコア。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "영양: 칼로리가 목표의 10% 이내, 단백질이 목표의 90% 이상, 식이섬유가 목표 달성, 탄수화물과 지방이 목표의 20% 이내. 수분 섭취 및 걸음 수: 목표 달성 진행률. 운동: 운동 또는 힘든 날 다음의 휴식일. 수면: 지난밤을 7시간과 비교. 회복: 오늘 아침 점수."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voeding: calorieën binnen 10% van je doel, eiwit op 90% of meer van je doel, vezels op je doel en koolhydraten en vet binnen 20% van het doel. Hydratatie en stappen: voortgang richting je doelen. Training: een training, of een rustdag na een zware dag. Slaap: afgelopen nacht vergeleken met 7 uur. Herstel: de score van vanochtend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odżywianie: kalorie w granicach 10% celu, białko na poziomie 90% celu lub więcej, błonnik na poziomie celu, a węglowodany i tłuszcz w granicach 20% celu. Nawodnienie i kroki: postęp względem celów. Trening: trening lub dzień przerwy po ciężkim dniu. Sen: ostatnia noc w porównaniu z 7 godzinami. Regeneracja: dzisiejszy poranny wynik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nutrição: calorias a até 10% da sua meta, proteína em 90% ou mais da sua meta, fibras na sua meta e carboidratos e gordura a até 20% da meta. Hidratação e passos: progresso em direção às suas metas. Treino: um treino ou um dia de descanso depois de um dia pesado. Sono: a noite passada comparada com 7 horas. Recuperação: a pontuação desta manhã."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nutriție: calorii în limita a 10% față de țintă, proteine la 90% sau mai mult din țintă, fibre la nivelul obiectivului, iar carbohidrații și grăsimile în limita a 20% față de țintă. Hidratare și pași: progresul spre obiective. Antrenament: un antrenament sau o zi de pauză după o zi grea. Somn: noaptea trecută comparată cu 7 ore. Recuperare: scorul de azi-dimineață."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Питание: калории в пределах 10% от цели, белки не менее 90% от цели, клетчатка на уровне цели, углеводы и жиры в пределах 20% от цели. Водный баланс и шаги: прогресс к вашим целям. Тренировки: тренировка или день отдыха после тяжёлого дня. Сон: прошлая ночь в сравнении с 7 часами. Восстановление: утренняя оценка."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Харчування: калорії в межах 10% від мети, білок — 90% мети або більше, клітковина на рівні мети, вуглеводи й жири в межах 20% від мети. Гідратація і кроки: прогрес до ваших цілей. Тренування: тренування або день відпочинку після важкого дня. Сон: минула ніч порівняно з 7 годинами. Відновлення: оцінка цього ранку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "营养：卡路里在目标的 10% 以内，蛋白质达到目标的 90% 或以上，纤维达到目标，碳水和脂肪在目标的 20% 以内。饮水和步数：朝目标的进度。训练：完成一次训练，或在高强度训练日后休息。睡眠：昨晚与 7 小时比较。恢复：今天早晨的分数。"
          }
        }
      }
    },
