    "cycle.insights.late.template" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تأخرت دورتك الشهرية {days} يومًا عن الموعد المقدَّر. قد تتغيّر الدورات لأسباب كثيرة؛ يُستحسن التحدث مع مختص رعاية صحية إذا تكرر ذلك أو أقلقك."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aybaşınız təxmin ediləndən {days} gün gecikir. Dövrlər bir çox səbəbdən dəyişə bilər; bu təkrarlanarsa və ya sizi narahat edərsə, tibb mütəxəssisi ilə danışmağı düşünün."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menstruace je o {days} dní později, než bylo odhadnuto. Cykly se mohou posunout z mnoha důvodů; pokud se to opakuje nebo tě to znepokojuje, zvaž konzultaci se zdravotníkem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deine Periode ist {days} Tage später als geschätzt. Zyklen können sich aus vielen Gründen verschieben; sprich mit medizinischem Fachpersonal, wenn das öfter vorkommt oder dich beunruhigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your period is {days} days later than estimated. Cycles can shift for many reasons; consider talking with a healthcare professional if this keeps happening or worries you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu periodo lleva {days} días de retraso respecto a lo estimado. Los ciclos pueden cambiar por muchas razones; considera hablar con un profesional sanitario si esto se repite o te preocupa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vos règles ont {days} jours de retard par rapport à l’estimation. Les cycles peuvent varier pour de nombreuses raisons ; pensez à en parler à un professionnel de santé si cela se reproduit ou vous inquiète."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपका पीरियड अनुमान से {days} दिन देर से है। चक्र कई कारणों से आगे-पीछे हो सकते हैं; अगर ऐसा बार-बार हो या आपको चिंता हो, तो किसी स्वास्थ्य विशेषज्ञ से बात करने पर विचार करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le mestruazioni sono in ritardo di {days} giorni rispetto alla stima. I cicli possono variare per molti motivi; valuta di parlarne con un professionista sanitario se succede spesso o ti preoccupa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "生理が予測より{days}日遅れています。周期はさまざまな理由でずれることがあります。繰り返す場合や気になる場合は、医療専門家への相談を検討してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "생리가 예상보다 {days}일 늦어지고 있습니다. 주기는 여러 이유로 달라질 수 있으니, 계속 반복되거나 걱정된다면 의료 전문가와 상담해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je menstruatie is {days} dagen later dan geschat. Cycli kunnen om veel redenen verschuiven; overweeg met een zorgverlener te praten als dit vaker gebeurt of je zorgen baart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Miesiączka spóźnia się o {days} dni względem szacunku. Cykle mogą się przesuwać z wielu powodów; rozważ rozmowę z pracownikiem ochrony zdrowia, jeśli to się powtarza lub cię niepokoi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sua menstruação está {days} dias atrasada em relação à estimativa. Os ciclos podem mudar por vários motivos; considere conversar com um profissional de saúde se isso continuar acontecendo ou se preocupar você."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menstruația ta întârzie cu {days} zile față de estimare. Ciclurile se pot schimba din multe motive; ia în considerare o discuție cu un profesionist din domeniul sănătății dacă situația se repetă sau te îngrijorează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Менструация задерживается на {days} дн. относительно прогноза. Цикл может смещаться по многим причинам; если это повторяется или беспокоит вас, стоит обсудить это с медицинским специалистом."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Менструація затримується на {days} дн. відносно прогнозу. Цикл може зміщуватися з багатьох причин; якщо це повторюється або турбує вас, варто обговорити це з медичним фахівцем."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你的经期比预估晚了 {days} 天。周期可能因多种原因而变化；如果这种情况持续发生或让你担心，可以考虑咨询医疗专业人士。"
          }
        }
      }
    },
    "cycle.insights.long_period.template" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "استمرت دورتك الشهرية الأخيرة {days} يومًا. إذا استمرت الدورات الطويلة أو أقلقتك، يُستحسن مناقشتها مع مختص رعاية صحية."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Son aybaşınız {days} gün davam edib. Uzun aybaşılar davam edərsə və ya sizi narahat edərsə, bunu tibb mütəxəssisi ilə müzakirə etməyi düşünün."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Poslední menstruace trvala {days} dní. Pokud dlouhé menstruace pokračují nebo tě znepokojují, zvaž konzultaci se zdravotníkem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
