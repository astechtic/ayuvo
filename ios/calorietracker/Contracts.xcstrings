    "insights.methodology.health_age.sections.0.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "العمر الصحي من Ayuvo هو تقدير Ayuvo الخاص لمدى مقارنة عاداتك الأخيرة ومؤشرات لياقتك بالقيم السكانية المنشورة. وهو ليس عمرًا سريريًا أو بيولوجيًا، وليس نتيجة WHOOP أو أي شركة أخرى."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo Sağlamlıq yaşı son vərdişlərinizin və fiziki forma göstəricilərinizin dərc olunmuş əhali dəyərləri ilə necə müqayisə olunduğuna dair Ayuvo-nun öz təxminidir. Bu, klinik və ya bioloji yaş deyil və WHOOP-un və ya hər hansı digər şirkətin göstəricisi deyil."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zdravotní věk Ayuvo je vlastní odhad Ayuvo, jak si tvé nedávné návyky a ukazatele kondice stojí v porovnání s publikovanými populačními hodnotami. Nejde o klinický ani biologický věk a nejde o skóre WHOOP ani žádné jiné společnosti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Ayuvo-Gesundheitsalter ist Ayuvos eigene Schätzung, wie deine jüngsten Gewohnheiten und Fitnessmarker im Vergleich zu veröffentlichten Bevölkerungswerten abschneiden. Es ist kein klinisches oder biologisches Alter und nicht der Wert von WHOOP oder einem anderen Unternehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo Health Age is Ayuvo's own estimate of how your recent habits and fitness markers compare with published population values. It is not a clinical or biological age, and it is not WHOOP's or any other company's score."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La Edad de salud de Ayuvo es la estimación propia de Ayuvo de cómo se comparan tus hábitos recientes y tus marcadores de forma física con los valores de población publicados. No es una edad clínica ni biológica, ni es la puntuación de WHOOP ni de ninguna otra empresa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'Âge santé Ayuvo est une estimation propre à Ayuvo de la façon dont vos habitudes récentes et vos marqueurs de forme se comparent aux valeurs de population publiées. Ce n'est pas un âge clinique ou biologique, ni le score de WHOOP ou d'une autre entreprise."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo हेल्थ एज Ayuvo का अपना अनुमान है कि आपकी हाल की आदतें और फिटनेस मार्कर प्रकाशित जनसंख्या मानों से कैसे तुलना करते हैं। यह क्लिनिकल या जैविक आयु नहीं है, और यह WHOOP या किसी अन्य कंपनी का स्कोर नहीं है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'Età della salute di Ayuvo è una stima di Ayuvo di come le tue abitudini recenti e i tuoi indicatori di forma fisica si confrontano con valori pubblicati della popolazione. Non è un'età clinica o biologica e non è il punteggio di WHOOP né di altre aziende."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo健康年齢は、最近の習慣やフィットネス指標が公表されている集団の値と比べてどうかを、Ayuvoが独自に推定したものです。臨床的・生物学的な年齢ではなく、WHOOPやその他の企業のスコアでもありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo 건강 나이는 최근 습관과 체력 지표가 공개된 인구 집단 값과 어떻게 비교되는지에 대한 Ayuvo 자체 추정치예요. 임상적 또는 생물학적 나이가 아니며, WHOOP이나 다른 회사의 점수도 아니에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo-gezondheidsleeftijd is Ayuvo's eigen schatting van hoe je recente gewoonten en conditiemarkers zich verhouden tot gepubliceerde bevolkingswaarden. Het is geen klinische of biologische leeftijd en het is niet de score van WHOOP of een ander bedrijf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wiek zdrowotny Ayuvo to własne oszacowanie Ayuvo, jak Twoje niedawne nawyki i wskaźniki sprawności wypadają na tle opublikowanych wartości populacyjnych. Nie jest to wiek kliniczny ani biologiczny i nie jest to wynik WHOOP ani żadnej innej firmy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A Idade de saúde do Ayuvo é uma estimativa própria do Ayuvo de como seus hábitos recentes e marcadores de condicionamento se comparam com valores populacionais publicados. Não é uma idade clínica nem biológica, e não é a pontuação da WHOOP nem de qualquer outra empresa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vârsta sănătății Ayuvo este estimarea proprie a Ayuvo privind cum se compară obiceiurile tale recente și markerii de fitness cu valorile publicate pentru populație. Nu este o vârstă clinică sau biologică și nu este scorul WHOOP sau al altei companii."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Возраст здоровья Ayuvo — собственная оценка Ayuvo того, как ваши недавние привычки и показатели физической формы соотносятся с опубликованными популяционными значениями. Это не клинический и не биологический возраст, а также не показатель WHOOP или любой другой компании."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вік здоров'я Ayuvo — це власна оцінка Ayuvo того, як ваші нещодавні звички та маркери фізичної форми співвідносяться з опублікованими популяційними значеннями. Це не клінічний і не біологічний вік, а також не оцінка WHOOP чи будь-якої іншої компанії."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo 健康年龄是 Ayuvo 自行估算的结果，用于比较你近期的习惯和体能指标与已发表的人群数值。它不是临床年龄或生物学年龄，也不是 WHOOP 或任何其他公司的分数。"
          }
        }
      }
    },
