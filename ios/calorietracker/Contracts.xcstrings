    "derived.metrics.adaptive_tdee.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ما يحرقه جسمك على الأرجح يوميًا، محسوبًا مما أكلته وكيف تغيّر اتجاه وزنك خلال 4 أسابيع."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yediklərinizdən və çəki trendinizin 4 həftə ərzində necə dəyişdiyindən hesablanan, bədəninizin gündə ehtimal olunan yandırdığı enerji."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kolik tvé tělo pravděpodobně denně spálí, vypočteno z toho, co jsi snědl(a), a jak se změnil trend tvé hmotnosti za 4 týdny."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Was dein Körper wahrscheinlich pro Tag verbrennt, berechnet aus dem, was du gegessen hast, und wie sich dein Gewichtstrend über 4 Wochen verändert hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What your body likely burns per day, worked out from what you ate and how your weight trend changed over 4 weeks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lo que probablemente quema tu cuerpo al día, calculado a partir de lo que comiste y de cómo cambió la tendencia de tu peso en 4 semanas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ce que votre corps dépense probablement par jour, calculé à partir de ce que vous avez mangé et de l'évolution de votre tendance de poids sur 4 semaines."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपका शरीर प्रतिदिन संभवतः कितनी ऊर्जा बर्न करता है, जो आपके खाने और 4 सप्ताह में आपके वज़न ट्रेंड में हुए बदलाव से निकाली जाती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quanto probabilmente brucia il tuo corpo al giorno, calcolato da ciò che hai mangiato e da come è cambiato l'andamento del tuo peso in 4 settimane."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "食べた量と4週間の体重トレンドの変化から算出した、体が1日に消費していると思われるエネルギーです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "4주 동안 먹은 양과 체중 추세의 변화로 계산한, 몸이 하루에 소모할 것으로 보이는 에너지예요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wat je lichaam waarschijnlijk per dag verbruikt, berekend uit wat je at en hoe je gewichtstrend in 4 weken veranderde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ile Twój organizm prawdopodobnie spala dziennie, wyliczone z tego, co jadłeś, i zmiany trendu wagi w ciągu 4 tygodni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quanto seu corpo provavelmente gasta por dia, calculado a partir do que você comeu e de como sua tendência de peso mudou em 4 semanas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cât arde probabil corpul tău pe zi, calculat din ce ai mâncat și din cum s-a schimbat tendința greutății în 4 săptămâni."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сколько ваше тело, вероятно, сжигает в день — рассчитано по тому, что вы ели, и по изменению тренда веса за 4 недели."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Скільки ваше тіло ймовірно витрачає за день, розраховано за тим, що ви їли, і як змінилася тенденція вашої ваги за 4 тижні."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "根据你 4 周内的饮食和体重趋势变化，推算你身体每天可能消耗的能量。"
          }
        }
      }
    },
