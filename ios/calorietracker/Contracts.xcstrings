    "derived.metrics.double_support_weekly.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "نسبة كل خطوة تكون فيها كلتا القدمين على الأرض. القيم المعتادة 20-40%؛ وقد تعني القيم الأعلى توازنًا أقل."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hər addımda hər iki ayağın yerdə olduğu vaxtın payı. Tipik dəyərlər 20-40%⁠-dir; daha yüksək dəyər zəif tarazlıq demək ola bilər."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Podíl každého kroku, kdy jsou obě nohy na zemi. Obvyklé hodnoty jsou 20–40 %; vyšší může znamenat horší rovnováhu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anteil jedes Schritts, bei dem beide Füße den Boden berühren. Typische Werte liegen bei 20–40 %; höhere Werte können weniger Gleichgewicht bedeuten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share of each step with both feet on the ground. Typical values are 20-40%; higher can mean less balance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Proporción de cada paso con ambos pies en el suelo. Los valores típicos son 20-40 %; un valor más alto puede indicar menos equilibrio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Part de chaque pas avec les deux pieds au sol. Les valeurs typiques sont de 20-40 % ; plus élevé peut signifier moins d'équilibre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हर कदम का वह हिस्सा जब दोनों पैर ज़मीन पर हों। सामान्य मान 20-40% हैं; अधिक होने का मतलब कम संतुलन हो सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Percentuale di ogni passo con entrambi i piedi a terra. I valori tipici sono 20-40%; valori più alti possono indicare meno equilibrio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "各歩のうち両足が地面についている割合です。一般的な値は20〜40%で、高いとバランスが低下している可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "각 걸음에서 양발이 모두 땅에 닿아 있는 시간의 비율이에요. 일반적인 값은 20-40%이며, 높으면 균형이 떨어졌다는 뜻일 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deel van elke stap waarbij beide voeten op de grond staan. Normale waarden zijn 20-40%; hoger kan op minder evenwicht wijzen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odsetek każdego kroku, w którym obie stopy są na ziemi. Typowe wartości to 20-40%; wyższe mogą oznaczać gorszą równowagę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Parcela de cada passo com os dois pés no chão. Valores típicos são 20-40%; valores mais altos podem indicar menos equilíbrio."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Proporția din fiecare pas în care ambele picioare sunt pe sol. Valorile obișnuite sunt 20-40%; valorile mai mari pot însemna un echilibru mai slab."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Доля каждого шага, когда обе ноги стоят на земле. Типичные значения — 20–40%; более высокие могут означать худшее равновесие."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Частка кожного кроку, коли обидві ноги на землі. Типові значення — 20-40%; вищі можуть означати гіршу рівновагу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每一步中双脚同时着地的时间占比。典型值为 20-40%；较高可能意味着平衡能力较弱。"
          }
        }
      }
    },
