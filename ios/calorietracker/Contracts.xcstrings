          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu último periodo duró {days} días. Si los periodos largos continúan o te preocupan, considera comentarlo con un profesional sanitario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vos dernières règles ont duré {days} jours. Si des règles longues se répètent ou vous inquiètent, pensez à en parler à un professionnel de santé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपका पिछला पीरियड {days} दिन चला। अगर लंबे पीरियड जारी रहें या आपको चिंता हो, तो किसी स्वास्थ्य विशेषज्ञ से बात करने पर विचार करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le ultime mestruazioni sono durate {days} giorni. Se mestruazioni lunghe continuano o ti preoccupano, valuta di parlarne con un professionista sanitario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "前回の生理は{days}日間続きました。長い生理が続く場合や気になる場合は、医療専門家への相談を検討してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "지난 생리는 {days}일 동안 지속되었습니다. 긴 생리가 계속되거나 걱정된다면 의료 전문가와 상담해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je laatste menstruatie duurde {days} dagen. Als lange menstruaties aanhouden of je zorgen baren, overweeg dit dan met een zorgverlener te bespreken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ostatnia miesiączka trwała {days} dni. Jeśli długie miesiączki się powtarzają lub cię niepokoją, rozważ omówienie tego z pracownikiem ochrony zdrowia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sua última menstruação durou {days} dias. Se menstruações longas continuarem ou preocuparem você, considere conversar sobre isso com um profissional de saúde."
          }
        },
        "ro" : {
          "stringUnit" : {
