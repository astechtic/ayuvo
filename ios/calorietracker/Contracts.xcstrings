    "insights.methodology.daily_review.sections.0.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "نظرة إلى الوراء على يوم واحد: نتيجة يوم من 0 إلى 100، وما سار بشكل جيد، وما يحتاج إلى انتباه، وما يمكن تجربته غدًا، وما يمكن التفكير في تقليله."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bir günə nəzər: 0-dan 100-ə qədər Gün göstəricisi, nəyin yaxşı getdiyi, nəyin diqqət tələb etdiyi, sabah nəyi sınamalı və nəyi azaltmağı nəzərdən keçirməli."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ohlédnutí za jedním dnem: Skóre dne od 0 do 100, co se povedlo, co vyžaduje pozornost, co zkusit zítra a co zvážit omezit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein Rückblick auf einen Tag: ein Tageswert von 0 bis 100, was gut lief, was Aufmerksamkeit braucht, was du morgen ausprobieren kannst und was du reduzieren könntest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A look back at one day: a Day Score from 0 to 100, what went well, what needs attention, what to try tomorrow and what to consider reducing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un repaso de un día: una Puntuación del día de 0 a 100, lo que fue bien, lo que necesita atención, qué probar mañana y qué plantearte reducir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un retour sur une journée : un score du jour de 0 à 100, ce qui s'est bien passé, ce qui demande de l'attention, ce qu'il faut essayer demain et ce qu'il faut envisager de réduire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "एक दिन पर नज़र: 0 से 100 तक दिन का स्कोर, क्या अच्छा रहा, किस पर ध्यान देना है, कल क्या आज़माना है और क्या कम करने पर विचार करना है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uno sguardo a una giornata: un Punteggio del giorno da 0 a 100, cosa è andato bene, cosa richiede attenzione, cosa provare domani e cosa valutare di ridurre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "1日の振り返り：0〜100のデイスコア、うまくいったこと、注意が必要なこと、明日試すこと、減らすことを検討したいこと。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "하루를 돌아보기: 0-100점의 하루 점수, 잘한 점, 주의가 필요한 점, 내일 시도할 점, 줄이는 것을 고려할 점."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Een terugblik op één dag: een dagscore van 0 tot 100, wat goed ging, wat aandacht nodig heeft, wat je morgen kunt proberen en wat je zou kunnen minderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spojrzenie wstecz na jeden dzień: Wynik dnia od 0 do 100, co poszło dobrze, co wymaga uwagi, czego spróbować jutro i co warto rozważyć ograniczyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um olhar sobre um dia: uma Pontuação do dia de 0 a 100, o que foi bem, o que precisa de atenção, o que tentar amanhã e o que considerar reduzir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O privire înapoi asupra unei zile: un Scor al zilei de la 0 la 100, ce a mers bine, ce necesită atenție, ce să încerci mâine și ce ai putea reduce."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Взгляд на один день: оценка дня от 0 до 100, что получилось хорошо, на что обратить внимание, что попробовать завтра и что стоит сократить."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Погляд назад на один день: оцінка дня від 0 до 100, що вдалося, що потребує уваги, що спробувати завтра і що варто зменшити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "回顾一天：0 到 100 的当日分数、做得好的方面、需要注意的方面、明天可以尝试的事情，以及可以考虑减少的内容。"
          }
        }
      }
    },
