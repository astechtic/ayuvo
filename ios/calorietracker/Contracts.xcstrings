    "insights.methodology.daily_review.sections.1.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "التغذية 30%، النشاط 20%، النوم 20%، الترطيب 10%، التدريب 10%، التعافي 10%، والصيام 10%. تُحتسب فقط المجالات التي تتتبعها ولديك بيانات عنها، وتُعدَّل الأوزان وفق ما هو مُضمَّن. المجال الذي لم تسجّله يظهر كغير مُسجَّل ولا يخفض نتيجتك أبدًا."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Qidalanma 30%, aktivlik 20%, yuxu 20%, hidratasiya 10%, məşq 10%, bərpa 10% və oruc 10%. Yalnız izlədiyiniz və məlumatı olan sahələr sayılır və çəkilər daxil edilənlərə uyğun miqyaslanır. Qeyd etmədiyiniz sahə qeyd edilməyib kimi göstərilir və heç vaxt göstəricinizi aşağı salmır."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Výživa 30 %, aktivita 20 %, spánek 20 %, hydratace 10 %, trénink 10 %, regenerace 10 % a půst 10 %. Počítají se jen oblasti, které sleduješ a máš pro ně data, a váhy se přepočítají podle toho, co je zahrnuto. Oblast, kterou jsi nezapsal(a), se zobrazí jako nezapsaná a nikdy nesníží tvé skóre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ernährung 30 %, Aktivität 20 %, Schlaf 20 %, Flüssigkeit 10 %, Training 10 %, Erholung 10 % und Fasten 10 %. Nur Bereiche, die du erfasst und für die Daten vorliegen, zählen, und die Gewichtung wird auf das Einbezogene skaliert. Ein Bereich, den du nicht erfasst hast, wird als nicht erfasst angezeigt und senkt deinen Wert nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutrition 30%, activity 20%, sleep 20%, hydration 10%, training 10%, recovery 10% and fasting 10%. Only areas you track and have data for count, and the weights are scaled to what is included. An area you did not log shows as not logged and never lowers your score."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nutrición 30 %, actividad 20 %, sueño 20 %, hidratación 10 %, entrenamiento 10 %, recuperación 10 % y ayuno 10 %. Solo cuentan las áreas que sigues y de las que hay datos, y los pesos se ajustan a lo incluido. Un área que no registraste aparece como sin registrar y nunca reduce tu puntuación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nutrition 30 %, activité 20 %, sommeil 20 %, hydratation 10 %, entraînement 10 %, récupération 10 % et jeûne 10 %. Seuls les domaines que vous suivez et pour lesquels vous avez des données comptent, et les pondérations sont ajustées à ce qui est inclus. Un domaine non enregistré s'affiche comme non enregistré et ne fait jamais baisser votre score."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "पोषण 30%, गतिविधि 20%, नींद 20%, हाइड्रेशन 10%, ट्रेनिंग 10%, रिकवरी 10% और उपवास 10%। केवल वे क्षेत्र गिने जाते हैं जिन्हें आप ट्रैक करते हैं और जिनका डेटा है, और भार शामिल क्षेत्रों के अनुसार समायोजित होते हैं। जो क्षेत्र आपने लॉग नहीं किया, वह लॉग नहीं किया गया दिखता है और कभी आपका स्कोर कम नहीं करता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nutrizione 30%, attività 20%, sonno 20%, idratazione 10%, allenamento 10%, recupero 10% e digiuno 10%. Contano solo le aree che monitori e per cui hai dati, e i pesi vengono riproporzionati in base a ciò che è incluso. Un'area che non hai registrato appare come non registrata e non abbassa mai il punteggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "栄養30%、活動20%、睡眠20%、水分補給10%、トレーニング10%、リカバリー10%、断食10%。記録していてデータがある項目のみが対象となり、重みは含まれる項目に合わせて調整されます。記録しなかった項目は未記録として表示され、スコアを下げることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "영양 30%, 활동 20%, 수면 20%, 수분 섭취 10%, 운동 10%, 회복 10%, 단식 10%. 추적 중이고 데이터가 있는 영역만 계산되며, 가중치는 포함된 영역에 맞게 조정돼요. 기록하지 않은 영역은 기록 없음으로 표시되고 점수를 낮추지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voeding 30%, activiteit 20%, slaap 20%, hydratatie 10%, training 10%, herstel 10% en vasten 10%. Alleen onderdelen die je bijhoudt en waarvoor gegevens zijn tellen mee, en de gewichten worden geschaald naar wat is meegenomen. Een onderdeel dat je niet hebt gelogd, wordt als niet gelogd getoond en verlaagt je score nooit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odżywianie 30%, aktywność 20%, sen 20%, nawodnienie 10%, trening 10%, regeneracja 10% i post 10%. Liczą się tylko obszary, które śledzisz i dla których są dane, a wagi są skalowane do tego, co uwzględniono. Obszar bez wpisów jest pokazywany jako brak wpisu i nigdy nie obniża wyniku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nutrição 30%, atividade 20%, sono 20%, hidratação 10%, treino 10%, recuperação 10% e jejum 10%. Só contam as áreas que você acompanha e para as quais há dados, e os pesos são ajustados ao que foi incluído. Uma área que você não registrou aparece como não registrada e nunca reduz sua pontuação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nutriție 30%, activitate 20%, somn 20%, hidratare 10%, antrenament 10%, recuperare 10% și post 10%. Contează doar domeniile pe care le urmărești și pentru care ai date, iar ponderile sunt scalate la ce este inclus. Un domeniu pe care nu l-ai înregistrat apare ca neînregistrat și nu îți scade niciodată scorul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Питание 30%, активность 20%, сон 20%, водный баланс 10%, тренировки 10%, восстановление 10% и голодание 10%. Учитываются только области, которые вы отслеживаете и по которым есть данные, а веса пересчитываются под включённые области. Область без записей отображается как «нет записей» и никогда не снижает оценку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Харчування 30%, активність 20%, сон 20%, гідратація 10%, тренування 10%, відновлення 10% і голодування 10%. Враховуються лише сфери, які ви відстежуєте і для яких є дані, а ваги масштабуються відповідно до включеного. Сфера, яку ви не записали, показується як не записана і ніколи не знижує вашу оцінку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "营养 30%，活动 20%，睡眠 20%，饮水 10%，训练 10%，恢复 10%，禁食 10%。只计入你追踪且有数据的方面，权重会按包含的方面重新换算。未记录的方面显示为未记录，绝不会降低你的分数。"
          }
        }
      }
    },
