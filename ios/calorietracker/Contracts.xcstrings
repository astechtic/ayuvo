    "derived.metrics.goal_eta.method" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(الهدف − الاتجاه) ÷ المعدل الأسبوعي، عند التقدم نحو الهدف بمعدل ≥0.05 kg أسبوعيًا."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Həftədə ≥0,05 kg sürətlə hədəfə doğru irəlilədikdə (hədəf − trend) ÷ həftəlik sürət."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Cíl − trend) ÷ týdenní tempo, pokud se k cíli blížíš tempem ≥0,05 kg týdně."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Ziel − Trend) ÷ wöchentliche Rate, wenn du dich mit ≥0,05 kg pro Woche auf das Ziel zubewegst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Goal − trend) ÷ weekly rate, when moving towards the goal at ≥0.05 kg a week."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Objetivo − tendencia) ÷ ritmo semanal, cuando avanzas hacia el objetivo a ≥0,05 kg por semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Objectif − tendance) ÷ rythme hebdomadaire, lorsque vous progressez vers l'objectif à ≥0,05 kg par semaine."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(लक्ष्य − ट्रेंड) ÷ साप्ताहिक दर, जब आप ≥0.05 kg प्रति सप्ताह की दर से लक्ष्य की ओर बढ़ रहे हों।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Obiettivo − andamento) ÷ variazione settimanale, quando ti muovi verso l'obiettivo di almeno 0,05 kg a settimana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "目標に向かって週0.05 kg以上のペースで変化している場合の（目標 − トレンド）÷ 週間変化量。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(목표 − 추세) ÷ 주간 변화율. 주당 ≥0.05 kg 속도로 목표를 향해 가고 있을 때 계산돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
