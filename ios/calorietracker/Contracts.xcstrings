          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Čas strávený půstem za den. Půst přes půlnoc se započítá do každého dne, který zasahuje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fastenzeit pro Tag. Eine Fastenperiode über Mitternacht zählt zu jedem Tag, den sie umfasst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time spent fasting per day. A fast that crosses midnight counts toward each day it covers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tiempo de ayuno por día. Un ayuno que pasa de la medianoche cuenta para cada día que abarca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le temps passé à jeûner par jour. Un jeûne qui passe minuit compte pour chaque jour qu'il couvre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "प्रतिदिन उपवास में बिताया गया समय। आधी रात पार करने वाला उपवास उन सभी दिनों में गिना जाता है जिन्हें वह कवर करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tempo di digiuno per giorno. Un digiuno che supera la mezzanotte conta per ogni giorno che copre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "1日あたりの断食時間です。日付をまたぐ断食は、それぞれの日にカウントされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "하루 동안 단식한 시간이에요. 자정을 넘긴 단식은 해당하는 각 날짜에 나누어 집계돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tijd die je per dag vast. Een vasten dat over middernacht loopt, telt mee voor elke dag die het beslaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Czas postu w ciągu dnia. Post trwający przez północ liczy się do każdego dnia, który obejmuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tempo em jejum por dia. Um jejum que passa da meia-noite conta para cada dia que abrange."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Timpul de post pe zi. Un post care trece de miezul nopții se numără pentru fiecare zi pe care o acoperă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Время голодания за день. Голодание, переходящее через полночь, учитывается в каждом дне, который оно охватывает."
          }
        },
        "uk" : {
          "stringUnit" : {
