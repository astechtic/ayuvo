    "derived.metrics.sleep_debt.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "النوم الذي فاتك مقارنةً بحاجتك الليلية خلال آخر 14 ليلة. يحتاج البالغون إلى 7 ساعات على الأقل."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Son 14 gecə ərzində gecəlik ehtiyacınıza nisbətən çatışmayan yuxu. Böyüklərə ən azı 7 saat lazımdır."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spánek, který ti chyběl oproti tvé noční potřebě za posledních 14 nocí. Dospělí potřebují alespoň 7 hodin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Schlaf, der dir in den letzten 14 Nächten gegenüber deinem nächtlichen Bedarf gefehlt hat. Erwachsene brauchen mindestens 7 Stunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep you missed against your nightly need over the last 14 nights. Adults need at least 7 hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El sueño que te faltó respecto a tu necesidad diaria en las últimas 14 noches. Los adultos necesitan al menos 7 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le sommeil manqué par rapport à votre besoin nocturne sur les 14 dernières nuits. Les adultes ont besoin d'au moins 7 heures."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "पिछली 14 रातों में आपकी रात की ज़रूरत की तुलना में छूटी नींद। वयस्कों को कम से कम 7 घंटे चाहिए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il sonno che ti è mancato rispetto al tuo fabbisogno notturno nelle ultime 14 notti. Gli adulti hanno bisogno di almeno 7 ore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "過去14夜で、毎晩必要な睡眠に対して不足した睡眠です。成人には少なくとも7時間の睡眠が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "최근 14일 밤 동안 필요한 수면량 대비 부족했던 수면이에요. 성인은 최소 7시간이 필요해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Slaap die je hebt gemist ten opzichte van je nachtelijke behoefte over de laatste 14 nachten. Volwassenen hebben minstens 7 uur nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sen, którego zabrakło Ci względem nocnego zapotrzebowania w ciągu ostatnich 14 nocy. Dorośli potrzebują co najmniej 7 godzin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sono que faltou em relação à sua necessidade noturna nas últimas 14 noites. Adultos precisam de pelo menos 7 horas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Somnul pe care l-ai pierdut față de necesarul tău pe noapte în ultimele 14 nopți. Adulții au nevoie de cel puțin 7 ore."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Недобранный сон относительно вашей ночной потребности за последние 14 ночей. Взрослым нужно не менее 7 часов."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сон, якого вам бракувало порівняно з нічною потребою за останні 14 ночей. Дорослим потрібно щонайменше 7 годин."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "过去 14 晚你相对每晚所需睡眠而缺少的睡眠。成年人至少需要 7 小时。"
          }
        }
      }
    },
    "derived.metrics.sleep_debt.method" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Σ max(0, الحاجة − وقت النوم) على الليالي المسجّلة خلال آخر 14 يومًا. الحاجة الافتراضية 8 ساعات."
          }
        },
        "az" : {
          "stringUnit" : {
