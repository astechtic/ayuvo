    "insights.methodology.recovery.sections.5.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يتطلب التعافي خط أساس للنوم وخط أساس لـ HRV أو لمعدل ضربات القلب أثناء الراحة، لكل منهما 14 ليلة على الأقل. تُعامل الليالي التي بها أقل من ساعتين من النوم المسجّل على أنها غير مكتملة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bərpa üçün yuxu əsas səviyyəsi və HRV və ya istirahət ürək döyüntüsü əsas səviyyəsi lazımdır, hər biri ən azı 14 gecə ilə. 2 saatdan az qeyd olunmuş yuxusu olan gecələr natamam sayılır."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Regenerace vyžaduje výchozí hodnotu spánku a výchozí hodnotu HRV nebo klidové tepové frekvence, každou alespoň ze 14 nocí. Noci s méně než 2 hodinami zaznamenaného spánku se považují za neúplné."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Erholung braucht einen Schlaf-Basiswert und einen Basiswert für HRV oder Ruheherzfrequenz, jeweils mit mindestens 14 Nächten. Nächte mit weniger als 2 Stunden erfasstem Schlaf gelten als unvollständig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery needs a sleep baseline and an HRV or resting heart rate baseline, each with at least 14 nights. Nights with less than 2 hours of recorded sleep are treated as incomplete."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La Recuperación necesita una referencia de sueño y una referencia de HRV o de frecuencia cardíaca en reposo, cada una con al menos 14 noches. Las noches con menos de 2 horas de sueño registrado se consideran incompletas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La Récupération nécessite une référence de sommeil et une référence de VFC ou de fréquence cardiaque au repos, chacune avec au moins 14 nuits. Les nuits avec moins de 2 heures de sommeil enregistré sont considérées comme incomplètes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "रिकवरी के लिए नींद की बेसलाइन और HRV या विश्राम हृदय गति की बेसलाइन चाहिए, हर एक में कम से कम 14 रातें। 2 घंटे से कम दर्ज नींद वाली रातें अधूरी मानी जाती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il Recupero richiede un valore di riferimento del sonno e uno dell'HRV o della frequenza cardiaca a riposo, ciascuno con almeno 14 notti. Le notti con meno di 2 ore di sonno registrato sono considerate incomplete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "リカバリーには、睡眠のベースラインと、HRVまたは安静時心拍数のベースラインが必要で、それぞれ少なくとも14夜分が必要です。記録された睡眠が2時間未満の夜は不完全として扱われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "회복을 계산하려면 수면 기준치와 HRV 또는 안정 시 심박수 기준치가 필요하며, 각각 최소 14일 밤의 데이터가 있어야 해요. 기록된 수면이 2시간 미만인 밤은 불완전한 것으로 처리돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Herstel vereist een slaapbasislijn en een basislijn voor HRV of hartslag in rust, elk met minstens 14 nachten. Nachten met minder dan 2 uur geregistreerde slaap worden als onvolledig behandeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Regeneracja wymaga wartości bazowej snu oraz wartości bazowej HRV lub tętna spoczynkowego, każdej z co najmniej 14 nocy. Noce z mniej niż 2 godzinami zapisanego snu traktowane są jako niepełne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A Recuperação precisa de uma linha de base de sono e de uma linha de base de HRV ou de frequência cardíaca em repouso, cada uma com pelo menos 14 noites. Noites com menos de 2 horas de sono registrado são tratadas como incompletas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Recuperarea necesită un nivel de referință pentru somn și unul pentru HRV sau pulsul în repaus, fiecare cu cel puțin 14 nopți. Nopțile cu mai puțin de 2 ore de somn înregistrat sunt tratate ca incomplete."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Для восстановления нужен базовый уровень сна и базовый уровень HRV или пульса в покое — каждый не менее чем за 14 ночей. Ночи, когда записано менее 2 часов сна, считаются неполными."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Для Відновлення потрібні базовий рівень сну і базовий рівень HRV або пульсу в спокої, кожен щонайменше з 14 ночей. Ночі з менш ніж 2 годинами записаного сну вважаються неповними."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "恢复需要睡眠基线，以及 HRV 或静息心率基线，每项都至少需要 14 晚数据。记录睡眠不足 2 小时的夜晚视为不完整。"
          }
        }
      }
    },
