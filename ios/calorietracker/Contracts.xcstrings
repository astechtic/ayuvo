    "derived.metrics.night_hr_dip.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مقدار انخفاض معدل ضربات قلبك أثناء النوم مقارنةً باليقظة. الانخفاض بنسبة 10% أو أكثر هو النمط الصحي المعتاد."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ürək döyüntünüzün yuxuda oyaq vaxtdan nə qədər aşağı olduğu. 10% və ya daha çox enmə adi sağlam modeldir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O kolik je tvá tepová frekvence ve spánku nižší než v bdělém stavu. Pokles o 10 % nebo více je obvyklý zdravý vzorec."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wie viel niedriger deine Herzfrequenz im Schlaf als im Wachzustand ist. Ein Abfall von 10 % oder mehr ist das übliche gesunde Muster."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How much lower your heart rate is asleep than awake. A dip of 10% or more is the usual healthy pattern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuánto más baja es tu frecuencia cardíaca dormido que despierto. Un descenso del 10 % o más es el patrón saludable habitual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De combien votre fréquence cardiaque est plus basse endormi qu'éveillé. Une baisse de 10 % ou plus correspond au schéma sain habituel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "जागते समय की तुलना में सोते समय आपकी हृदय गति कितनी कम होती है। 10% या उससे अधिक की गिरावट सामान्य स्वस्थ पैटर्न है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quanto la tua frequenza cardiaca è più bassa nel sonno rispetto alla veglia. Un calo del 10% o più è il normale schema sano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "睡眠中の心拍数が起きている時よりどれだけ低いかを示します。10%以上の低下が通常の健康的なパターンです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "잠잘 때 심박수가 깨어 있을 때보다 얼마나 낮은지 보여줘요. 10% 이상 낮아지는 것이 일반적인 건강한 패턴이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hoeveel lager je hartslag is als je slaapt dan als je wakker bent. Een daling van 10% of meer is het gebruikelijke gezonde patroon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O ile niższe jest Twoje tętno podczas snu niż na jawie. Spadek o 10% lub więcej to typowy zdrowy wzorzec."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quanto sua frequência cardíaca fica mais baixa dormindo do que acordado. Uma queda de 10% ou mais é o padrão saudável habitual."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cât de mic este pulsul tău în somn față de starea de veghe. O scădere de 10% sau mai mult este tiparul sănătos obișnuit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Насколько пульс во сне ниже, чем во время бодрствования. Снижение на 10% и более — обычная здоровая картина."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Наскільки ваш пульс під час сну нижчий, ніж під час неспання. Зниження на 10% або більше — звичайна здорова картина."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你睡眠时的心率比清醒时低多少。下降 10% 或以上是常见的健康模式。"
          }
        }
      }
    },
    "derived.metrics.night_hr_dip.method" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "1 − (متوسط النوم ÷ متوسط اليقظة خلال 14 ساعة بعد الاستيقاظ) × 100. يتطلب 4 ساعات على الأقل من معدل ضربات القلب أثناء اليقظة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "1 − (yuxu ortalaması ÷ oyandıqdan sonrakı 14 saat ərzində oyaq ortalama) × 100. Ən azı 4 saatlıq oyaq ürək döyüntüsü tələb olunur."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
