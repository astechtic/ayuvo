        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tras los días en que cumpliste tu objetivo de proteína, tu volumen de fuerza del día siguiente ha sido de media {abs_diff} {unit} {direction_word} ({n_exposed} frente a {n_unexposed} días)."
