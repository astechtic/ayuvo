    "derived.metrics.protein_per_kg.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "البروتين الذي سجّلته لكل كيلوغرام من وزن الجسم. يدعم تناول 1.4-2.0 g/kg يوميًا تمارين القوة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bədən çəkisinin hər kiloqramına qeyd etdiyiniz protein. Gündə 1,4-2,0 g/kg güc məşqlərini dəstəkləyir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zapsané bílkoviny na kilogram tělesné hmotnosti. 1,4–2,0 g/kg denně podporuje silový trénink."
