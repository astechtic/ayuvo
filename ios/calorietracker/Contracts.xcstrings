    "insights.methodology.recovery.sections.4.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "67 فأعلى تعافٍ جيد (تدريب عادي)، ومن 34 إلى 66 متوسط (فكّر في تدريب أخف)، وأقل من 34 منخفض (يوم يركّز على التعافي)."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "67 və yuxarı Yaxşı bərpa (normal məşq), 34-dən 66-ya qədər Orta (daha yüngül məşqi nəzərdən keçirin), 34-dən aşağı isə Aşağıdır (bərpaya yönəlmiş gün)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "67 a více je dobrá regenerace (běžný trénink), 34 až 66 střední (zvaž lehčí trénink) a pod 34 nízká (den zaměřený na regeneraci)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "67 und mehr bedeutet gute Erholung (normales Training), 34 bis 66 mittel (leichteres Training erwägen) und unter 34 niedrig (ein auf Erholung ausgerichteter Tag)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "67 and above is Good Recovery (normal training), 34 to 66 is Moderate (consider lighter training) and below 34 is Low (a recovery-focused day)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "67 o más es Buena recuperación (entrenamiento normal), de 34 a 66 es Moderada (plantéate entrenar más suave) y por debajo de 34 es Baja (un día centrado en la recuperación)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "67 et plus correspond à une bonne récupération (entraînement normal), 34 à 66 à modérée (envisagez un entraînement plus léger) et moins de 34 à faible (une journée axée sur la récupération)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "67 और उससे ऊपर अच्छी रिकवरी (सामान्य ट्रेनिंग) है, 34 से 66 मध्यम (हल्की ट्रेनिंग पर विचार करें) और 34 से कम कम (रिकवरी पर केंद्रित दिन)।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Da 67 in su è Recupero buono (allenamento normale), da 34 a 66 è Moderato (valuta un allenamento più leggero) e sotto 34 è Basso (una giornata dedicata al recupero)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "67以上は良好なリカバリー（通常のトレーニング）、34〜66は中程度（軽めのトレーニングを検討）、34未満は低い（リカバリー重視の日）です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "67점 이상은 좋은 회복(일반 운동), 34-66점은 보통(가벼운 운동 고려), 34점 미만은 낮음(회복에 집중하는 날)이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "67 en hoger is Goed herstel (normaal trainen), 34 tot 66 is Matig (overweeg lichter te trainen) en onder 34 is Laag (een dag gericht op herstel)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "67 i więcej to Dobra regeneracja (normalny trening), 34 do 66 to Umiarkowana (rozważ lżejszy trening), a poniżej 34 to Niska (dzień nastawiony na regenerację)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "67 ou mais é Recuperação boa (treino normal), de 34 a 66 é Moderada (considere um treino mais leve) e abaixo de 34 é Baixa (um dia focado na recuperação)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "67 și peste înseamnă Recuperare bună (antrenament normal), 34-66 înseamnă Moderată (ia în calcul un antrenament mai ușor), iar sub 34 înseamnă Scăzută (o zi axată pe recuperare)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "67 и выше — хорошее восстановление (обычные тренировки), от 34 до 66 — среднее (подумайте о более лёгкой тренировке), ниже 34 — низкое (день с упором на восстановление)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "67 і вище — Добре відновлення (звичайні тренування), від 34 до 66 — Помірне (варто тренуватися легше), нижче 34 — Низьке (день із фокусом на відновленні)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "67 及以上为恢复良好（正常训练），34 到 66 为中等（考虑轻松训练），低于 34 为较低（以恢复为主的一天）。"
          }
        }
      }
    },
