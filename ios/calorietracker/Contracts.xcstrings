    "metric.metrics.app:fasting.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الوقت الذي تقضيه صائمًا في كل يوم. يُحتسب الصيام الذي يمتد بعد منتصف الليل لكل يوم يشمله."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
