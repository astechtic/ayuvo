    "insights.methodology.baselines.sections.3.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يعرض Ayuvo الفرق عن متوسطك، ونسبة التغيّر، وعدد وحدات التشتت التي يبعدها اليوم. تستخدم الاتجاهات ميل آخر 28 يومًا، ويُعرض كنسبة مئوية من خط الأساس لكل أسبوع."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo ortalamanızdan fərqi, faiz dəyişikliyini və bu günün neçə yayılma uzaqda olduğunu göstərir. Trendlər son 28 günün meylindən istifadə edir və həftəlik əsas səviyyənizin faizi kimi göstərilir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo ukazuje rozdíl od tvého průměru, procentní změnu a o kolik rozptylů se dnešek liší. Trendy používají sklon posledních 28 dní, zobrazený jako procento tvé výchozí hodnoty za týden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo zeigt die Differenz zu deinem Durchschnitt, die prozentuale Änderung und wie viele Streuungen der heutige Wert entfernt ist. Trends nutzen die Steigung der letzten 28 Tage, dargestellt als Prozentsatz deines Basiswerts pro Woche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo shows the difference from your average, the percentage change and how many spreads away today is. Trends use the slope of the last 28 days, shown as a percentage of your baseline per week."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo muestra la diferencia respecto a tu promedio, el cambio porcentual y a cuántas dispersiones está hoy. Las tendencias usan la pendiente de los últimos 28 días, mostrada como porcentaje de tu referencia por semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo affiche l'écart par rapport à votre moyenne, la variation en pourcentage et le nombre d'écarts types auquel se situe aujourd'hui. Les tendances utilisent la pente des 28 derniers jours, affichée en pourcentage de votre référence par semaine."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo आपके औसत से अंतर, प्रतिशत बदलाव और आज कितने फैलाव दूर है, यह दिखाता है। ट्रेंड पिछले 28 दिनों के ढलान का उपयोग करते हैं, जिसे प्रति सप्ताह आपकी बेसलाइन के प्रतिशत के रूप में दिखाया जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo mostra la differenza dalla tua media, la variazione percentuale e di quante dispersioni si discosta oggi. Gli andamenti usano la pendenza degli ultimi 28 giorni, mostrata come percentuale del tuo valore di riferimento a settimana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvoは、平均との差、変化率、そして今日がばらつき何個分離れているかを表示します。トレンドは過去28日間の傾きを使い、1週間あたりのベースラインに対する割合で表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo는 평균과의 차이, 변화율, 오늘 값이 분포 몇 단위만큼 떨어져 있는지를 보여줘요. 추세는 최근 28일의 기울기를 사용하며, 주당 기준치 대비 백분율로 표시돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo toont het verschil met je gemiddelde, de procentuele verandering en hoeveel spreidingen vandaag ervan af ligt. Trends gebruiken de helling van de laatste 28 dagen, weergegeven als percentage van je basislijn per week."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo pokazuje różnicę względem Twojej średniej, zmianę procentową i o ile rozrzutów odbiega dzisiejszy dzień. Trendy wykorzystują nachylenie z ostatnich 28 dni, pokazane jako procent wartości bazowej na tydzień."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Ayuvo mostra a diferença em relação à sua média, a variação percentual e a quantas dispersões o dia de hoje está. As tendências usam a inclinação dos últimos 28 dias, mostrada como porcentagem da sua linha de base por semana."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo arată diferența față de media ta, schimbarea procentuală și la câte dispersii distanță se află ziua de azi. Tendințele folosesc panta ultimelor 28 de zile, afișată ca procent din nivelul de referință pe săptămână."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo показывает отличие от вашего среднего, изменение в процентах и на сколько разбросов отклоняется сегодняшнее значение. Тренды используют наклон за последние 28 дней, показанный в процентах от базового уровня в неделю."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo показує різницю від вашого середнього, зміну у відсотках і на скільки розкидів відрізняється сьогоднішній день. Тенденції використовують нахил за останні 28 днів, показаний у відсотках від базового рівня на тиждень."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo 会显示与平均值的差值、百分比变化，以及今天偏离了多少个标准差。趋势使用过去 28 天的斜率，以每周占基线的百分比显示。"
          }
        }
      }
    },
    "insights.methodology.baselines.sections.3.heading" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
