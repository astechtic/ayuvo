    "derived.metrics.sleep_regularity_index.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "احتمال أن تكون في الحالة نفسها (نائمًا أو مستيقظًا) في الوقت نفسه في أيام متتالية، على مقياس من 100. القيمة الأعلى تعني انتظامًا أكبر."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ardıcıl günlərdə eyni vaxtda eyni vəziyyətdə (yuxuda və ya oyaq) olmağınızın ehtimalı, 100-lük şkala ilə. Daha yüksək dəyər daha müntəzəm deməkdir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pravděpodobnost, že jsi ve stejný čas v po sobě jdoucích dnech ve stejném stavu (spánek nebo bdění), přepočtená na 100. Vyšší znamená pravidelnější."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Wahrscheinlichkeit, an aufeinanderfolgenden Tagen zur selben Uhrzeit im selben Zustand (schlafend oder wach) zu sein, skaliert auf 100. Höher ist regelmäßiger."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The chance you are in the same state (asleep or awake) at the same time on consecutive days, scaled to 100. Higher is more regular."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La probabilidad de estar en el mismo estado (dormido o despierto) a la misma hora en días consecutivos, escalada a 100. Cuanto más alto, más regular."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La probabilité d'être dans le même état (endormi ou éveillé) à la même heure deux jours consécutifs, ramenée sur 100. Plus c'est élevé, plus c'est régulier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "लगातार दिनों में एक ही समय पर एक ही अवस्था (सोते या जागते) में होने की संभावना, 100 के पैमाने पर। अधिक का मतलब अधिक नियमित।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La probabilità di trovarti nello stesso stato (addormentato o sveglio) alla stessa ora in giorni consecutivi, su una scala fino a 100. Più alto significa più regolare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "連続する日の同じ時刻に同じ状態（睡眠または覚醒）である確率を100段階に換算したものです。高いほど規則的です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "연속된 날의 같은 시각에 같은 상태(수면 또는 깨어 있음)일 확률을 100점 척도로 나타낸 값이에요. 높을수록 규칙적이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De kans dat je op opeenvolgende dagen op hetzelfde tijdstip in dezelfde toestand bent (slapend of wakker), geschaald naar 100. Hoger is regelmatiger."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prawdopodobieństwo, że o tej samej porze w kolejnych dniach jesteś w tym samym stanie (sen lub czuwanie), w skali do 100. Wyższa wartość oznacza większą regularność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A chance de você estar no mesmo estado (dormindo ou acordado) no mesmo horário em dias consecutivos, em escala até 100. Quanto maior, mais regular."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Probabilitatea să fii în aceeași stare (adormit sau treaz) la aceeași oră în zile consecutive, pe o scară până la 100. Mai mare înseamnă mai regulat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вероятность того, что вы находитесь в одном и том же состоянии (сон или бодрствование) в одно и то же время в соседние дни, по шкале до 100. Чем выше, тем регулярнее."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Імовірність того, що ви перебуваєте в тому самому стані (спите чи не спите) в той самий час у суміжні дні, за шкалою до 100. Чим вище, тим регулярніше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你在连续两天同一时间处于相同状态（睡着或清醒）的概率，换算为 100 分制。越高越规律。"
          }
        }
      }
    },
    "derived.metrics.sleep_regularity_index.method" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مقارنة دقيقة بدقيقة لكل يوم من الظهر إلى الظهر مع اليوم التالي خلال آخر 14 يومًا: 200 × نسبة التطابق − 100. يتطلب 5 أزواج من الأيام."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Son 14 gün ərzində hər günortadan-günortaya gününün növbəti gün ilə dəqiqəbədəqiqə müqayisəsi: 200 × uyğunluq − 100. 5 gün cütü tələb olunur."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Porovnání každého dne od poledne do poledne s následujícím, minutu po minutě, za posledních 14 dní: 200 × shoda − 100. Vyžaduje 5 dvojic dní."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Minutengenauer Vergleich jedes Tages (Mittag bis Mittag) mit dem nächsten über die letzten 14 Tage: 200 × Übereinstimmung − 100. Erfordert 5 Tagespaare."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minute-by-minute comparison of each noon-to-noon day with the next over the last 14 days: 200 × agreement − 100. Needs 5 day pairs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Comparación minuto a minuto de cada día (de mediodía a mediodía) con el siguiente en los últimos 14 días: 200 × concordancia − 100. Requiere 5 pares de días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Comparaison minute par minute de chaque journée de midi à midi avec la suivante sur les 14 derniers jours : 200 × concordance − 100. Nécessite 5 paires de jours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "पिछले 14 दिनों में हर दोपहर-से-दोपहर के दिन की अगले दिन से मिनट-दर-मिनट तुलना: 200 × मेल − 100। 5 दिन-जोड़े चाहिए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Confronto minuto per minuto di ogni giorno (da mezzogiorno a mezzogiorno) con il successivo negli ultimi 14 giorni: 200 × concordanza − 100. Richiede 5 coppie di giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "過去14日間の、正午から正午までの各日を翌日と1分ごとに比較：200 × 一致率 − 100。5組の日のペアが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "최근 14일 동안 정오에서 다음 날 정오까지의 하루를 다음 날과 분 단위로 비교: 200 × 일치율 − 100. 5쌍의 날이 필요해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vergelijking per minuut van elke dag (van 12 tot 12 uur) met de volgende over de laatste 14 dagen: 200 × overeenkomst − 100. Vereist 5 dagparen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Porównanie minuta po minucie każdej doby (od południa do południa) z następną w ciągu ostatnich 14 dni: 200 × zgodność − 100. Wymaga 5 par dni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Comparação minuto a minuto de cada dia (meio-dia a meio-dia) com o seguinte nos últimos 14 dias: 200 × concordância − 100. Requer 5 pares de dias."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Comparație minut cu minut a fiecărei zile (de la prânz la prânz) cu următoarea, în ultimele 14 zile: 200 × concordanță − 100. Necesită 5 perechi de zile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Поминутное сравнение каждых суток (от полудня до полудня) со следующими за последние 14 дней: 200 × совпадение − 100. Нужно 5 пар суток."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Похвилинне порівняння кожної доби (від полудня до полудня) з наступною за останні 14 днів: 200 × збіг − 100. Потрібно 5 пар днів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在过去 14 天中，将每个中午到中午的一天与下一天逐分钟比较：200 × 一致率 − 100。需要 5 组相邻天数据。"
          }
        }
      }
    },
