    "insights.methodology.baselines.sections.5.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تعتمد خطوط الأساس على مدى ارتدائك لجهازك وعلى مستشعراته. تُعرض القراءة المفقودة على أنها مفقودة، وليست صفرًا أبدًا."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Əsas səviyyələr cihazınızı nə qədər tez-tez taxmağınızdan və onun sensorlarından asılıdır. Çatışmayan göstərici heç vaxt sıfır kimi deyil, çatışmayan kimi göstərilir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Výchozí hodnoty závisí na tom, jak často nosíš své zařízení, a na jeho senzorech. Chybějící měření se zobrazuje jako chybějící, nikdy jako nula."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Basiswerte hängen davon ab, wie oft du dein Gerät trägst, und von seinen Sensoren. Ein fehlender Messwert wird als fehlend angezeigt, nie als null."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baselines depend on how often you wear your device and on its sensors. A missing reading is shown as missing, never as zero."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las referencias dependen de la frecuencia con que llevas tu dispositivo y de sus sensores. Una lectura que falta se muestra como ausente, nunca como cero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les références dépendent de la fréquence à laquelle vous portez votre appareil et de ses capteurs. Une mesure manquante est affichée comme manquante, jamais comme zéro."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बेसलाइन इस पर निर्भर करती है कि आप अपना डिवाइस कितनी बार पहनते हैं और उसके सेंसर कैसे हैं। छूटी रीडिंग छूटी हुई ही दिखाई जाती है, कभी शून्य के रूप में नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I valori di riferimento dipendono da quanto spesso indossi il dispositivo e dai suoi sensori. Una rilevazione mancante viene mostrata come mancante, mai come zero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ベースラインは、デバイスの装着頻度とセンサーによって左右されます。測定値がない場合は欠損として表示され、ゼロとして表示されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "기준치는 기기를 얼마나 자주 착용하는지와 기기의 센서에 따라 달라져요. 누락된 측정값은 누락으로 표시되며, 0으로 표시되지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Basislijnen hangen af van hoe vaak je je apparaat draagt en van de sensoren ervan. Een ontbrekende meting wordt als ontbrekend getoond, nooit als nul."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wartości bazowe zależą od tego, jak często nosisz urządzenie, i od jego czujników. Brakujący odczyt jest pokazywany jako brakujący, nigdy jako zero."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As linhas de base dependem da frequência com que você usa seu dispositivo e dos sensores dele. Uma leitura ausente é mostrada como ausente, nunca como zero."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nivelurile de referință depind de cât de des porți dispozitivul și de senzorii acestuia. O citire lipsă este afișată ca lipsă, niciodată ca zero."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Базовые уровни зависят от того, как часто вы носите устройство, и от его датчиков. Отсутствующее показание отображается как отсутствующее, а не как ноль."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Базові рівні залежать від того, як часто ви носите пристрій, і від його датчиків. Відсутній показник показується як відсутній, ніколи не як нуль."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "基线取决于你佩戴设备的频率及其传感器。缺失的读数会显示为缺失，绝不会显示为零。"
          }
        }
      }
    },
