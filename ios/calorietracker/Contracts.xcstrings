    "insights.methodology.recovery.sections.0.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "التعافي نتيجة صباحية من 0 إلى 100 تقارن إشارات جسمك الليلة الماضية بخطوط الأساس الخاصة بك. تكون جاهزة بمجرد مزامنة نوم الليلة الماضية."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bərpa keçən gecənin bədən siqnallarını sizin öz əsas səviyyələrinizlə müqayisə edən 0-100 arası səhər göstəricisidir. Keçən gecənin yuxusu sinxronlaşdıqdan sonra hazır olur."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Regenerace je ranní skóre 0–100, které porovnává tělesné signály z minulé noci s tvými vlastními výchozími hodnotami. Je připravena, jakmile se synchronizuje spánek z minulé noci."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Erholung ist ein Morgenwert von 0–100, der die Körpersignale der letzten Nacht mit deinen eigenen Basiswerten vergleicht. Sie ist bereit, sobald der Schlaf der letzten Nacht synchronisiert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery is a 0-100 morning score that compares last night's body signals with your own baselines. It is ready once last night's sleep has synced."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La Recuperación es una puntuación matutina de 0 a 100 que compara las señales de tu cuerpo de anoche con tus propias referencias. Está lista en cuanto se sincroniza el sueño de anoche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La Récupération est un score matinal de 0 à 100 qui compare les signaux corporels de la nuit dernière avec vos propres références. Elle est prête une fois le sommeil de la nuit dernière synchronisé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "रिकवरी 0-100 का सुबह का स्कोर है जो पिछली रात के शरीर के संकेतों की तुलना आपकी अपनी बेसलाइन से करता है। पिछली रात की नींद सिंक होते ही यह तैयार हो जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il Recupero è un punteggio mattutino da 0 a 100 che confronta i segnali del corpo della notte scorsa con i tuoi valori di riferimento. È pronto quando il sonno della notte scorsa è stato sincronizzato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "リカバリーは、昨夜の体のシグナルをあなた自身のベースラインと比較する、0〜100の朝のスコアです。昨夜の睡眠データが同期されると利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "회복은 지난밤의 신체 신호를 나의 기준치와 비교하는 0-100점의 아침 점수예요. 지난밤 수면이 동기화되면 준비돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Herstel is een ochtendscore van 0-100 die de lichaamssignalen van afgelopen nacht vergelijkt met je eigen basislijnen. Hij is klaar zodra je slaap van afgelopen nacht is gesynchroniseerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Regeneracja to poranny wynik 0-100, który porównuje sygnały Twojego ciała z ostatniej nocy z Twoimi wartościami bazowymi. Jest gotowa, gdy sen z ostatniej nocy zostanie zsynchronizowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A Recuperação é uma pontuação matinal de 0 a 100 que compara os sinais do seu corpo na noite passada com suas próprias linhas de base. Ela fica pronta assim que o sono da noite passada é sincronizado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Recuperarea este un scor de dimineață de la 0 la 100 care compară semnalele corpului tău de azi-noapte cu propriile niveluri de referință. Este gata după ce se sincronizează somnul de azi-noapte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Восстановление — утренняя оценка от 0 до 100, сравнивающая сигналы тела прошлой ночью с вашими базовыми уровнями. Она готова, как только синхронизирован сон прошлой ночи."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Відновлення — ранкова оцінка від 0 до 100, що порівнює сигнали тіла минулої ночі з вашими власними базовими рівнями. Вона готова, щойно синхронізовано сон минулої ночі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "恢复是 0-100 的早晨分数，将昨晚的身体信号与你自己的基线进行比较。昨晚的睡眠同步后即可查看。"
          }
        }
      }
    },
