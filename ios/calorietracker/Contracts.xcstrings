          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exponentially smoothed average: trend += 0.1 × (weigh-in − trend) on each day with a weigh-in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Media suavizada exponencialmente: tendencia += 0,1 × (pesaje − tendencia) cada día con un pesaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
