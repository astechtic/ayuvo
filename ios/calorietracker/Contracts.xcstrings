        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cum este punctată fiecare dată de intrare"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Как оценивается каждый показатель"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Як оцінюється кожен показник"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "各输入项如何评分"
          }
        }
      }
    },
    "insights.methodology.recovery.sections.3.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "عندما يكون حِمل التدريب أمس مرتفعًا مقارنةً بمتوسطك خلال 28 يومًا، تُخصم 3 نقاط، أو 6 نقاط إذا كان أكثر من ضعف المتوسط."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dünənki məşq yükü 28 günlük ortalamanızla müqayisədə yüksək olduqda 3 bal, ortalamanın iki qatından çox olduqda isə 6 bal çıxılır."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Když byla včerejší tréninková zátěž vysoká v porovnání s tvým 28denním průměrem, odečtou se 3 body, nebo 6, když byla víc než dvojnásobkem průměru."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wenn die Trainingsbelastung von gestern im Vergleich zu deinem 28-Tage-Durchschnitt hoch war, werden 3 Punkte abgezogen, oder 6, wenn sie mehr als doppelt so hoch wie der Durchschnitt war."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When yesterday's training load was high compared with your 28-day average, 3 points are taken off, or 6 when it was more than double the average."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuando la carga de entrenamiento de ayer fue alta en comparación con tu promedio de 28 días, se restan 3 puntos, o 6 si fue más del doble del promedio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lorsque la charge d'entraînement d'hier était élevée par rapport à votre moyenne sur 28 jours, 3 points sont retirés, ou 6 lorsqu'elle dépassait le double de la moyenne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "जब कल का ट्रेनिंग लोड आपके 28-दिन के औसत की तुलना में अधिक था, तो 3 अंक घटाए जाते हैं, या 6 जब वह औसत के दोगुने से अधिक था।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quando il carico di allenamento di ieri era elevato rispetto alla tua media di 28 giorni, vengono tolti 3 punti, o 6 quando era più del doppio della media."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "昨日のトレーニング負荷が28日平均と比べて高かった場合は3ポイント、平均の2倍を超えた場合は6ポイントが差し引かれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "어제 운동 부하가 28일 평균보다 높았으면 3점, 평균의 두 배를 넘었으면 6점이 차감돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Als de trainingsbelasting van gisteren hoog was vergeleken met je 28-daags gemiddelde, gaan er 3 punten af, of 6 als die meer dan het dubbele van het gemiddelde was."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gdy wczorajsze obciążenie treningowe było wysokie w porównaniu z Twoją średnią z 28 dni, odejmowane są 3 punkty lub 6, gdy przekraczało dwukrotność średniej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quando a carga de treino de ontem foi alta em comparação com sua média de 28 dias, são descontados 3 pontos, ou 6 quando ela foi mais que o dobro da média."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Când încărcarea de antrenament de ieri a fost mare față de media ta pe 28 de zile, se scad 3 puncte sau 6 când a fost mai mult decât dublul mediei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Если вчерашняя тренировочная нагрузка была высокой по сравнению с вашим средним за 28 дней, вычитается 3 балла, а если она более чем вдвое превышала среднее — 6."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Коли вчорашнє тренувальне навантаження було високим порівняно з вашим середнім за 28 днів, знімається 3 бали, або 6, якщо воно перевищувало середнє більш ніж удвічі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "如果昨天的训练负荷相对你的 28 天平均值较高，扣 3 分；如果超过平均值的两倍，扣 6 分。"
          }
        }
      }
    },
