    "insights.methodology.background.sections.1.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يطلب Ayuvo من هاتفك تحديث التعافي في الصباح بعد مزامنة النوم. يحدد iOS وAndroid متى يعمل التحديث في الخلفية فعليًا، لذا قد يظهر لاحقًا، أو فقط عند فتح التطبيق."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo yuxu sinxronlaşdıqdan sonra səhər Bərpanı yeniləməyi telefonunuzdan xahiş edir. Fon işinin faktiki olaraq nə vaxt işləyəcəyinə iOS və Android qərar verir, ona görə də o, daha gec və ya yalnız tətbiqi açdığınız zaman görünə bilər."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo žádá telefon, aby ráno po synchronizaci spánku obnovil Regeneraci. Kdy se práce na pozadí skutečně spustí, rozhoduje iOS a Android, takže se může objevit později nebo až po otevření aplikace."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo bittet dein Handy, die Erholung morgens nach der Schlafsynchronisierung zu aktualisieren. iOS und Android entscheiden, wann Hintergrundaufgaben tatsächlich laufen, daher kann sie später erscheinen oder erst, wenn du die App öffnest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo asks your phone to refresh Recovery in the morning after sleep syncs. iOS and Android decide when background work actually runs, so it may appear later, or only when you open the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo pide a tu teléfono que actualice la Recuperación por la mañana cuando se sincroniza el sueño. iOS y Android deciden cuándo se ejecuta realmente el trabajo en segundo plano, así que puede aparecer más tarde o solo cuando abras la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo demande à votre téléphone d'actualiser la Récupération le matin, après la synchronisation du sommeil. iOS et Android décident du moment où les tâches en arrière-plan s'exécutent réellement ; elle peut donc apparaître plus tard, ou seulement à l'ouverture de l'app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "नींद सिंक होने के बाद Ayuvo आपके फ़ोन से सुबह रिकवरी रिफ़्रेश करने को कहता है। बैकग्राउंड काम असल में कब चलेगा, यह iOS और Android तय करते हैं, इसलिए यह देर से दिख सकती है, या केवल ऐप खोलने पर।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo chiede al telefono di aggiornare il Recupero al mattino dopo la sincronizzazione del sonno. iOS e Android decidono quando eseguire effettivamente le attività in background, quindi potrebbe comparire più tardi, o solo quando apri l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvoは、睡眠データの同期後、朝にリカバリーを更新するようスマホに依頼します。バックグラウンド処理を実際にいつ実行するかはiOSとAndroidが決めるため、表示が遅れたり、アプリを開いたときにのみ表示されたりすることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo는 수면이 동기화된 후 아침에 회복을 새로 고치도록 휴대폰에 요청해요. 백그라운드 작업이 실제로 실행되는 시점은 iOS와 Android가 결정하므로 더 늦게 표시되거나 앱을 열 때만 표시될 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo vraagt je telefoon om Herstel 's ochtends te verversen nadat je slaap is gesynchroniseerd. iOS en Android bepalen wanneer achtergrondtaken echt worden uitgevoerd, dus het kan later verschijnen, of pas als je de app opent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo prosi telefon o odświeżenie Regeneracji rano, po synchronizacji snu. iOS i Android decydują, kiedy praca w tle faktycznie się wykona, więc wynik może pojawić się później lub dopiero po otwarciu aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Ayuvo pede ao seu celular para atualizar a Recuperação pela manhã, depois que o sono é sincronizado. O iOS e o Android decidem quando o trabalho em segundo plano realmente é executado, então ela pode aparecer mais tarde ou só quando você abrir o app."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo cere telefonului să actualizeze Recuperarea dimineața, după ce se sincronizează somnul. iOS și Android decid când rulează efectiv procesele în fundal, așa că poate apărea mai târziu sau doar când deschizi aplicația."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo просит телефон обновить восстановление утром после синхронизации сна. iOS и Android сами решают, когда фоновая работа действительно выполняется, поэтому оценка может появиться позже или только при открытии приложения."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo просить телефон оновити Відновлення вранці після синхронізації сну. iOS і Android самі вирішують, коли фонові завдання справді виконуються, тому воно може з'явитися пізніше або лише тоді, коли ви відкриєте застосунок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "睡眠数据同步后，Ayuvo 会请求手机在早晨刷新恢复分数。后台任务的实际运行时间由 iOS 和 Android 决定，因此可能会较晚出现，或仅在你打开 App 时出现。"
          }
        }
      }
    },
