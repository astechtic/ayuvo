    "insights.methodology.patterns.sections.2.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "التمارين المكثفة المتأخرة ونوم تلك الليلة؛ حِمل التدريب المرتفع والتعافي في اليوم التالي؛ تحقيق هدف الماء والتعافي في اليوم التالي؛ تحقيق هدف البروتين وحجم تمارين القوة في اليوم التالي؛ الليلة القصيرة وخطوات ذلك اليوم."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gec intensiv məşqlər və həmin gecənin yuxusu; yüksək məşq yükü və növbəti günün bərpası; su hədəfinə çatmaq və növbəti günün bərpası; protein hədəfinə çatmaq və növbəti günün güc həcmi; qısa gecə və həmin günün addımları."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pozdní intenzivní tréninky a spánek té noci; vysoká tréninková zátěž a regenerace následující den; splnění cíle vody a regenerace následující den; splnění cíle bílkovin a objem silového tréninku následující den; krátká noc a kroky toho dne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Späte intensive Trainings und der Schlaf in dieser Nacht; hohe Trainingsbelastung und die Erholung am nächsten Tag; erreichtes Wasserziel und die Erholung am nächsten Tag; erreichtes Proteinziel und das Kraftvolumen am nächsten Tag; eine kurze Nacht und die Schritte an diesem Tag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Late intense workouts and that night's sleep; high training load and next-day recovery; meeting your water goal and next-day recovery; meeting your protein target and next-day strength volume; a short night and that day's steps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entrenamientos intensos a última hora y el sueño de esa noche; carga de entrenamiento alta y la recuperación del día siguiente; cumplir tu objetivo de agua y la recuperación del día siguiente; cumplir tu objetivo de proteína y el volumen de fuerza del día siguiente; una noche corta y los pasos de ese día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entraînements intenses tardifs et sommeil de la nuit suivante ; charge d'entraînement élevée et récupération du lendemain ; objectif d'eau atteint et récupération du lendemain ; objectif de protéines atteint et volume de musculation du lendemain ; nuit courte et pas de la journée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "देर से किए गए तीव्र वर्कआउट और उस रात की नींद; अधिक ट्रेनिंग लोड और अगले दिन की रिकवरी; पानी का लक्ष्य पूरा करना और अगले दिन की रिकवरी; प्रोटीन लक्ष्य पूरा करना और अगले दिन का स्ट्रेंथ वॉल्यूम; छोटी रात और उस दिन के कदम।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Allenamenti intensi a tarda ora e sonno di quella notte; carico di allenamento elevato e recupero del giorno dopo; raggiungimento dell'obiettivo di acqua e recupero del giorno dopo; raggiungimento dell'obiettivo di proteine e volume di forza del giorno dopo; una notte breve e i passi di quel giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "遅い時間の激しいワークアウトとその夜の睡眠、高いトレーニング負荷と翌日のリカバリー、水分目標の達成と翌日のリカバリー、タンパク質目標の達成と翌日の筋トレのボリューム、短い睡眠とその日の歩数。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "늦은 시간의 고강도 운동과 그날 밤 수면, 높은 운동 부하와 다음 날 회복, 물 목표 달성과 다음 날 회복, 단백질 목표 달성과 다음 날 근력 운동량, 짧은 수면과 그날의 걸음 수."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Late intensieve trainingen en je slaap die nacht; hoge trainingsbelasting en herstel de volgende dag; je waterdoel halen en herstel de volgende dag; je eiwitdoel halen en krachtvolume de volgende dag; een korte nacht en je stappen die dag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Późne intensywne treningi i sen tej nocy; wysokie obciążenie treningowe i regeneracja następnego dnia; osiągnięcie celu wody i regeneracja następnego dnia; osiągnięcie celu białka i objętość treningu siłowego następnego dnia; krótka noc i kroki tego dnia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Treinos intensos tarde da noite e o sono daquela noite; carga de treino alta e a recuperação do dia seguinte; atingir sua meta de água e a recuperação do dia seguinte; atingir sua meta de proteína e o volume de força do dia seguinte; uma noite curta e os passos daquele dia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Antrenamentele intense târzii și somnul din acea noapte; încărcarea mare de antrenament și recuperarea din ziua următoare; atingerea obiectivului de apă și recuperarea din ziua următoare; atingerea țintei de proteine și volumul de forță din ziua următoare; o noapte scurtă și pașii din acea zi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Поздние интенсивные тренировки и сон в ту же ночь; высокая тренировочная нагрузка и восстановление на следующий день; выполнение цели по воде и восстановление на следующий день; выполнение цели по белку и силовой объём на следующий день; короткая ночь и шаги в тот же день."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Пізні інтенсивні тренування і сон тієї ночі; високе тренувальне навантаження і відновлення наступного дня; досягнення мети з води і відновлення наступного дня; досягнення мети з білка і силовий обсяг наступного дня; коротка ніч і кроки того дня."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "晚间高强度训练与当晚睡眠；高训练负荷与次日恢复；达成饮水目标与次日恢复；达成蛋白质目标与次日力量训练量；睡眠不足的夜晚与当天步数。"
          }
        }
      }
    },
