    "insights.methodology.baselines.sections.4.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يستخدم HRV ومعدل ضربات القلب أثناء الراحة وأكسجين الدم ومعدل التنفس القراءات المأخوذة خلال نوم الليلة الماضية. وعندما لا تقع أي قراءة ضمن نافذة نومك، تُستخدم القيمة اليومية بدلًا من ذلك ويُشار إليها بذلك."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HRV, istirahət ürək döyüntüsü, qanda oksigen və tənəffüs tezliyi keçən gecənin yuxusu zamanı alınan göstəricilərdən istifadə edir. Yuxu pəncərənizə heç bir göstərici düşmədikdə, əvəzində gündəlik dəyər istifadə olunur və belə qeyd edilir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HRV, klidová tepová frekvence, okysličení krve a dechová frekvence používají měření pořízená během spánku minulé noci. Když žádné měření nespadá do okna tvého spánku, použije se místo toho denní hodnota a je tak označena."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HRV, Ruheherzfrequenz, Blutsauerstoff und Atemfrequenz nutzen Messwerte aus dem Schlaf der letzten Nacht. Wenn kein Messwert in dein Schlaffenster fällt, wird stattdessen der Tageswert verwendet und entsprechend gekennzeichnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV, resting heart rate, blood oxygen and breathing rate use readings taken during last night's sleep. When no reading falls inside your sleep window, the daily value is used instead and marked as such."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La HRV, la frecuencia cardíaca en reposo, el oxígeno en sangre y la frecuencia respiratoria usan lecturas tomadas durante el sueño de anoche. Cuando ninguna lectura cae dentro de tu ventana de sueño, se usa el valor diario en su lugar y se indica así."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La VFC, la fréquence cardiaque au repos, l'oxygène sanguin et la fréquence respiratoire utilisent des mesures prises pendant le sommeil de la nuit dernière. Si aucune mesure ne tombe dans votre période de sommeil, la valeur quotidienne est utilisée à la place et signalée comme telle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HRV, विश्राम हृदय गति, ब्लड ऑक्सीजन और साँस लेने की दर पिछली रात की नींद के दौरान ली गई रीडिंग का उपयोग करते हैं। जब आपकी नींद की अवधि में कोई रीडिंग न हो, तो इसके बजाय दैनिक मान उपयोग होता है और उसे इसी रूप में चिह्नित किया जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HRV, frequenza cardiaca a riposo, ossigeno nel sangue e frequenza respiratoria usano le rilevazioni effettuate durante il sonno della notte scorsa. Se nessuna rilevazione rientra nella finestra del sonno, viene usato il valore giornaliero, segnalato come tale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HRV、安静時心拍数、血中酸素、呼吸数は、昨夜の睡眠中に測定された値を使用します。睡眠時間帯に測定値がない場合は、代わりに1日の値を使用し、その旨を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HRV, 안정 시 심박수, 혈중 산소, 호흡수는 지난밤 수면 중 측정값을 사용해요. 수면 시간대 안에 측정값이 없으면 대신 일일 값을 사용하고 그렇게 표시해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HRV, hartslag in rust, bloedzuurstof en ademhalingsfrequentie gebruiken metingen tijdens je slaap van afgelopen nacht. Valt er geen meting binnen je slaapperiode, dan wordt de dagwaarde gebruikt en als zodanig gemarkeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HRV, tętno spoczynkowe, natlenienie krwi i częstość oddechów wykorzystują odczyty ze snu ostatniej nocy. Gdy żaden odczyt nie mieści się w oknie snu, używana jest wartość dzienna, odpowiednio oznaczona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HRV, frequência cardíaca em repouso, oxigênio no sangue e frequência respiratória usam leituras feitas durante o sono da noite passada. Quando nenhuma leitura cai dentro da sua janela de sono, o valor diário é usado no lugar e marcado como tal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HRV, pulsul în repaus, oxigenul din sânge și frecvența respiratorie folosesc citiri făcute în timpul somnului de azi-noapte. Când nicio citire nu se încadrează în fereastra de somn, se folosește în schimb valoarea zilnică, marcată ca atare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Для HRV, пульса в покое, кислорода в крови и частоты дыхания используются показания, снятые во время сна прошлой ночью. Если ни одно показание не попадает в окно сна, вместо него используется дневное значение с соответствующей пометкой."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HRV, пульс у спокої, кисень у крові та частота дихання використовують показники, зняті під час сну минулої ночі. Якщо жоден показник не потрапляє у ваш період сну, натомість використовується денне значення з відповідною позначкою."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HRV、静息心率、血氧和呼吸频率使用昨晚睡眠期间测得的读数。如果睡眠时段内没有读数，则改用当天的数值并加以标注。"
          }
        }
      }
    },
