    "derived.metrics.active_hours.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الساعات بين 07:00 و22:00 التي مشيت فيها 250 خطوة على الأقل. يُنصح بقطع الجلوس كل ساعة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "07:00 ilə 22:00 arasında ən azı 250 addım olan saatlar. Oturmağı hər saat kəsmək tövsiyə olunur."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hodiny mezi 07:00 a 22:00 s alespoň 250 kroky. Doporučuje se přerušit sezení každou hodinu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stunden zwischen 07:00 und 22:00 mit mindestens 250 Schritten. Empfohlen wird, das Sitzen jede Stunde zu unterbrechen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hours between 07:00 and 22:00 with at least 250 steps. Breaking up sitting every hour is recommended."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Horas entre las 07:00 y las 22:00 con al menos 250 pasos. Se recomienda interrumpir el tiempo sentado cada hora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Heures entre 07:00 et 22:00 avec au moins 250 pas. Il est recommandé d'interrompre la position assise toutes les heures."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "07:00 और 22:00 के बीच के वे घंटे जिनमें कम से कम 250 कदम हों। हर घंटे बैठना तोड़ने की सलाह दी जाती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ore tra le 07:00 e le 22:00 con almeno 250 passi. È consigliato interrompere la sedentarietà ogni ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "07:00〜22:00の間で250歩以上歩いた時間数です。1時間ごとに座りっぱなしを中断することが推奨されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "07:00-22:00 사이에 250걸음 이상 걸은 시간 수예요. 매시간 앉아 있는 시간을 끊어 주는 것이 권장돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
