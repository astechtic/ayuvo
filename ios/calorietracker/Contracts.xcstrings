    "derived.metrics.weight_trend.method" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "متوسط مُنعَّم أُسّيًا: الاتجاه += 0.1 × (الوزن المسجّل − الاتجاه) في كل يوم يوجد فيه وزن مسجّل."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eksponensial hamarlanmış ortalama: çəki ölçülən hər gün trend += 0,1 × (ölçmə − trend)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Exponenciálně vyhlazený průměr: trend += 0,1 × (vážení − trend) v každý den s vážením."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
