        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nach Tagen, an denen du dein Proteinziel erreicht hast, war dein Kraftvolumen am nächsten Tag im Schnitt {abs_diff} {unit} {direction_word} ({n_exposed} vs. {n_unexposed} Tage)."
