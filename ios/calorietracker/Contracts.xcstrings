    "derived.metrics.hr_max_estimate.method" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "معادلة Tanaka 208 − 0.7 × العمر، وتُرفع إلى أعلى معدل لضربات القلب لمدة دقيقتين خلال آخر 180 يومًا إذا كان أعلى."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tanaka düsturu 208 − 0,7 × yaş; son 180 gündə görülən ən yüksək 2 dəqiqəlik ürək döyüntüsü daha yüksəkdirsə, ona qədər qaldırılır."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tanakův vzorec 208 − 0,7 × věk, zvýšený na nejvyšší 2minutovou tepovou frekvenci za posledních 180 dní, pokud je vyšší."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tanaka-Formel 208 − 0,7 × Alter, angehoben auf die höchste 2-Minuten-Herzfrequenz der letzten 180 Tage, falls diese höher ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanaka formula 208 − 0.7 × age, raised to the highest 2-minute heart rate seen in the last 180 days when that is higher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fórmula de Tanaka 208 − 0,7 × edad, elevada a la frecuencia cardíaca de 2 minutos más alta registrada en los últimos 180 días cuando esta es mayor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Formule de Tanaka 208 − 0,7 × âge, relevée à la fréquence cardiaque la plus élevée sur 2 minutes observée au cours des 180 derniers jours si elle est supérieure."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tanaka फ़ॉर्मूला 208 − 0.7 × आयु, जिसे पिछले 180 दिनों में देखी गई सबसे अधिक 2-मिनट हृदय गति तक बढ़ाया जाता है, अगर वह अधिक हो।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Formula di Tanaka 208 − 0,7 × età, portata alla frequenza cardiaca più alta su 2 minuti rilevata negli ultimi 180 giorni se questa è superiore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "田中の式 208 − 0.7 × 年齢。過去180日間に見られた2分間の最高心拍数の方が高い場合は、その値に引き上げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tanaka 공식 208 − 0.7 × 나이. 최근 180일 동안 기록된 가장 높은 2분 심박수가 더 높으면 그 값으로 올려요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tanaka-formule 208 − 0,7 × leeftijd, verhoogd tot de hoogste hartslag over 2 minuten in de laatste 180 dagen als die hoger is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wzór Tanaki 208 − 0,7 × wiek, podniesiony do najwyższego 2-minutowego tętna z ostatnich 180 dni, jeśli jest wyższe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fórmula de Tanaka 208 − 0,7 × idade, elevada para a maior frequência cardíaca de 2 minutos observada nos últimos 180 dias quando esta for maior."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Formula Tanaka 208 − 0,7 × vârsta, ridicată la cel mai mare puls pe 2 minute din ultimele 180 de zile, dacă acesta este mai mare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Формула Танаки 208 − 0,7 × возраст, повышенная до наибольшего 2-минутного пульса за последние 180 дней, если он выше."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Формула Танаки 208 − 0,7 × вік, підвищена до найвищого 2-хвилинного пульсу за останні 180 днів, якщо той вищий."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tanaka 公式 208 − 0.7 × 年龄；若过去 180 天内出现的最高 2 分钟心率更高，则采用该值。"
          }
        }
      }
    },
