        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Proteína registrada por kilogramo de peso corporal. 1,4-2,0 g/kg al día favorece el entrenamiento de fuerza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Protéines enregistrées par kilogramme de poids corporel. 1,4-2,0 g/kg par jour soutient l'entraînement de musculation."
