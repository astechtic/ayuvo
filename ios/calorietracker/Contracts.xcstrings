    "derived.metrics.sleep_efficiency.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "نسبة الوقت الذي قضيته نائمًا من وقتك في السرير. تُعد نسبة 85% أو أكثر جيدة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yataqda keçirdiyiniz vaxtın yuxuda keçən payı. 85% və ya daha çox yaxşı hesab olunur."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
