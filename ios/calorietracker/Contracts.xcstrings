    "cycle.insights.out_of_range.template" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{count} من دوراتك الـ{total} الأخيرة كانت أقصر من {low} أو أطول من {high} يومًا. هناك أسباب محتملة كثيرة؛ يُستحسن مناقشة هذا النمط مع مختص رعاية صحية إذا استمر."
          }
        },
        "az" : {
          "stringUnit" : {
