    "derived.metrics.sleep_midpoint.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "المنتصف بين الخلود إلى النوم والاستيقاظ. يتتبع توقيت ساعتك البيولوجية."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yuxuya getmə ilə oyanma arasındakı orta nöqtə. Bədən saatınızın vaxtını izləyir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Polovina mezi usnutím a probuzením. Sleduje načasování tvých vnitřních hodin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Mitte zwischen Einschlafen und Aufwachen. Sie zeigt das Timing deiner inneren Uhr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halfway between falling asleep and waking. It tracks your body-clock timing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El punto medio entre dormirte y despertarte. Refleja el horario de tu reloj biológico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le milieu entre l'endormissement et le réveil. Il reflète le rythme de votre horloge biologique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सोने और जागने के बीच का आधा समय। यह आपकी बॉडी-क्लॉक की टाइमिंग को ट्रैक करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il punto a metà tra l'addormentamento e il risveglio. Segue la tempistica del tuo orologio biologico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "眠りについてから目覚めるまでの中間点です。体内時計のタイミングを表します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "잠든 시간과 깬 시간의 중간 지점이에요. 생체 시계의 타이밍을 보여줘요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halverwege tussen inslapen en wakker worden. Dit volgt de timing van je biologische klok."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Połowa czasu między zaśnięciem a przebudzeniem. Odzwierciedla rytm Twojego zegara biologicznego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O ponto intermediário entre adormecer e acordar. Acompanha o ritmo do seu relógio biológico."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Punctul de la jumătatea dintre adormire și trezire. Reflectă ritmul ceasului tău biologic."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Середина между засыпанием и пробуждением. Отражает работу ваших внутренних часов."
