    "derived.metrics.wear_minutes.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "عدد الدقائق التي سجّل فيها جهازك القابل للارتداء معدل ضربات القلب اليوم. يُحتسب اليوم الذي يبلغ 10 ساعات أو أكثر يومًا صالحًا."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bu gün taxılan cihazınızın neçə dəqiqə ürək döyüntüsü qeyd etdiyi. 10 saat və ya daha çox olan gün etibarlı gün sayılır."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kolik minut dnes tvé nositelné zařízení zaznamenávalo tepovou frekvenci. Den s 10 a více hodinami se počítá jako platný."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wie viele Minuten dein Wearable heute die Herzfrequenz aufgezeichnet hat. Ein Tag mit 10 Stunden oder mehr zählt als gültiger Tag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How many minutes today your wearable recorded heart rate. A day with 10 hours or more is counted as a valid day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuántos minutos registró hoy tu wearable la frecuencia cardíaca. Un día con 10 horas o más cuenta como día válido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nombre de minutes aujourd'hui pendant lesquelles votre appareil connecté a enregistré la fréquence cardiaque. Une journée de 10 heures ou plus compte comme journée valide."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आज आपके वियरेबल ने कितने मिनट हृदय गति रिकॉर्ड की। 10 घंटे या उससे अधिक वाला दिन मान्य दिन गिना जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quanti minuti oggi il tuo dispositivo indossabile ha registrato la frequenza cardiaca. Un giorno con 10 ore o più viene considerato valido."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "今日ウェアラブルが心拍数を記録した時間（分）です。10時間以上の日が有効な日として数えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "오늘 웨어러블이 심박수를 기록한 시간(분)이에요. 10시간 이상 기록된 날은 유효한 날로 계산돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hoeveel minuten je wearable vandaag hartslag heeft vastgelegd. Een dag met 10 uur of meer telt als geldige dag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przez ile minut dzisiaj Twoje urządzenie noszone rejestrowało tętno. Dzień z 10 godzinami lub więcej liczy się jako ważny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quantos minutos hoje seu wearable registrou a frequência cardíaca. Um dia com 10 horas ou mais conta como dia válido."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Câte minute a înregistrat azi dispozitivul purtabil pulsul. O zi cu 10 ore sau mai mult este considerată o zi validă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сколько минут сегодня носимое устройство записывало пульс. День с 10 часами и более считается полноценным."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Скільки хвилин сьогодні ваш носимий пристрій записував пульс. День із 10 годинами або більше вважається повноцінним."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "今天你的可穿戴设备记录心率的分钟数。达到 10 小时或以上的一天计为有效天。"
          }
        }
      }
