          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{count} deiner letzten {total} Zyklen waren kürzer als {low} oder länger als {high} Tage. Dafür gibt es viele mögliche Gründe; besprich dieses Muster mit medizinischem Fachpersonal, wenn es anhält."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
