    "insights.methodology.patterns.sections.0.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يقارن Ayuvo الأيام التي حدث فيها شيء ما بالأيام التي لم يحدث فيها، مثل تمرين مكثف متأخر، وينظر إلى ما حدث بعده، مثل نوم تلك الليلة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo gec intensiv məşq kimi bir şeyin olduğu və olmadığı günləri müqayisə edir və sonra nə baş verdiyinə, məsələn, həmin gecənin yuxusuna baxır."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo porovnává dny s něčím a bez toho, například s pozdním intenzivním tréninkem, a sleduje, co následovalo, například spánek té noci."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo vergleicht Tage mit und ohne etwas, etwa ein spätes intensives Training, und schaut, was danach passiert ist, etwa der Schlaf in dieser Nacht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo compares days with and without something, such as a late intense workout, and looks at what happened next, such as that night's sleep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo compara días con y sin algo, como un entrenamiento intenso a última hora, y observa lo que pasó después, como el sueño de esa noche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo compare les jours avec et sans un élément, comme un entraînement intense tardif, et observe ce qui s'est passé ensuite, comme le sommeil de la nuit suivante."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo किसी चीज़ के साथ और उसके बिना वाले दिनों की तुलना करता है, जैसे देर से किया गया तीव्र वर्कआउट, और देखता है कि आगे क्या हुआ, जैसे उस रात की नींद।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo confronta i giorni con e senza qualcosa, come un allenamento intenso a tarda ora, e osserva cosa è successo dopo, come il sonno di quella notte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvoは、遅い時間の激しいワークアウトなど、何かがあった日となかった日を比較し、その夜の睡眠など、その後に何が起きたかを確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo는 늦은 시간의 고강도 운동처럼 어떤 일이 있었던 날과 없었던 날을 비교하고, 그날 밤 수면처럼 그다음에 일어난 일을 살펴봐요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo vergelijkt dagen met en zonder iets, zoals een late intensieve training, en kijkt wat er daarna gebeurde, zoals je slaap die nacht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo porównuje dni z czymś i bez tego, np. z późnym intensywnym treningiem, i sprawdza, co działo się potem, np. ze snem tej nocy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Ayuvo compara dias com e sem algo, como um treino intenso tarde da noite, e observa o que aconteceu depois, como o sono daquela noite."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo compară zilele cu și fără ceva, precum un antrenament intens târziu, și se uită la ce s-a întâmplat după, de exemplu la somnul din acea noapte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo сравнивает дни с каким-либо событием и без него, например с поздней интенсивной тренировкой, и смотрит, что было дальше, например сон в ту ночь."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo порівнює дні з певною подією і без неї, як-от пізнє інтенсивне тренування, і дивиться, що сталося далі, наприклад на сон тієї ночі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo 会比较有和没有某种情况的日子（例如晚间高强度训练），并观察之后发生了什么（例如当晚的睡眠）。"
          }
        }
      }
    },
