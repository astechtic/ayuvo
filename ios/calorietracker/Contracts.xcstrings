    "insights.patterns.pairs.water_goal_recovery.template" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بعد الأيام التي حققت فيها هدف الماء، كان تعافيك في اليوم التالي {direction_word} بمقدار {abs_diff} {unit} في المتوسط ({n_exposed} مقابل {n_unexposed} يوم)."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Su hədəfinizə çatdığınız günlərdən sonra növbəti günkü bərpanız orta hesabla {abs_diff} {unit} {direction_word} olub ({n_exposed} və {n_unexposed} gün)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Po dnech, kdy jsi splnil(a) cíl vody, byla tvá regenerace následující den v průměru o {abs_diff} {unit} {direction_word} (počet dní: {n_exposed} vs. {n_unexposed})."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nach Tagen, an denen du dein Wasserziel erreicht hast, war deine Erholung am nächsten Tag im Schnitt {abs_diff} {unit} {direction_word} ({n_exposed} vs. {n_unexposed} Tage)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After days you met your water goal, your next-day recovery has been {abs_diff} {unit} {direction_word} on average ({n_exposed} vs {n_unexposed} days)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tras los días en que cumpliste tu objetivo de agua, tu recuperación del día siguiente ha sido de media {abs_diff} {unit} {direction_word} ({n_exposed} frente a {n_unexposed} días)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Après les jours où vous avez atteint votre objectif d'eau, votre score de récupération du lendemain a été en moyenne {direction_word} de {abs_diff} {unit} ({n_exposed} vs {n_unexposed} jours)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "जिन दिनों आपने पानी का लक्ष्य पूरा किया, उनके बाद अगले दिन आपकी रिकवरी औसतन {abs_diff} {unit} {direction_word} रही है ({n_exposed} बनाम {n_unexposed} दिन)।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dopo i giorni in cui hai raggiunto l'obiettivo di acqua, il tuo recupero del giorno dopo è stato in media {abs_diff} {unit} {direction_word} ({n_exposed} vs {n_unexposed} giorni)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "水分目標を達成した日の翌日は、リカバリーが平均で{abs_diff} {unit} {direction_word}でした（{n_exposed}日 対 {n_unexposed}日）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "물 목표를 달성한 날 이후 다음 날 회복: 평균 {abs_diff} {unit} {direction_word} ({n_exposed}일 대 {n_unexposed}일)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Na dagen waarop je je waterdoel haalde, was je herstel de volgende dag gemiddeld {abs_diff} {unit} {direction_word} ({n_exposed} vs. {n_unexposed} dagen)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Po dniach, w których osiągnąłeś cel wody, Twoja regeneracja następnego dnia: średnio {abs_diff} {unit} {direction_word} ({n_exposed} vs {n_unexposed} dni)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Depois de dias em que você atingiu sua meta de água, sua recuperação no dia seguinte tem sido {abs_diff} {unit} {direction_word} em média ({n_exposed} vs. {n_unexposed} dias)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "După zilele în care ți-ai atins obiectivul de apă, recuperarea ta din ziua următoare a fost în medie {abs_diff} {unit} {direction_word} ({n_exposed} față de {n_unexposed} zile)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "После дней, когда вы выполнили цель по воде, ваше восстановление на следующий день в среднем на {abs_diff} {unit} {direction_word} (дней: {n_exposed} против {n_unexposed})."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Після днів, коли ви досягли мети з води, ваше відновлення наступного дня в середньому було на {abs_diff} {unit} {direction_word} ({n_exposed} проти {n_unexposed} днів)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在达成饮水目标的日子之后，你次日的恢复平均{direction_word} {abs_diff} {unit}（{n_exposed} 天对比 {n_unexposed} 天）。"
          }
        }
      }
    },
