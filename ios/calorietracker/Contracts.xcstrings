      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بعد الأيام التي حققت فيها هدف البروتين، كان حجم تمارين القوة في اليوم التالي {direction_word} بمقدار {abs_diff} {unit} في المتوسط ({n_exposed} مقابل {n_unexposed} يوم)."
