    "derived.metrics.hr_reserve.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الفرق بين الحد الأقصى لمعدل ضربات قلبك ومعدله أثناء الراحة. الاحتياطي الأكبر يعني عادةً لياقة أفضل."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Maksimal və istirahət ürək döyüntünüz arasındakı fərq. Daha böyük ehtiyat adətən daha yaxşı fiziki forma deməkdir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rozdíl mezi tvou maximální a klidovou tepovou frekvencí. Větší rezerva obvykle znamená lepší kondici."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Abstand zwischen deiner maximalen und deiner Ruheherzfrequenz. Eine größere Reserve bedeutet meist eine bessere Fitness."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The gap between your maximum and resting heart rate. A larger reserve usually means better fitness."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La diferencia entre tu frecuencia cardíaca máxima y en reposo. Una reserva mayor suele indicar mejor forma física."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'écart entre votre fréquence cardiaque maximale et au repos. Une réserve plus grande indique généralement une meilleure forme."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपकी अधिकतम और विश्राम हृदय गति के बीच का अंतर। बड़ा रिज़र्व आमतौर पर बेहतर फिटनेस दर्शाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La differenza tra la tua frequenza cardiaca massima e quella a riposo. Una riserva maggiore di solito indica una forma fisica migliore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "最大心拍数と安静時心拍数の差です。予備能が大きいほど、通常は体力が高いことを意味します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "최대 심박수와 안정 시 심박수의 차이예요. 예비량이 클수록 대개 체력이 더 좋다는 뜻이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Het verschil tussen je maximale hartslag en je hartslag in rust. Een grotere reserve betekent meestal een betere conditie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Różnica między Twoim tętnem maksymalnym a spoczynkowym. Większa rezerwa zwykle oznacza lepszą wydolność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A diferença entre sua frequência cardíaca máxima e a em repouso. Uma reserva maior geralmente indica melhor condicionamento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Diferența dintre pulsul tău maxim și cel în repaus. O rezervă mai mare înseamnă de obicei o condiție fizică mai bună."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Разница между максимальным пульсом и пульсом в покое. Больший резерв обычно означает лучшую физическую форму."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Різниця між вашим максимальним пульсом і пульсом у спокої. Більший резерв зазвичай означає кращу фізичну форму."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你的最大心率与静息心率之差。储备越大通常意味着体能越好。"
          }
        }
      }
    },
