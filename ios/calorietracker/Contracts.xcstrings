        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "النسبة المولية للصوديوم إلى البوتاسيوم. تقترح منظمة الصحة العالمية إبقاءها أقل من 1. غالبًا لا يُحتسب الملح المضاف أثناء الطهي في تقديرات الطعام."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Natriumun kaliuma molyar nisbəti. ÜST onu 1-dən aşağı saxlamağı tövsiyə edir. Bişirmə zamanı əlavə edilən duz çox vaxt qida təxminlərində olmur."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Molární poměr sodíku a draslíku. WHO doporučuje udržovat ho pod 1. Sůl přidaná při vaření často v odhadech jídla chybí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Molares Verhältnis von Natrium zu Kalium. Die WHO empfiehlt, es unter 1 zu halten. Beim Kochen zugesetztes Salz ist in Lebensmittelschätzungen oft nicht enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Molar ratio of sodium to potassium. WHO suggests keeping it below 1. Salt added while cooking is often not in food estimates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Proporción molar de sodio a potasio. La OMS sugiere mantenerla por debajo de 1. La sal añadida al cocinar a menudo no aparece en las estimaciones de alimentos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rapport molaire sodium/potassium. L'OMS suggère de le maintenir en dessous de 1. Le sel ajouté en cuisinant n'est souvent pas inclus dans les estimations alimentaires."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सोडियम और पोटैशियम का मोलर अनुपात। WHO इसे 1 से कम रखने का सुझाव देता है। खाना बनाते समय डाला गया नमक अक्सर भोजन के अनुमानों में शामिल नहीं होता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rapporto molare tra sodio e potassio. L'OMS suggerisce di mantenerlo sotto 1. Il sale aggiunto durante la cottura spesso non è incluso nelle stime degli alimenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ナトリウムとカリウムのモル比です。WHOは1未満に保つことを推奨しています。調理中に加えた塩は食品の推定値に含まれないことがよくあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "나트륨 대 칼륨의 몰 비율이에요. WHO는 1 미만으로 유지할 것을 제안해요. 조리 중 추가한 소금은 음식 추정치에 포함되지 않는 경우가 많아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Molaire verhouding tussen natrium en kalium. De WHO adviseert die onder 1 te houden. Zout dat tijdens het koken wordt toegevoegd, zit vaak niet in voedingsschattingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stosunek molowy sodu do potasu. WHO zaleca utrzymywać go poniżej 1. Sól dodana podczas gotowania często nie jest uwzględniona w szacunkach jedzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Razão molar entre sódio e potássio. A OMS sugere mantê-la abaixo de 1. O sal adicionado ao cozinhar muitas vezes não entra nas estimativas dos alimentos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Raportul molar dintre sodiu și potasiu. OMS sugerează să-l menții sub 1. Sarea adăugată la gătit adesea nu apare în estimările alimentelor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Молярное соотношение натрия и калия. ВОЗ советует держать его ниже 1. Соль, добавленная при готовке, часто не учитывается в оценках еды."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Молярне співвідношення натрію до калію. ВООЗ радить тримати його нижче 1. Сіль, додану під час готування, часто не враховано в оцінках їжі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "钠与钾的摩尔比。WHO 建议保持在 1 以下。烹饪时添加的盐通常不包含在食物估算中。"
          }
        }
      }
    },
