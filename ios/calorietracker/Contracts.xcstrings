    "derived.metrics.iron_absorption_risk.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "عدد المرات التي تناولت فيها الشاي أو القهوة خلال ساعة من طعام غني بالحديد، وهو ما قد يقلل مقدار الحديد الذي تمتصه."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dəmirlə zəngin qidadan bir saat ərzində çay və ya qəhvə içdiyiniz hallar; bu, udduğunuz dəmirin miqdarını azalda bilər."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kolikrát jsi pil(a) čaj nebo kávu do hodiny od jídla bohatého na železo, což může snížit, kolik železa vstřebáš."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wie oft du Tee oder Kaffee innerhalb einer Stunde nach einem eisenreichen Lebensmittel getrunken hast, was die Eisenaufnahme verringern kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Times you had tea or coffee within an hour of an iron-rich food, which can reduce how much iron you absorb."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Veces que tomaste té o café a menos de una hora de un alimento rico en hierro, lo que puede reducir cuánto hierro absorbes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nombre de fois où vous avez pris du thé ou du café dans l'heure suivant un aliment riche en fer, ce qui peut réduire la quantité de fer absorbée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कितनी बार आपने आयरन-युक्त भोजन के एक घंटे के भीतर चाय या कॉफ़ी ली, जिससे आपके शरीर में आयरन का अवशोषण कम हो सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le volte in cui hai bevuto tè o caffè entro un'ora da un alimento ricco di ferro, il che può ridurre la quantità di ferro assorbita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "鉄分の多い食品の前後1時間以内にお茶やコーヒーを飲んだ回数です。鉄の吸収量が減る可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "철분이 풍부한 음식을 먹은 지 1시간 이내에 차나 커피를 마신 횟수예요. 이렇게 하면 철분 흡수량이 줄어들 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Keren dat je thee of koffie dronk binnen een uur na ijzerrijk eten, wat kan verminderen hoeveel ijzer je opneemt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ile razy piłeś herbatę lub kawę w ciągu godziny od jedzenia bogatego w żelazo, co może zmniejszać wchłanianie żelaza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vezes em que você tomou chá ou café até uma hora antes ou depois de um alimento rico em ferro, o que pode reduzir quanto ferro você absorve."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De câte ori ai băut ceai sau cafea în decurs de o oră de la un aliment bogat în fier, ceea ce poate reduce cât fier absorbi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сколько раз вы пили чай или кофе в течение часа после богатой железом еды, что может снизить усвоение железа."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Скільки разів ви пили чай або каву протягом години після їжі, багатої на залізо, що може зменшити засвоєння заліза."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你在食用富铁食物前后一小时内喝茶或咖啡的次数，这可能会减少铁的吸收。"
          }
        }
      }
    },
