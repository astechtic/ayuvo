    "insights.methodology.recovery.sections.2.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يبدأ كل مُدخل من 50 لليلة معتادة ويتحرك 20 نقطة لكل وحدة تشتت أعلى أو أقل من المعتاد، في الاتجاه الصحي: HRV الأعلى يعطي نتيجة أعلى، ومعدل ضربات القلب أثناء الراحة الأعلى يعطي نتيجة أقل. لا يخفض معدل التنفس النتيجة إلا عندما يكون خارج نطاقك المعتاد بوضوح، ولا يخفضها أكسجين الدم إلا عندما يكون أقل من المعتاد بوضوح."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hər giriş tipik gecə üçün 50-dən başlayır və adi halınızdan yuxarı və ya aşağı hər yayılma üçün sağlam istiqamətdə 20 bal dəyişir: daha yüksək HRV daha yüksək bal, daha yüksək istirahət ürək döyüntüsü daha aşağı bal verir. Tənəffüs tezliyi yalnız adi aralığınızdan xeyli kənarda olduqda, qanda oksigen isə yalnız adi səviyyənizdən xeyli aşağı olduqda göstəricini aşağı salır."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Každý vstup začíná na 50 pro typickou noc a posouvá se o 20 bodů za každý rozptyl nad nebo pod obvyklou hodnotou, ve zdravém směru: vyšší HRV dává vyšší skóre, vyšší klidová tepová frekvence nižší. Dechová frekvence snižuje skóre, jen když je výrazně mimo tvé obvyklé rozmezí, a okysličení krve, jen když je výrazně pod obvyklou hodnotou."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jede Eingabe beginnt für eine typische Nacht bei 50 und verschiebt sich um 20 Punkte pro Streuung über oder unter deinem Üblichen, in gesunder Richtung: Eine höhere HRV ergibt einen höheren Wert, eine höhere Ruheherzfrequenz einen niedrigeren. Die Atemfrequenz senkt den Wert nur, wenn sie deutlich außerhalb deines üblichen Bereichs liegt, und der Blutsauerstoff nur, wenn er deutlich unter deinem Üblichen liegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each input starts at 50 for a typical night and moves 20 points for each spread above or below your usual, in the healthy direction: higher HRV scores higher, a higher resting heart rate scores lower. Breathing rate only lowers the score when it is well outside your usual range, and blood oxygen only when it is well below your usual."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada dato parte de 50 en una noche típica y se mueve 20 puntos por cada dispersión por encima o por debajo de lo habitual, en la dirección saludable: una HRV más alta puntúa más, una frecuencia cardíaca en reposo más alta puntúa menos. La frecuencia respiratoria solo reduce la puntuación cuando está muy fuera de tu rango habitual, y el oxígeno en sangre solo cuando está muy por debajo de lo habitual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chaque donnée part de 50 pour une nuit typique et varie de 20 points par écart type au-dessus ou en dessous de l'habitude, dans le sens favorable à la santé : une VFC plus élevée donne un score plus élevé, une fréquence cardiaque au repos plus élevée un score plus bas. La fréquence respiratoire ne fait baisser le score que lorsqu'elle est nettement en dehors de votre plage habituelle, et l'oxygène sanguin seulement lorsqu'il est nettement en dessous de l'habitude."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हर इनपुट सामान्य रात के लिए 50 से शुरू होता है और आपके सामान्य से ऊपर या नीचे हर फैलाव पर स्वस्थ दिशा में 20 अंक बदलता है: अधिक HRV का स्कोर अधिक, अधिक विश्राम हृदय गति का स्कोर कम। साँस लेने की दर स्कोर तभी घटाती है जब वह आपकी सामान्य सीमा से काफ़ी बाहर हो, और ब्लड ऑक्सीजन तभी जब वह आपके सामान्य से काफ़ी कम हो।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ogni dato parte da 50 per una notte tipica e si sposta di 20 punti per ogni dispersione sopra o sotto il tuo solito, nella direzione sana: un'HRV più alta dà un punteggio più alto, una frequenza cardiaca a riposo più alta dà un punteggio più basso. La frequenza respiratoria abbassa il punteggio solo quando è molto al di fuori del tuo intervallo abituale, e l'ossigeno nel sangue solo quando è molto al di sotto del solito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "各入力は典型的な夜を50として始まり、普段よりばらつき1つ分上下するごとに、健康的な方向へ20ポイント動きます：HRVは高いほどスコアが高く、安静時心拍数は高いほどスコアが低くなります。呼吸数は普段の範囲から大きく外れた場合のみ、血中酸素は普段より大きく下回った場合のみスコアを下げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "각 입력값은 일반적인 밤 기준 50점에서 시작해 평소보다 분포 한 단위 높거나 낮을 때마다 건강한 방향으로 20점씩 움직여요. HRV가 높을수록 점수가 높고, 안정 시 심박수가 높을수록 점수가 낮아요. 호흡수는 평소 범위를 크게 벗어날 때만, 혈중 산소는 평소보다 크게 낮을 때만 점수를 낮춰요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elke invoer begint op 50 voor een gewone nacht en verschuift 20 punten per spreiding boven of onder normaal, in de gezonde richting: hogere HRV scoort hoger, een hogere hartslag in rust scoort lager. Ademhalingsfrequentie verlaagt de score alleen als die ruim buiten je normale bereik ligt, en bloedzuurstof alleen als die ruim onder normaal ligt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Każda dana zaczyna od 50 dla typowej nocy i przesuwa się o 20 punktów za każdy rozrzut powyżej lub poniżej Twojej normy, w zdrowym kierunku: wyższe HRV daje wyższy wynik, wyższe tętno spoczynkowe — niższy. Częstość oddechów obniża wynik tylko wtedy, gdy jest wyraźnie poza Twoim zwykłym zakresem, a natlenienie krwi tylko wtedy, gdy jest wyraźnie poniżej normy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada entrada começa em 50 para uma noite típica e se move 20 pontos para cada dispersão acima ou abaixo do habitual, na direção saudável: HRV mais alta pontua mais, frequência cardíaca em repouso mais alta pontua menos. A frequência respiratória só reduz a pontuação quando está bem fora da sua faixa habitual, e o oxigênio no sangue só quando está bem abaixo do habitual."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fiecare dată de intrare pornește de la 50 pentru o noapte obișnuită și se mută cu 20 de puncte pentru fiecare dispersie peste sau sub obișnuit, în direcția sănătoasă: un HRV mai mare dă un scor mai mare, un puls în repaus mai mare dă un scor mai mic. Frecvența respiratorie scade scorul doar când este mult în afara intervalului obișnuit, iar oxigenul din sânge doar când este mult sub obișnuit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Каждый показатель начинается с 50 для обычной ночи и сдвигается на 20 баллов за каждый разброс выше или ниже обычного в сторону здоровья: более высокая HRV даёт более высокую оценку, более высокий пульс в покое — более низкую. Частота дыхания снижает оценку, только если она заметно выходит за обычный диапазон, а кислород в крови — только если он заметно ниже обычного."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Кожен показник починається з 50 для типової ночі й зміщується на 20 балів за кожен розкид вище або нижче звичного у здоровому напрямку: вища HRV дає вищу оцінку, вищий пульс у спокої — нижчу. Частота дихання знижує оцінку, лише коли вона значно виходить за звичний діапазон, а кисень у крові — лише коли він значно нижчий за звичний."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每个输入项在典型夜晚从 50 分开始，每高于或低于平时一个标准差，就按健康方向变化 20 分：HRV 越高得分越高，静息心率越高得分越低。呼吸频率仅在明显超出你的平时范围时才会降低分数，血氧仅在明显低于平时时才会降低分数。"
          }
        }
      }
    },
