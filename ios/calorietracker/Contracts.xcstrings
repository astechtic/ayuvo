    "derived.metrics.sound_dose.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مقدار ما استخدمته من الحد الأسبوعي للاستماع الآمن، حيث تعادل 100% أسبوعيًا 80 dB لمدة 40 ساعة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Həftəlik təhlükəsiz dinləmə limitinin nə qədərini istifadə etdiyiniz; həftədə 100% 40 saat ərzində 80 dB deməkdir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kolik z týdenního limitu bezpečného poslechu jsi využil(a), přičemž 100 % týdně odpovídá 80 dB po dobu 40 hodin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wie viel des wöchentlichen Kontingents für sicheres Hören du genutzt hast, wobei 100 % pro Woche 80 dB über 40 Stunden entsprechen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How much of the weekly safe-listening allowance you used, where 100% a week is 80 dB for 40 hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuánto usaste de la exposición semanal de escucha segura, donde el 100 % semanal equivale a 80 dB durante 40 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La part de votre limite hebdomadaire d'écoute sans risque que vous avez utilisée, 100 % par semaine correspondant à 80 dB pendant 40 heures."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "साप्ताहिक सुरक्षित सुनने की सीमा का आपने कितना हिस्सा उपयोग किया, जहाँ सप्ताह का 100% यानी 40 घंटे के लिए 80 dB है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quanto hai usato della quota settimanale di ascolto sicuro, dove il 100% a settimana equivale a 80 dB per 40 ore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "週間の安全な聴取量のうち、どれだけ使ったかを示します。週100%は80 dBで40時間に相当します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "주간 안전 청취 허용량 중 사용한 비율이에요. 주당 100%는 80 dB로 40시간이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hoeveel van het wekelijkse veilige luistertegoed je hebt gebruikt, waarbij 100% per week gelijk is aan 80 dB gedurende 40 uur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jaką część tygodniowego limitu bezpiecznego słuchania wykorzystałeś, gdzie 100% tygodniowo to 80 dB przez 40 godzin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quanto você usou da cota semanal de audição segura, em que 100% por semana equivale a 80 dB por 40 horas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cât ai folosit din limita săptămânală de ascultare sigură, unde 100% pe săptămână înseamnă 80 dB timp de 40 de ore."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Какую часть недельной нормы безопасного прослушивания вы использовали; 100% в неделю — это 80 дБ в течение 40 часов."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Яку частку тижневої норми безпечного прослуховування ви використали, де 100% за тиждень — це 80 дБ протягом 40 годин."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你使用了每周安全聆听限额的多少，每周 100% 相当于 80 dB 持续 40 小时。"
          }
        }
      }
    },
