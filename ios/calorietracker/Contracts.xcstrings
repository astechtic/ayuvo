          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "直近{total}回の周期のうち{count}回が{low}日より短いか{high}日より長くなりました。理由はいろいろ考えられます。続く場合は、医療専門家への相談を検討してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
