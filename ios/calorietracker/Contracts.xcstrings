    "derived.metrics.sleep_timing_variability.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مدى تفاوت وقت نومك خلال آخر 14 ليلة. أقل من 30-60 دقيقة يُعد منتظمًا."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Son 14 gecə ərzində yatma vaxtınızın nə qədər dəyişdiyi. 30-60 dəqiqədən az olması müntəzəm sayılır."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jak moc se tvůj čas usínání liší za posledních 14 nocí. Méně než 30–60 minut je pravidelné."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wie stark deine Schlafenszeit in den letzten 14 Nächten schwankt. Unter 30–60 Minuten gilt als regelmäßig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How much your bedtime varies across the last 14 nights. Under 30-60 minutes is regular."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuánto varía tu hora de acostarte en las últimas 14 noches. Menos de 30-60 minutos es regular."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'amplitude de variation de votre heure de coucher sur les 14 dernières nuits. Moins de 30-60 minutes est régulier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "पिछली 14 रातों में आपके सोने का समय कितना बदलता है। 30-60 मिनट से कम नियमित है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quanto varia l'ora in cui vai a letto nelle ultime 14 notti. Meno di 30-60 minuti è regolare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "過去14夜の就寝時刻のばらつきです。30〜60分未満なら規則的です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "최근 14일 밤 동안 취침 시간이 얼마나 달라졌는지 보여줘요. 30-60분 미만이면 규칙적이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hoeveel je bedtijd varieert over de laatste 14 nachten. Minder dan 30-60 minuten is regelmatig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jak bardzo zmienia się pora zasypiania w ciągu ostatnich 14 nocy. Poniżej 30-60 minut oznacza regularność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quanto sua hora de dormir varia nas últimas 14 noites. Menos de 30-60 minutos é regular."
          }
        },
        "ro" : {
          "stringUnit" : {
