    "derived.metrics.sleep_onset_latency.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "المدة التي استغرقتها للخلود إلى النوم بعد الدخول إلى السرير. حتى 30 دقيقة أمر معتاد."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yatağa girdikdən sonra yuxuya getməyinizin nə qədər çəkdiyi. 30 dəqiqəyə qədər adi haldır."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jak dlouho ti trvalo usnout po ulehnutí do postele. Obvyklé je až 30 minut."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wie lange du nach dem Zubettgehen zum Einschlafen gebraucht hast. Bis zu 30 Minuten sind üblich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How long it took to fall asleep after getting into bed. Up to 30 minutes is typical."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuánto tardaste en dormirte después de acostarte. Hasta 30 minutos es lo habitual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le temps qu'il vous a fallu pour vous endormir après vous être couché. Jusqu'à 30 minutes est habituel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बिस्तर में जाने के बाद नींद आने में कितना समय लगा। 30 मिनट तक सामान्य है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quanto tempo hai impiegato ad addormentarti dopo essere andato a letto. Fino a 30 minuti è normale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ベッドに入ってから眠りにつくまでにかかった時間です。30分以内が一般的です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "침대에 누운 후 잠들기까지 걸린 시간이에요. 30분 이내가 일반적이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hoelang het duurde om in slaap te vallen nadat je in bed ging liggen. Tot 30 minuten is normaal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ile czasu zajęło Ci zaśnięcie po położeniu się do łóżka. Do 30 minut to typowa wartość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quanto tempo você levou para adormecer depois de deitar. Até 30 minutos é comum."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cât ți-a luat să adormi după ce te-ai băgat în pat. Până la 30 de minute este obișnuit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
