          }
        }
      }
    },
    "insights.methodology.background.sections.0.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُحسب النتائج من بياناتك الصحية المتزامنة في كل مرة تفتحها، لذا لا يوجد سجل نتائج منفصل يلزم الحفاظ على تزامنه."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Göstəricilər hər dəfə açdığınızda sinxronlaşdırılmış sağlamlıq məlumatlarınızdan hesablanır, ona görə də sinxron saxlanılmalı ayrıca göstərici tarixçəsi yoxdur."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skóre se počítají z tvých synchronizovaných zdravotních údajů pokaždé, když je otevřeš, takže neexistuje žádná samostatná historie skóre, kterou by bylo nutné synchronizovat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Werte werden bei jedem Öffnen aus deinen synchronisierten Gesundheitsdaten berechnet, daher gibt es keinen separaten Werteverlauf, der synchron gehalten werden muss."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scores are calculated from your synced health data each time you open them, so there is no separate score history to keep in sync."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las puntuaciones se calculan a partir de tus datos de salud sincronizados cada vez que las abres, así que no hay un historial de puntuaciones aparte que mantener sincronizado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les scores sont calculés à partir de vos données de santé synchronisées chaque fois que vous les ouvrez ; il n'y a donc pas d'historique de scores distinct à synchroniser."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हर बार खोलने पर स्कोर आपके सिंक किए गए स्वास्थ्य डेटा से गणना किए जाते हैं, इसलिए सिंक रखने के लिए कोई अलग स्कोर इतिहास नहीं है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I punteggi vengono calcolati dai tuoi dati sanitari sincronizzati ogni volta che li apri, quindi non c'è una cronologia separata dei punteggi da mantenere sincronizzata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "スコアは開くたびに同期済みの健康データから計算されるため、同期しておくべき別のスコア履歴はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "점수는 열 때마다 동기화된 건강 데이터로 계산되므로 따로 동기화할 점수 기록이 없어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scores worden elke keer dat je ze opent berekend uit je gesynchroniseerde gezondheidsgegevens, dus er is geen aparte scoregeschiedenis die gesynchroniseerd moet blijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wyniki są obliczane z Twoich zsynchronizowanych danych zdrowotnych przy każdym otwarciu, więc nie ma osobnej historii wyników do synchronizowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As pontuações são calculadas a partir dos seus dados de saúde sincronizados sempre que você as abre, então não há um histórico de pontuações separado para manter sincronizado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scorurile sunt calculate din datele de sănătate sincronizate de fiecare dată când le deschizi, așa că nu există un istoric separat de scoruri care trebuie sincronizat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Оценки рассчитываются из синхронизированных данных о здоровье при каждом открытии, поэтому отдельную историю оценок синхронизировать не нужно."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Оцінки обчислюються з ваших синхронізованих даних про здоров'я щоразу, коли ви їх відкриваєте, тому окрему історію оцінок синхронізувати не потрібно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每次打开时，分数都会根据你已同步的健康数据计算，因此没有需要单独同步的分数历史。"
          }
        }
      }
    },
