    "insights.methodology.background.sections.2.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "إشعارات التعافي والمراجعة اليومية الاختيارية تخبرك فقط بأن شيئًا ما أصبح جاهزًا. ولا تعرض قيمك أبدًا."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "İstəyə bağlı Bərpa və Gündəlik icmal bildirişləri yalnız nəyinsə hazır olduğunu bildirir. Onlar heç vaxt dəyərlərinizi göstərmir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Volitelná oznámení Regenerace a Denního souhrnu jen sdělují, že je něco připraveno. Nikdy nezobrazují tvé hodnoty."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die optionalen Mitteilungen zu Erholung und Tagesrückblick sagen nur, dass etwas bereit ist. Sie zeigen nie deine Werte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The optional Recovery and Daily Review notifications only say that something is ready. They never show your values."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las notificaciones opcionales de Recuperación y Resumen diario solo avisan de que algo está listo. Nunca muestran tus valores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les notifications facultatives de Récupération et de Bilan du jour indiquent seulement que quelque chose est prêt. Elles n'affichent jamais vos valeurs."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "वैकल्पिक रिकवरी और दैनिक समीक्षा सूचनाएँ केवल यह बताती हैं कि कुछ तैयार है। वे कभी आपके मान नहीं दिखातीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le notifiche facoltative di Recupero e Riepilogo giornaliero dicono solo che qualcosa è pronto. Non mostrano mai i tuoi valori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "オプションのリカバリーとデイリーレビューの通知は、準備ができたことを知らせるだけです。あなたの数値が表示されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "선택 사항인 회복 및 일일 리뷰 알림은 준비되었다는 사실만 알려줘요. 수치는 절대 표시하지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De optionele meldingen voor Herstel en Dagoverzicht zeggen alleen dat iets klaar is. Ze tonen nooit je waarden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Opcjonalne powiadomienia Regeneracji i Przeglądu dnia informują tylko, że coś jest gotowe. Nigdy nie pokazują Twoich wartości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As notificações opcionais de Recuperação e Revisão diária apenas informam que algo está pronto. Elas nunca mostram seus valores."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Notificările opționale pentru Recuperare și Analiza zilei spun doar că ceva este gata. Nu îți arată niciodată valorile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Необязательные уведомления о восстановлении и итогах дня лишь сообщают, что что-то готово. Они никогда не показывают ваши значения."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Необов'язкові сповіщення Відновлення та Щоденного огляду лише повідомляють, що щось готово. Вони ніколи не показують ваших значень."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "可选的恢复和每日回顾通知只会告诉你内容已准备好，绝不会显示你的数值。"
          }
        }
      }
    },
