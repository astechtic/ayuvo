        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "घातांकीय रूप से स्मूद किया गया औसत: वज़न दर्ज करने वाले हर दिन ट्रेंड += 0.1 × (वज़न − ट्रेंड)।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Media livellata esponenzialmente: andamento += 0,1 × (pesata − andamento) in ogni giorno con una pesata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
