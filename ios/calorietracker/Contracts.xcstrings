    "derived.metrics.vo2max_estimate.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تقدير لـ VO₂max لديك من الحد الأقصى لمعدل ضربات قلبك ومعدله أثناء الراحة. إنه دليل تقريبي؛ يعطي تمرين GPS في الهواء الطلق تقديرًا أفضل."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Maksimal və istirahət ürək döyüntünüzə əsasən VO₂max-ınızın təxmini. Bu, kobud göstəricidir; açıq havada GPS məşqi daha yaxşı təxmin verir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odhad tvého VO₂max z maximální a klidové tepové frekvence. Jde o hrubé vodítko; venkovní GPS trénink poskytne lepší odhad."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine Schätzung deiner VO₂max aus deiner maximalen und deiner Ruheherzfrequenz. Sie ist nur ein grober Richtwert; ein GPS-Training im Freien liefert eine bessere Schätzung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An estimate of your VO₂max from your maximum and resting heart rate. It is a rough guide; an outdoor GPS workout gives a better estimate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una estimación de tu VO₂max a partir de tu frecuencia cardíaca máxima y en reposo. Es una guía aproximada; un entrenamiento al aire libre con GPS da una mejor estimación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une estimation de votre VO₂max à partir de votre fréquence cardiaque maximale et au repos. C'est une indication approximative ; un entraînement GPS en extérieur donne une meilleure estimation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपकी अधिकतम और विश्राम हृदय गति से आपके VO₂max का अनुमान। यह एक मोटा अनुमान है; बाहरी GPS वर्कआउट बेहतर अनुमान देता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una stima del tuo VO₂max basata sulla frequenza cardiaca massima e a riposo. È un'indicazione approssimativa; un allenamento GPS all'aperto fornisce una stima migliore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "最大心拍数と安静時心拍数から推定したVO₂maxです。おおまかな目安であり、屋外のGPSワークアウトの方がより良い推定になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "최대 심박수와 안정 시 심박수로 추정한 VO₂max예요. 대략적인 참고용이며, 야외 GPS 운동을 하면 더 나은 추정치를 얻을 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Een schatting van je VO₂max op basis van je maximale hartslag en je hartslag in rust. Het is een ruwe indicatie; een GPS-training buiten geeft een betere schatting."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oszacowanie Twojego VO₂max na podstawie tętna maksymalnego i spoczynkowego. To orientacyjna wartość; trening na zewnątrz z GPS daje lepsze oszacowanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uma estimativa do seu VO₂max a partir da sua frequência cardíaca máxima e em repouso. É uma referência aproximada; um treino ao ar livre com GPS dá uma estimativa melhor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O estimare a VO₂max din pulsul tău maxim și cel în repaus. Este un reper aproximativ; un antrenament GPS în aer liber oferă o estimare mai bună."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Оценка вашего VO₂max по максимальному пульсу и пульсу в покое. Это приблизительный ориентир; тренировка на улице с GPS даёт более точную оценку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Оцінка вашого VO₂max за максимальним пульсом і пульсом у спокої. Це приблизний орієнтир; тренування на вулиці з GPS дає точнішу оцінку."
