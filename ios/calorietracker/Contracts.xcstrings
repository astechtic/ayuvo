    "insights.methodology.recovery.sections.1.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يُحتسب تقلب معدل ضربات القلب بنسبة 35%، ومعدل ضربات القلب أثناء الراحة 25%، والنوم 25%، ومعدل التنفس 7.5%، وأكسجين الدم 7.5%. يتكون النوم من 70% للمدة مقارنةً بمعدلك المعتاد و30% لمدى قرب منتصف نومك من الليالي الأربع عشرة السابقة. تُستبعد المدخلات المفقودة وتُرفع أوزان المدخلات المتبقية."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ürək döyüntüsü dəyişkənliyi 35%, istirahət ürək döyüntüsü 25%, yuxu 25%, tənəffüs tezliyi 7,5% və qanda oksigen 7,5% təşkil edir. Yuxunun 70%⁠-i adi halınızla müqayisədə müddət, 30%⁠-i isə yuxunun orta nöqtəsinin əvvəlki 14 gecəyə nə qədər yaxın olmasıdır. Çatışmayan girişlər çıxarılır və qalan çəkilər artırılır."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Variabilita srdeční frekvence se počítá 35 %, klidová tepová frekvence 25 %, spánek 25 %, dechová frekvence 7,5 % a okysličení krve 7,5 %. Spánek tvoří ze 70 % délka v porovnání s obvyklou a z 30 % to, jak blízko byl střed spánku předchozím 14 nocím. Chybějící vstupy se vynechají a zbývající váhy se úměrně zvýší."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Herzfrequenzvariabilität zählt 35 %, Ruheherzfrequenz 25 %, Schlaf 25 %, Atemfrequenz 7,5 % und Blutsauerstoff 7,5 %. Schlaf besteht zu 70 % aus der Dauer im Vergleich zum Üblichen und zu 30 % daraus, wie nah dein Schlafmittelpunkt an den vorherigen 14 Nächten lag. Fehlende Eingaben werden weggelassen und die übrigen Gewichte hochskaliert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heart rate variability counts for 35%, resting heart rate 25%, sleep 25%, breathing rate 7.5% and blood oxygen 7.5%. Sleep is 70% duration compared with your usual and 30% how close your sleep midpoint was to the previous 14 nights. Missing inputs are left out and the remaining weights are scaled up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La variabilidad de la frecuencia cardíaca cuenta un 35 %, la frecuencia cardíaca en reposo un 25 %, el sueño un 25 %, la frecuencia respiratoria un 7,5 % y el oxígeno en sangre un 7,5 %. El sueño es un 70 % duración comparada con lo habitual y un 30 % cercanía de tu punto medio del sueño a las 14 noches anteriores. Los datos que faltan se excluyen y los pesos restantes se ajustan al alza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La variabilité de la fréquence cardiaque compte pour 35 %, la fréquence cardiaque au repos 25 %, le sommeil 25 %, la fréquence respiratoire 7,5 % et l'oxygène sanguin 7,5 %. Le sommeil se compose à 70 % de la durée par rapport à l'habitude et à 30 % de la proximité du milieu de votre sommeil avec celui des 14 nuits précédentes. Les données manquantes sont exclues et les pondérations restantes sont augmentées en conséquence."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हृदय गति परिवर्तनशीलता 35%, विश्राम हृदय गति 25%, नींद 25%, साँस लेने की दर 7.5% और ब्लड ऑक्सीजन 7.5% गिनी जाती है। नींद में 70% आपकी सामान्य अवधि की तुलना और 30% यह कि आपकी नींद का मध्य बिंदु पिछली 14 रातों के कितना करीब था। छूटे इनपुट हटा दिए जाते हैं और बाकी भार बढ़ा दिए जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La variabilità della frequenza cardiaca conta per il 35%, la frequenza cardiaca a riposo per il 25%, il sonno per il 25%, la frequenza respiratoria per il 7,5% e l'ossigeno nel sangue per il 7,5%. Il sonno è per il 70% la durata rispetto al solito e per il 30% quanto il punto medio del sonno era vicino a quello delle 14 notti precedenti. I dati mancanti vengono esclusi e i pesi rimanenti vengono aumentati in proporzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "心拍変動が35%、安静時心拍数が25%、睡眠が25%、呼吸数が7.5%、血中酸素が7.5%を占めます。睡眠は、普段と比べた睡眠時間が70%、睡眠の中間時刻が過去14夜にどれだけ近かったかが30%です。欠けている入力は除外され、残りの重みが拡大されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "심박 변이도 35%, 안정 시 심박수 25%, 수면 25%, 호흡수 7.5%, 혈중 산소 7.5%로 계산돼요. 수면은 평소 대비 수면 시간 70%와 수면 중간점이 이전 14일 밤과 얼마나 가까운지 30%로 구성돼요. 누락된 입력값은 제외되고 나머지 가중치가 비례해 늘어나요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hartslagvariabiliteit telt voor 35%, hartslag in rust 25%, slaap 25%, ademhalingsfrequentie 7,5% en bloedzuurstof 7,5%. Slaap bestaat voor 70% uit duur vergeleken met normaal en voor 30% uit hoe dicht je slaapmiddelpunt bij dat van de vorige 14 nachten lag. Ontbrekende invoer wordt weggelaten en de overige gewichten worden opgeschaald."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zmienność rytmu serca stanowi 35%, tętno spoczynkowe 25%, sen 25%, częstość oddechów 7,5% i natlenienie krwi 7,5%. Sen to w 70% długość w porównaniu ze zwykłą i w 30% to, jak blisko środek snu był względem poprzednich 14 nocy. Brakujące dane są pomijane, a pozostałe wagi proporcjonalnie zwiększane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A variabilidade da frequência cardíaca conta 35%, a frequência cardíaca em repouso 25%, o sono 25%, a frequência respiratória 7,5% e o oxigênio no sangue 7,5%. O sono é 70% duração em comparação com o habitual e 30% o quanto o ponto médio do sono ficou próximo das 14 noites anteriores. Entradas ausentes são deixadas de fora e os pesos restantes são ampliados proporcionalmente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Variabilitatea ritmului cardiac contează 35%, pulsul în repaus 25%, somnul 25%, frecvența respiratorie 7,5% și oxigenul din sânge 7,5%. Somnul înseamnă 70% durata față de obișnuit și 30% cât de aproape a fost mijlocul somnului de cel din ultimele 14 nopți. Datele lipsă sunt omise, iar ponderile rămase sunt scalate proporțional."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вариабельность пульса составляет 35%, пульс в покое 25%, сон 25%, частота дыхания 7,5% и кислород в крови 7,5%. Сон на 70% — продолжительность относительно обычной и на 30% — насколько середина сна была близка к предыдущим 14 ночам. Отсутствующие данные не учитываются, а веса остальных пропорционально увеличиваются."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Варіабельність серцевого ритму становить 35%, пульс у спокої 25%, сон 25%, частота дихання 7,5% і кисень у крові 7,5%. Сон — це на 70% тривалість порівняно зі звичною і на 30% близькість середини сну до попередніх 14 ночей. Відсутні показники не враховуються, а ваги решти пропорційно збільшуються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "心率变异性占 35%，静息心率 25%，睡眠 25%，呼吸频率 7.5%，血氧 7.5%。睡眠中 70% 为与平时相比的时长，30% 为睡眠中点与前 14 晚的接近程度。缺失的输入项会被排除，其余权重相应放大。"
          }
        }
      }
    },
