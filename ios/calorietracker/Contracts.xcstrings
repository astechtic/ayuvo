          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "지수 평활 평균: 체중을 잰 날마다 추세 += 0.1 × (측정 체중 − 추세)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Exponentieel afgevlakt gemiddelde: trend += 0,1 × (weging − trend) op elke dag met een weging."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
