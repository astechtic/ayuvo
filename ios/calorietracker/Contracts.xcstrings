    "derived.metrics.training_impulse.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "درجة حِمل تزن الوقت بحسب مدى الجهد الذي بذله قلبك. الدقائق الأصعب تُحتسب بشكل أُسّي أكثر."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vaxtı ürəyinizin nə qədər gərgin işlədiyinə görə çəkiləndirən yük göstəricisi. Daha ağır dəqiqələr eksponensial olaraq daha çox sayılır."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skóre zátěže, které váží čas podle toho, jak tvrdě pracovalo tvé srdce. Náročnější minuty se počítají exponenciálně víc."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein Belastungswert, der die Zeit danach gewichtet, wie stark dein Herz gearbeitet hat. Härtere Minuten zählen exponentiell mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A load score that weighs time by how hard your heart worked. Harder minutes count exponentially more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una puntuación de carga que pondera el tiempo según lo mucho que trabajó tu corazón. Los minutos más intensos cuentan exponencialmente más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un score de charge qui pondère le temps selon l'effort de votre cœur. Les minutes plus intenses comptent de façon exponentielle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "एक लोड स्कोर जो समय को इस आधार पर तौलता है कि आपके हृदय ने कितनी मेहनत की। कठिन मिनट घातांकीय रूप से अधिक गिने जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un punteggio di carico che pesa il tempo in base a quanto ha lavorato il tuo cuore. I minuti più intensi contano in modo esponenzialmente maggiore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "心臓がどれだけ頑張ったかで時間に重み付けした負荷スコアです。きつい時間ほど指数関数的に大きく数えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "심장이 얼마나 힘들게 일했는지에 따라 시간에 가중치를 둔 부하 점수예요. 강도가 높은 시간일수록 기하급수적으로 더 크게 계산돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Een belastingsscore die tijd weegt naar hoe hard je hart werkte. Zwaardere minuten tellen exponentieel zwaarder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wskaźnik obciążenia, który waży czas według tego, jak ciężko pracowało Twoje serce. Cięższe minuty liczą się wykładniczo bardziej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uma pontuação de carga que pondera o tempo pelo esforço do seu coração. Minutos mais intensos contam exponencialmente mais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un scor de încărcare care ponderează timpul după cât de mult a lucrat inima. Minutele mai grele contează exponențial mai mult."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Показатель нагрузки, взвешивающий время по тому, насколько интенсивно работало сердце. Более тяжёлые минуты учитываются экспоненциально больше."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Показник навантаження, що зважує час за тим, наскільки інтенсивно працювало серце. Важчі хвилини враховуються експоненційно більше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "按心脏用力程度对时间加权的负荷分数。强度越高的分钟，计分呈指数级增加。"
          }
        }
      }
    },
    "derived.metrics.training_impulse.method" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "TRIMP وفق Banister على الدقائق عند ≥30% من احتياطي معدل ضربات القلب: Σ الدقائق × HRr × 0.64 × e^(k × HRr)، حيث k = 1.92 للرجال و1.67 للنساء."
          }
        },
        "az" : {
          "stringUnit" : {
