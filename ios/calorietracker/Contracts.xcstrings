    "derived.disclaimer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تقدير Ayuvo من بياناتك الخاصة باستخدام معادلات منشورة. هذا ليس قياسًا طبيًا ولا تشخيصًا؛ تحدّث إلى طبيبك بشأن أي شيء يقلقك."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dərc olunmuş düsturlardan istifadə etməklə sizin öz məlumatlarınızdan Ayuvo tərəfindən təxmin edilib. Bu, tibbi ölçmə və ya diaqnoz deyil; sizi narahat edən hər hansı məsələni həkiminizlə müzakirə edin."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odhad Ayuvo z tvých vlastních údajů pomocí publikovaných vzorců. Nejde o lékařské měření ani diagnózu; cokoli, co tě znepokojuje, konzultuj se svým lékařem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Von Ayuvo aus deinen eigenen Daten mit veröffentlichten Formeln geschätzt. Dies ist keine medizinische Messung oder Diagnose; sprich mit deiner Ärztin oder deinem Arzt über alles, was dich beunruhigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimated by Ayuvo from your own data using published formulas. It is not a medical measurement or diagnosis; talk to your doctor about anything that concerns you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Estimado por Ayuvo a partir de tus propios datos con fórmulas publicadas. No es una medición médica ni un diagnóstico; habla con tu médico sobre cualquier cosa que te preocupe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Estimé par Ayuvo à partir de vos propres données à l'aide de formules publiées. Ce n'est ni une mesure médicale ni un diagnostic ; parlez à votre médecin de tout ce qui vous inquiète."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo ने प्रकाशित फ़ॉर्मूलों का उपयोग करके आपके अपने डेटा से इसका अनुमान लगाया है। यह कोई मेडिकल माप या निदान नहीं है; जो भी बात आपको चिंतित करे, उसके बारे में अपने डॉक्टर से बात करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stimato da Ayuvo a partire dai tuoi dati con formule pubblicate. Non è una misurazione medica né una diagnosi; parla con il tuo medico di qualsiasi cosa ti preoccupi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "公開された計算式を用いて、あなた自身のデータからAyuvoが推定したものです。医療的な測定や診断ではありません。気になることがあれば医師に相談してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "공개된 공식을 사용해 내 데이터로 Ayuvo가 추정한 값이에요. 의료 측정이나 진단이 아니에요. 걱정되는 점은 의사와 상담하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geschat door Ayuvo op basis van je eigen gegevens met gepubliceerde formules. Het is geen medische meting of diagnose; bespreek alles waarover je je zorgen maakt met je arts."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oszacowane przez Ayuvo na podstawie Twoich danych przy użyciu opublikowanych wzorów. To nie jest pomiar medyczny ani diagnoza; porozmawiaj z lekarzem o wszystkim, co Cię niepokoi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Estimado pelo Ayuvo a partir dos seus próprios dados usando fórmulas publicadas. Não é uma medição médica nem um diagnóstico; converse com seu médico sobre qualquer coisa que preocupe você."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Estimat de Ayuvo din propriile tale date, folosind formule publicate. Nu este o măsurătoare medicală sau un diagnostic; discută cu medicul tău despre orice te îngrijorează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Оценка Ayuvo на основе ваших собственных данных по опубликованным формулам. Это не медицинское измерение и не диагноз; обсудите с врачом всё, что вас беспокоит."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Оцінка Ayuvo на основі ваших даних за опублікованими формулами. Це не медичне вимірювання і не діагноз; обговоріть із лікарем усе, що вас турбує."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "由 Ayuvo 根据你自己的数据，使用已发表的公式估算。这不是医学测量或诊断；如有任何担心，请咨询你的医生。"
          }
        }
      }
    },
