    "derived.metrics.sedentary_hr.method" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "متوسط دقائق معدل ضربات القلب النهارية التي لم تكن فيها خطوات في الدقيقة الحالية والدقائق العشر السابقة. يتطلب 30 دقيقة من هذا النوع."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cari və əvvəlki 10 dəqiqədə addım olmayan gündüz ürək döyüntüsü dəqiqələrinin ortalaması. Belə 30 dəqiqə tələb olunur."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Průměr denních minut tepové frekvence, kdy aktuální a předchozích 10 minut nebyly žádné kroky. Vyžaduje 30 takových minut."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mittelwert der Herzfrequenzminuten tagsüber, in denen die aktuelle und die vorherigen 10 Minuten keine Schritte hatten. Erfordert 30 solcher Minuten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mean of daytime heart-rate minutes where the current and previous 10 minutes had no steps. Needs 30 such minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Media de los minutos de frecuencia cardíaca diurna en los que el minuto actual y los 10 anteriores no tuvieron pasos. Requiere 30 de esos minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Moyenne des minutes de fréquence cardiaque diurnes où la minute en cours et les 10 précédentes n'avaient aucun pas. Nécessite 30 minutes de ce type."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "दिन के उन हृदय गति मिनटों का औसत जिनमें मौजूदा और पिछले 10 मिनटों में कोई कदम नहीं था। ऐसे 30 मिनट चाहिए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Media dei minuti diurni di frequenza cardiaca in cui il minuto attuale e i 10 precedenti non avevano passi. Richiede 30 minuti di questo tipo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "その分と直前の10分間に歩数がなかった、日中の1分ごとの心拍数の平均です。そのような時間が30分必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "현재 분과 이전 10분 동안 걸음이 없었던 주간 분 단위 심박수의 평균이에요. 이런 시간이 30분 필요해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gemiddelde van hartslagminuten overdag waarin de huidige en vorige 10 minuten geen stappen hadden. Vereist 30 van zulke minuten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Średnia z dziennych minut tętna, w których bieżąca i poprzednie 10 minut były bez kroków. Wymaga 30 takich minut."
          }
        },
