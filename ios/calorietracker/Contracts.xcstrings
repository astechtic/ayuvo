    "metric.metrics.app:workout_burn.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الطاقة المقدّرة المحروقة في التمارين التي تكملها في Ayuvo. يتم تخطي التمارين التي لا يتوفر لها تقدير."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo-da tamamladığınız məşqlərdə yandırılan təxmini enerji. Təxmini olmayan məşqlər nəzərə alınmır."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odhadovaná energie spálená v trénincích, které dokončíš v Ayuvo. Tréninky bez odhadu se přeskakují."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geschätzte verbrannte Energie in Trainings, die du in Ayuvo abschließt. Trainings ohne Schätzung werden übersprungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimated energy burned in workouts you complete in Ayuvo. Workouts without an estimate are skipped."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La energía estimada quemada en los entrenamientos que completas en Ayuvo. Se omiten los entrenamientos sin estimación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'énergie estimée brûlée pendant les entraînements que vous terminez dans Ayuvo. Les entraînements sans estimation sont ignorés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo में पूरे किए गए वर्कआउट में बर्न हुई अनुमानित ऊर्जा। बिना अनुमान वाले वर्कआउट छोड़ दिए जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Energia stimata bruciata negli allenamenti che completi in Ayuvo. Gli allenamenti senza stima vengono esclusi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvoで完了したワークアウトの推定消費エネルギーです。推定値のないワークアウトは除外されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo에서 완료한 운동의 추정 소모 에너지예요. 추정치가 없는 운동은 제외돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geschatte energie verbrand tijdens trainingen die je in Ayuvo voltooit. Trainingen zonder schatting worden overgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Szacowana energia spalona podczas treningów ukończonych w Ayuvo. Treningi bez oszacowania są pomijane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Energia estimada gasta nos treinos que você conclui no Ayuvo. Treinos sem estimativa são ignorados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Energia estimată arsă în antrenamentele pe care le finalizezi în Ayuvo. Antrenamentele fără estimare sunt omise."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Расчётная энергия, сожжённая на тренировках в Ayuvo. Тренировки без оценки не учитываются."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Орієнтовна енергія, спалена в тренуваннях, які ви завершуєте в Ayuvo. Тренування без оцінки пропускаються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你在 Ayuvo 中完成的训练的估算能量消耗。没有估算值的训练会被跳过。"
          }
        }
      }
    },
