    "derived.metrics.sedentary_hr.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "معدل ضربات قلبك أثناء الجلوس دون حركة خلال النهار (09:00-21:00)، عندما لم تمشِ أي خطوة لمدة 10 دقائق على الأقل."
