        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gündüz (09:00-21:00) ən azı 10 dəqiqə heç bir addım atmadan hərəkətsiz oturduğunuz zaman ürək döyüntünüz."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tvá tepová frekvence při klidném sezení během dne (09:00–21:00), když jsi alespoň 10 minut neudělal(a) žádný krok."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
