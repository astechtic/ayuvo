            "value" : "Tvá průměrná tepová frekvence při chůzi. Se zlepšující se kondicí obvykle klesá."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deine durchschnittliche Herzfrequenz beim Gehen. Sie sinkt meist, wenn sich deine Fitness verbessert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your average heart rate while walking. It usually falls as fitness improves."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu frecuencia cardíaca media al caminar. Suele bajar a medida que mejora tu forma física."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Votre fréquence cardiaque moyenne pendant la marche. Elle diminue généralement à mesure que votre forme s'améliore."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "चलते समय आपकी औसत हृदय गति। फिटनेस बेहतर होने पर यह आमतौर पर कम होती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La tua frequenza cardiaca media mentre cammini. Di solito diminuisce man mano che la forma fisica migliora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "歩行中の平均心拍数です。通常、体力が向上すると下がります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "걷는 동안의 평균 심박수예요. 체력이 좋아질수록 대개 낮아져요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je gemiddelde hartslag tijdens het wandelen. Die daalt meestal als je conditie verbetert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Twoje średnie tętno podczas chodzenia. Zwykle spada wraz z poprawą wydolności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sua frequência cardíaca média ao caminhar. Ela costuma cair à medida que o condicionamento melhora."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pulsul tău mediu la mers. De obicei scade pe măsură ce condiția fizică se îmbunătățește."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ваш средний пульс при ходьбе. Обычно он снижается по мере улучшения физической формы."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ваш середній пульс під час ходьби. Зазвичай він знижується, коли фізична форма покращується."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你步行时的平均心率。通常随着体能提升而下降。"
          }
        }
      }
    },
    "derived.metrics.walking_hr.method" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "متوسط معدل ضربات القلب في الدقائق التي بها 60-130 خطوة، ضمن سلاسل من 3 دقائق أو أكثر من هذا النوع (الدقائق الأسرع تُحتسب جريًا). يتطلب 10 دقائق."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "60-130 addımlı dəqiqələrdə, belə 3 və ya daha çox ardıcıl dəqiqədən ibarət silsilələrdə orta ürək döyüntüsü (daha sürətli dəqiqələr qaçış sayılır). 10 dəqiqə tələb olunur."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Průměrná tepová frekvence v minutách s 60–130 kroky, v úsecích 3 a více takových minut (rychlejší minuty se počítají jako běh). Vyžaduje 10 minut."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mittlere Herzfrequenz in Minuten mit 60–130 Schritten, in Folgen von 3 oder mehr solcher Minuten (schnellere Minuten zählen als Laufen). Erfordert 10 Minuten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mean heart rate in minutes with 60-130 steps, in runs of 3 or more such minutes (faster minutes count as running). Needs 10 minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Frecuencia cardíaca media en los minutos con 60-130 pasos, en tramos de 3 o más de esos minutos (los minutos más rápidos cuentan como carrera). Requiere 10 minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fréquence cardiaque moyenne pendant les minutes à 60-130 pas, par séries de 3 minutes ou plus de ce type (les minutes plus rapides comptent comme de la course). Nécessite 10 minutes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "60-130 कदम वाले मिनटों में औसत हृदय गति, ऐसे 3 या अधिक लगातार मिनटों में (तेज़ मिनट दौड़ना गिने जाते हैं)। 10 मिनट चाहिए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Frequenza cardiaca media nei minuti con 60-130 passi, in serie di 3 o più minuti di questo tipo (i minuti più veloci contano come corsa). Richiede 10 minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "1分あたり60〜130歩の時間が3分以上続いた区間での平均心拍数です（それより速い分はランニングとして数えます）。10分必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "분당 60-130걸음인 분이 3분 이상 이어진 구간의 평균 심박수예요(더 빠른 분은 달리기로 계산). 10분이 필요해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gemiddelde hartslag in minuten met 60-130 stappen, in reeksen van 3 of meer van zulke minuten (snellere minuten tellen als hardlopen). Vereist 10 minuten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Średnie tętno w minutach z 60-130 krokami, w ciągach 3 lub więcej takich minut (szybsze minuty liczą się jako bieg). Wymaga 10 minut."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Frequência cardíaca média nos minutos com 60-130 passos, em sequências de 3 ou mais desses minutos (minutos mais rápidos contam como corrida). Requer 10 minutos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pulsul mediu în minutele cu 60-130 de pași, în serii de 3 sau mai multe astfel de minute (minutele mai rapide contează ca alergare). Necesită 10 minute."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Средний пульс в минуты с 60–130 шагами, в сериях из 3 и более таких минут (более быстрые минуты считаются бегом). Нужно 10 минут."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Середній пульс у хвилини з 60-130 кроками, у серіях від 3 таких хвилин (швидші хвилини вважаються бігом). Потрібно 10 хвилин."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每分钟 60-130 步、且连续 3 分钟或以上的分钟内的平均心率（更快的分钟计为跑步）。需要 10 分钟。"
          }
        }
      }
    },
