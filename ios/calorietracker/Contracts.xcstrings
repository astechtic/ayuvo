    "derived.metrics.chronotype.method" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MSFsc = MSF − (SDf − SDweek) ÷ 2 عندما يكون النوم في أيام العطلة أطول من النوم في أيام الأسبوع، حيث SDweek = (5 × SDw + 2 × SDf) ÷ 7."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sərbəst gün yuxusu iş günü yuxusundan uzun olduqda MSFsc = MSF − (SDf − SDweek) ÷ 2, burada SDweek = (5 × SDw + 2 × SDf) ÷ 7."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MSFsc = MSF − (SDf − SDweek) ÷ 2, když je spánek ve volných dnech delší než ve všední dny, kde SDweek = (5 × SDw + 2 × SDf) ÷ 7."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MSFsc = MSF − (SDf − SDweek) ÷ 2, wenn der Schlaf an freien Tagen länger ist als an Wochentagen, wobei SDweek = (5 × SDw + 2 × SDf) ÷ 7."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MSFsc = MSF − (SDf − SDweek) ÷ 2 when free-day sleep is longer than weekday sleep, where SDweek = (5 × SDw + 2 × SDf) ÷ 7."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MSFsc = MSF − (SDf − SDweek) ÷ 2 cuando el sueño en días libres es más largo que entre semana, donde SDweek = (5 × SDw + 2 × SDf) ÷ 7."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MSFsc = MSF − (SDf − SDweek) ÷ 2 lorsque le sommeil des jours libres est plus long que celui de la semaine, où SDweek = (5 × SDw + 2 × SDf) ÷ 7."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MSFsc = MSF − (SDf − SDweek) ÷ 2, जब छुट्टी के दिन की नींद सप्ताह के दिनों की नींद से लंबी हो, जहाँ SDweek = (5 × SDw + 2 × SDf) ÷ 7।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MSFsc = MSF − (SDf − SDweek) ÷ 2 quando il sonno nei giorni liberi è più lungo di quello nei giorni feriali, dove SDweek = (5 × SDw + 2 × SDf) ÷ 7."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "休日の睡眠が平日の睡眠より長い場合、MSFsc = MSF −（SDf − SDweek）÷ 2。ここでSDweek =（5 × SDw + 2 × SDf）÷ 7。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "자유로운 날의 수면이 평일 수면보다 길 때 MSFsc = MSF − (SDf − SDweek) ÷ 2, 여기서 SDweek = (5 × SDw + 2 × SDf) ÷ 7."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MSFsc = MSF − (SDf − SDweek) ÷ 2 als de slaap op vrije dagen langer is dan op werkdagen, waarbij SDweek = (5 × SDw + 2 × SDf) ÷ 7."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MSFsc = MSF − (SDf − SDweek) ÷ 2, gdy sen w dni wolne jest dłuższy niż w dni robocze, gdzie SDweek = (5 × SDw + 2 × SDf) ÷ 7."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MSFsc = MSF − (SDf − SDweek) ÷ 2 quando o sono nos dias livres é mais longo que nos dias úteis, onde SDweek = (5 × SDw + 2 × SDf) ÷ 7."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MSFsc = MSF − (SDf − SDweek) ÷ 2 când somnul din zilele libere este mai lung decât cel din zilele lucrătoare, unde SDweek = (5 × SDw + 2 × SDf) ÷ 7."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MSFsc = MSF − (SDf − SDweek) ÷ 2, если сон в свободные дни длиннее, чем в будни, где SDweek = (5 × SDw + 2 × SDf) ÷ 7."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MSFsc = MSF − (SDf − SDweek) ÷ 2, коли сон у вільні дні довший, ніж у будні, де SDweek = (5 × SDw + 2 × SDf) ÷ 7."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "当休息日睡眠长于工作日睡眠时，MSFsc = MSF − (SDf − SDweek) ÷ 2，其中 SDweek = (5 × SDw + 2 × SDf) ÷ 7。"
          }
        }
      }
    },
