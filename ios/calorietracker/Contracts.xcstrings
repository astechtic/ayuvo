    "insights.methodology.baselines.sections.0.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يقارن Ayuvo كل قراءة بسجلك الحديث الخاص، وليس بأشخاص آخرين. خط الأساس لأي مقياس هو متوسط الأيام الستين السابقة، دون احتساب اليوم."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo hər göstəricini başqa insanlarla deyil, sizin öz son tarixçənizlə müqayisə edir. Göstərici üçün əsas səviyyəniz bu gün istisna olmaqla əvvəlki 60 günün ortalamasıdır."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo porovnává každé měření s tvou vlastní nedávnou historií, ne s ostatními lidmi. Tvá výchozí hodnota pro metriku je průměr předchozích 60 dní, bez dneška."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo vergleicht jeden Messwert mit deinem eigenen jüngsten Verlauf, nicht mit anderen Personen. Dein Basiswert für einen Messwert ist der Durchschnitt der vorherigen 60 Tage, ohne heute."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo compares each reading with your own recent history, not with other people. Your baseline for a metric is the average of the previous 60 days, not counting today."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo compara cada lectura con tu propio historial reciente, no con otras personas. Tu referencia de una métrica es el promedio de los 60 días anteriores, sin contar hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo compare chaque mesure avec votre propre historique récent, pas avec d'autres personnes. Votre référence pour une métrique est la moyenne des 60 jours précédents, sans compter aujourd'hui."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo हर रीडिंग की तुलना आपके अपने हाल के इतिहास से करता है, दूसरे लोगों से नहीं। किसी मेट्रिक के लिए आपकी बेसलाइन पिछले 60 दिनों का औसत है, आज को छोड़कर।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo confronta ogni rilevazione con la tua cronologia recente, non con altre persone. Il tuo valore di riferimento per una metrica è la media dei 60 giorni precedenti, escluso oggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvoは各測定値を、他の人ではなく、あなた自身の最近の履歴と比較します。指標のベースラインは、今日を除く過去60日間の平均です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo는 각 측정값을 다른 사람이 아닌 나의 최근 기록과 비교해요. 지표의 기준치는 오늘을 제외한 이전 60일의 평균이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo vergelijkt elke meting met je eigen recente geschiedenis, niet met andere mensen. Je basislijn voor een waarde is het gemiddelde van de vorige 60 dagen, vandaag niet meegerekend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo porównuje każdy odczyt z Twoją własną niedawną historią, a nie z innymi osobami. Twoja wartość bazowa dla metryki to średnia z poprzednich 60 dni, bez dnia dzisiejszego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Ayuvo compara cada leitura com o seu próprio histórico recente, não com outras pessoas. Sua linha de base de uma métrica é a média dos 60 dias anteriores, sem contar hoje."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo compară fiecare citire cu propriul tău istoric recent, nu cu alți oameni. Nivelul tău de referință pentru o valoare este media ultimelor 60 de zile, fără ziua de azi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo сравнивает каждое показание с вашей собственной недавней историей, а не с другими людьми. Базовый уровень показателя — это среднее за предыдущие 60 дней без учёта сегодняшнего."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo порівнює кожен показник із вашою власною нещодавньою історією, а не з іншими людьми. Ваш базовий рівень для показника — це середнє за попередні 60 днів, не враховуючи сьогодні."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo 将每个读数与你自己的近期历史比较，而不是与他人比较。某项指标的基线是之前 60 天的平均值，不包括今天。"
          }
        }
      }
    },
    "insights.methodology.baselines.sections.0.heading" : {
      "extractionState" : "manual",
      "localizations" : {
