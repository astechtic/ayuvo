    "insights.methodology.baselines.sections.1.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يتطلب خط الأساس 14 يومًا على الأقل بها قراءة. وحتى ذلك الحين سترى \"جارٍ تعلّم خط الأساس\" مع عدد مثل 9/14. تكون الثقة عالية عندما تتوفر بيانات في 70% على الأقل من الأيام الستين مع 30 قراءة أو أكثر، ومتوسطة في غير ذلك."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Əsas səviyyə üçün göstəricisi olan ən azı 14 gün lazımdır. O vaxta qədər 9/14 kimi sayla \"Əsas səviyyəniz öyrənilir\" görəcəksiniz. 60 günün ən azı 70%⁠-ində məlumat və 30 və ya daha çox göstərici olduqda etibarlılıq yüksəkdir, əks halda ortadır."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Výchozí hodnota vyžaduje alespoň 14 dní s měřením. Do té doby uvidíš „Zjišťujeme tvou výchozí hodnotu“ s počtem, například 9/14. Spolehlivost je vysoká, když má data alespoň 70 % z 60 dní a měření je 30 nebo více, jinak je střední."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein Basiswert benötigt mindestens 14 Tage mit einem Messwert. Bis dahin siehst du „Basiswert wird ermittelt“ mit einer Zählung wie 9/14. Die Zuverlässigkeit ist hoch, wenn für mindestens 70 % der 60 Tage Daten vorliegen und es 30 oder mehr Messwerte gibt, andernfalls mittel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A baseline needs at least 14 days with a reading. Until then you will see \"Learning your baseline\" with a count such as 9/14. Confidence is high when at least 70% of the 60 days have data and there are 30 or more readings, and medium otherwise."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una referencia necesita al menos 14 días con lectura. Hasta entonces verás \"Aprendiendo tu referencia\" con un recuento como 9/14. La confianza es alta cuando al menos el 70 % de los 60 días tienen datos y hay 30 lecturas o más, y media en caso contrario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une référence nécessite au moins 14 jours avec une mesure. D'ici là, vous verrez « Apprentissage de votre référence » avec un compteur tel que 9/14. La fiabilité est élevée lorsqu'au moins 70 % des 60 jours ont des données et qu'il y a 30 mesures ou plus, et moyenne sinon."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बेसलाइन के लिए कम से कम 14 दिनों की रीडिंग चाहिए। तब तक आपको \"आपकी बेसलाइन सीखी जा रही है\" के साथ 9/14 जैसी गिनती दिखेगी। जब 60 में से कम से कम 70% दिनों का डेटा हो और 30 या अधिक रीडिंग हों तो विश्वसनीयता उच्च होती है, वरना मध्यम।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un valore di riferimento richiede almeno 14 giorni con una rilevazione. Fino ad allora vedrai \"Sto imparando il tuo valore di riferimento\" con un conteggio come 9/14. L'affidabilità è alta quando almeno il 70% dei 60 giorni ha dati e ci sono 30 o più rilevazioni, altrimenti è media."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ベースラインには、測定値のある日が少なくとも14日必要です。それまでは「ベースラインを学習中」と、9/14のようなカウントが表示されます。60日間のうち70%以上にデータがあり、測定値が30件以上ある場合は信頼度が高、それ以外は中となります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "기준치를 만들려면 측정값이 있는 날이 최소 14일 필요해요. 그전까지는 9/14 같은 개수와 함께 \"기준치 학습 중\"이 표시돼요. 60일 중 최소 70%에 데이터가 있고 측정값이 30개 이상이면 신뢰도가 높음이고, 그렇지 않으면 보통이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Een basislijn heeft minstens 14 dagen met een meting nodig. Tot die tijd zie je 'Basislijn wordt geleerd' met een teller zoals 9/14. De betrouwbaarheid is hoog als minstens 70% van de 60 dagen gegevens heeft en er 30 of meer metingen zijn, en anders gemiddeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wartość bazowa wymaga co najmniej 14 dni z odczytem. Do tego czasu zobaczysz „Poznajemy Twoją wartość bazową” z licznikiem, np. 9/14. Pewność jest wysoka, gdy co najmniej 70% z 60 dni ma dane i jest 30 lub więcej odczytów; w przeciwnym razie jest średnia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uma linha de base precisa de pelo menos 14 dias com leitura. Até lá, você verá “Aprendendo sua linha de base” com uma contagem como 9/14. A confiança é alta quando pelo menos 70% dos 60 dias têm dados e há 30 leituras ou mais; caso contrário, é média."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un nivel de referință necesită cel puțin 14 zile cu o citire. Până atunci vei vedea „Învățăm nivelul tău de referință” cu un contor precum 9/14. Încrederea este ridicată când cel puțin 70% din cele 60 de zile au date și există 30 sau mai multe citiri, altfel este medie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Для базового уровня нужно не менее 14 дней с показаниями. До тех пор вы будете видеть «Изучаем ваш базовый уровень» со счётчиком, например 9/14. Достоверность высокая, если данные есть не менее чем за 70% из 60 дней и показаний 30 и более, в остальных случаях — средняя."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Для базового рівня потрібно щонайменше 14 днів із показником. Доти ви бачитимете «Вивчаємо ваш базовий рівень» з лічильником, наприклад 9/14. Достовірність висока, коли дані є щонайменше за 70% із 60 днів і є 30 або більше показників, інакше — середня."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "基线至少需要 14 天有读数。在此之前，你会看到“正在学习你的基线”以及类似 9/14 的计数。当 60 天中至少 70% 有数据且读数达到 30 个或以上时，置信度为高，否则为中。"
          }
        }
      }
    },
