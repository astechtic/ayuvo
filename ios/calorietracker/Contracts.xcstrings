    "derived.metrics.physical_activity_level.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "إجمالي الطاقة المحروقة ÷ طاقة الراحة. 1.40-1.69 خامل إلى نشط قليلًا، 1.70-1.99 نشط، 2.00-2.40 نشط بقوة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ümumi yandırılan enerji ÷ istirahət enerjisi. 1,40-1,69 oturaqdan yüngül aktivə, 1,70-1,99 aktiv, 2,00-2,40 intensiv aktiv."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Celková spálená energie ÷ klidová energie. 1,40–1,69 je sedavá až lehká aktivita, 1,70–1,99 aktivní, 2,00–2,40 velmi aktivní."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gesamter Energieverbrauch ÷ Ruheenergie. 1,40–1,69 bedeutet sitzend bis leicht aktiv, 1,70–1,99 aktiv, 2,00–2,40 sehr aktiv."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total energy burned ÷ resting energy. 1.40-1.69 is sedentary to lightly active, 1.70-1.99 active, 2.00-2.40 vigorously active."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Energía total gastada ÷ energía en reposo. 1,40-1,69 es de sedentario a ligeramente activo, 1,70-1,99 activo, 2,00-2,40 vigorosamente activo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Énergie totale dépensée ÷ énergie au repos. 1,40-1,69 correspond à sédentaire à légèrement actif, 1,70-1,99 à actif, 2,00-2,40 à très actif."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कुल बर्न हुई ऊर्जा ÷ विश्राम ऊर्जा। 1.40-1.69 निष्क्रिय से हल्का सक्रिय, 1.70-1.99 सक्रिय, 2.00-2.40 बहुत सक्रिय।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Energia totale bruciata ÷ energia a riposo. 1,40-1,69 è da sedentario a leggermente attivo, 1,70-1,99 attivo, 2,00-2,40 molto attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "総消費エネルギー ÷ 安静時エネルギー。1.40〜1.69は座位中心〜軽い活動、1.70〜1.99は活動的、2.00〜2.40は非常に活動的です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
