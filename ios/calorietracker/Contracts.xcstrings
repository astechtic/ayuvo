          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Part de votre temps au lit passée à dormir. 85 % ou plus est considéré comme bon."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बिस्तर में बिताए समय में से सोने में बीता हिस्सा। 85% या उससे अधिक अच्छा माना जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Percentuale del tempo a letto trascorsa dormendo. L'85% o più è considerato buono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ベッドにいた時間のうち眠っていた割合です。85%以上が良好とされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "침대에 있던 시간 중 잠든 시간의 비율이에요. 85% 이상이면 좋은 편이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
