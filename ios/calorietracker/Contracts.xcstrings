    "derived.metrics.cardio_minutes.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الدقائق التي كان فيها معدل ضربات قلبك في النطاق المعتدل أو الشديد، مع احتساب الدقائق الشديدة مرتين. توصي منظمة الصحة العالمية بـ 150-300 دقيقة أسبوعيًا."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ürək döyüntünüzün orta və ya intensiv aralıqda olduğu dəqiqələr; intensiv dəqiqələr iki dəfə sayılır. ÜST həftədə 150-300 dəqiqə tövsiyə edir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Minuty, kdy byla tvá tepová frekvence ve střední nebo vysoké intenzitě, přičemž minuty vysoké intenzity se počítají dvakrát. WHO doporučuje 150–300 týdně."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Minuten, in denen deine Herzfrequenz im moderaten oder intensiven Bereich lag, wobei intensive Minuten doppelt zählen. Die WHO empfiehlt 150–300 pro Woche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minutes your heart rate was in the moderate or vigorous range, with vigorous minutes counted twice. WHO recommends 150-300 a week."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Minutos en que tu frecuencia cardíaca estuvo en rango moderado o vigoroso; los minutos vigorosos cuentan el doble. La OMS recomienda 150-300 a la semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Minutes où votre fréquence cardiaque était dans la plage modérée ou intense, les minutes intenses comptant double. L'OMS recommande 150 à 300 par semaine."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "वे मिनट जब आपकी हृदय गति मध्यम या तीव्र सीमा में थी, तीव्र मिनट दोगुने गिने जाते हैं। WHO सप्ताह में 150-300 की सलाह देता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Minuti in cui la tua frequenza cardiaca era nella fascia moderata o intensa, con i minuti intensi contati due volte. L'OMS raccomanda 150-300 minuti a settimana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "心拍数が中強度または高強度の範囲にあった時間（分）で、高強度の時間は2倍で数えます。WHOは週150〜300分を推奨しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "심박수가 중강도 또는 고강도 범위에 있었던 시간(분)으로, 고강도 시간은 두 배로 계산돼요. WHO는 주당 150-300분을 권장해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Minuten waarin je hartslag in het matige of intensieve bereik lag, waarbij intensieve minuten dubbel tellen. De WHO raadt 150-300 per week aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Minuty, w których Twoje tętno było w zakresie umiarkowanym lub intensywnym; minuty intensywne liczą się podwójnie. WHO zaleca 150-300 tygodniowo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Minutos em que sua frequência cardíaca ficou na faixa moderada ou vigorosa, com os minutos vigorosos contados em dobro. A OMS recomenda 150-300 por semana."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Minutele în care pulsul tău a fost în intervalul moderat sau intens, minutele intense fiind numărate de două ori. OMS recomandă 150-300 pe săptămână."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Минуты, когда пульс был в умеренном или интенсивном диапазоне; интенсивные минуты считаются дважды. ВОЗ рекомендует 150–300 в неделю."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Хвилини, коли ваш пульс був у помірному або інтенсивному діапазоні; інтенсивні хвилини рахуються двічі. ВООЗ рекомендує 150-300 на тиждень."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你的心率处于中等或高强度范围的分钟数，高强度分钟按两倍计算。WHO 建议每周 150-300 分钟。"
          }
        }
      }
    },
    "derived.metrics.cardio_minutes.method" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُصنَّف كل دقيقة من معدل ضربات القلب حسب نسبة احتياطي معدل ضربات القلب (معتدل 40-59%، شديد 60-89%، شبه أقصى ≥90%). وبدون معدل ضربات القلب أثناء الراحة تُستخدم النسبة من الحد الأقصى (معتدل 64-76%، شديد 77-95%، شبه أقصى ≥96%). معتدل + 2 × (شديد + شبه أقصى)."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hər ürək döyüntüsü dəqiqəsi ürək döyüntüsü ehtiyatının %⁠-inə görə təsnif edilir (orta 40-59%, intensiv 60-89%, maksimala yaxın ≥90%). İstirahət ürək döyüntüsü olmadıqda maksimumun %⁠-i istifadə olunur (orta 64-76%, intensiv 77-95%, maksimala yaxın ≥96%). Orta + 2 × (intensiv + maksimala yaxın)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Každá minuta tepové frekvence se zařadí podle % rezervy tepové frekvence (střední 40–59 %, vysoká 60–89 %, téměř maximální ≥90 %). Bez klidové tepové frekvence se použije % maxima (střední 64–76 %, vysoká 77–95 %, téměř maximální ≥96 %). Střední + 2 × (vysoká + téměř maximální)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jede Herzfrequenzminute wird nach % der Herzfrequenzreserve eingestuft (moderat 40–59 %, intensiv 60–89 %, nahezu maximal ≥90 %). Ohne Ruheherzfrequenz wird der % des Maximums verwendet (moderat 64–76 %, intensiv 77–95 %, nahezu maximal ≥96 %). Moderat + 2 × (intensiv + nahezu maximal)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each heart-rate minute is classed by % heart-rate reserve (moderate 40-59%, vigorous 60-89%, near-maximal ≥90%). Without a resting heart rate % of maximum is used (moderate 64-76%, vigorous 77-95%, near-maximal ≥96%). Moderate + 2 × (vigorous + near-maximal)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada minuto de frecuencia cardíaca se clasifica por % de reserva de frecuencia cardíaca (moderado 40-59 %, vigoroso 60-89 %, casi máximo ≥90 %). Sin frecuencia cardíaca en reposo se usa el % del máximo (moderado 64-76 %, vigoroso 77-95 %, casi máximo ≥96 %). Moderado + 2 × (vigoroso + casi máximo)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chaque minute de fréquence cardiaque est classée selon le % de réserve de fréquence cardiaque (modérée 40-59 %, intense 60-89 %, quasi maximale ≥90 %). Sans fréquence cardiaque au repos, le % du maximum est utilisé (modérée 64-76 %, intense 77-95 %, quasi maximale ≥96 %). Modérée + 2 × (intense + quasi maximale)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हृदय गति के हर मिनट को % हृदय गति रिज़र्व के आधार पर वर्गीकृत किया जाता है (मध्यम 40-59%, तीव्र 60-89%, लगभग अधिकतम ≥90%)। विश्राम हृदय गति न होने पर अधिकतम का % उपयोग होता है (मध्यम 64-76%, तीव्र 77-95%, लगभग अधिकतम ≥96%)। मध्यम + 2 × (तीव्र + लगभग अधिकतम)।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ogni minuto di frequenza cardiaca viene classificato in base alla % di riserva di frequenza cardiaca (moderata 40-59%, intensa 60-89%, quasi massimale ≥90%). Senza una frequenza cardiaca a riposo si usa la % del massimo (moderata 64-76%, intensa 77-95%, quasi massimale ≥96%). Moderata + 2 × (intensa + quasi massimale)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "1分ごとの心拍数を心拍予備能の%で分類します（中強度 40〜59%、高強度 60〜89%、最大に近い ≥90%）。安静時心拍数がない場合は最大心拍数の%を使用します（中強度 64〜76%、高強度 77〜95%、最大に近い ≥96%）。中強度 + 2 ×（高強度 + 最大に近い）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "각 분 단위 심박수를 심박 예비량 %로 분류해요(중강도 40-59%, 고강도 60-89%, 최대에 가까움 ≥90%). 안정 시 심박수가 없으면 최대 심박수 %를 사용해요(중강도 64-76%, 고강도 77-95%, 최대에 가까움 ≥96%). 중강도 + 2 × (고강도 + 최대에 가까움)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elke hartslagminuut wordt ingedeeld op % hartslagreserve (matig 40-59%, intensief 60-89%, bijna maximaal ≥90%). Zonder hartslag in rust wordt % van het maximum gebruikt (matig 64-76%, intensief 77-95%, bijna maximaal ≥96%). Matig + 2 × (intensief + bijna maximaal)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Każda minuta tętna jest klasyfikowana według % rezerwy tętna (umiarkowana 40-59%, intensywna 60-89%, prawie maksymalna ≥90%). Bez tętna spoczynkowego używany jest % tętna maksymalnego (umiarkowana 64-76%, intensywna 77-95%, prawie maksymalna ≥96%). Umiarkowane + 2 × (intensywne + prawie maksymalne)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada minuto de frequência cardíaca é classificado pelo % da reserva de frequência cardíaca (moderado 40-59%, vigoroso 60-89%, quase máximo ≥90%). Sem frequência cardíaca em repouso, usa-se o % da máxima (moderado 64-76%, vigoroso 77-95%, quase máximo ≥96%). Moderado + 2 × (vigoroso + quase máximo)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fiecare minut de puls este clasificat după % din rezerva de puls (moderat 40-59%, intens 60-89%, aproape maximal ≥90%). Fără un puls în repaus se folosește % din maxim (moderat 64-76%, intens 77-95%, aproape maximal ≥96%). Moderat + 2 × (intens + aproape maximal)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Каждая минута пульса классифицируется по % резерва пульса (умеренная 40–59%, интенсивная 60–89%, почти максимальная ≥90%). Без пульса в покое используется % от максимума (умеренная 64–76%, интенсивная 77–95%, почти максимальная ≥96%). Умеренные + 2 × (интенсивные + почти максимальные)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Кожну хвилину пульсу класифіковано за % резерву пульсу (помірна 40-59%, інтенсивна 60-89%, майже максимальна ≥90%). Без пульсу в спокої використовується % від максимуму (помірна 64-76%, інтенсивна 77-95%, майже максимальна ≥96%). Помірні + 2 × (інтенсивні + майже максимальні)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每分钟心率按心率储备百分比分类（中等 40-59%，高强度 60-89%，接近最大 ≥90%）。没有静息心率时，改用最大心率百分比（中等 64-76%，高强度 77-95%，接近最大 ≥96%）。中等 + 2 ×（高强度 + 接近最大）。"
          }
        }
      }
    },
