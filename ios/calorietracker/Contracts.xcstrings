    "insights.patterns.pairs.high_load_recovery.template" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بعد أيام حِمل التدريب المرتفع، كان تعافيك في اليوم التالي {direction_word} بمقدار {abs_diff} {unit} في المتوسط ({n_exposed} مقابل {n_unexposed} يوم)."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yüksək məşq yüklü günlərdən sonra növbəti günkü bərpanız orta hesabla {abs_diff} {unit} {direction_word} olub ({n_exposed} və {n_unexposed} gün)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Po dnech s vysokou tréninkovou zátěží byla tvá regenerace následující den v průměru o {abs_diff} {unit} {direction_word} (počet dní: {n_exposed} vs. {n_unexposed})."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nach Tagen mit hoher Trainingsbelastung war deine Erholung am nächsten Tag im Schnitt {abs_diff} {unit} {direction_word} ({n_exposed} vs. {n_unexposed} Tage)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After high training-load days, your next-day recovery has been {abs_diff} {unit} {direction_word} on average ({n_exposed} vs {n_unexposed} days)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tras días de carga de entrenamiento alta, tu recuperación del día siguiente ha sido de media {abs_diff} {unit} {direction_word} ({n_exposed} frente a {n_unexposed} días)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Après les jours de charge d'entraînement élevée, votre score de récupération du lendemain a été en moyenne {direction_word} de {abs_diff} {unit} ({n_exposed} vs {n_unexposed} jours)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अधिक ट्रेनिंग लोड वाले दिनों के बाद, अगले दिन आपकी रिकवरी औसतन {abs_diff} {unit} {direction_word} रही है ({n_exposed} बनाम {n_unexposed} दिन)।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dopo i giorni con carico di allenamento elevato, il tuo recupero del giorno dopo è stato in media {abs_diff} {unit} {direction_word} ({n_exposed} vs {n_unexposed} giorni)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "トレーニング負荷が高かった日の翌日は、リカバリーが平均で{abs_diff} {unit} {direction_word}でした（{n_exposed}日 対 {n_unexposed}日）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "운동 부하가 높은 날 이후 다음 날 회복: 평균 {abs_diff} {unit} {direction_word} ({n_exposed}일 대 {n_unexposed}일)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Na dagen met een hoge trainingsbelasting was je herstel de volgende dag gemiddeld {abs_diff} {unit} {direction_word} ({n_exposed} vs. {n_unexposed} dagen)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Po dniach z wysokim obciążeniem treningowym Twoja regeneracja następnego dnia: średnio {abs_diff} {unit} {direction_word} ({n_exposed} vs {n_unexposed} dni)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Depois de dias com carga de treino alta, sua recuperação no dia seguinte tem sido {abs_diff} {unit} {direction_word} em média ({n_exposed} vs. {n_unexposed} dias)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "După zilele cu încărcare mare de antrenament, recuperarea ta din ziua următoare a fost în medie {abs_diff} {unit} {direction_word} ({n_exposed} față de {n_unexposed} zile)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "После дней с высокой тренировочной нагрузкой ваше восстановление на следующий день в среднем на {abs_diff} {unit} {direction_word} (дней: {n_exposed} против {n_unexposed})."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Після днів із високим тренувальним навантаженням ваше відновлення наступного дня в середньому було на {abs_diff} {unit} {direction_word} ({n_exposed} проти {n_unexposed} днів)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在高训练负荷的日子之后，你次日的恢复平均{direction_word} {abs_diff} {unit}（{n_exposed} 天对比 {n_unexposed} 天）。"
          }
        }
      }
    },
