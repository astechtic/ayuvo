        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Po dnech, kdy jsi splnil(a) cíl bílkovin, byl tvůj objem silového tréninku následující den v průměru o {abs_diff} {unit} {direction_word} (počet dní: {n_exposed} vs. {n_unexposed})."
