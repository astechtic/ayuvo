    "insights.methodology.daily_review.sections.3.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُقارن العناصر الغذائية التي حددت لها حدًا أعلى، مثل السكر أو الصوديوم أو الدهون المشبعة أو الكافيين، بذلك الحد وبمتوسطك خلال 28 يومًا. وقد تظهر هنا أيضًا أنماط من بياناتك الخاصة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Şəkər, natrium, doymuş yağ və ya kofein kimi sizin təyin etdiyiniz yuxarı limiti olan qida maddələri həmin limitlə və 28 günlük ortalamanızla müqayisə edilir. Öz məlumatlarınızdan qanunauyğunluqlar da burada görünə bilər."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Živiny s horním limitem, který sis nastavil(a), například cukr, sodík, nasycené tuky nebo kofein, se porovnávají s tímto limitem a s tvým 28denním průměrem. Mohou se zde objevit i vzorce z tvých vlastních údajů."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nährstoffe mit einer von dir festgelegten Obergrenze, etwa Zucker, Natrium, gesättigte Fettsäuren oder Koffein, werden mit dieser Grenze und deinem 28-Tage-Durchschnitt verglichen. Auch Muster aus deinen eigenen Daten können hier erscheinen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutrients with an upper limit you set, such as sugar, sodium, saturated fat or caffeine, are compared with that limit and your 28-day average. Patterns from your own data can appear here too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los nutrientes con un límite máximo que hayas fijado, como azúcar, sodio, grasas saturadas o cafeína, se comparan con ese límite y con tu promedio de 28 días. Aquí también pueden aparecer patrones de tus propios datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les nutriments pour lesquels vous avez fixé une limite supérieure, comme le sucre, le sodium, les graisses saturées ou la caféine, sont comparés à cette limite et à votre moyenne sur 28 jours. Des tendances issues de vos propres données peuvent aussi apparaître ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "जिन पोषक तत्वों की आपने ऊपरी सीमा तय की है, जैसे चीनी, सोडियम, सैचुरेटेड फैट या कैफ़ीन, उनकी तुलना उस सीमा और आपके 28-दिन के औसत से की जाती है। आपके अपने डेटा के पैटर्न भी यहाँ दिख सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I nutrienti con un limite massimo impostato da te, come zuccheri, sodio, grassi saturi o caffeina, vengono confrontati con quel limite e con la tua media di 28 giorni. Qui possono comparire anche schemi ricavati dai tuoi dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "糖質、ナトリウム、飽和脂肪酸、カフェインなど、上限を設定した栄養素は、その上限と28日平均と比較されます。あなた自身のデータから見つかったパターンもここに表示されることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "당류, 나트륨, 포화 지방, 카페인처럼 상한을 설정한 영양소는 그 한도 및 28일 평균과 비교돼요. 내 데이터에서 찾은 패턴도 여기에 나타날 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voedingsstoffen met een bovengrens die je hebt ingesteld, zoals suiker, natrium, verzadigd vet of cafeïne, worden vergeleken met die grens en je 28-daags gemiddelde. Ook patronen uit je eigen gegevens kunnen hier verschijnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Składniki odżywcze z ustawionym przez Ciebie górnym limitem, takie jak cukier, sód, tłuszcze nasycone czy kofeina, są porównywane z tym limitem i Twoją średnią z 28 dni. Mogą się tu też pojawić wzorce z Twoich danych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nutrientes com um limite máximo definido por você, como açúcar, sódio, gordura saturada ou cafeína, são comparados com esse limite e com sua média de 28 dias. Padrões dos seus próprios dados também podem aparecer aqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nutrienții cu o limită superioară setată de tine, precum zahărul, sodiul, grăsimile saturate sau cofeina, sunt comparați cu acea limită și cu media ta pe 28 de zile. Aici pot apărea și tipare din propriile tale date."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Нутриенты с заданным вами верхним лимитом, например сахар, натрий, насыщенные жиры или кофеин, сравниваются с этим лимитом и вашим средним за 28 дней. Здесь также могут появляться закономерности из ваших данных."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Поживні речовини з установленим вами верхнім лімітом, як-от цукор, натрій, насичені жири чи кофеїн, порівнюються з цим лімітом і вашим середнім за 28 днів. Тут також можуть з'являтися закономірності з ваших даних."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "设有上限的营养素（如糖、钠、饱和脂肪或咖啡因）会与该上限和你的 28 天平均值比较。基于你自己数据的规律也可能出现在这里。"
          }
        }
      }
    },
