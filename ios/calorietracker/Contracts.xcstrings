    "metric.metrics.app:weight.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "إدخالات الوزن التي تسجّلها في Ayuvo، بما فيها القراءات المستوردة من تطبيقات الصحة المرتبطة. تعرض كل نقطة أحدث قراءة في تلك الفترة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo-da qeyd etdiyiniz çəki qeydləri, o cümlədən qoşulmuş sağlamlıq tətbiqlərindən idxal edilən göstəricilər. Hər nöqtə həmin dövrün ən son göstəricisini göstərir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Záznamy hmotnosti, které zapisuješ v Ayuvo, včetně měření importovaných z připojených zdravotních aplikací. Každý bod ukazuje nejnovější měření daného období."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gewichtseinträge, die du in Ayuvo erfasst, einschließlich aus verbundenen Gesundheits-Apps importierter Messwerte. Jeder Punkt zeigt den letzten Messwert des jeweiligen Zeitraums."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weight entries you log in Ayuvo, including readings imported from connected health apps. Each point shows the latest reading of that period."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las entradas de peso que registras en Ayuvo, incluidas las lecturas importadas de apps de salud conectadas. Cada punto muestra la lectura más reciente de ese periodo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les pesées que vous enregistrez dans Ayuvo, y compris les mesures importées depuis des apps de santé connectées. Chaque point indique la dernière mesure de la période."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo में लॉग की गई वज़न एंट्री, जिनमें कनेक्ट किए गए हेल्थ ऐप से इम्पोर्ट की गई रीडिंग भी शामिल हैं। हर पॉइंट उस अवधि की सबसे हाल की रीडिंग दिखाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voci di peso che registri in Ayuvo, incluse le misurazioni importate dalle app di salute collegate. Ogni punto mostra la misurazione più recente di quel periodo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvoで記録した体重（接続した健康アプリからインポートした測定値を含む）です。各ポイントはその期間の最新の測定値を示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "연결된 건강 앱에서 가져온 측정값을 포함해 Ayuvo에 기록한 체중이에요. 각 포인트는 해당 기간의 최근 측정값을 보여 줘요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gewichtsmetingen die je in Ayuvo logt, inclusief metingen die zijn geïmporteerd uit gekoppelde gezondheidsapps. Elk punt toont de laatste meting van die periode."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pomiary wagi zapisane w Ayuvo, w tym odczyty zaimportowane z połączonych aplikacji zdrowotnych. Każdy punkt pokazuje najnowszy odczyt z danego okresu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Registros de peso que você faz no Ayuvo, incluindo leituras importadas de apps de saúde conectados. Cada ponto mostra a leitura mais recente daquele período."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Greutățile pe care le înregistrezi în Ayuvo, inclusiv citirile importate din aplicațiile de sănătate conectate. Fiecare punct arată cea mai recentă citire din acea perioadă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Записи веса в Ayuvo, включая данные, импортированные из подключённых приложений здоровья. Каждая точка показывает последнее значение за этот период."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Записи ваги, які ви додаєте в Ayuvo, зокрема вимірювання, імпортовані з підключених застосунків здоров'я. Кожна точка показує останнє вимірювання за цей період."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你在 Ayuvo 中记录的体重条目，包括从已连接的健康 App 导入的读数。每个点显示该时段的最新读数。"
          }
        }
      }
