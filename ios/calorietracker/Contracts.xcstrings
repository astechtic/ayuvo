    "insights.methodology.daily_review.sections.4.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا ترى المراجعة إلا ما تم تسجيله أو مزامنته. إنها تصف يومك؛ وليست نصيحة طبية."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "İcmal yalnız qeyd edilən və ya sinxronlaşdırılanları görə bilər. O, gününüzü təsvir edir; tibbi məsləhət deyil."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Souhrn vidí jen to, co bylo zapsáno nebo synchronizováno. Popisuje tvůj den; nejde o lékařskou radu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Rückblick sieht nur, was erfasst oder synchronisiert wurde. Er beschreibt deinen Tag; er ist keine medizinische Beratung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The review can only see what was logged or synced. It describes your day; it is not medical advice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El resumen solo puede ver lo que se registró o sincronizó. Describe tu día; no es consejo médico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le bilan ne voit que ce qui a été enregistré ou synchronisé. Il décrit votre journée ; ce n'est pas un avis médical."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "समीक्षा केवल वही देख सकती है जो लॉग या सिंक किया गया। यह आपके दिन का वर्णन करती है; यह मेडिकल सलाह नहीं है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il riepilogo vede solo ciò che è stato registrato o sincronizzato. Descrive la tua giornata; non è un consiglio medico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "レビューは記録または同期されたものしか確認できません。あなたの1日を説明するものであり、医学的なアドバイスではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "리뷰는 기록되거나 동기화된 내용만 볼 수 있어요. 하루를 설명할 뿐이며, 의학적 조언이 아니에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Het overzicht ziet alleen wat is gelogd of gesynchroniseerd. Het beschrijft je dag; het is geen medisch advies."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przegląd widzi tylko to, co zostało zapisane lub zsynchronizowane. Opisuje Twój dzień; nie jest poradą medyczną."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A revisão só enxerga o que foi registrado ou sincronizado. Ela descreve o seu dia; não é aconselhamento médico."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Analiza vede doar ce a fost înregistrat sau sincronizat. Îți descrie ziua; nu este un sfat medical."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Итоги учитывают только то, что было записано или синхронизировано. Они описывают ваш день; это не медицинская рекомендация."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Огляд бачить лише те, що було записано або синхронізовано. Він описує ваш день; це не медична порада."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "回顾只能看到已记录或已同步的内容。它描述你的一天，不构成医疗建议。"
          }
        }
      }
    },
