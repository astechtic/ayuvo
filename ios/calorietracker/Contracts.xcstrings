    "derived.metrics.walking_speed_weekly.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "سرعة مشيك المعتادة خلال آخر 7 أيام. ترتبط السرعة الأقل من 0.8 m/s بمخاطر صحية أعلى لدى كبار السن."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Son 7 gündə tipik gəzinti sürətiniz. 0,8 m/s-dən aşağı sürət yaşlılarda daha yüksək sağlamlıq riski ilə əlaqələndirilir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tvá obvyklá rychlost chůze za posledních 7 dní. Méně než 0,8 m/s souvisí u starších dospělých s vyšším zdravotním rizikem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deine typische Gehgeschwindigkeit in den letzten 7 Tagen. Unter 0,8 m/s ist bei älteren Erwachsenen mit einem höheren Gesundheitsrisiko verbunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your typical walking speed over the last 7 days. Below 0.8 m/s is linked with higher health risk in older adults."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu velocidad habitual al caminar en los últimos 7 días. Por debajo de 0,8 m/s se asocia a un mayor riesgo para la salud en adultos mayores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Votre vitesse de marche habituelle sur les 7 derniers jours. En dessous de 0,8 m/s, elle est associée à un risque accru pour la santé chez les personnes âgées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "पिछले 7 दिनों में आपकी सामान्य चलने की गति। 0.8 m/s से कम बुज़ुर्गों में अधिक स्वास्थ्य जोखिम से जुड़ी है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La tua velocità di camminata tipica negli ultimi 7 giorni. Sotto 0,8 m/s è associata a un rischio per la salute più alto negli anziani."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "過去7日間の一般的な歩行速度です。0.8 m/s未満は、高齢者における健康リスクの上昇と関連しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "최근 7일 동안의 일반적인 걷기 속도예요. 고령자의 경우 0.8 m/s 미만은 더 높은 건강 위험과 관련이 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je gebruikelijke wandelsnelheid over de laatste 7 dagen. Onder 0,8 m/s hangt samen met een hoger gezondheidsrisico bij ouderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Twoja typowa prędkość chodu w ciągu ostatnich 7 dni. Poniżej 0,8 m/s wiąże się z wyższym ryzykiem zdrowotnym u osób starszych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sua velocidade típica de caminhada nos últimos 7 dias. Abaixo de 0,8 m/s está associada a maior risco à saúde em idosos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Viteza ta obișnuită de mers în ultimele 7 zile. Sub 0,8 m/s este asociată cu un risc mai mare pentru sănătate la vârstnici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ваша обычная скорость ходьбы за последние 7 дней. Скорость ниже 0,8 м/с у пожилых людей связана с более высоким риском для здоровья."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ваша типова швидкість ходьби за останні 7 днів. Швидкість нижче 0,8 м/с пов'язана з вищим ризиком для здоров'я в літніх людей."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你过去 7 天的典型步行速度。在老年人中，低于 0.8 m/s 与较高的健康风险相关。"
          }
        }
      }
    },
