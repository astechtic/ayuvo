    "insights.methodology.baselines.sections.2.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "نطاقك الطبيعي هو متوسطك زائد أو ناقص انحراف معياري واحد، أي التشتت المعتاد لقراءاتك. يُستخدم حد أدنى للتشتت لكل مقياس، حتى لا يجعل السجل الثابت جدًا التغيرات الصغيرة تبدو كبيرة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Normal aralığınız ortalamanız üstəgəl və ya çıxılmaqla bir standart kənarlaşmadır, yəni göstəricilərinizin adi yayılması. Hər göstərici üçün minimal yayılma istifadə olunur ki, çox sabit tarixçə kiçik dəyişiklikləri dramatik göstərməsin."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tvé normální rozmezí je tvůj průměr plus minus jedna směrodatná odchylka, tedy obvyklý rozptyl tvých měření. Pro každou metriku se používá minimální rozptyl, aby velmi stabilní historie nedělala z drobných změn dramatické."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dein Normalbereich ist dein Durchschnitt plus oder minus eine Standardabweichung, also die übliche Streuung deiner Messwerte. Für jeden Messwert wird eine Mindeststreuung verwendet, damit ein sehr gleichmäßiger Verlauf winzige Änderungen nicht dramatisch wirken lässt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your normal range is your average plus or minus one standard deviation, the usual spread of your readings. A minimum spread is used for each metric, so a very steady history does not make tiny changes look dramatic."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu rango normal es tu promedio más o menos una desviación estándar, la dispersión habitual de tus lecturas. Se usa una dispersión mínima para cada métrica, para que un historial muy estable no haga que cambios pequeños parezcan drásticos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Votre plage normale est votre moyenne plus ou moins un écart type, la dispersion habituelle de vos mesures. Une dispersion minimale est utilisée pour chaque métrique, afin qu'un historique très stable ne rende pas spectaculaires de petites variations."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपकी सामान्य सीमा आपका औसत प्लस या माइनस एक मानक विचलन है, यानी आपकी रीडिंग का सामान्य फैलाव। हर मेट्रिक के लिए न्यूनतम फैलाव उपयोग होता है, ताकि बहुत स्थिर इतिहास में छोटे बदलाव बड़े न लगें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il tuo intervallo normale è la tua media più o meno una deviazione standard, la dispersione abituale delle tue rilevazioni. Per ogni metrica si usa una dispersione minima, così una cronologia molto stabile non fa sembrare drammatiche piccole variazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "通常範囲は、平均値±1標準偏差（測定値の通常のばらつき）です。各指標には最小のばらつきが設定されているため、非常に安定した履歴でも小さな変化が大げさに見えることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "정상 범위는 평균에서 표준 편차 하나만큼 더하거나 뺀 범위로, 측정값의 일반적인 분포예요. 지표마다 최소 분포가 적용되므로 기록이 매우 안정적이어도 작은 변화가 크게 보이지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je normale bereik is je gemiddelde plus of min één standaardafwijking, de gebruikelijke spreiding van je metingen. Voor elke waarde geldt een minimale spreiding, zodat een heel stabiele geschiedenis kleine veranderingen niet dramatisch laat lijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Twój normalny zakres to Twoja średnia plus minus jedno odchylenie standardowe, czyli typowy rozrzut Twoich odczytów. Dla każdej metryki stosowany jest minimalny rozrzut, aby przy bardzo stabilnej historii drobne zmiany nie wyglądały dramatycznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sua faixa normal é sua média mais ou menos um desvio-padrão, a dispersão habitual das suas leituras. Uma dispersão mínima é usada para cada métrica, para que um histórico muito estável não faça pequenas mudanças parecerem drásticas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Intervalul tău normal este media ta plus sau minus o abatere standard, adică dispersia obișnuită a citirilor tale. Pentru fiecare valoare se folosește o dispersie minimă, ca un istoric foarte stabil să nu facă schimbările mici să pară dramatice."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ваш нормальный диапазон — это среднее плюс-минус одно стандартное отклонение, обычный разброс ваших показаний. Для каждого показателя задан минимальный разброс, чтобы при очень стабильной истории крошечные изменения не выглядели резкими."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ваш нормальний діапазон — це ваше середнє плюс-мінус одне стандартне відхилення, тобто звичайний розкид ваших показників. Для кожного показника використовується мінімальний розкид, тож дуже стабільна історія не робить дрібні зміни драматичними."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你的正常范围是平均值加减一个标准差，即你读数的通常波动幅度。每项指标都设有最小波动幅度，这样非常稳定的历史数据不会让微小变化看起来很剧烈。"
          }
        }
      }
    },
