    "derived.metrics.tdee.method" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(طاقة الراحة + الطاقة النشطة) ÷ 0.9، أي إضافة نحو 10% للهضم. يتطلب يومًا كاملًا من طاقة الراحة (70% على الأقل من معدل الأيض الأساسي المتوقع لديك)."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(İstirahət + aktiv enerji) ÷ 0,9, həzm üçün təxminən 10% əlavə edilir. Tam günlük istirahət enerjisi tələb olunur (proqnozlaşdırılan BMR-in ən azı 70%⁠-i)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Klidová + aktivní energie) ÷ 0,9, tedy přičtení asi 10 % na trávení. Vyžaduje celý den klidové energie (alespoň 70 % tvého předpokládaného BMR)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Ruhe- + Aktivitätsenergie) ÷ 0,9, wobei etwa 10 % für die Verdauung hinzukommen. Erfordert einen vollen Tag Ruheenergie (mindestens 70 % deines vorhergesagten Grundumsatzes)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Resting + active energy) ÷ 0.9, adding about 10% for digestion. Needs a full day of resting energy (at least 70% of your predicted BMR)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Energía en reposo + activa) ÷ 0,9, añadiendo alrededor de un 10 % por la digestión. Requiere un día completo de energía en reposo (al menos el 70 % de tu TMB prevista)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Énergie au repos + énergie active) ÷ 0,9, soit environ 10 % ajoutés pour la digestion. Nécessite une journée complète d'énergie au repos (au moins 70 % de votre métabolisme de base prédit)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(विश्राम + सक्रिय ऊर्जा) ÷ 0.9, पाचन के लिए लगभग 10% जोड़कर। पूरे दिन की विश्राम ऊर्जा चाहिए (आपके अनुमानित BMR का कम से कम 70%)।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Energia a riposo + attiva) ÷ 0,9, aggiungendo circa il 10% per la digestione. Richiede un giorno intero di energia a riposo (almeno il 70% del tuo metabolismo basale previsto)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "（安静時 + アクティブエネルギー）÷ 0.9で、消化分として約10%を加えます。1日分の安静時エネルギー（予測基礎代謝量の70%以上）が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(휴식 + 활동 에너지) ÷ 0.9, 소화에 약 10%를 더해요. 하루 전체의 휴식 에너지(예측 BMR의 최소 70%)가 필요해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Rustenergie + actieve energie) ÷ 0,9, waarmee ongeveer 10% voor de spijsvertering wordt toegevoegd. Vereist een volledige dag rustenergie (minstens 70% van je voorspelde BMR)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Energia spoczynkowa + aktywna) ÷ 0,9, dodając ok. 10% na trawienie. Wymaga pełnego dnia energii spoczynkowej (co najmniej 70% przewidywanej BMR)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Energia em repouso + ativa) ÷ 0,9, somando cerca de 10% para a digestão. Requer um dia completo de energia em repouso (pelo menos 70% da sua TMB prevista)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Energie în repaus + activă) ÷ 0,9, adăugând circa 10% pentru digestie. Necesită o zi completă de energie în repaus (cel puțin 70% din BMR-ul tău estimat)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Энергия покоя + активная энергия) ÷ 0,9, что добавляет около 10% на пищеварение. Нужны данные энергии покоя за полный день (не менее 70% прогнозируемого BMR)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Енергія спокою + активна енергія) ÷ 0,9, тобто додається близько 10% на травлення. Потрібні дані енергії спокою за повний день (щонайменше 70% від прогнозованого BMR)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "（静息能量 + 活动能量）÷ 0.9，约增加 10% 用于消化。需要一整天的静息能量数据（至少为预测 BMR 的 70%）。"
          }
        }
      }
    },
