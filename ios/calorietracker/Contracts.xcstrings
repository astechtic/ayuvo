    "insights.methodology.health_age.sections.5.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تأتي الجداول السكانية من مجموعات وطرق مخبرية محددة، وقراءات الساعة تقديرات. معايير HRV مأخوذة من تسجيلات تخطيط القلب أثناء الراحة، لذا يبقى وزن هذا المؤشر صغيرًا. تعامل مع الرقم كاتجاه تراقبه، لا كحكم نهائي."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Əhali cədvəlləri müəyyən qruplardan və laboratoriya metodlarından gəlir, saat göstəriciləri isə təxminidir. HRV normaları istirahətdə EKQ qeydlərindən gəlir, ona görə də bu göstəricinin təsiri kiçik saxlanılır. Rəqəmə hökm kimi deyil, izləniləcək istiqamət kimi yanaşın."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Populační tabulky pocházejí z konkrétních skupin a laboratorních metod a měření z hodinek jsou odhady. Normy HRV pocházejí z klidových záznamů EKG, proto má tento ukazatel malou váhu. Ber číslo jako směr ke sledování, ne jako verdikt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bevölkerungstabellen stammen aus bestimmten Gruppen und Labormethoden, und Uhr-Messwerte sind Schätzungen. HRV-Normen stammen aus Ruhe-EKG-Aufzeichnungen, daher wird dieser Marker gering gewichtet. Betrachte die Zahl als Richtung, die du beobachten kannst, nicht als Urteil."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Population tables come from specific groups and lab methods, and watch readings are estimates. HRV norms come from resting ECG recordings, so that marker is kept small. Treat the number as a direction to watch, not a verdict."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las tablas de población proceden de grupos y métodos de laboratorio concretos, y las lecturas del reloj son estimaciones. Las normas de HRV proceden de registros de ECG en reposo, por lo que ese marcador tiene poco peso. Toma la cifra como una dirección que vigilar, no como un veredicto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les tableaux de population proviennent de groupes et de méthodes de laboratoire spécifiques, et les mesures de la montre sont des estimations. Les normes de VFC proviennent d'enregistrements ECG au repos, ce marqueur a donc un poids réduit. Considérez ce chiffre comme une tendance à surveiller, pas comme un verdict."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "जनसंख्या तालिकाएँ विशिष्ट समूहों और लैब विधियों से आती हैं, और घड़ी की रीडिंग अनुमान होती हैं। HRV मानक आराम के समय की ECG रिकॉर्डिंग से आते हैं, इसलिए उस मार्कर का असर कम रखा गया है। इस संख्या को देखने लायक दिशा मानें, अंतिम फ़ैसला नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le tabelle della popolazione provengono da gruppi e metodi di laboratorio specifici, e le rilevazioni dell'orologio sono stime. Le norme dell'HRV derivano da ECG a riposo, quindi il peso di quell'indicatore è ridotto. Considera il numero come una direzione da osservare, non un verdetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "集団の表は特定のグループと検査方法に基づくもので、ウォッチの測定値は推定値です。HRVの基準値は安静時の心電図記録によるものなので、この指標の比重は小さくしています。この数値は判定ではなく、見守るべき方向性として捉えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "인구 집단 표는 특정 집단과 검사 방법에서 나온 것이며, 워치 측정값은 추정치예요. HRV 기준은 안정 시 심전도 기록에서 나온 것이므로 이 지표의 비중은 작게 유지돼요. 이 숫자는 판정이 아니라 지켜볼 방향으로 참고하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bevolkingstabellen komen van specifieke groepen en labmethoden, en metingen van horloges zijn schattingen. HRV-normen komen van ecg-opnamen in rust, dus die marker telt maar weinig mee. Zie het getal als een richting om in de gaten te houden, niet als een oordeel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tabele populacyjne pochodzą z określonych grup i metod laboratoryjnych, a odczyty z zegarka są szacunkami. Normy HRV pochodzą ze spoczynkowych zapisów EKG, dlatego waga tego wskaźnika jest niewielka. Traktuj tę liczbę jako kierunek do obserwowania, a nie werdykt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As tabelas populacionais vêm de grupos e métodos laboratoriais específicos, e as leituras do relógio são estimativas. As referências de HRV vêm de registros de ECG em repouso, por isso esse marcador tem peso pequeno. Trate o número como uma direção a observar, não como um veredito."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tabelele pentru populație provin din grupuri și metode de laborator specifice, iar citirile de pe ceas sunt estimări. Normele HRV provin din înregistrări ECG în repaus, așa că acel marker are o pondere mică. Privește cifra ca pe o direcție de urmărit, nu ca pe un verdict."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Популяционные таблицы получены для определённых групп и лабораторными методами, а показания часов являются оценками. Нормы HRV основаны на записях ЭКГ в покое, поэтому вес этого маркера невелик. Воспринимайте число как направление для наблюдения, а не как вердикт."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Популяційні таблиці складено для конкретних груп і лабораторних методів, а показники годинника — це оцінки. Норми HRV отримано із записів ЕКГ у спокої, тому вага цього маркера невелика. Сприймайте число як напрямок для спостереження, а не як вердикт."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "人群数据表来自特定群体和实验室方法，而手表读数只是估算。HRV 标准来自静息心电图记录，因此该指标的权重较小。请把这个数字当作需要关注的方向，而不是定论。"
          }
        }
      }
    },
