    "insights.methodology.health_age.sections.3.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تاريخ ميلادك في ملفك الشخصي، و3 مؤشرات على الأقل تشمل VO₂max أو معدل ضربات القلب أثناء الراحة أو HRV. تحتاج معظم المؤشرات إلى 30 يومًا من البيانات خلال آخر 90 يومًا؛ ويحتاج VO₂max إلى 3 قراءات وتكوين الجسم إلى قراءة واحدة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Profilinizdə doğum tarixiniz və VO2 max, istirahət ürək döyüntüsü və ya HRV daxil olmaqla ən azı 3 göstərici. Əksər göstəricilər son 90 gündə 30 günlük məlumat tələb edir; VO2 max 3 ölçmə, bədən tərkibi isə 1 ölçmə tələb edir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Datum narození v profilu a alespoň 3 ukazatele, včetně VO2 max, klidové tepové frekvence nebo HRV. Většina ukazatelů vyžaduje 30 dní dat za posledních 90; VO2 max vyžaduje 3 měření a složení těla 1."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dein Geburtstag im Profil und mindestens 3 Marker, darunter VO₂max, Ruheherzfrequenz oder HRV. Die meisten Marker brauchen 30 Tage mit Daten in den letzten 90; VO₂max braucht 3 Messwerte und Körperzusammensetzung 1."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your birthday in your profile, and at least 3 markers including VO2 max, resting heart rate or HRV. Most markers need 30 days of data in the last 90; VO2 max needs 3 readings and body composition 1."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu fecha de nacimiento en el perfil y al menos 3 marcadores, incluido el VO₂max, la frecuencia cardíaca en reposo o la HRV. La mayoría de los marcadores necesitan 30 días de datos en los últimos 90; el VO₂max necesita 3 lecturas y la composición corporal 1."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Votre date de naissance dans votre profil, et au moins 3 marqueurs dont la VO2 max, la fréquence cardiaque au repos ou la VFC. La plupart des marqueurs nécessitent 30 jours de données sur les 90 derniers ; la VO2 max nécessite 3 mesures et la composition corporelle 1."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपकी प्रोफ़ाइल में आपका जन्मदिन, और कम से कम 3 मार्कर जिनमें VO2 max, विश्राम हृदय गति या HRV शामिल हो। ज़्यादातर मार्करों को पिछले 90 में से 30 दिनों का डेटा चाहिए; VO2 max को 3 रीडिंग और शरीर की संरचना को 1 चाहिए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La tua data di nascita nel profilo e almeno 3 indicatori tra cui VO₂max, frequenza cardiaca a riposo o HRV. La maggior parte degli indicatori richiede 30 giorni di dati negli ultimi 90; il VO₂max richiede 3 rilevazioni e la composizione corporea 1."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "プロフィールの誕生日と、VO2 max、安静時心拍数、HRVのいずれかを含む3つ以上の指標。ほとんどの指標は過去90日間のうち30日分のデータが必要です。VO2 maxは3回、体組成は1回の測定値が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "프로필의 생일과 VO₂max, 안정 시 심박수 또는 HRV를 포함한 최소 3개의 지표가 필요해요. 대부분의 지표는 최근 90일 중 30일의 데이터가 필요하며, VO₂max는 측정값 3개, 체성분은 1개가 필요해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je geboortedatum in je profiel, en minstens 3 markers waaronder VO2 max, hartslag in rust of HRV. De meeste markers hebben 30 dagen gegevens nodig binnen de laatste 90; VO2 max heeft 3 metingen nodig en lichaamssamenstelling 1."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Data urodzenia w Twoim profilu i co najmniej 3 wskaźniki, w tym VO₂max, tętno spoczynkowe lub HRV. Większość wskaźników wymaga 30 dni danych z ostatnich 90; VO₂max wymaga 3 odczytów, a skład ciała 1."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sua data de nascimento no perfil e pelo menos 3 marcadores, incluindo VO₂max, frequência cardíaca em repouso ou HRV. A maioria dos marcadores precisa de 30 dias de dados nos últimos 90; o VO₂max precisa de 3 leituras e a composição corporal, de 1."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Data nașterii în profil și cel puțin 3 markeri, inclusiv VO₂max, pulsul în repaus sau HRV. Majoritatea markerilor necesită 30 de zile de date din ultimele 90; VO₂max necesită 3 citiri, iar compoziția corporală 1."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Дата рождения в профиле и не менее 3 маркеров, включая VO₂max, пульс в покое или HRV. Для большинства маркеров нужно 30 дней данных за последние 90; для VO₂max — 3 показания, для состава тела — 1."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Дата народження у вашому профілі та щонайменше 3 маркери, зокрема VO₂max, пульс у спокої або HRV. Більшості маркерів потрібно 30 днів даних з останніх 90; VO₂max — 3 показники, складу тіла — 1."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "个人资料中的生日，以及至少 3 项指标，其中包括 VO₂max、静息心率或 HRV。大多数指标需要在过去 90 天内有 30 天数据；VO₂max 需要 3 个读数，身体成分需要 1 个。"
          }
        }
      }
    },
