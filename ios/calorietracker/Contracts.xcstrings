    "derived.metrics.weight_rate.method" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(اتجاه اليوم − الاتجاه قبل 14 يومًا) ÷ 2. يتطلب 4 أوزان مسجّلة خلال 14 يومًا."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Bugünkü trend − 14 gün əvvəlki trend) ÷ 2. 14 gündə 4 çəki ölçməsi tələb olunur."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Dnešní trend − trend před 14 dny) ÷ 2. Vyžaduje 4 vážení za 14 dní."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Trend heute − Trend vor 14 Tagen) ÷ 2. Erfordert 4 Wiegungen in 14 Tagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Trend today − trend 14 days ago) ÷ 2. Needs 4 weigh-ins in 14 days."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Tendencia de hoy − tendencia de hace 14 días) ÷ 2. Requiere 4 pesajes en 14 días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Tendance aujourd'hui − tendance il y a 14 jours) ÷ 2. Nécessite 4 pesées sur 14 jours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(आज का ट्रेंड − 14 दिन पहले का ट्रेंड) ÷ 2। 14 दिनों में 4 बार वज़न दर्ज होना चाहिए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Andamento oggi − andamento 14 giorni fa) ÷ 2. Richiede 4 pesate in 14 giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "（今日のトレンド − 14日前のトレンド）÷ 2。14日間に4回の体重測定が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(오늘 추세 − 14일 전 추세) ÷ 2. 14일 동안 체중 측정 4회가 필요해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Trend vandaag − trend 14 dagen geleden) ÷ 2. Vereist 4 wegingen in 14 dagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Trend dziś − trend 14 dni temu) ÷ 2. Wymaga 4 pomiarów wagi w ciągu 14 dni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Tendência hoje − tendência há 14 dias) ÷ 2. Requer 4 pesagens em 14 dias."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Tendința de azi − tendința de acum 14 zile) ÷ 2. Necesită 4 cântăriri în 14 zile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Тренд сегодня − тренд 14 дней назад) ÷ 2. Нужно 4 взвешивания за 14 дней."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "(Тенденція сьогодні − тенденція 14 днів тому) ÷ 2. Потрібно 4 зважування за 14 днів."
