    "derived.metrics.sleep_wakeups.method" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "فجوات ≥5 دقائق بين مراحل النوم، من أول نوم حتى الاستيقاظ النهائي. تُعرض دقائق اليقظة على أنها اليقظة بعد بدء النوم."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "İlk yuxudan son oyanmaya qədər yuxu mərhələləri arasında ≥5 dəqiqəlik fasilələr. Oyaq dəqiqələr yuxuya getdikdən sonra oyaqlıq kimi göstərilir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mezery ≥5 minut mezi fázemi spánku, od prvního usnutí po konečné probuzení. Minuty v bdělém stavu se zobrazují jako bdění po usnutí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lücken von ≥5 Minuten zwischen Schlafphasen, vom ersten Einschlafen bis zum endgültigen Aufwachen. Wachminuten werden als Wachzeit nach dem Einschlafen angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaps of ≥5 minutes between asleep stages, from first sleep to final waking. Minutes awake are shown as wake after sleep onset."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Intervalos de ≥5 minutos entre fases de sueño, desde el primer sueño hasta el despertar final. Los minutos despierto se muestran como vigilia tras el inicio del sueño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Intervalles de ≥5 minutes entre les phases de sommeil, du premier endormissement au réveil final. Les minutes éveillées sont affichées comme éveil après endormissement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "पहली नींद से अंतिम जागने तक, नींद के चरणों के बीच ≥5 मिनट के अंतराल। जागने के मिनट नींद शुरू होने के बाद जागना के रूप में दिखाए जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Intervalli di ≥5 minuti tra le fasi di sonno, dal primo addormentamento al risveglio finale. I minuti di veglia sono mostrati come veglia dopo l'addormentamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "最初の睡眠から最終的な起床までの、睡眠ステージ間の5分以上の空白です。覚醒していた時間は入眠後覚醒時間として表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "처음 잠든 시점부터 최종 기상까지 수면 단계 사이의 5분 이상 공백이에요. 깨어 있던 시간은 입면 후 각성 시간으로 표시돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
