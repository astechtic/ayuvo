    "derived.metrics.rhr_deviation.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مدى ابتعاد معدل ضربات القلب أثناء الراحة اليوم عن متوسطك خلال 30 يومًا. يومان متتاليان بزيادة 5 bpm أو أكثر عن المعتاد قد يعنيان إجهادًا أو نومًا سيئًا أو بداية مرض."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bugünkü istirahət ürək döyüntüsünün 30 günlük ortalamanızdan nə qədər fərqləndiyi. Ardıcıl iki gün adi səviyyədən 5 bpm və ya daha çox yuxarı olması gərginlik, pis yuxu və ya xəstələnmə demək ola bilər."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jak daleko je dnešní klidová tepová frekvence od tvého 30denního průměru. Dva dny po sobě o 5 bpm nebo víc nad obvyklou hodnotou mohou znamenat zátěž, špatný spánek nebo nástup nemoci."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wie weit die heutige Ruheherzfrequenz von deinem 30-Tage-Durchschnitt abweicht. Zwei Tage in Folge 5 bpm oder mehr über dem Üblichen können auf Belastung, schlechten Schlaf oder eine beginnende Krankheit hindeuten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How far today's resting heart rate is from your 30-day average. Two days in a row 5 bpm or more above usual can mean strain, poor sleep or getting ill."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuánto se aleja la frecuencia cardíaca en reposo de hoy de tu promedio de 30 días. Dos días seguidos con 5 bpm o más por encima de lo habitual pueden indicar esfuerzo, mal descanso o que te estás enfermando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'écart entre votre fréquence cardiaque au repos d'aujourd'hui et votre moyenne sur 30 jours. Deux jours de suite à 5 bpm ou plus au-dessus de l'habitude peuvent indiquer de la fatigue, un mauvais sommeil ou le début d'une maladie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आज की विश्राम हृदय गति आपके 30-दिन के औसत से कितनी दूर है। लगातार दो दिन सामान्य से 5 bpm या उससे अधिक होना तनाव, खराब नींद या बीमार पड़ने का संकेत हो सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quanto la frequenza cardiaca a riposo di oggi si discosta dalla tua media di 30 giorni. Due giorni di fila con 5 bpm o più sopra il solito possono indicare affaticamento, sonno scarso o l'inizio di una malattia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "今日の安静時心拍数が30日平均からどれだけ離れているかを示します。2日続けて普段より5 bpm以上高い場合は、負担、睡眠不足、体調不良の兆しの可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "오늘의 안정 시 심박수가 30일 평균과 얼마나 차이 나는지 보여줘요. 이틀 연속 평소보다 5 bpm 이상 높으면 무리, 수면 부족 또는 몸이 아파지는 신호일 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hoever je hartslag in rust vandaag afwijkt van je gemiddelde over 30 dagen. Twee dagen op rij 5 bpm of meer boven normaal kan wijzen op belasting, slecht slapen of ziek worden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jak bardzo dzisiejsze tętno spoczynkowe odbiega od Twojej średniej z 30 dni. Dwa dni z rzędu o 5 bpm lub więcej powyżej normy mogą oznaczać przeciążenie, słaby sen lub początek choroby."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quanto a frequência cardíaca em repouso de hoje se afasta da sua média de 30 dias. Dois dias seguidos 5 bpm ou mais acima do habitual podem indicar sobrecarga, sono ruim ou início de doença."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cât de departe este pulsul în repaus de azi față de media ta pe 30 de zile. Două zile la rând cu 5 bpm sau mai mult peste obișnuit pot însemna suprasolicitare, somn slab sau o boală care începe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Насколько сегодняшний пульс в покое отличается от среднего за 30 дней. Два дня подряд на 5 bpm и более выше обычного могут означать перенапряжение, плохой сон или начало болезни."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Наскільки сьогоднішній пульс у спокої відрізняється від вашого середнього за 30 днів. Два дні поспіль на 5 вд/хв або більше вище звичного можуть означати перенавантаження, поганий сон або початок хвороби."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "今天的静息心率与你 30 天平均值的差距。连续两天比平时高 5 bpm 或以上，可能意味着身体负荷过大、睡眠不佳或即将生病。"
          }
        }
      }
    },
