    "metric.metrics.app:calories.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الطاقة من الطعام الذي تسجّله في Ayuvo، مجموعةً لكل يوم. تعرض النطاقات الأطول متوسطك في الأيام التي سجّلت فيها طعامًا."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo-da qeyd etdiyiniz qidalardan gələn enerji, gün üzrə toplanıb. Daha uzun aralıqlar qida qeyd etdiyiniz günlər üzrə ortanı göstərir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Energie z jídla, které zapisuješ v Ayuvo, sečtená za každý den. Delší období zobrazují průměr za dny, kdy jsi zapsal(a) jídlo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Energie aus dem Essen, das du in Ayuvo erfasst, pro Tag summiert. Längere Zeiträume zeigen deinen Durchschnitt an Tagen mit erfasstem Essen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energy from the food you log in Ayuvo, added up per day. Longer ranges show your average on days you logged food."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La energía de la comida que registras en Ayuvo, sumada por día. Los intervalos más largos muestran tu promedio en los días en que registraste comida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'énergie des aliments que vous enregistrez dans Ayuvo, additionnée par jour. Les périodes plus longues affichent votre moyenne sur les jours où vous avez enregistré des aliments."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo में लॉग किए गए भोजन से ऊर्जा, प्रतिदिन जोड़ी गई। लंबी सीमाओं में उन दिनों का औसत दिखता है जिन दिनों आपने भोजन लॉग किया।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Energia dagli alimenti che registri in Ayuvo, sommata per giorno. Gli intervalli più lunghi mostrano la media dei giorni in cui hai registrato alimenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvoで記録した食事のエネルギーを1日ごとに合計したものです。長い期間では、食事を記録した日の平均が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo에 기록한 음식의 에너지를 하루 단위로 합산해요. 긴 기간에서는 음식을 기록한 날의 평균이 표시돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Energie uit het eten dat je in Ayuvo logt, opgeteld per dag. Langere periodes tonen je gemiddelde op dagen waarop je eten hebt gelogd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Energia z jedzenia zapisanego w Ayuvo, sumowana dziennie. Dłuższe zakresy pokazują średnią z dni, w których zapisano jedzenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Energia dos alimentos que você registra no Ayuvo, somada por dia. Períodos mais longos mostram sua média nos dias em que você registrou alimentos."
