          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anteil deiner Zeit im Bett, die du geschlafen hast. 85 % oder mehr gelten als gut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share of your time in bed spent asleep. 85% or more is considered good."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
