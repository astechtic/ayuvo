    "insights.methodology.recovery.sections.6.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يمكن أن يؤثر المرض والكحول والسفر والتوتر وطريقة ارتداء الجهاز في هذه الإشارات. التعافي تقدير للعافية من بياناتك الخاصة، وليس تشخيصًا طبيًا أو نصيحة طبية."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Xəstəlik, alkoqol, səyahət, stress və cihazın oturuşu bu siqnallara təsir edə bilər. Bərpa öz məlumatlarınızdan sağlamlıq təxminidir; tibbi diaqnoz və ya məsləhət deyil."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nemoc, alkohol, cestování, stres i nasazení zařízení mohou tyto signály ovlivnit. Regenerace je odhad wellness z tvých vlastních údajů, nikoli lékařská diagnóza ani rada."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Krankheit, Alkohol, Reisen, Stress und der Sitz des Geräts können diese Signale beeinflussen. Die Erholung ist eine Wellness-Schätzung aus deinen eigenen Daten, keine medizinische Diagnose oder Beratung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illness, alcohol, travel, stress and device fit can all move these signals. Recovery is a wellness estimate from your own data, not a medical diagnosis or advice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las enfermedades, el alcohol, los viajes, el estrés y el ajuste del dispositivo pueden alterar estas señales. La Recuperación es una estimación de bienestar a partir de tus propios datos, no un diagnóstico ni consejo médico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La maladie, l'alcool, les voyages, le stress et l'ajustement de l'appareil peuvent tous influencer ces signaux. La Récupération est une estimation de bien-être basée sur vos propres données, et non un diagnostic ou un avis médical."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बीमारी, शराब, यात्रा, तनाव और डिवाइस का ठीक से न पहना होना, ये सभी इन संकेतों को बदल सकते हैं। रिकवरी आपके अपने डेटा से वेलनेस अनुमान है, मेडिकल निदान या सलाह नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Malattia, alcol, viaggi, stress e vestibilità del dispositivo possono influenzare questi segnali. Il Recupero è una stima di benessere basata sui tuoi dati, non una diagnosi o un consiglio medico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "病気、アルコール、旅行、ストレス、デバイスの装着具合は、いずれもこれらのシグナルに影響します。リカバリーはあなた自身のデータに基づくウェルネスの推定であり、医学的な診断やアドバイスではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "질병, 음주, 여행, 스트레스, 기기 착용 상태 모두 이 신호에 영향을 줄 수 있어요. 회복은 내 데이터로 계산한 웰니스 추정치이며, 의학적 진단이나 조언이 아니에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ziekte, alcohol, reizen, stress en hoe je apparaat zit kunnen deze signalen allemaal beïnvloeden. Herstel is een welzijnsschatting uit je eigen gegevens, geen medische diagnose of advies."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Choroba, alkohol, podróże, stres i dopasowanie urządzenia mogą wpływać na te sygnały. Regeneracja to szacunek dotyczący samopoczucia na podstawie Twoich danych, a nie diagnoza medyczna ani porada."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Doença, álcool, viagens, estresse e o ajuste do dispositivo podem alterar esses sinais. A Recuperação é uma estimativa de bem-estar a partir dos seus próprios dados, não um diagnóstico nem aconselhamento médico."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Boala, alcoolul, călătoriile, stresul și modul în care stă dispozitivul pot influența aceste semnale. Recuperarea este o estimare de wellness din propriile tale date, nu un diagnostic sau un sfat medical."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Болезнь, алкоголь, поездки, стресс и посадка устройства могут влиять на эти сигналы. Восстановление — оценка самочувствия на основе ваших данных, а не медицинский диагноз или рекомендация."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Хвороба, алкоголь, подорожі, стрес і посадка пристрою — усе це може змінювати ці сигнали. Відновлення — це оцінка самопочуття на основі ваших даних, а не медичний діагноз чи порада."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "生病、饮酒、旅行、压力和设备佩戴松紧都可能影响这些信号。恢复是基于你自己数据的健康估算，不是医学诊断或建议。"
          }
        }
      }
    },
