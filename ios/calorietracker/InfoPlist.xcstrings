          "stringUnit" : {
            "state" : "new",
            "value" : "Ayuvo needs microphone access so you can log food by voice."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ Ayuvo صور الوجبات في مكتبة الصور عند النقر على حفظ."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo \"Yadda saxla\" düyməsinə toxunanda yemək şəkillərini foto kitabxananıza yadda saxlayır."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo speichert Mahlzeitfotos in deiner Fotomediathek, wenn du auf Speichern tippst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo saves meal photos to your photo library when you tap Save."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo guarda fotos de comidas en tu biblioteca de fotos cuando tocas Guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo enregistre les photos de repas dans votre photothèque lorsque vous touchez Enregistrer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आप सहेजें पर टैप करते हैं, तो Ayuvo भोजन की तस्वीरें आपकी फोटो लाइब्रेरी में सहेजता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo salva le foto dei pasti nella libreria foto quando tocchi Salva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvoは「保存」をタップすると、食事の写真をフォトライブラリに保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo는 저장을 탭하면 식사 사진을 사진 보관함에 저장합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo slaat maaltijdfoto's op in je fotobibliotheek wanneer je op Opslaan tikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo zapisuje zdjęcia posiłków w bibliotece zdjęć po dotknięciu Zapisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Ayuvo salva fotos de refeições na sua biblioteca de fotos quando você toca em Salvar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo salvează fotografiile meselor în biblioteca foto când atingi Salvează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo сохраняет фото блюд в медиатеку, когда вы нажимаете «Сохранить»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo зберігає фото страв в медiatеку, когда ви нажимаете «Зберегти»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你点按“保存”时，Ayuvo 会将餐食照片保存到照片图库。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
