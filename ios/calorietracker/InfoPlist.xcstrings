    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo reads your activity, body measurements, heart, sleep, vitals, respiratory, mobility, hearing, cycle tracking, mindfulness, symptoms and nutrition data to show them in the Health Data hub and keep your history in sync on this iPhone. Only if you allow it, Coach can use this data to answer your questions through your AI provider."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يكتب Ayuvo بيانات التغذية وقياسات الجسم وسعرات التمارين المحسوبة أو يحدّثها أو يزيلها عندما تغيّر سجلاتك."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo qeydlərinizi dəyişdirdikdə qidalanma, bədən ölçüləri və hesablanmış məşq kalorilərinizi yazır, yeniləyir və ya silir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo schreibt, aktualisiert oder entfernt deine Ernährungsdaten, Körpermaße und berechneten Trainingskalorien, wenn du deine Einträge änderst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo writes, updates or removes your nutrition, body measurements and calculated workout calories when you change your logs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo escribe, actualiza o elimina tus datos de nutrición, medidas corporales y calorías de entrenamiento calculadas cuando cambias tus registros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo écrit, met à jour ou supprime vos données de nutrition, vos mensurations et vos calories d’entraînement calculées lorsque vous modifiez vos journaux."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आप अपने लॉग बदलते हैं, तो Ayuvo आपके पोषण, शरीर माप और गणना की गई वर्कआउट कैलोरी को लिखता, अपडेट करता या हटाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo scrive, aggiorna o rimuove i tuoi dati di nutrizione, le misure corporee e le calorie di allenamento calcolate quando modifichi i tuoi diari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvoは、ログを変更すると栄養、身体測定、算出したワークアウトのカロリーを書き込み、更新、または削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo는 기록을 변경하면 영양, 신체 측정 및 계산된 운동 칼로리를 기록, 업데이트 또는 제거합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo schrijft, werkt bij of verwijdert je voeding, lichaamsmaten en berekende trainingscalorieën wanneer je je logboek wijzigt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo zapisuje, aktualizuje lub usuwa dane o odżywianiu, pomiary ciała i obliczone kalorie treningu, gdy zmieniasz swoje wpisy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Ayuvo grava, atualiza ou remove sua nutrição, medidas corporais e calorias de treino calculadas quando você altera seus registros."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo scrie, actualizează sau elimină datele tale de nutriție, măsurătorile corporale și caloriile de antrenament calculate atunci când îți modifici jurnalele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo записывает, обновляет или удаляет данные о питании, измерения тела и рассчитанные калории тренировок, когда вы меняете свои записи."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo записує, оновлює або видаляє дані про харчування, вимірювання тіла та розраховані калорії тренувань, коли ви змінюєте свої записи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你更改日志时，Ayuvo 会写入、更新或删除你的营养、身体测量和计算得出的锻炼卡路里。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
