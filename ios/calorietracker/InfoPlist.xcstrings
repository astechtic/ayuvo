    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يستخدم Ayuvo الكاميرا لمسح الطعام والرموز الشريطية."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo qida və ştrix-kodları skan etmək üçün kameradan istifadə edir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo používá fotoaparát ke skenování jídla a čárových kódů."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo verwendet die Kamera, um Lebensmittel und Barcodes zu scannen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo uses the camera to scan food and barcodes, and to measure your pulse from your fingertip or face. Camera frames are processed on this device and are not saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo usa la cámara para escanear alimentos y códigos de barras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo utilise l’appareil photo pour scanner les aliments et les codes-barres."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo भोजन और बारकोड स्कैन करने के लिए कैमरे का उपयोग करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo usa la fotocamera per scansionare alimenti e codici a barre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvoは、食品やバーコードのスキャンにカメラを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo는 음식과 바코드를 스캔하기 위해 카메라를 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo gebruikt de camera om voedsel en barcodes te scannen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo używa aparatu do skanowania żywności i kodów kreskowych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Ayuvo usa a câmera para escanear alimentos e códigos de barras."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo folosește camera pentru a scana alimente și coduri de bare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo использует камеру для сканирования продуктов и штрихкодов."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo використовує камеру для сканування продуктів и штрихкодов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo 使用相机扫描食物和条形码。"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يقرأ Ayuvo بيانات النشاط وقياسات الجسم والقلب والنوم والعلامات الحيوية والتنفس والحركة والسمع وتتبع الدورة واليقظة الذهنية والأعراض والتغذية لعرضها في مركز البيانات الصحية والحفاظ على مزامنة سجلك على هذا الـ iPhone. فقط إذا سمحت بذلك، يمكن للمدرب استخدام هذه البيانات للإجابة عن أسئلتك عبر مزوّد الذكاء الاصطناعي الخاص بك."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo fəaliyyət, bədən ölçüləri, ürək, yuxu, həyati göstəricilər, tənəffüs, hərəkətlilik, eşitmə, tsikl izləmə, düşüncəlilik, simptomlar və qidalanma məlumatlarınızı oxuyur ki, onları Sağlamlıq məlumatları mərkəzində göstərsin və bu iPhone-da tarixçənizi sinxron saxlasın. Yalnız siz icazə versəniz, Məşqçi suallarınızı Sİ provayderiniz vasitəsilə cavablandırmaq üçün bu məlumatlardan istifadə edə bilər."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo čte tvé údaje o aktivitě, tělesných mírách, srdci, spánku, vitálních funkcích, dýchání, pohyblivosti, sluchu, sledování cyklu, všímavosti, příznacích a výživě, aby je zobrazil v centru zdravotních dat a udržoval tvou historii synchronizovanou na tomto iPhonu. Pouze pokud to povolíš, může Kouč tato data použít k zodpovězení tvých otázek prostřednictvím tvého poskytovatele AI."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo liest deine Daten zu Aktivität, Körpermaßen, Herz, Schlaf, Vitalwerten, Atmung, Mobilität, Hören, Zyklusprotokoll, Achtsamkeit, Symptomen und Ernährung, um sie im Gesundheitsdaten-Bereich anzuzeigen und deinen Verlauf auf diesem iPhone synchron zu halten. Nur wenn du es erlaubst, kann Coach diese Daten verwenden, um deine Fragen über deinen KI-Anbieter zu beantworten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo reads your activity, body measurements, heart, sleep, vitals, respiratory, mobility, hearing, cycle tracking, mindfulness, symptoms and nutrition data to show them in the Health Data hub and keep your history in sync on this iPhone. Only if you allow it, Coach can use this data to answer your questions through your AI provider."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo lee tus datos de actividad, medidas corporales, corazón, sueño, constantes vitales, respiración, movilidad, audición, seguimiento del ciclo, mindfulness, síntomas y nutrición para mostrarlos en el centro de datos de salud y mantener tu historial sincronizado en este iPhone. Solo si lo permites, Coach puede usar estos datos para responder a tus preguntas a través de tu proveedor de IA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo lit vos données d'activité, de mensurations, de cœur, de sommeil, de signes vitaux, de respiration, de mobilité, d'audition, de suivi du cycle, de pleine conscience, de symptômes et de nutrition pour les afficher dans le hub Données de santé et garder votre historique synchronisé sur cet iPhone. Uniquement si vous l'autorisez, le Coach peut utiliser ces données pour répondre à vos questions via votre fournisseur d'IA."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo आपकी गतिविधि, शरीर के माप, हृदय, नींद, वाइटल्स, श्वसन, गतिशीलता, सुनने की क्षमता, मासिक चक्र ट्रैकिंग, माइंडफ़ुलनेस, लक्षण और पोषण डेटा पढ़ता है, ताकि उन्हें हेल्थ डेटा हब में दिखा सके और इस iPhone पर आपका इतिहास सिंक रख सके। केवल आपकी अनुमति होने पर ही कोच आपके सवालों के जवाब देने के लिए आपके AI प्रदाता के ज़रिए इस डेटा का उपयोग कर सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo legge i tuoi dati su attività, misure corporee, cuore, sonno, parametri vitali, respirazione, mobilità, udito, monitoraggio del ciclo, consapevolezza, sintomi e alimentazione per mostrarli nell'hub Dati salute e mantenere la tua cronologia sincronizzata su questo iPhone. Solo se lo consenti, il Coach può usare questi dati per rispondere alle tue domande tramite il tuo provider IA."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvoは、アクティビティ、身体測定値、心臓、睡眠、バイタル、呼吸、移動能力、聴覚、周期記録、マインドフルネス、症状、栄養のデータを読み取り、ヘルスデータハブに表示して、このiPhoneで履歴を同期します。許可した場合に限り、コーチはこのデータを使って、AIプロバイダ経由であなたの質問に答えることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo는 활동, 신체 측정값, 심장, 수면, 활력 징후, 호흡, 이동성, 청각, 생리 주기 추적, 마음챙김, 증상 및 영양 데이터를 읽어 건강 데이터 허브에 표시하고 이 iPhone에서 기록을 동기화해요. 허용한 경우에만 코치가 이 데이터를 사용해 AI 제공업체를 통해 질문에 답할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo leest je gegevens over activiteit, lichaamsmetingen, hart, slaap, vitale functies, ademhaling, mobiliteit, gehoor, menstruatiecyclus, mindfulness, symptomen en voeding om ze te tonen in de hub Gezondheidsgegevens en je geschiedenis op deze iPhone gesynchroniseerd te houden. Alleen als je dat toestaat, kan Coach deze gegevens via je AI-provider gebruiken om je vragen te beantwoorden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo odczytuje dane o aktywności, pomiarach ciała, sercu, śnie, parametrach życiowych, oddychaniu, mobilności, słuchu, cyklu, uważności, objawach i odżywianiu, aby wyświetlać je w centrum Dane zdrowotne i synchronizować historię na tym iPhonie. Tylko jeśli na to pozwolisz, Trener może używać tych danych, aby odpowiadać na Twoje pytania przez Twojego dostawcę AI."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Ayuvo lê seus dados de atividade, medidas corporais, coração, sono, sinais vitais, respiração, mobilidade, audição, ciclo menstrual, mindfulness, sintomas e nutrição para exibi-los na central de dados de saúde e manter seu histórico sincronizado neste iPhone. Somente se você permitir, o Coach pode usar esses dados para responder às suas perguntas por meio do seu provedor de IA."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo citește datele tale despre activitate, măsurători corporale, inimă, somn, semne vitale, respirație, mobilitate, auz, urmărirea ciclului, mindfulness, simptome și nutriție pentru a le afișa în centrul Date de sănătate și pentru a-ți păstra istoricul sincronizat pe acest iPhone. Doar dacă permiți, Antrenorul poate folosi aceste date pentru a-ți răspunde la întrebări prin furnizorul tău AI."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo считывает данные об активности, замерах тела, сердце, сне, жизненных показателях, дыхании, мобильности, слухе, цикле, осознанности, симптомах и питании, чтобы показывать их в разделе «Данные здоровья» и синхронизировать историю на этом iPhone. Только с вашего разрешения Тренер может использовать эти данные, чтобы отвечать на ваши вопросы через вашего провайдера ИИ."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo зчитує дані про вашу активність, вимірювання тіла, серце, сон, життєві показники, дихання, мобільність, слух, відстеження циклу, усвідомленість, симптоми та харчування, щоб показувати їх у розділі «Дані здоров'я» і синхронізувати вашу історію на цьому iPhone. Лише якщо ви дозволите, Тренер зможе використовувати ці дані, щоб відповідати на ваші запитання через вашого провайдера ШІ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo 会读取你的活动、身体测量、心脏、睡眠、生命体征、呼吸、行动能力、听力、周期跟踪、正念、症状和营养数据，以便在“健康数据”中心显示，并在这台 iPhone 上保持历史记录同步。只有在你允许的情况下，教练才能通过你的 AI 提供商使用这些数据来回答你的问题。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يكتب Ayuvo أو يحدّث أو يزيل بيانات التغذية وقياسات الجسم والتمارين مع مساراتها وسعرات التمارين المحسوبة، وكذلك دوراتك الشهرية وغزارتها وأعراض الدورة إذا فعّلت مزامنة الدورة، عندما تغيّر سجلاتك."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Qeydlərinizi dəyişdirdikdə Ayuvo qidalanma, bədən ölçüləri, marşrutları ilə birlikdə məşqlər, hesablanmış məşq kaloriləri və dövr sinxronizasiyasını aktiv etsəniz, aybaşı, axın və dövr simptomları məlumatlarınızı yazır, yeniləyir və ya silir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo zapisuje, aktualizuje nebo odstraňuje tvé údaje o výživě, tělesných mírách, trénincích včetně tras, vypočtených kaloriích z tréninků a – pokud zapneš synchronizaci cyklu – o menstruaci, krvácení a příznacích cyklu, když změníš své záznamy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo schreibt, aktualisiert oder entfernt deine Ernährungsdaten, Körpermaße, Trainings samt Routen, berechneten Trainingskalorien und – wenn du die Zyklussynchronisierung einschaltest – deine Perioden, Blutungsstärke und Zyklussymptome, wenn du deine Einträge änderst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuvo writes, updates or removes your nutrition, body measurements, workouts with their routes, calculated workout calories and, if you turn on cycle sync, your periods, flow and cycle symptoms when you change your logs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo escribe, actualiza o elimina tus datos de nutrición, medidas corporales, entrenamientos con sus rutas, calorías de entrenamiento calculadas y, si activas la sincronización del ciclo, tus periodos, flujo y síntomas del ciclo cuando cambias tus registros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo écrit, met à jour ou supprime vos données de nutrition, vos mensurations, vos entraînements avec leurs itinéraires, vos calories d’entraînement calculées et, si vous activez la synchronisation du cycle, vos règles, leur flux et vos symptômes du cycle lorsque vous modifiez vos journaux."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "जब आप अपने लॉग बदलते हैं, तब Ayuvo आपका पोषण, शरीर के माप, रूट सहित वर्कआउट, गणना की गई वर्कआउट कैलोरी और, अगर आप चक्र सिंक चालू करते हैं, तो आपके पीरियड, फ़्लो और चक्र के लक्षण लिखता, अपडेट करता या हटाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quando modifichi le tue registrazioni, Ayuvo scrive, aggiorna o rimuove alimentazione, misure corporee, allenamenti con i relativi percorsi, calorie calcolate degli allenamenti e, se attivi la sincronizzazione del ciclo, mestruazioni, flusso e sintomi del ciclo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "記録を変更すると、Ayuvoは栄養、体の測定値、ルートを含むワークアウト、計算されたワークアウトの消費カロリー、そして周期の同期をオンにした場合は生理、経血量、周期の症状を書き込み、更新、または削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "기록을 변경하면 Ayuvo가 영양, 신체 치수, 경로가 포함된 운동, 계산된 운동 칼로리, 그리고 주기 동기화를 켠 경우 생리, 생리량, 주기 증상을 기록, 업데이트 또는 삭제해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo schrijft, wijzigt of verwijdert je voeding, lichaamsmetingen, trainingen met hun routes, berekende trainingscalorieën en, als je cyclussynchronisatie inschakelt, je menstruaties, bloeding en cyclussymptomen wanneer je je registraties wijzigt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gdy zmieniasz swoje wpisy, Ayuvo zapisuje, aktualizuje lub usuwa dane o odżywianiu, pomiary ciała, treningi wraz z trasami, obliczone kalorie z treningów oraz — jeśli włączysz synchronizację cyklu — miesiączki, krwawienie i objawy cyklu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Ayuvo grava, atualiza ou remove sua nutrição, medidas corporais, treinos com seus trajetos, calorias de treino calculadas e, se você ativar a sincronização do ciclo, suas menstruações, fluxo e sintomas do ciclo quando você altera seus registros."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo scrie, actualizează sau elimină datele despre nutriție, măsurătorile corporale, antrenamentele cu traseele lor, caloriile calculate ale antrenamentelor și, dacă activezi sincronizarea ciclului, menstruațiile, fluxul și simptomele ciclului atunci când îți modifici înregistrările."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo записывает, обновляет или удаляет данные о питании, параметрах тела, тренировках с маршрутами, рассчитанных калориях тренировок, а если включена синхронизация цикла — о менструациях, выделениях и симптомах цикла, когда вы меняете свои записи."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo записує, оновлює або видаляє дані про харчування, параметри тіла, тренування з маршрутами, розраховані калорії тренувань, а якщо ввімкнено синхронізацію циклу — про менструації, виділення та симптоми циклу, коли ви змінюєте свої записи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "当你更改记录时，Ayuvo 会写入、更新或移除你的营养、身体测量、带路线的体能训练、计算出的训练卡路里；如果你开启了周期同步，还包括你的经期、经量和周期症状。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الاتصال بخادم Ollama على شبكتك المحلية، والعثور على هاتف الشريك المقترن على شبكة Wi-Fi نفسها لمزامنة البيانات الصحية التي تشاركانها."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yerli şəbəkənizdəki Ollama serverinə qoşulmaq və paylaşdığınız sağlamlıq məlumatlarını sinxronlaşdırmaq üçün eyni Wi-Fi şəbəkəsində cütləşdirilmiş partnyorun telefonunu tapmaq."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Připojení k serveru Ollama ve tvé místní síti a nalezení telefonu spárovaného partnera ve stejné síti Wi-Fi kvůli synchronizaci zdravotních dat, která sdílíte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mit einem Ollama-Server in deinem lokalen Netzwerk verbinden und das Telefon eines gekoppelten Partners im selben WLAN finden, um die geteilten Gesundheitsdaten zu synchronisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Connect to an Ollama server on your local network, and find a paired partner's phone on the same Wi-Fi to sync the health data you share."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Conectar con un servidor Ollama en tu red local y encontrar el teléfono de tu pareja vinculada en la misma Wi-Fi para sincronizar los datos de salud que compartís."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se connecter à un serveur Ollama sur votre réseau local et trouver le téléphone d’un partenaire associé sur le même Wi-Fi pour synchroniser les données de santé que vous partagez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अपने लोकल नेटवर्क पर Ollama सर्वर से कनेक्ट करें, और साझा किया गया स्वास्थ्य डेटा सिंक करने के लिए उसी Wi-Fi पर जोड़े गए पार्टनर का फ़ोन ढूँढें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Connettiti a un server Ollama sulla tua rete locale e trova il telefono di un partner abbinato sulla stessa Wi-Fi per sincronizzare i dati sanitari che condividete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ローカルネットワーク上のOllamaサーバーに接続し、共有している健康データを同期するために同じWi-Fi上のペアリング済みパートナーのiPhoneを見つけます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "로컬 네트워크의 Ollama 서버에 연결하고, 공유하는 건강 데이터를 동기화하기 위해 같은 Wi-Fi에 있는 연결된 파트너의 휴대폰을 찾아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verbinden met een Ollama-server op je lokale netwerk en de telefoon van een gekoppelde partner op hetzelfde wifi-netwerk vinden om de gezondheidsgegevens die je deelt te synchroniseren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Połącz się z serwerem Ollama w sieci lokalnej i znajdź telefon sparowanego partnera w tej samej sieci Wi-Fi, aby synchronizować udostępniane dane o zdrowiu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Conectar a um servidor Ollama na sua rede local e encontrar o celular de um parceiro pareado na mesma rede Wi-Fi para sincronizar os dados de saúde que vocês compartilham."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Conectează-te la un server Ollama din rețeaua locală și găsește telefonul unui partener asociat în aceeași rețea Wi-Fi pentru a sincroniza datele de sănătate pe care le partajați."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Подключение к серверу Ollama в вашей локальной сети и поиск телефона сопряжённого партнёра в той же сети Wi-Fi для синхронизации данных о здоровье, которыми вы делитесь."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Підключення до сервера Ollama у вашій локальній мережі та пошук телефона спареного партнера в тій самій мережі Wi-Fi для синхронізації даних про здоровʼя, якими ви ділитеся."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "连接到本地网络上的 Ollama 服务器，并在同一 Wi-Fi 中找到已配对伙伴的手机，以同步你们共享的健康数据。"
