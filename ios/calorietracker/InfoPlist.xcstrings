        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يستخدم Ayuvo موقعك أثناء تسجيل المشي أو الجري أو ركوب الدراجة أو المشي لمسافات طويلة في الهواء الطلق لقياس المسافة والوتيرة والمقاطع ومسارك. يُستخدم الموقع فقط خلال التمرين الذي تبدؤه."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo açıq havada gəzinti, qaçış, velosiped sürüşü və ya yürüş qeyd edərkən məsafəni, tempi, hissələri və marşrutunuzu ölçmək üçün məkanınızdan istifadə edir. Məkan yalnız sizin başlatdığınız məşq zamanı istifadə olunur."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo používá tvou polohu při záznamu venkovní chůze, běhu, jízdy na kole nebo túry k měření vzdálenosti, tempa, úseků a trasy. Poloha se používá pouze během tréninku, který spustíš."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo verwendet deinen Standort, während du ein Outdoor-Training (Gehen, Laufen, Radfahren oder Wandern) aufzeichnest, um Distanz, Tempo, Splits und deine Route zu messen. Der Standort wird nur während eines von dir gestarteten Trainings verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Ayuvo uses your location while you record an outdoor walk, run, ride or hike to measure distance, pace, splits and your route. Location is only used during a workout you start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo usa tu ubicación mientras registras una caminata, carrera, salida en bici o ruta de senderismo al aire libre para medir la distancia, el ritmo, los parciales y tu ruta. La ubicación solo se usa durante un entrenamiento que tú inicias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo utilise votre position pendant que vous enregistrez une marche, une course, une sortie à vélo ou une randonnée en extérieur pour mesurer la distance, l'allure, les temps intermédiaires et votre itinéraire. La position n'est utilisée que pendant un entraînement que vous démarrez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "जब आप बाहर वॉक, रन, राइड या हाइक रिकॉर्ड करते हैं, तब दूरी, पेस, स्प्लिट्स और आपका रूट मापने के लिए Ayuvo आपकी लोकेशन का उपयोग करता है। लोकेशन का उपयोग केवल आपके द्वारा शुरू किए गए वर्कआउट के दौरान होता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo usa la tua posizione mentre registri una camminata, una corsa, un giro in bici o un'escursione all'aperto per misurare distanza, passo, parziali e percorso. La posizione viene usata solo durante un allenamento avviato da te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvoは、屋外でのウォーキング、ランニング、サイクリング、ハイキングを記録している間、距離、ペース、スプリット、ルートを測定するために位置情報を使用します。位置情報は、あなたが開始したワークアウト中にのみ使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo는 야외 걷기, 달리기, 라이딩 또는 하이킹을 기록하는 동안 위치를 사용해 거리, 페이스, 구간 기록 및 경로를 측정해요. 위치는 직접 시작한 운동 중에만 사용돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo gebruikt je locatie terwijl je buiten wandelt, hardloopt, fietst of hiket om afstand, tempo, splits en je route te meten. Je locatie wordt alleen gebruikt tijdens een training die je zelf start."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo używa Twojej lokalizacji podczas nagrywania spaceru, biegu, jazdy na rowerze lub wędrówki na zewnątrz, aby mierzyć dystans, tempo, odcinki i trasę. Lokalizacja jest używana tylko podczas treningu, który sam rozpoczniesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Ayuvo usa sua localização enquanto você grava uma caminhada, corrida, pedalada ou trilha ao ar livre para medir distância, ritmo, parciais e sua rota. A localização só é usada durante um treino iniciado por você."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo folosește locația ta cât timp înregistrezi o plimbare, o alergare, o tură cu bicicleta sau o drumeție în aer liber, pentru a măsura distanța, ritmul, segmentele și traseul. Locația este folosită doar în timpul unui antrenament pornit de tine."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo использует вашу геопозицию во время записи прогулки, пробежки, велозаезда или похода на улице, чтобы измерять дистанцию, темп, отрезки и маршрут. Геопозиция используется только во время начатой вами тренировки."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayuvo використовує вашу геопозицію, коли ви записуєте ходьбу, біг, велопоїздку чи похід на вулиці, щоб вимірювати відстань, темп, відрізки та маршрут. Геопозиція використовується лише під час тренування, яке ви почали."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "当你记录户外步行、跑步、骑行或徒步时，Ayuvo 会使用你的位置来测量距离、配速、分段和路线。位置信息仅在你开始的训练期间使用。"
          }
        }
      }
    },
